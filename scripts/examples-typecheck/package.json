{
  "name": "tangle-website-examples-typecheck",
  "private": true,
  "type": "module",
  "description": "Typechecks src/examples/*/*.mts and every ```ts fence in src/content/blog against the published SDK packages. The files are copied in so Node resolution finds this package's node_modules.",
  "scripts": {
    "typecheck": "rm -rf src && cp -R ../../src/examples src && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@computesdk/e2b": "1.7.68",
    "@tangle-network/agent-app": "1.0.19",
    "@tangle-network/agent-eval": "1.0.12",
    "@tangle-network/agent-interface": "5.10.14",
    "@tangle-network/agent-provider-computesdk": "1.0.7",
    "@tangle-network/agent-provider-daytona": "0.6.1",
    "@tangle-network/agent-provider-e2b": "0.6.1",
    "@tangle-network/agent-provider-tangle": "5.0.5",
    "@tangle-network/agent-runtime": "3.0.24",
    "@tangle-network/browser-agent-driver": "0.37.0",
    "@tangle-network/sandbox": "1.0.168",
    "computesdk": "4.1.14",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
