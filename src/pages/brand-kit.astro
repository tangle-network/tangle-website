---
import BaseLayout from '../layouts/BaseLayout.astro'
import { knot, palettes, type BrandPalette } from '@tangle-network/brand'

const themes = [
  { name: 'Dark', use: 'Homepage and product pages', file: '/images/brand/atmospheres/tangle-atmosphere-indigo-01.webp', logo: '/brand/tangle-logo-light.svg', className: 'dark' },
  { name: 'Paper', use: 'Blog, benchmarks, docs and research', file: '/images/brand/atmospheres/tangle-paper-indigo-01.webp', logo: '/brand/tangle-logo.svg', className: 'light' },
]

const logos = [
  { file: 'tangle-logo-light.svg', use: 'For dark backgrounds', className: 'logo-tile-dark dark' },
  { file: 'tangle-logo.svg', use: 'For light backgrounds', className: 'logo-tile-light' },
  { file: 'tangle-icon-filled.svg', use: 'Icon, for favicons', className: 'logo-tile-icon' },
]

// CSS variable, palette role, use. Hex values are read from the pinned brand package, never typed here.
const tokens: [string, keyof BrandPalette, string][] = [
  ['--depth-1', 'canvas', 'Page background'],
  ['--depth-2', 'card', 'Cards'],
  ['--depth-3', 'nested', 'Nested panels'],
  ['--depth-4', 'overlay', 'Menus and popovers'],
  ['--border-default', 'hairline', 'Borders'],
  ['--text-primary', 'ink', 'Body text'],
  ['--btn-primary-bg', 'accent', 'Primary buttons'],
  ['--surface-success-text', 'successText', 'Passed checks'],
  ['--surface-warning-text', 'warningText', 'Warnings'],
  ['--surface-danger-text', 'dangerText', 'Failed checks'],
]
const columns = [palettes.websiteDark, palettes.websiteLight]
---

<BaseLayout
  title="Brand kit"
  description="Download Tangle logos and brand colors."
>
  <script is:inline>
    document.body.classList.add('brand-kit-page')
  </script>

  <main class="brand-kit" data-theme="website" aria-labelledby="brand-kit-title">
    <section class="brand-hero dark" data-theme="website">
      <div class="brand-hero-inner">
        <img src="/brand/tangle-logo-light.svg" alt="Tangle" />
        <h1 id="brand-kit-title">Brand kit</h1>
        <p class="brand-hero-sub">
          Download Tangle logos and brand colors.
        </p>
      </div>
    </section>

    <section class="brand-section" aria-labelledby="themes-title">
      <div class="section-head">
        <h2 id="themes-title">Themes</h2>
      </div>
      <div class="theme-grid">
        {themes.map((theme) => (
          <article class={`theme-card theme-card-${theme.className}`}>
            <div class="theme-media">
              <img src={theme.file} alt={`Tangle ${theme.name} theme background`} />
              <img class="theme-logo" src={theme.logo} alt={`Tangle logo on the ${theme.name} theme`} />
            </div>
            <div class="theme-body">
              <h3>{theme.name}</h3>
              <p class="theme-use mono">{theme.use}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="brand-section logo-section" aria-labelledby="logo-title">
      <div class="section-head">
        <h2 id="logo-title">Logo</h2>
      </div>
      <ul class="logo-grid" role="list">
        {logos.map((logo) => (
          <li>
            <a class={`logo-tile ${logo.className}`} data-theme="website" href={`/brand/${logo.file}`} download>
              <img src={`/brand/${logo.file}`} alt="" />
              <span>{logo.use}<code class="mono">{logo.file}</code></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="brand-section palette-section" aria-labelledby="colors-title">
      <div class="section-head">
        <h2 id="colors-title">Colors</h2>
      </div>
      <div class="token-scroll">
        <table class="token-table">
          <thead>
            <tr><th>Token</th><th>Dark</th><th>Paper</th><th>Use</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>Knot gradient</td>
              <td colspan="2"><span class="chip" style={`background: linear-gradient(90deg, ${knot.stops.join(', ')});`}></span><code>{knot.stops.join(' → ')}</code></td>
              <td>Logo artwork</td>
            </tr>
            {tokens.map(([variable, role, use]) => (
              <tr>
                <td><code>{variable}</code></td>
                {columns.map((palette) => (
                  <td><span class="chip" style={`background: ${palette[role]};`}></span><code>{palette[role]}</code></td>
                ))}
                <td>{use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="token-source">Import <code>@tangle-network/brand/styles</code> to use these variables.</p>
    </section>
  </main>
</BaseLayout>

<style>
  :global(.brand-kit-page .wf-nav) {
    background: rgba(12, 11, 29, 0.86);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(18px);
  }

  .mono {
    font-family: var(--font-mono);
    font-feature-settings: 'tnum';
  }

  .brand-kit {
    min-height: 100vh;
    background: var(--bg-root);
    color: var(--text-primary);
  }

  .brand-hero {
    position: relative;
    overflow: hidden;
    padding: 8rem 6% 4.5rem;
    background: var(--md3-surface-container-lowest);
    color: var(--text-primary);
  }

  .brand-hero::before {
    position: absolute;
    inset: -10% -6% -20% 30%;
    content: '';
    background: url('/images/brand/knot-poster.webp') center / cover no-repeat;
    opacity: 0.85;
  }

  .brand-hero::after {
    position: absolute;
    inset: 0;
    content: '';
    background:
      linear-gradient(90deg, rgba(8, 8, 20, 0.96) 0%, rgba(8, 8, 20, 0.7) 48%, rgba(8, 8, 20, 0.22) 100%),
      linear-gradient(180deg, rgba(8, 8, 20, 0.05), rgba(8, 8, 20, 0.72) 100%);
  }

  .brand-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 76rem;
    margin: 0 auto;
  }

  .brand-hero-inner > img {
    width: 10.5rem;
    max-height: 3rem;
    margin-bottom: 2rem;
    object-fit: contain;
    object-position: left center;
  }

  .brand-hero h1,
  .brand-section h2,
  .theme-card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }

  .brand-hero h1 {
    max-width: 10ch;
    font-size: clamp(3.8rem, 7.5vw, 7rem);
    line-height: 0.96;
  }

  .brand-hero-sub {
    max-width: 40rem;
    margin: 1.4rem 0 0;
    color: rgba(240, 240, 250, 0.78);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .brand-section {
    padding: 5rem 6%;
  }

  .section-head,
  .theme-grid,
  .logo-grid,
  .token-scroll,
  .token-source {
    max-width: 76rem;
    margin-right: auto;
    margin-left: auto;
  }

  .brand-section h2 {
    color: var(--text-primary);
    font-size: clamp(2rem, 3.6vw, 3.4rem);
    line-height: 1.02;
  }

  .theme-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .theme-card {
    overflow: hidden;
    border: 1px solid var(--md3-outline-variant);
    border-radius: 10px;
    background: var(--bg-card);
  }

  .theme-media {
    position: relative;
    min-height: 24rem;
    overflow: hidden;
  }

  .theme-media > img:first-child {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .theme-card-light .theme-media {
    border-bottom: 1px solid var(--md3-outline-variant);
  }

  .theme-logo {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    z-index: 1;
    width: 10.5rem;
    max-height: 2.8rem;
    object-fit: contain;
    object-position: left center;
  }

  .theme-body {
    padding: 1.2rem 1.2rem 1.35rem;
  }

  .theme-card h3 {
    color: var(--text-primary);
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
    line-height: 1.05;
  }

  .theme-use {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .logo-section {
    background: var(--bg-card);
  }

  .logo-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }

  .logo-tile {
    display: flex;
    min-height: 14rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.3rem;
    border-radius: 10px;
    text-decoration: none;
  }

  .logo-tile img {
    width: min(13rem, 60%);
    max-height: 4rem;
  }

  .logo-tile span {
    color: inherit;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .logo-tile code {
    display: block;
    margin-top: 0.3rem;
    color: var(--text-muted);
    font-weight: 400;
    font-size: 0.76rem;
  }

  .logo-tile-dark {
    background: var(--depth-1);
    color: var(--text-primary);
  }

  .logo-tile-light,
  .logo-tile-icon {
    border: 1px solid var(--md3-outline-variant);
    background: var(--bg-section);
    color: var(--text-primary);
  }

  .logo-tile-icon img {
    width: 4rem;
  }

  .palette-section {
    background: var(--bg-root);
  }

  .token-scroll {
    margin-top: 2rem;
    overflow-x: auto;
  }

  .token-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .token-table th {
    padding: 0 1rem 0.75rem 0;
    color: var(--text-muted);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .token-table td {
    padding: 0.7rem 1rem 0.7rem 0;
    border-top: 1px solid var(--border-subtle);
    white-space: nowrap;
  }

  .token-table code,
  .token-source code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .chip {
    display: inline-block;
    width: 1.5rem;
    height: 1.5rem;
    margin-right: 0.6rem;
    border-radius: 5px;
    box-shadow: inset 0 0 0 1px rgba(25, 28, 36, 0.16);
    vertical-align: middle;
  }

  .token-source {
    margin-top: 1.25rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 820px) {
    .brand-hero {
      padding: 6rem 1rem 2.75rem;
    }

    .brand-hero::before {
      inset: -10% -40% -10% -5%;
      opacity: 0.5;
    }

    .brand-hero::after {
      background: linear-gradient(180deg, color-mix(in srgb, var(--md3-surface-container-lowest) 55%, transparent) 0%, color-mix(in srgb, var(--md3-surface-container-lowest) 92%, transparent) 70%, var(--md3-surface-container-lowest) 100%);
    }

    .brand-hero h1 {
      font-size: clamp(3.2rem, 15vw, 5rem);
    }

    .brand-section {
      padding: 3.5rem 1rem;
    }

    .theme-grid,
    .logo-grid {
      grid-template-columns: 1fr;
    }

    .theme-media {
      min-height: 18rem;
    }
  }
</style>
