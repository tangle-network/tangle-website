---
// Internal showcase index. Unlinked, noindex. One place to see every hero
// prototype, brand-film candidate, and generated-art gallery in progress.
const prototypes = [
  { slug: 'woven', title: 'The Run, Woven', note: 'A tangled run resolves left-to-right into clean lanes; red waste routed out. Three.js. FLAGSHIP.', ready: true },
  { slug: 'rope', title: 'Tension', note: 'A knotted Verlet rope relaxes into one taut straight line. Vanilla canvas.', ready: false },
  { slug: 'unknot', title: 'Unknotting', note: 'A real trefoil untangles into a single clean strand. Three.js, knot-theory.', ready: false },
  { slug: 'forcegraph', title: 'The Hairball', note: 'A jittering graph hairball prunes its waste and settles into a clean pipeline.', ready: false },
  { slug: 'flowfield', title: 'Laminar', note: 'Turbulent particle flow organizes into calm parallel laminar lanes.', ready: false },
  { slug: 'braid', title: 'From Trace to Fiber', note: 'A session-trace waterfall lifts and braids into a single fiber.', ready: false },
  { slug: 'wordmark', title: 'tangle / untangle', note: 'The wordmark drawn from tangled threads that untangle into clean type.', ready: false },
];
const galleries = [
  { href: '/knot-lab', title: 'Knot lab', note: 'The original Three.js torus knot (retired as hero, kept for reference).' },
  { href: '/art-review', title: 'Art review', note: '29 generated brand-art candidates with their full prompts.' },
  { href: '/ideas-review', title: 'Ideas review', note: '10 interaction / motion prototypes, ranked.' },
  { href: '/brand-kit', title: 'Brand kit', note: 'Indigo ladder, poles, logo, usage rules.' },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Tangle lab — showcase</title>
  </head>
  <body>
    <main>
      <header>
        <h1>Lab showcase</h1>
        <p class="hint">Every hero prototype, brand-film candidate, and art gallery in one place. Internal, noindex.</p>
      </header>

      <section>
        <h2>Hero prototypes <span class="mono">tangle → resolution</span></h2>
        <div class="grid">
          {prototypes.map((p) => (
            <a class={`card${p.ready ? '' : ' pending'}`} href={p.ready ? `/lab/${p.slug}` : undefined}>
              <div class="thumb" data-slug={p.slug}></div>
              <div class="meta">
                <strong>{p.title} {p.ready ? '' : <span class="tag mono">building</span>}</strong>
                <span>{p.note}</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section>
        <h2>Brand-film candidate <span class="mono">fal.ai generation</span></h2>
        <div class="film">
          <video src="/videos/hero-loop.mp4" muted loop autoplay playsinline></video>
          <p class="film-note">Generated filament loop (fal.ai). Reads well on mobile / as a section atmosphere or a separate page hero, not the main homepage hero.</p>
        </div>
      </section>

      <section>
        <h2>Galleries</h2>
        <div class="grid">
          {galleries.map((g) => (
            <a class="card link" href={g.href}>
              <div class="meta">
                <strong>{g.title}</strong>
                <span>{g.note}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  body { margin: 0; background: #080814; color: #ededf4; font-family: 'Inter', system-ui, sans-serif; }
  main { max-width: 74rem; margin: 0 auto; padding: 3.5rem 2rem 6rem; }
  h1 { font-size: 2.4rem; font-weight: 600; letter-spacing: -0.03em; margin: 0; }
  .hint { color: #9b9bbf; font-size: 1.05rem; max-width: 44rem; }
  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
  section { margin-top: 3.5rem; }
  h2 { font-size: 1.35rem; font-weight: 600; letter-spacing: -0.02em; display: flex; align-items: baseline; gap: 0.8rem; }
  h2 .mono { color: #818cf8; font-size: 0.85rem; font-weight: 400; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: 1rem; margin-top: 1.2rem; }
  .card { display: flex; flex-direction: column; border: 1px solid rgba(199,201,238,0.16); border-radius: 12px; overflow: hidden; background: #100f24; text-decoration: none; color: inherit; transition: border-color 0.15s ease, transform 0.15s ease; }
  .card:hover { border-color: rgba(129,140,248,0.5); transform: translateY(-2px); }
  .card.pending { opacity: 0.55; pointer-events: none; }
  .card.link { padding: 1.1rem 1.25rem; }
  .thumb { aspect-ratio: 16/9; background: radial-gradient(120% 100% at 70% 20%, rgba(129,140,248,0.22), transparent 60%), #0c0b1d; border-bottom: 1px solid rgba(199,201,238,0.12); }
  .meta { padding: 1rem 1.2rem 1.15rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .meta strong { font-size: 1.05rem; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; }
  .meta span { color: #9b9bbf; font-size: 0.92rem; line-height: 1.5; }
  .tag { font-size: 0.66rem; padding: 0.15rem 0.5rem; border-radius: 999px; background: rgba(129,140,248,0.14); color: #a5aafc; }
  .film { display: grid; grid-template-columns: minmax(0,1.6fr) minmax(0,1fr); gap: 1.5rem; align-items: center; margin-top: 1.2rem; }
  .film video { width: 100%; border-radius: 12px; border: 1px solid rgba(199,201,238,0.16); display: block; }
  .film-note { color: #9b9bbf; font-size: 0.95rem; line-height: 1.6; }
  @media (max-width: 720px) { .film { grid-template-columns: 1fr; } }
</style>
