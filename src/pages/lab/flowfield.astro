<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Laminar - Tangle lab</title>
  </head>
  <body>
    <canvas id="field"></canvas>
    <div class="caption">
      <h1>Laminar</h1>
      <p>vanilla canvas / curl-noise particles / pointer-x scrub</p>
    </div>

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canvas = document.getElementById('field');
      const ctx = canvas.getContext('2d', { alpha: false });
      const count = 2000;
      const lanes = 21;
      const x = new Float32Array(count);
      const y = new Float32Array(count);
      const px = new Float32Array(count);
      const py = new Float32Array(count);
      const lane = new Uint8Array(count);
      const speed = new Float32Array(count);
      const seed = new Float32Array(count);
      const failed = new Uint8Array(count);
      const palette = ['#C7C9F5', '#818CF8', '#6366F1', '#4F46E5'];
      const red = '#FB7185';
      let w = 1;
      let h = 1;
      let dpr = 1;
      let bg;
      let grain;
      let started = performance.now();
      let last = started;
      let target = reduced ? 1 : 0;
      let progress = target;
      let manualUntil = 0;
      let raf = 0;

      const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
      const mix = (a, b, t) => a + (b - a) * t;
      const ease = (t) => t * t * (3 - 2 * t);
      const rand = (n) => {
        const s = Math.sin(n * 127.113 + 91.7) * 43758.5453123;
        return s - Math.floor(s);
      };
      const bandY = (n) => {
        const pad = Math.min(h * 0.28, Math.max(54, h * 0.15));
        return pad + (n / (lanes - 1)) * Math.max(1, h - pad * 2);
      };

      function hash(ix, iy, z) {
        let n = Math.imul(ix, 374761393) ^ Math.imul(iy, 668265263) ^ Math.imul(Math.floor(z * 4096), 2246822519);
        n = Math.imul(n ^ (n >>> 13), 1274126177);
        return ((n ^ (n >>> 16)) >>> 0) / 4294967295;
      }

      function valueNoise(nx, ny, z) {
        const ix = Math.floor(nx);
        const iy = Math.floor(ny);
        const fx = nx - ix;
        const fy = ny - iy;
        const ux = ease(fx);
        const uy = ease(fy);
        const a = hash(ix, iy, z);
        const b = hash(ix + 1, iy, z);
        const c = hash(ix, iy + 1, z);
        const d = hash(ix + 1, iy + 1, z);
        return mix(mix(a, b, ux), mix(c, d, ux), uy);
      }

      function fbm(nx, ny, z) {
        let v = 0;
        let amp = 0.55;
        let f = 1;
        for (let i = 0; i < 4; i++) {
          v += valueNoise(nx * f, ny * f, z + i * 19.19) * amp;
          f *= 2.03;
          amp *= 0.5;
        }
        return v;
      }

      function curlAt(nx, ny, t, out) {
        const s = 0.00235;
        const ex = 0.018;
        const xx = nx * s;
        const yy = ny * s;
        const z = t * 0.055;
        const n1 = fbm(xx, yy + ex, z);
        const n2 = fbm(xx, yy - ex, z);
        const n3 = fbm(xx + ex, yy, z);
        const n4 = fbm(xx - ex, yy, z);
        out[0] = (n1 - n2) / (ex * 2);
        out[1] = (n4 - n3) / (ex * 2);
      }

      function resetParticle(i, clear) {
        const r1 = rand(seed[i] + 1.1);
        const r2 = rand(seed[i] + 2.2);
        const r3 = rand(seed[i] + 3.3);
        const by = bandY(lane[i]);
        if (clear) {
          x[i] = r1 * w;
          y[i] = by + (r2 - 0.5) * 2.5;
          px[i] = x[i] - (5 + speed[i] * 8);
          py[i] = y[i];
          return;
        }
        const a = r1 * Math.PI * 2;
        const rr = Math.pow(r2, 0.42) * Math.min(w, h) * 0.34;
        x[i] = w * (0.5 + (r3 - 0.5) * 0.18) + Math.cos(a) * rr;
        y[i] = h * 0.5 + Math.sin(a * 1.7) * rr * 0.62 + (r3 - 0.5) * h * 0.16;
        px[i] = x[i] + (rand(seed[i] + 4.4) - 0.5) * 12;
        py[i] = y[i] + (rand(seed[i] + 5.5) - 0.5) * 12;
      }

      function seedParticles(clear) {
        for (let i = 0; i < count; i++) {
          seed[i] = i * 17.171 + 3.31;
          lane[i] = i % lanes;
          speed[i] = 0.55 + rand(seed[i] + 7.7) * 1.35;
          failed[i] = rand(seed[i] + 8.8) > 0.956 ? 1 : 0;
          resetParticle(i, clear);
        }
      }

      function makeGrain() {
        const tile = document.createElement('canvas');
        tile.width = 180;
        tile.height = 180;
        const g = tile.getContext('2d');
        const img = g.createImageData(tile.width, tile.height);
        for (let i = 0; i < img.data.length; i += 4) {
          const n = Math.random();
          img.data[i] = 199;
          img.data[i + 1] = 201;
          img.data[i + 2] = 245;
          img.data[i + 3] = n > 0.5 ? n * 18 : 0;
        }
        g.putImageData(img, 0, 0);
        grain = ctx.createPattern(tile, 'repeat');
      }

      function makeBackground() {
        bg = ctx.createRadialGradient(w * 0.52, h * 0.45, 0, w * 0.52, h * 0.45, Math.max(w, h) * 0.76);
        bg.addColorStop(0, '#11122D');
        bg.addColorStop(0.48, '#0B0B1F');
        bg.addColorStop(1, '#080814');
      }

      function paintBackground(alpha) {
        ctx.save();
        ctx.globalCompositeOperation = 'source-over';
        ctx.globalAlpha = alpha;
        ctx.fillStyle = bg;
        ctx.fillRect(0, 0, w, h);
        ctx.restore();
      }

      function paintGrain(alpha) {
        ctx.save();
        ctx.globalCompositeOperation = 'screen';
        ctx.globalAlpha = alpha;
        ctx.fillStyle = grain;
        ctx.fillRect(0, 0, w, h);
        ctx.restore();
      }

      function paintBands(lam) {
        if (lam <= 0.08) return;
        ctx.save();
        ctx.globalCompositeOperation = 'lighter';
        for (let i = 0; i < lanes; i++) {
          const yy = bandY(i);
          ctx.beginPath();
          ctx.moveTo(-20, yy);
          ctx.lineTo(w + 20, yy);
          ctx.lineCap = 'round';
          ctx.strokeStyle = '#6366F1';
          ctx.globalAlpha = 0.012 * lam;
          ctx.lineWidth = 16;
          ctx.stroke();
          ctx.strokeStyle = '#C7C9F5';
          ctx.globalAlpha = 0.026 * lam;
          ctx.lineWidth = 1.1;
          ctx.stroke();
        }
        ctx.restore();
      }

      const cv = [0, 0];
      function moveParticles(lam, t, dt) {
        const chaos = 1 - lam;
        const cx = w * 0.5;
        const cy = h * 0.5;
        const scale = clamp(dt * 60, 0.35, 1.8);
        for (let i = 0; i < count; i++) {
          const ox = x[i];
          const oy = y[i];
          px[i] = ox;
          py[i] = oy;
          curlAt(ox, oy, t + seed[i] * 0.001, cv);

          const dx = ox - cx;
          const dy = oy - cy;
          const dist = Math.sqrt(dx * dx + dy * dy) + 0.001;
          const spin = clamp(1 - dist / (Math.min(w, h) * 0.58), 0, 1) * chaos;
          const toward = chaos * 0.0028;
          const spinX = (-dy / dist) * spin * 8.5 - dx * toward;
          const spinY = (dx / dist) * spin * 8.5 - dy * toward;
          const targetY = bandY(lane[i]);
          const rail = (targetY - oy) * (0.010 + lam * lam * 0.060);
          const forward = (0.16 + speed[i] * 0.18) * chaos + (2.8 + speed[i] * 2.2) * lam;
          const wash = Math.sin(ox * 0.01 + lane[i] * 0.63 + t * 0.7) * chaos * 0.55;
          const vx = (cv[0] * (20 * chaos + 1.8) + spinX + forward) * scale;
          const vy = (cv[1] * (20 * chaos + 1.8) + spinY + rail + wash) * scale;

          x[i] = ox + vx;
          y[i] = oy + vy;

          if (x[i] > w + 28 || x[i] < -38 || y[i] < -42 || y[i] > h + 42) {
            seed[i] += 101.13;
            if (lam > 0.68) {
              x[i] = -24 - rand(seed[i]) * w * 0.12;
              y[i] = targetY + (rand(seed[i] + 1) - 0.5) * 2.2;
              px[i] = x[i] - 10;
              py[i] = y[i];
            } else {
              resetParticle(i, false);
            }
          }
        }
      }

      function drawParticles(lam) {
        const chaos = 1 - lam;
        ctx.save();
        ctx.globalCompositeOperation = 'lighter';
        ctx.lineCap = 'round';
        for (let i = 0; i < count; i++) {
          if (failed[i]) {
            const a = Math.pow(clamp((0.62 - lam) / 0.62, 0, 1), 2) * 0.16;
            if (a <= 0.002) continue;
            ctx.strokeStyle = red;
            ctx.globalAlpha = a;
            ctx.lineWidth = 0.75 + chaos * 0.95;
          } else {
            const p = palette[(i + lane[i]) % palette.length];
            ctx.strokeStyle = p;
            ctx.globalAlpha = 0.030 + lam * 0.052 + chaos * 0.018;
            ctx.lineWidth = 0.46 + lam * 0.45 + rand(seed[i] + 9) * 0.32;
          }
          ctx.beginPath();
          ctx.moveTo(px[i], py[i]);
          ctx.lineTo(x[i], y[i]);
          ctx.stroke();
        }
        ctx.restore();
      }

      function primeTangle() {
        paintBackground(1);
        for (let i = 0; i < 46; i++) {
          moveParticles(0, i * 0.024, 0.018);
          drawParticles(0);
        }
        paintGrain(0.12);
      }

      function paintStaticEnd() {
        paintBackground(1);
        paintBands(1);
        for (let i = 0; i < 74; i++) {
          moveParticles(1, i * 0.024, 0.018);
          drawParticles(1);
        }
        paintGrain(0.16);
      }

      function resize() {
        dpr = Math.min(2, window.devicePixelRatio || 1);
        w = Math.max(1, window.innerWidth);
        h = Math.max(1, window.innerHeight);
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
        canvas.style.width = `${w}px`;
        canvas.style.height = `${h}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        makeBackground();
        makeGrain();
        seedParticles(reduced);
        if (reduced) paintStaticEnd();
        else primeTangle();
      }

      function scrub(v) {
        target = clamp(v, 0, 1);
        manualUntil = performance.now() + 3200;
      }

      window.addEventListener('pointermove', (e) => scrub(e.clientX / Math.max(1, w)), { passive: true });
      window.addEventListener('pointerdown', (e) => scrub(e.clientX / Math.max(1, w)), { passive: true });
      window.addEventListener('wheel', (e) => scrub(target + e.deltaY * 0.00065), { passive: true });
      window.addEventListener('resize', resize);

      function frame(now) {
        const dt = Math.min(0.04, Math.max(0.001, (now - last) / 1000));
        last = now;
        if (now > manualUntil) {
          target = clamp((now - started) / 7600, 0, 1);
        }
        progress += (target - progress) * (1 - Math.pow(0.0008, dt));
        const lam = ease(progress);
        paintBackground(0.035 + lam * 0.128);
        paintBands(lam);
        moveParticles(lam, now * 0.001, dt);
        drawParticles(lam);
        paintGrain(0.055);
        raf = requestAnimationFrame(frame);
      }

      resize();
      if (!reduced) {
        raf = requestAnimationFrame(frame);
      } else if (raf) {
        cancelAnimationFrame(raf);
      }
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    min-height: 100%;
    overflow: hidden;
    background: #080814;
  }

  #field {
    position: fixed;
    inset: 0;
    display: block;
    width: 100vw;
    height: 100vh;
    touch-action: none;
    cursor: ew-resize;
    background: #080814;
  }

  .caption {
    position: fixed;
    left: max(1rem, min(4vw, 3rem));
    bottom: max(1rem, min(4vw, 2.6rem));
    color: #C7C9F5;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    text-shadow: 0 0 24px rgba(99, 102, 241, 0.38);
    pointer-events: none;
  }

  .caption h1 {
    margin: 0;
    font-size: 2rem;
    line-height: 1;
    font-weight: 600;
    letter-spacing: 0;
  }

  .caption p {
    margin: 0.58rem 0 0;
    max-width: min(28rem, calc(100vw - 2rem));
    color: #818CF8;
    font-size: 0.78rem;
    line-height: 1.45;
    font-weight: 500;
    letter-spacing: 0;
  }

  @media (max-width: 640px) {
    .caption h1 {
      font-size: 1.45rem;
    }

    .caption p {
      font-size: 0.68rem;
    }
  }
</style>
