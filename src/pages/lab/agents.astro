---
// The Tangle Agents collection. Every agent is a generative character; its
// traits are its config (harness / model / tools). Deploy the featured agent
// and it runs, gets traced, and earns power-ups: self-improvement, made
// visible. A wall of the collection below. noindex, standalone.
const imgs = [
  'matte-bot-01', 'crystal-bot-01', 'woven-bot-02', 'matte-bot-03', 'crystal-bot-02',
  'matte-bot-02', 'woven-bot-01', 'crystal-bot-03', 'woven-bot-03',
];
const harnesses = ['Claude Code', 'Codex', 'OpenCode', 'Hermes', 'OpenClaw', 'NanoClaw', 'Kimi Code', 'Pi'];
const models = ['claude-sonnet-5', 'claude-fable-5', 'gpt-5.5', 'gemini-3-pro', 'kimi-k2', 'llama-4-405b'];
const toolPool = ['shell', 'files', 'browser', 'python', 'git', 'sql', 'web', 'http'];
const tiers = ['Common', 'Uncommon', 'Rare', 'Epic'];
// deterministic pseudo-random so the roster is stable per build
const rand = (s) => { const v = Math.sin(s * 999.13) * 43758.5453; return v - Math.floor(v); };
const roster = Array.from({ length: 24 }, (_, i) => {
  const img = imgs[i % imgs.length];
  const nTools = 2 + Math.floor(rand(i * 3.1) * 4);
  const tools = [...toolPool].sort((a, b) => rand(i + a.length) - rand(i + b.length)).slice(0, nTools);
  return {
    id: `AGENT-${String(1024 + i * 37).padStart(4, '0')}`,
    img,
    harness: harnesses[Math.floor(rand(i * 1.7) * harnesses.length)],
    model: models[Math.floor(rand(i * 2.3) * models.length)],
    tools,
    level: 1 + Math.floor(rand(i * 5.9) * 9),
    tier: tiers[Math.floor(rand(i * 7.3) * tiers.length)],
    win: (rand(i * 4.4) * 22).toFixed(1),
  };
});
const featured = roster[0];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Tangle Agents — the collection</title>
  </head>
  <body>
    <main>
      <header class="hero">
        <h1>Every agent improves.</h1>
        <p>Each agent is a character: its harness, model, and tools make it one of a kind. Deploy it and it runs, gets traced, and earns upgrades. Watch it get better.</p>
      </header>

      <!-- FEATURED: run -> trace -> power-up -->
      <section class="feature">
        <div class="hero-card" data-tier={featured.tier}>
          <img src={`/images/agents/${featured.img}.png`} alt="Featured agent" />
          <span class="tier mono">{featured.tier}</span>
          <span class="lvl mono">LV <b id="f-lvl">{featured.level}</b></span>
          <div class="powerups" id="f-powerups"></div>
        </div>
        <div class="feature-body">
          <span class="fid mono">{featured.id}</span>
          <div class="traits">
            <span class="chip mono">{featured.harness}</span>
            <span class="chip mono">{featured.model}</span>
            {featured.tools.map((t) => <span class="chip mono dim">{t}</span>)}
          </div>
          <dl class="stat mono">
            <div><dt>status</dt><dd id="f-status">idle</dd></div>
            <div><dt>traces</dt><dd id="f-traces">0</dd></div>
            <div><dt>win-rate</dt><dd id="f-win">{featured.win}%</dd></div>
          </dl>
          <button id="run" class="run">Deploy and run</button>
          <p class="note mono" id="f-note">Deploy sends it to a sandbox. Every run is traced; the analyst ships it an upgrade.</p>
        </div>
      </section>

      <div class="wallhead">
        <h2>The collection</h2>
        <span class="mono">1,024 agents · every combination unique</span>
      </div>
      <div class="wall">
        {roster.map((a) => (
          <article class="card" data-tier={a.tier}>
            <div class="thumb"><img src={`/images/agents/${a.img}.png`} alt={a.id} loading="lazy" /><span class="tier mono">{a.tier}</span><span class="lvl mono">LV {a.level}</span></div>
            <div class="cardmeta">
              <span class="cid mono">{a.id}</span>
              <div class="mini"><span class="chip mono">{a.harness}</span><span class="chip mono dim">{a.tools.length} tools</span></div>
            </div>
          </article>
        ))}
      </div>
    </main>

    <script>
      const runBtn = document.getElementById('run');
      const status = document.getElementById('f-status');
      const traces = document.getElementById('f-traces');
      const win = document.getElementById('f-win');
      const lvl = document.getElementById('f-lvl');
      const note = document.getElementById('f-note');
      const pu = document.getElementById('f-powerups');
      const upgrades = ['+retry-scoping', '+parallel-tools', '+prompt-cache', '+eval-gate', '+faster-plan'];
      let running = false, t = 0, base = parseFloat(win.textContent), earned = 0;

      runBtn.addEventListener('click', () => {
        if (running) return;
        running = true; runBtn.disabled = true; runBtn.textContent = 'Running...';
        status.textContent = 'running'; status.className = 'run-on';
        note.textContent = 'Agent is working in a sandbox. Spans are streaming into its trace...';
        const iv = setInterval(() => {
          t += Math.floor(6 + Math.random() * 22); traces.textContent = String(t);
        }, 120);
        setTimeout(() => {
          clearInterval(iv);
          status.textContent = 'analyzed'; note.textContent = 'The analyst found waste in the trace and proved a fix on held-out runs.';
          // earn a power-up + level up
          const up = upgrades[earned % upgrades.length]; earned++;
          const chip = document.createElement('span'); chip.className = 'pu mono'; chip.textContent = up;
          pu.appendChild(chip); requestAnimationFrame(() => chip.classList.add('in'));
          lvl.textContent = String(parseInt(lvl.textContent) + 1);
          base += 3.2 + Math.random() * 4; win.textContent = base.toFixed(1) + '%';
          win.classList.add('up'); setTimeout(() => win.classList.remove('up'), 1200);
          status.textContent = 'improved'; status.className = 'run-done';
          setTimeout(() => {
            note.textContent = `Upgrade ${up} shipped. The agent is stronger. Run it again.`;
            runBtn.disabled = false; runBtn.textContent = 'Run again'; running = false; status.textContent = 'ready';
          }, 900);
        }, 2600);
      });
    </script>
  </body>
</html>

<style>
  :root { --bg: #0b0b1c; --card: #141334; --line: rgba(129,140,248,0.16); --ink: #ededf4; --mut: #9a9ac2; --ind: #818cf8; --ind2: #6366f1; }
  html, body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'Inter', system-ui, sans-serif; }
  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; font-feature-settings: 'tnum'; }
  main { max-width: 78rem; margin: 0 auto; padding: 3.5rem 2rem 6rem; }
  .hero h1 { margin: 0; font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 600; letter-spacing: -0.035em; }
  .hero p { margin: 1rem 0 0; color: var(--mut); font-size: clamp(1.1rem, 1.5vw, 1.35rem); line-height: 1.6; max-width: 44rem; }

  .feature { display: grid; grid-template-columns: 22rem 1fr; gap: 2.2rem; margin: 3rem 0 4.5rem; align-items: center; }
  .hero-card { position: relative; border-radius: 20px; overflow: hidden; border: 1px solid var(--line); background: #0d0d24; aspect-ratio: 1; }
  .hero-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-card[data-tier="Epic"] { border-color: rgba(129,140,248,0.6); box-shadow: 0 0 50px rgba(99,102,241,0.35); }
  .tier { position: absolute; top: 0.8rem; left: 0.8rem; padding: 0.25rem 0.6rem; border-radius: 999px; background: rgba(11,11,28,0.7); backdrop-filter: blur(6px); font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ind); border: 1px solid var(--line); }
  .lvl { position: absolute; top: 0.8rem; right: 0.8rem; padding: 0.25rem 0.6rem; border-radius: 999px; background: rgba(79,70,229,0.85); font-size: 0.7rem; color: #fff; }
  .lvl b { font-weight: 700; }
  .powerups { position: absolute; left: 0.8rem; right: 0.8rem; bottom: 0.8rem; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .pu { padding: 0.28rem 0.55rem; border-radius: 7px; background: rgba(16,185,129,0.18); border: 1px solid rgba(110,231,183,0.4); color: #6ee7b7; font-size: 0.72rem; opacity: 0; transform: translateY(8px) scale(0.9); transition: all 0.4s cubic-bezier(0.2,0.7,0.2,1); }
  .pu.in { opacity: 1; transform: none; }

  .feature-body { display: flex; flex-direction: column; gap: 1.1rem; }
  .fid { color: var(--ind); font-size: 0.9rem; letter-spacing: 0.04em; }
  .traits { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { padding: 0.4rem 0.7rem; border-radius: 8px; background: rgba(129,140,248,0.1); border: 1px solid var(--line); color: #c7c9f5; font-size: 0.82rem; }
  .chip.dim { background: transparent; color: var(--mut); }
  .stat { display: flex; gap: 0; margin: 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; width: fit-content; }
  .stat div { padding: 0.9rem 1.4rem; }
  .stat div + div { border-left: 1px solid var(--line); }
  .stat dt { color: var(--mut); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.06em; margin: 0; }
  .stat dd { margin: 0.3rem 0 0; font-size: 1.5rem; font-weight: 600; }
  #f-status.run-on { color: #a5aafc; } #f-status.run-done { color: #6ee7b7; }
  #f-win.up { color: #6ee7b7; transition: color 0.3s; }
  .run { width: fit-content; background: #4f46e5; border: 1px solid #6d63ff; color: #fff; font-family: inherit; font-size: 1rem; font-weight: 600; padding: 0.8rem 1.6rem; border-radius: 11px; cursor: pointer; }
  .run:hover:not(:disabled) { background: #4338ca; } .run:disabled { opacity: 0.7; cursor: default; }
  .note { color: var(--mut); font-size: 0.82rem; margin: 0; max-width: 34rem; line-height: 1.5; }

  .wallhead { display: flex; align-items: baseline; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 2rem; }
  .wallhead h2 { margin: 0; font-size: 1.6rem; font-weight: 600; letter-spacing: -0.02em; }
  .wallhead .mono { color: var(--mut); font-size: 0.85rem; }
  .wall { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 1rem; margin-top: 1.6rem; }
  .card { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--card); transition: transform 0.15s, border-color 0.15s; }
  .card:hover { transform: translateY(-3px); border-color: rgba(129,140,248,0.5); }
  .card[data-tier="Epic"] { border-color: rgba(129,140,248,0.4); }
  .thumb { position: relative; aspect-ratio: 1; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cardmeta { padding: 0.75rem 0.85rem 0.9rem; }
  .cid { color: var(--ind); font-size: 0.74rem; }
  .mini { display: flex; gap: 0.35rem; margin-top: 0.5rem; flex-wrap: wrap; }
  .mini .chip { padding: 0.22rem 0.5rem; font-size: 0.68rem; }
  @media (max-width: 760px) { .feature { grid-template-columns: 1fr; } }
</style>
