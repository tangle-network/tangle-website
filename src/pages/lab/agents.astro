---
// The Tangle Agents collection. Every card is a DISTINCT generative character;
// tier is derived from the art itself (woven/crystal = rarer, matte = common),
// and rarer tiers get real visual treatment (aura, holo frame, orbiting modules).
// Deploy the featured agent: it runs, gets traced, and earns visible power-up
// modules that orbit it as it levels up. Self-improvement, made visible. noindex.

// tier is tied to the character family, not a random sticker.
const art = [
  // woven fiber-optic = Epic (most distinctive)
  ['woven-bot-01', 'Epic'], ['woven-bot-02', 'Epic'], ['woven-bot-03', 'Epic'],
  // crystal/glass with a core = Rare
  ['crystal-bot-01', 'Rare'], ['crystal-bot-02', 'Rare'], ['crystal-bot-03', 'Rare'],
  ['crystal-v2-01', 'Rare'], ['crystal-v2-02', 'Rare'], ['crystal-v2-03', 'Rare'],
  ['crystal-var-01', 'Rare'], ['crystal-var-02', 'Rare'], ['crystal-var-03', 'Rare'],
  // matte designer = Common / Uncommon
  ['matte-bot-01', 'Uncommon'], ['matte-bot-02', 'Common'], ['matte-bot-03', 'Uncommon'],
  ['matte-v2-01', 'Uncommon'], ['matte-v2-02', 'Common'], ['matte-v2-03', 'Common'],
  ['matte-var-01', 'Common'], ['matte-var-02', 'Uncommon'], ['matte-var-03', 'Common'],
  // tier-purpose-built renders
  ['epic-01', 'Epic'], ['epic-02', 'Epic'], ['epic-03', 'Epic'],
  ['rare-01', 'Rare'], ['rare-02', 'Rare'], ['rare-03', 'Rare'],
  ['common-01', 'Common'], ['common-02', 'Common'], ['common-03', 'Common'],
];
const harnesses = ['Claude Code', 'Codex', 'OpenCode', 'Hermes', 'OpenClaw', 'NanoClaw', 'Kimi Code', 'Pi'];
const models = ['claude-sonnet-5', 'claude-fable-5', 'gpt-5.5', 'gemini-3-pro', 'kimi-k2', 'llama-4-405b'];
const toolPool = ['shell', 'files', 'browser', 'python', 'git', 'sql', 'web', 'http'];
const rand = (s) => { const v = Math.sin(s * 999.13) * 43758.5453; return v - Math.floor(v); };
const tierRank = { Common: 0, Uncommon: 1, Rare: 2, Epic: 3 };
const roster = art.map(([img, tier], i) => {
  const nTools = 2 + Math.floor(rand(i * 3.1) * 4);
  const tools = [...toolPool].sort((a, b) => rand(i + a.length) - rand(i + b.length)).slice(0, nTools);
  return {
    id: `AGENT-${String(1024 + i * 41).padStart(4, '0')}`, img, tier,
    harness: harnesses[Math.floor(rand(i * 1.7) * harnesses.length)],
    model: models[Math.floor(rand(i * 2.3) * models.length)],
    tools, level: 1 + tierRank[tier] * 2 + Math.floor(rand(i * 5.9) * 3),
    win: (4 + rand(i * 4.4) * 18).toFixed(1),
  };
});
// featured agent EVOLVES: each upgrade re-renders the robot itself (FLUX
// Kontext image edits), so the picture changes as it levels up, not a label.
const featuredEvo = {
  id: 'AGENT-0001', harness: 'Claude Code', harnessLogo: '/images/harness/claude-code.svg',
  model: 'claude-sonnet-5', tools: ['shell', 'files', 'browser', 'git'],
  stages: [
    { img: 'matte-v2-01', tier: 'Common', level: 1, win: '6.2', note: 'A fresh agent. Deploy it to a sandbox and it starts leaving traces.' },
    { img: 'evolve/matte-v2-01-s1', tier: 'Rare', level: 5, win: '13.8', up: 'armored core', note: 'The analyst scoped its test reruns. It came back with an armored core.' },
    { img: 'evolve/matte-v2-01-s2', tier: 'Epic', level: 10, win: '21.4', up: 'winged, haloed', note: 'Parallel tools and a prompt cache. Fully evolved, it barely wastes a span.' },
  ],
};
// featured = an Epic
const featured = roster.find((a) => a.tier === 'Epic');
// wall sorted by rarity desc for a satisfying drop
const wall = [...roster].sort((a, b) => tierRank[b.tier] - tierRank[a.tier]);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Tangle Agents — the collection</title>
  </head>
  <body>
    <main>
      <header class="hero">
        <h1>Every agent improves.</h1>
        <p>Each agent is a character. Its harness, model, and tools make it one of a kind. Deploy it and it runs, gets traced, and earns upgrades that attach to it. Watch it get better.</p>
      </header>

      <section class="feature">
        <div class="hero-card tier-common" id="f-card" data-stages={JSON.stringify(featuredEvo.stages)}>
          <div class="aura" id="f-aura"></div>
          <div class="stages">
            {featuredEvo.stages.map((s, i) => (
              <img class={`stage${i === 0 ? ' on' : ''}`} src={`/images/agents/${s.img}.png`} data-i={i} alt={`Agent stage ${i}`} />
            ))}
          </div>
          <span class="tier mono" id="f-tier">{featuredEvo.stages[0].tier}</span>
          <span class="lvl mono">LV <b id="f-lvl">{featuredEvo.stages[0].level}</b></span>
        </div>
        <div class="feature-body">
          <span class="fid mono">{featuredEvo.id}</span>
          <div class="traits">
            <span class="chip mono"><img class="hlogo" src={featuredEvo.harnessLogo} alt="" />{featuredEvo.harness}</span>
            <span class="chip mono">{featuredEvo.model}</span>
            {featuredEvo.tools.map((t) => <span class="chip mono dim">{t}</span>)}
          </div>
          <dl class="stat mono">
            <div><dt>status</dt><dd id="f-status">idle</dd></div>
            <div><dt>traces</dt><dd id="f-traces">0</dd></div>
            <div><dt>win-rate</dt><dd id="f-win">{featuredEvo.stages[0].win}%</dd></div>
            <div><dt>stage</dt><dd id="f-stage">1 / 3</dd></div>
          </dl>
          <button id="run" class="run">Deploy and run</button>
          <p class="note mono" id="f-note">Deploy sends it to a sandbox. Every run is traced; the analyst ships an improvement, and the agent evolves.</p>
        </div>
      </section>

      <div class="wallhead">
        <h2>The collection</h2>
        <span class="mono">every combination unique · sorted by rarity</span>
      </div>
      <div class="wall">
        {wall.map((a) => (
          <article class={`card tier-${a.tier.toLowerCase()}`}>
            <div class="thumb">
              <img src={`/images/agents/${a.img}.png`} alt={a.id} loading="lazy" />
              <span class="tier mono">{a.tier}</span>
              <span class="lvl mono">LV {a.level}</span>
            </div>
            <div class="cardmeta">
              <span class="cid mono">{a.id}</span>
              <div class="mini"><span class="chip mono">{a.harness}</span><span class="chip mono dim">{a.tools.length} tools</span></div>
            </div>
          </article>
        ))}
      </div>
    </main>

    <script>
      const $ = (id) => document.getElementById(id);
      const runBtn = $('run'), status = $('f-status'), traces = $('f-traces'), win = $('f-win'),
        lvl = $('f-lvl'), tier = $('f-tier'), stageEl = $('f-stage'), note = $('f-note'),
        aura = $('f-aura'), card = $('f-card');
      const stages = JSON.parse(card.dataset.stages);
      const imgs = [...card.querySelectorAll('.stage')];
      let running = false, t = 0, at = 0;

      function evolveTo(i) {
        imgs.forEach((im) => im.classList.toggle('on', +im.dataset.i === i));
        const s = stages[i];
        card.className = `hero-card tier-${s.tier.toLowerCase()}`;
        tier.textContent = s.tier;
        lvl.textContent = String(s.level);
        stageEl.textContent = `${i + 1} / ${stages.length}`;
        win.textContent = s.win + '%'; win.classList.add('up'); setTimeout(() => win.classList.remove('up'), 1200);
        aura.style.setProperty('--glow', i / (stages.length - 1));
      }

      runBtn.addEventListener('click', () => {
        if (running) return;
        if (at >= stages.length - 1) { // reset to replay
          at = 0; t = 0; traces.textContent = '0'; evolveTo(0);
          runBtn.textContent = 'Deploy and run'; status.textContent = 'idle'; status.className = '';
          note.textContent = stages[0].note; return;
        }
        running = true; runBtn.disabled = true; runBtn.textContent = 'Running...';
        status.textContent = 'running'; status.className = 'run-on';
        note.textContent = 'Working in a sandbox. Spans are streaming into its trace...';
        const iv = setInterval(() => { t += Math.floor(6 + Math.random() * 22); traces.textContent = String(t); }, 100);
        setTimeout(() => {
          clearInterval(iv);
          status.textContent = 'analyzed';
          note.textContent = 'The analyst found waste and proved a fix on held-out runs. Applying...';
          setTimeout(() => {
            at++; evolveTo(at);
            const s = stages[at];
            status.textContent = 'evolved'; status.className = 'run-done';
            note.textContent = `Evolved: ${s.up}. ${s.note}`;
            runBtn.disabled = false;
            runBtn.textContent = at >= stages.length - 1 ? 'Replay from start' : 'Run again';
            running = false;
          }, 700);
        }, 2200);
      });
    </script>
  </body>
</html>

<style>
  :root { --bg: #0b0b1c; --card: #141334; --line: rgba(129,140,248,0.16); --ink: #ededf4; --mut: #9a9ac2; --ind: #818cf8; --ind2: #6366f1; }
  html, body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'Inter', system-ui, sans-serif; }
  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; font-feature-settings: 'tnum'; }
  main { max-width: 80rem; margin: 0 auto; padding: 3.5rem 2rem 6rem; }
  .hero h1 { margin: 0; font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 600; letter-spacing: -0.035em; }
  .hero p { margin: 1rem 0 0; color: var(--mut); font-size: clamp(1.1rem, 1.5vw, 1.35rem); line-height: 1.6; max-width: 46rem; }

  /* pull FLUX renders toward brand indigo (they drift blue/violet/orange) */
  .thumb img, .hero-card img { filter: saturate(0.72) hue-rotate(-16deg) brightness(1.03) contrast(1.02); }

  .feature { display: grid; grid-template-columns: 24rem 1fr; gap: 2.4rem; margin: 3rem 0 4.5rem; align-items: center; }
  .hero-card { position: relative; border-radius: 22px; overflow: hidden; border: 1px solid var(--line); background: #0d0d24; aspect-ratio: 1; }
  .hero-card img { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: cover; display: block; }
  .aura { position: absolute; inset: -30%; z-index: 0; --glow: 0; opacity: calc(0.25 + var(--glow) * 0.75);
    background: radial-gradient(circle at 50% 45%, rgba(129,140,248,0.55), transparent 55%); transition: opacity 0.6s; }
  /* orbiting upgrade modules */
  /* evolution stage crossfade: same character, upgraded picture.
     selector is .hero-card .stage to outrank the generic .hero-card img rule. */
  .stages { position: absolute; inset: 0; z-index: 1; }
  .hero-card .stage { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transition: opacity 0.8s ease; }
  .hero-card .stage.on { opacity: 1; }
  .hlogo { width: 15px; height: 15px; object-fit: contain; margin-right: 0.4rem; vertical-align: -2px; }

  .tier { position: absolute; top: 0.8rem; left: 0.8rem; z-index: 3; padding: 0.25rem 0.6rem; border-radius: 999px; background: rgba(11,11,28,0.72); backdrop-filter: blur(6px); font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ind); border: 1px solid var(--line); }
  .lvl { position: absolute; top: 0.8rem; right: 0.8rem; z-index: 3; padding: 0.25rem 0.6rem; border-radius: 999px; background: rgba(79,70,229,0.85); font-size: 0.7rem; color: #fff; }

  /* tier visual treatments */
  .tier-uncommon .tier { color: #a5aafc; }
  .tier-rare { border-color: rgba(129,140,248,0.45); }
  .tier-rare .tier { color: #c7c9f5; background: rgba(79,70,229,0.35); }
  .tier-epic { border-color: rgba(167,170,252,0.7); box-shadow: 0 0 0 1px rgba(167,170,252,0.3), 0 12px 50px rgba(99,102,241,0.3); }
  .tier-epic .tier { color: #fff; background: linear-gradient(90deg, #6366f1, #818cf8); border-color: transparent; }
  .tier-epic .thumb::after, .hero-card.tier-epic::after { content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: linear-gradient(115deg, transparent 30%, rgba(199,201,238,0.14) 47%, transparent 60%); background-size: 250% 250%;
    animation: holo 4.5s linear infinite; }
  @keyframes holo { 0% { background-position: 120% 0; } 100% { background-position: -60% 0; } }

  .feature-body { display: flex; flex-direction: column; gap: 1.1rem; }
  .fid { color: var(--ind); font-size: 0.9rem; letter-spacing: 0.04em; }
  .traits { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { padding: 0.4rem 0.7rem; border-radius: 8px; background: rgba(129,140,248,0.1); border: 1px solid var(--line); color: #c7c9f5; font-size: 0.82rem; }
  .chip.dim { background: transparent; color: var(--mut); }
  .stat { display: flex; gap: 0; margin: 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; width: fit-content; }
  .stat div { padding: 0.85rem 1.3rem; }
  .stat div + div { border-left: 1px solid var(--line); }
  .stat dt { color: var(--mut); font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.06em; margin: 0; }
  .stat dd { margin: 0.3rem 0 0; font-size: 1.4rem; font-weight: 600; }
  #f-status.run-on { color: #a5aafc; } #f-status.run-done { color: #6ee7b7; }
  #f-win.up { color: #6ee7b7; transition: color 0.3s; }
  .run { width: fit-content; background: #4f46e5; border: 1px solid #6d63ff; color: #fff; font-family: inherit; font-size: 1rem; font-weight: 600; padding: 0.8rem 1.6rem; border-radius: 11px; cursor: pointer; }
  .run:hover:not(:disabled) { background: #4338ca; } .run:disabled { opacity: 0.7; cursor: default; }
  .note { color: var(--mut); font-size: 0.82rem; margin: 0; max-width: 36rem; line-height: 1.5; }

  .wallhead { display: flex; align-items: baseline; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 2rem; gap: 1rem; }
  .wallhead h2 { margin: 0; font-size: 1.6rem; font-weight: 600; letter-spacing: -0.02em; }
  .wallhead .mono { color: var(--mut); font-size: 0.85rem; }
  .wall { display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); gap: 1.1rem; margin-top: 1.6rem; }
  .card { position: relative; border: 1px solid var(--line); border-radius: 15px; overflow: hidden; background: var(--card); transition: transform 0.15s, box-shadow 0.15s; }
  .card:hover { transform: translateY(-4px); }
  .thumb { position: relative; aspect-ratio: 1; overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cardmeta { padding: 0.75rem 0.85rem 0.9rem; }
  .cid { color: var(--ind); font-size: 0.74rem; }
  .mini { display: flex; gap: 0.35rem; margin-top: 0.5rem; flex-wrap: wrap; }
  .mini .chip { padding: 0.22rem 0.5rem; font-size: 0.68rem; }
  @media (max-width: 760px) { .feature { grid-template-columns: 1fr; } }
</style>
