---
// Physical register test: the run as a real cast-glass object under studio
// light. No additive glow, no bloom, no space, no void. Matte/frosted PBR
// material + RoomEnvironment lighting on a soft studio backdrop. The antidote
// to the neon-gimmick direction. Scroll resolves the tangle. noindex.
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Physical — Tangle lab</title>
  </head>
  <body>
    <div id="scroller"><div id="spacer"></div></div>
    <canvas id="c"></canvas>
    <div class="mat mono">
      <button data-m="glass" class="on">cast glass</button>
      <button data-m="ceramic">matte ceramic</button>
      <button data-m="metal">brushed metal</button>
    </div>
    <div class="cap">
      <h1>The run</h1>
      <p class="mono" id="sub">physical material · studio light · no glow · scroll to resolve</p>
    </div>

    <script>
      import * as THREE from 'three';
      import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canvas = document.getElementById('c');
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
      renderer.setPixelRatio(Math.min(2, devicePixelRatio));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.0;

      const scene = new THREE.Scene();
      // soft studio backdrop (deep desaturated indigo, not black, not space)
      const bg = document.createElement('canvas'); bg.width = 4; bg.height = 512;
      const bx = bg.getContext('2d'); const bgrad = bx.createLinearGradient(0, 0, 0, 512);
      bgrad.addColorStop(0, '#20213f'); bgrad.addColorStop(0.55, '#141531'); bgrad.addColorStop(1, '#0b0b1c');
      bx.fillStyle = bgrad; bx.fillRect(0, 0, 4, 512);
      scene.background = new THREE.CanvasTexture(bg);

      const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
      camera.position.set(0, 0, 13);

      // studio environment lighting (neutral, physical)
      const pmrem = new THREE.PMREMGenerator(renderer);
      scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
      const key = new THREE.DirectionalLight(0xeef0ff, 2.2); key.position.set(5, 8, 6); scene.add(key);
      const fill = new THREE.DirectionalLight(0x8b8fd6, 0.8); fill.position.set(-7, -2, 4); scene.add(fill);
      scene.add(new THREE.AmbientLight(0x3a3b6b, 0.5));

      // ---- geometry: a clean woven cable that unwinds into lanes -------------
      const N = 12, K = 16, spanX = 9.2;
      const WASTE = new Set([3, 8]);
      const rnd = (s) => { const v = Math.sin(s * 999.13) * 43758.5453; return v - Math.floor(v); };
      const fibers = [];
      for (let i = 0; i < N; i++) {
        const laneY = (i / (N - 1) - 0.5) * 4.6;
        const theta = (i / N) * Math.PI * 2;
        const resolved = [], tangled = [];
        const waste = WASTE.has(i);
        for (let k = 0; k < K; k++) {
          const u = k / (K - 1);
          const x = -spanX / 2 + spanX * u;
          resolved.push(new THREE.Vector3(x, laneY, 0));
          const env = Math.sin(u * Math.PI);
          const phase = u * Math.PI * 3.4 + theta;
          const R = 2.0 * env * (waste ? 1.2 : 1);
          const ny = (rnd(i * 7.1 + k * 3.3) - 0.5) * 0.5 * env;
          tangled.push(new THREE.Vector3(x, Math.sin(phase) * R + ny, Math.cos(phase) * R));
        }
        fibers.push({ i, resolved, tangled, waste });
      }

      const INK = new THREE.Color('#8f96e8'), RED = new THREE.Color('#c02c50');
      const mats = {
        glass: (w) => new THREE.MeshPhysicalMaterial({ color: w ? RED : new THREE.Color('#b9bdf0'),
          metalness: 0, roughness: 0.28, transmission: 0.82, ior: 1.5, thickness: 1.4,
          clearcoat: 1, clearcoatRoughness: 0.25, envMapIntensity: 1.1, transparent: true, attenuationColor: new THREE.Color('#5b60c8'), attenuationDistance: 3 }),
        ceramic: (w) => new THREE.MeshPhysicalMaterial({ color: w ? RED : INK,
          metalness: 0, roughness: 0.55, clearcoat: 0.7, clearcoatRoughness: 0.4, envMapIntensity: 0.9, sheen: 0.3, sheenColor: new THREE.Color('#c7c9f5') }),
        metal: (w) => new THREE.MeshStandardMaterial({ color: w ? RED : new THREE.Color('#9aa0e0'),
          metalness: 1, roughness: 0.38, envMapIntensity: 1.3 }),
      };
      let matKind = 'glass';

      const tube = (pts, r) => new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts), 120, r, 12, false);
      const meshes = fibers.map((f) => {
        const r = f.waste ? 0.05 : 0.08;
        const m = new THREE.Mesh(tube(f.resolved.slice(), r), mats.glass(f.waste));
        m.userData = { f, r }; scene.add(m); return m;
      });
      const applyMat = (k) => { matKind = k; for (const m of meshes) { if (m.material.dispose) m.material.dispose(); m.material = mats[k](m.userData.f.waste); } };

      const fit = () => { const w = innerWidth, h = innerHeight; renderer.setSize(w, h, false);
        camera.aspect = w / h; camera.updateProjectionMatrix(); };
      addEventListener('resize', fit); fit();

      const sub = document.getElementById('sub');
      document.querySelectorAll('[data-m]').forEach((b) => b.addEventListener('click', () => {
        document.querySelectorAll('[data-m]').forEach((x) => x.classList.remove('on'));
        b.classList.add('on'); applyMat(b.dataset.m);
        sub.textContent = `${b.textContent} · studio light · no glow · scroll to resolve`;
      }));

      const scroller = document.getElementById('scroller');
      let target = reduced ? 1 : 0, resolve = reduced ? 1 : 0;
      scroller.addEventListener('scroll', () => { const max = scroller.scrollHeight - innerHeight;
        target = max > 0 ? Math.min(1, scroller.scrollTop / max) : 1; }, { passive: true });

      const smooth = (t) => t * t * (3 - 2 * t);
      const tmp = new THREE.Vector3();
      const clock = new THREE.Clock();
      function frame() {
        requestAnimationFrame(frame);
        const time = clock.elapsedTime;
        resolve += (target - resolve) * 0.07;
        for (const m of meshes) {
          const { f, r } = m.userData; const pts = [];
          for (let k = 0; k < K; k++) {
            const ph = (k / (K - 1)) * 0.5;
            const tl = smooth(Math.min(1, Math.max(0, (resolve - ph) / 0.5)));
            tmp.copy(f.tangled[k]).lerp(f.resolved[k], tl);
            pts.push(tmp.clone());
          }
          m.geometry.dispose(); m.geometry = tube(pts, r);
          if ('opacity' in m.material) { m.material.transparent = f.waste; m.material.opacity = f.waste ? Math.pow(1 - smooth(resolve), 1.3) : 1; }
          m.visible = !(f.waste && resolve > 0.9);
        }
        camera.position.x = Math.sin(time * 0.1) * 1.2 * (1 - resolve * 0.6);
        camera.position.z = 13 - smooth(resolve) * 1.2;
        camera.lookAt(0, 0, 0);
        renderer.render(scene, camera);
      }
      frame();
    </script>
  </body>
</html>

<style>
  html, body { margin: 0; height: 100%; background: #0b0b1c; overflow: hidden; }
  #c { position: fixed; inset: 0; width: 100vw; height: 100vh; display: block; }
  #scroller { position: fixed; inset: 0; overflow-y: scroll; z-index: 3; }
  #spacer { height: 300vh; }
  #scroller::-webkit-scrollbar { width: 0; }
  .mat { position: fixed; top: 1.4rem; right: 1.4rem; z-index: 5; display: flex; gap: 0.4rem;
    background: rgba(20,21,49,0.7); backdrop-filter: blur(10px); border: 1px solid rgba(143,150,232,0.25);
    border-radius: 11px; padding: 0.6rem; font-family: 'JetBrains Mono', ui-monospace, monospace; }
  .mat button { background: rgba(143,150,232,0.08); border: 1px solid rgba(143,150,232,0.22); color: #c7c9f5;
    font-family: inherit; font-size: 0.78rem; padding: 0.36rem 0.75rem; border-radius: 7px; cursor: pointer; }
  .mat button.on { background: #4f46e5; border-color: #6d63ff; color: #fff; }
  .cap { position: fixed; left: 3rem; bottom: 2.6rem; z-index: 4; color: #eef0ff; font-family: 'Inter', system-ui, sans-serif; pointer-events: none; }
  .cap h1 { margin: 0; font-size: 2rem; font-weight: 600; letter-spacing: -0.03em; }
  .cap .mono { margin: 0.5rem 0 0; color: #9b9bbf; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 0.82rem; }
</style>
