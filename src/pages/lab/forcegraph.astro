<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>The Hairball - Tangle lab</title>
  </head>
  <body>
    <canvas id="hairball" aria-label="A tangled graph resolving into a clean ordered chain"></canvas>
    <div class="caption">
      <strong>The Hairball</strong>
      <span>vanilla canvas force simulation / redundant run spans prune away / pointer scrubs</span>
    </div>

    <script>
      const canvas = document.getElementById('hairball');
      const ctx = canvas.getContext('2d', { alpha: false });
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const TAU = Math.PI * 2;
      const bg0 = '#080814';
      const bg1 = '#11122D';
      const i0 = [199, 201, 245];
      const i1 = [129, 140, 248];
      const i2 = [99, 102, 241];
      const i3 = [79, 70, 229];
      const red = [251, 113, 133];

      let seed = 90210;
      const rnd = () => {
        seed = (seed * 1664525 + 1013904223) >>> 0;
        return seed / 4294967296;
      };
      const clamp = (v, a = 0, b = 1) => Math.max(a, Math.min(b, v));
      const mix = (a, b, t) => a + (b - a) * t;
      const ease = (t) => {
        t = clamp(t);
        return t * t * (3 - 2 * t);
      };
      const bell = (x, c, w) => {
        const d = (x - c) / w;
        return Math.exp(-d * d);
      };
      const rgba = (c, a) => `rgba(${c[0]},${c[1]},${c[2]},${a})`;

      const wasteIds = new Set([2, 5, 8, 12, 16, 19, 23, 27, 31, 34, 36, 38, 40, 41]);
      const nodes = [];
      let survivorCount = 0;
      let wasteCount = 0;

      for (let id = 0; id < 42; id++) {
        const waste = wasteIds.has(id);
        const a = rnd() * TAU;
        const r = Math.sqrt(rnd()) * 0.36;
        const tangleX = clamp(0.5 + Math.cos(a) * r * 1.04 + (rnd() - 0.5) * 0.12, 0.18, 0.82);
        const tangleY = clamp(0.5 + Math.sin(a) * r * 0.78 + (rnd() - 0.5) * 0.12, 0.22, 0.78);
        nodes.push({
          id,
          waste,
          order: waste ? -1 : survivorCount++,
          wasteOrder: waste ? wasteCount++ : -1,
          tangleX,
          tangleY,
          phase: rnd() * TAU,
          bend: (rnd() - 0.5) * 2,
          x: 0,
          y: 0,
          vx: 0,
          vy: 0,
        });
      }

      const survivors = nodes.filter((n) => !n.waste).sort((a, b) => a.order - b.order);
      const edges = [];
      const used = new Set();
      const keyFor = (a, b) => `${Math.min(a, b)}:${Math.max(a, b)}`;
      const addEdge = (a, b, type) => {
        if (a === b) return false;
        const key = keyFor(a, b);
        if (used.has(key)) return false;
        used.add(key);
        edges.push({
          a,
          b,
          type,
          waste: nodes[a].waste || nodes[b].waste,
          seed: rnd() * TAU,
          rest: 34 + rnd() * 70,
          bend: (rnd() - 0.5) * 2,
        });
        return true;
      };

      for (let i = 0; i < survivors.length - 1; i++) {
        addEdge(survivors[i].id, survivors[i + 1].id, 'chain');
      }
      for (const n of nodes.filter((node) => node.waste)) {
        addEdge(n.id, survivors[Math.floor(rnd() * survivors.length)].id, 'redundant');
        addEdge(n.id, Math.floor(rnd() * nodes.length), 'redundant');
      }
      while (edges.length < 118) {
        const a = Math.floor(rnd() * nodes.length);
        const b = Math.floor(rnd() * nodes.length);
        addEdge(a, b, 'redundant');
      }

      let width = 1;
      let height = 1;
      let dpr = 1;
      let progress = reduced ? 1 : 0;
      let target = progress;
      let auto = progress;
      let interacted = false;
      let last = performance.now();
      let grainPattern = null;

      function chainPoint(n) {
        const pad = Math.max(42, Math.min(width * 0.11, 132));
        const span = Math.max(1, width - pad * 2);
        return {
          x: pad + span * (n.order / Math.max(1, survivorCount - 1)),
          y: height * (width < 680 ? 0.5 : 0.52),
        };
      }

      function tanglePoint(n, time, p) {
        const wobble = Math.min(width, height) * 0.034 * (1 - ease(p / 0.52));
        return {
          x: width * n.tangleX + Math.cos(time * 1.18 + n.phase) * wobble,
          y: height * n.tangleY + Math.sin(time * 0.94 + n.phase * 1.7) * wobble,
        };
      }

      function wastePoint(n, p) {
        const dissolve = ease((p - 0.54) / 0.28);
        const angle = (n.wasteOrder / Math.max(1, wasteCount)) * TAU + n.phase * 0.28;
        const radius = Math.min(width, height) * (0.035 + dissolve * 0.18);
        return {
          x: width * 0.56 + Math.cos(angle + dissolve * 1.8) * radius,
          y: height * 0.42 + Math.sin(angle + dissolve * 1.8) * radius,
        };
      }

      function targetPoint(n, time, p) {
        const settle = ease((p - 0.28) / 0.62);
        const prune = ease((p - 0.22) / 0.36);
        const from = tanglePoint(n, time, p);
        const to = n.waste ? wastePoint(n, p) : chainPoint(n);
        const t = n.waste ? prune : settle;
        return {
          x: mix(from.x, to.x, t),
          y: mix(from.y, to.y, t),
        };
      }

      function createGrain() {
        const size = 164;
        const g = document.createElement('canvas');
        const gx = g.getContext('2d');
        g.width = size;
        g.height = size;
        const image = gx.createImageData(size, size);
        for (let i = 0; i < image.data.length; i += 4) {
          const v = Math.random();
          image.data[i] = i0[0];
          image.data[i + 1] = i0[1];
          image.data[i + 2] = i0[2];
          image.data[i + 3] = v > 0.52 ? 18 : 0;
        }
        gx.putImageData(image, 0, 0);
        grainPattern = ctx.createPattern(g, 'repeat');
      }

      function placeAt(p) {
        const now = performance.now() * 0.001;
        for (const n of nodes) {
          const t = targetPoint(n, now, p);
          n.x = t.x;
          n.y = t.y;
          n.vx = 0;
          n.vy = 0;
        }
      }

      function resize() {
        const rect = canvas.getBoundingClientRect();
        const previousWidth = width;
        const previousHeight = height;
        width = Math.max(1, Math.round(rect.width));
        height = Math.max(1, Math.round(rect.height));
        dpr = Math.min(2, window.devicePixelRatio || 1);
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        createGrain();

        if (previousWidth <= 1 || reduced) {
          placeAt(reduced ? 1 : progress);
        } else {
          const sx = width / previousWidth;
          const sy = height / previousHeight;
          for (const n of nodes) {
            n.x *= sx;
            n.y *= sy;
          }
        }
        draw(performance.now() * 0.001);
      }

      function simulate(dt, time) {
        const settle = ease((progress - 0.28) / 0.62);
        const prune = ease((progress - 0.22) / 0.36);
        const gone = ease((progress - 0.56) / 0.26);
        const jitter = (1 - settle) * 0.22;

        for (const n of nodes) {
          const t = targetPoint(n, time, progress);
          const k = n.waste ? 0.016 + prune * 0.07 : 0.012 + settle * 0.078;
          n.vx += (t.x - n.x) * k * dt;
          n.vy += (t.y - n.y) * k * dt;
          if (!n.waste || gone < 0.96) {
            n.vx += Math.cos(time * 1.45 + n.phase) * jitter * dt;
            n.vy += Math.sin(time * 1.25 + n.phase * 1.4) * jitter * dt;
          }
        }

        for (const e of edges) {
          const a = nodes[e.a];
          const b = nodes[e.b];
          const active = e.type === 'chain' ? 0.35 + settle : (1 - settle) * (e.waste ? 1 - gone * 0.7 : 1);
          if (active < 0.02) continue;
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const dist = Math.max(1, Math.hypot(dx, dy));
          const chainSpacing = (width - Math.max(42, Math.min(width * 0.11, 132)) * 2) / Math.max(1, survivorCount - 1);
          const rest = e.type === 'chain' ? mix(42, chainSpacing, settle) : e.rest;
          const pull = (dist - rest) * (e.type === 'chain' ? 0.007 + settle * 0.028 : 0.007) * active * dt;
          const fx = (dx / dist) * pull;
          const fy = (dy / dist) * pull;
          a.vx += fx;
          a.vy += fy;
          b.vx -= fx;
          b.vy -= fy;
        }

        const charge = mix(22, 52, settle);
        for (let i = 0; i < nodes.length; i++) {
          for (let j = i + 1; j < nodes.length; j++) {
            const a = nodes[i];
            const b = nodes[j];
            const aw = a.waste ? 1 - gone : 1;
            const bw = b.waste ? 1 - gone : 1;
            const m = aw * bw;
            if (m < 0.02) continue;
            const dx = b.x - a.x;
            const dy = b.y - a.y;
            const dsq = Math.max(64, dx * dx + dy * dy);
            const force = (charge * m * dt) / dsq;
            a.vx -= dx * force;
            a.vy -= dy * force;
            b.vx += dx * force;
            b.vy += dy * force;
          }
        }

        const drag = mix(0.84, 0.76, settle);
        for (const n of nodes) {
          n.vx *= drag;
          n.vy *= drag;
          n.x += n.vx * dt;
          n.y += n.vy * dt;
          if (progress === 1 && !n.waste) {
            const t = chainPoint(n);
            n.x = mix(n.x, t.x, 0.18);
            n.y = mix(n.y, t.y, 0.18);
          }
        }
      }

      function background() {
        const g = ctx.createRadialGradient(width * 0.56, height * 0.42, 0, width * 0.5, height * 0.5, Math.max(width, height) * 0.78);
        g.addColorStop(0, bg1);
        g.addColorStop(1, bg0);
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, width, height);
      }

      function strokeEdge(e, color, alpha, lineWidth, glow, time) {
        if (alpha <= 0.003) return;
        const a = nodes[e.a];
        const b = nodes[e.b];
        const settle = ease((progress - 0.28) / 0.62);
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const dist = Math.max(1, Math.hypot(dx, dy));
        const nx = -dy / dist;
        const ny = dx / dist;
        const curve = (1 - settle) * e.bend * Math.min(width, height) * 0.11 * Math.sin(time * 0.72 + e.seed);
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        if (Math.abs(curve) > 0.7) {
          ctx.quadraticCurveTo((a.x + b.x) * 0.5 + nx * curve, (a.y + b.y) * 0.5 + ny * curve, b.x, b.y);
        } else {
          ctx.lineTo(b.x, b.y);
        }
        ctx.lineWidth = lineWidth;
        ctx.lineCap = 'round';
        ctx.strokeStyle = rgba(color, alpha);
        ctx.shadowColor = rgba(color, alpha);
        ctx.shadowBlur = glow;
        ctx.stroke();
      }

      function drawWasteFlare(p, time) {
        const flare = bell(p, 0.47, 0.16);
        const gone = ease((p - 0.56) / 0.26);
        if (flare < 0.03 || gone > 0.98) return;
        const cx = width * 0.56;
        const cy = height * 0.42;
        ctx.save();
        ctx.globalCompositeOperation = 'lighter';
        for (let i = 0; i < 28; i++) {
          const a = (i / 28) * TAU + time * 0.42;
          const r = Math.min(width, height) * (0.035 + gone * 0.19 + (i % 5) * 0.004);
          const x = cx + Math.cos(a) * r;
          const y = cy + Math.sin(a) * r;
          ctx.beginPath();
          ctx.arc(x, y, mix(0.7, 2.2, flare) * (1 - gone), 0, TAU);
          ctx.fillStyle = rgba(red, 0.26 * flare * (1 - gone));
          ctx.shadowColor = rgba(red, 0.55 * flare * (1 - gone));
          ctx.shadowBlur = 13;
          ctx.fill();
        }
        ctx.restore();
      }

      function drawNode(n, p) {
        const gone = n.waste ? ease((p - 0.56) / 0.26) : 0;
        const wasteAlpha = 1 - gone;
        if (n.waste && wasteAlpha <= 0.01) return;
        const settle = ease((p - 0.28) / 0.62);
        const flare = n.waste ? bell(p, 0.47, 0.16) * wasteAlpha : 0;
        const c = flare > 0.07 ? red : (settle > 0.62 ? i0 : i1);
        const radius = n.waste ? (2.2 + flare * 4.8) * wasteAlpha : mix(2.6, 4.2, settle);
        const alpha = n.waste ? mix(0.34, 0.86, flare) * wasteAlpha : mix(0.48, 0.9, settle);

        ctx.beginPath();
        ctx.arc(n.x, n.y, radius, 0, TAU);
        ctx.fillStyle = rgba(c, alpha);
        ctx.shadowColor = rgba(c, alpha);
        ctx.shadowBlur = n.waste ? 18 * flare : mix(8, 13, settle);
        ctx.fill();

        if (!n.waste && settle > 0.58) {
          ctx.beginPath();
          ctx.arc(n.x, n.y, radius * 0.34, 0, TAU);
          ctx.fillStyle = rgba(i0, 0.62 * settle);
          ctx.shadowBlur = 0;
          ctx.fill();
        }
      }

      function draw(time) {
        background();
        const settle = ease((progress - 0.28) / 0.62);
        const redundantFade = 1 - ease((progress - 0.18) / 0.48);
        const gone = ease((progress - 0.56) / 0.26);
        const flare = bell(progress, 0.47, 0.16) * (1 - gone);

        ctx.save();
        ctx.globalCompositeOperation = 'lighter';
        for (const e of edges) {
          if (e.type !== 'redundant') continue;
          const wasteBoost = e.waste ? 1 : 0;
          const alpha = redundantFade * (e.waste ? 0.09 : 0.075) * (1 - wasteBoost * flare * 0.45);
          strokeEdge(e, i2, alpha, 0.72, 7, time);
          if (e.waste) {
            strokeEdge(e, red, flare * 0.18, 1.15, 14, time);
          }
        }
        for (const e of edges) {
          if (e.type !== 'chain') continue;
          strokeEdge(e, i3, 0.09 + settle * 0.22, mix(0.8, 2.05, settle), 10, time);
          strokeEdge(e, i0, settle * 0.36, mix(0.45, 0.85, settle), 7, time);
        }
        drawWasteFlare(progress, time);
        for (const n of nodes) {
          drawNode(n, progress);
        }
        ctx.restore();

        if (grainPattern) {
          ctx.save();
          ctx.globalAlpha = 0.24;
          ctx.fillStyle = grainPattern;
          ctx.fillRect(0, 0, width, height);
          ctx.restore();
        }
      }

      function frame(now) {
        const seconds = now * 0.001;
        const dt = Math.min(2, (now - last) / 16.67);
        last = now;

        if (!interacted) {
          auto = Math.min(1, auto + dt / 285);
          target = auto;
        }
        progress += (target - progress) * (interacted ? 0.18 : 0.074);
        if (target === 1 && progress > 0.996) progress = 1;

        simulate(dt, seconds);
        draw(seconds);
        window.requestAnimationFrame(frame);
      }

      function scrub(clientX) {
        interacted = true;
        target = clamp(clientX / Math.max(1, width));
      }

      window.addEventListener('pointermove', (event) => scrub(event.clientX), { passive: true });
      window.addEventListener('pointerdown', (event) => scrub(event.clientX), { passive: true });
      window.addEventListener('resize', resize);

      resize();
      if (reduced) {
        placeAt(1);
        draw(performance.now() * 0.001);
      } else {
        window.requestAnimationFrame((now) => {
          last = now;
          frame(now);
        });
      }
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    min-height: 100%;
    background: #080814;
    overflow: hidden;
  }

  #hairball {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    display: block;
    touch-action: none;
    background: #080814;
  }

  .caption {
    position: fixed;
    left: clamp(1rem, 4vw, 3rem);
    bottom: clamp(1rem, 3vw, 2.25rem);
    max-width: min(34rem, calc(100vw - 2rem));
    color: #818CF8;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(0.68rem, 1.4vw, 0.78rem);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0;
    text-shadow: 0 0 18px rgba(129, 140, 248, 0.38);
    pointer-events: none;
  }

  .caption strong {
    display: block;
    color: #C7C9F5;
    font-weight: 600;
  }

  .caption span {
    display: block;
  }

  @media (max-width: 620px) {
    .caption {
      font-size: 0.66rem;
      line-height: 1.45;
    }
  }
</style>
