<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>From Trace to Fiber - Tangle lab</title>
  </head>
  <body>
    <canvas id="braid" aria-label="From Trace to Fiber"></canvas>
    <div id="caption">From Trace to Fiber / three.js trace spans braided into a resolved fiber</div>

    <script>
      import * as THREE from 'three';
      import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
      import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
      import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';

      const style = document.createElement('style');
      style.textContent = `
        html, body {
          margin: 0;
          width: 100%;
          height: 100%;
          overflow: hidden;
          background: #080814;
        }

        #braid {
          position: fixed;
          inset: 0;
          width: 100vw;
          height: 100vh;
          display: block;
          touch-action: none;
          cursor: ew-resize;
        }

        #caption {
          position: fixed;
          left: clamp(18px, 3.2vw, 44px);
          bottom: clamp(16px, 3.1vw, 36px);
          max-width: min(520px, calc(100vw - 36px));
          color: #C7C9F5;
          font-family: "JetBrains Mono", "SFMono-Regular", ui-monospace, Menlo, Consolas, monospace;
          font-size: clamp(10px, 1.15vw, 13px);
          font-weight: 500;
          line-height: 1.45;
          letter-spacing: 0;
          opacity: 0.76;
          text-shadow: 0 0 18px rgba(129, 140, 248, 0.32);
          pointer-events: none;
        }
      `;
      document.head.appendChild(style);

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canvas = document.getElementById('braid');
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false, powerPreference: 'high-performance' });
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.setClearColor('#080814', 1);
      renderer.setPixelRatio(Math.min(2, window.devicePixelRatio || 1));

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 120);
      camera.position.set(0, 0, 14);

      const composer = new EffectComposer(renderer);
      composer.addPass(new RenderPass(scene, camera));
      const bloom = new UnrealBloomPass(new THREE.Vector2(1, 1), 0.68, 0.46, 0.32);
      composer.addPass(bloom);

      const world = new THREE.Group();
      world.position.y = 0.28;
      scene.add(world);

      const colorBg0 = new THREE.Color('#080814');
      const colorBg1 = new THREE.Color('#11122D');
      const colorDim = new THREE.Color('#4F46E5');
      const colorMid = new THREE.Color('#6366F1');
      const colorLight = new THREE.Color('#818CF8');
      const colorHot = new THREE.Color('#C7C9F5');
      const colorWaste = new THREE.Color('#FB7185');

      const bgMaterial = new THREE.ShaderMaterial({
        depthWrite: false,
        depthTest: false,
        uniforms: {
          uBottom: { value: colorBg0 },
          uTop: { value: colorBg1 },
          uGrain: { value: colorHot },
          uTime: { value: 0 },
        },
        vertexShader: `
          varying vec2 vUv;
          void main() {
            vUv = uv;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          uniform vec3 uBottom;
          uniform vec3 uTop;
          uniform vec3 uGrain;
          uniform float uTime;
          varying vec2 vUv;

          float hash(vec2 p) {
            return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
          }

          void main() {
            float lift = smoothstep(0.0, 1.0, vUv.y);
            vec3 col = mix(uBottom, uTop, lift * 0.92);
            float d = distance(vUv, vec2(0.52, 0.55));
            col *= 1.0 - smoothstep(0.26, 0.86, d) * 0.38;
            float n = hash(gl_FragCoord.xy + floor(uTime * 12.0));
            col += uGrain * ((n - 0.5) * 0.026);
            gl_FragColor = vec4(col, 1.0);
          }
        `,
      });
      const bg = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), bgMaterial);
      bg.position.z = -12;
      bg.renderOrder = -100;
      scene.add(bg);

      const grainMaterial = new THREE.ShaderMaterial({
        transparent: true,
        depthWrite: false,
        depthTest: false,
        blending: THREE.AdditiveBlending,
        uniforms: {
          uColor: { value: colorHot },
          uTime: { value: 0 },
          uOpacity: { value: reduced ? 0.018 : 0.027 },
        },
        vertexShader: `
          varying vec2 vUv;
          void main() {
            vUv = uv;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          uniform vec3 uColor;
          uniform float uTime;
          uniform float uOpacity;
          varying vec2 vUv;

          float hash(vec2 p) {
            return fract(sin(dot(p, vec2(269.5, 183.3))) * 43758.5453123);
          }

          void main() {
            float n = hash(gl_FragCoord.xy + floor(uTime * 18.0));
            float speck = smoothstep(0.73, 1.0, n);
            gl_FragColor = vec4(uColor * speck, uOpacity * speck);
          }
        `,
      });
      const grain = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), grainMaterial);
      grain.position.z = 5;
      grain.renderOrder = 1000;
      scene.add(grain);

      const traceGroup = new THREE.Group();
      world.add(traceGroup);

      const rowY = [2.82, 2.03, 1.24, 0.45, -0.34, -1.13, -1.92, -2.71];
      const traceLeft = -5.72;
      const traceRight = 5.82;
      const gridVerts = [];
      for (const y of rowY) {
        gridVerts.push(traceLeft, y, -0.16, traceRight, y, -0.16);
      }
      for (let i = 0; i <= 8; i += 1) {
        const x = traceLeft + (traceRight - traceLeft) * (i / 8);
        gridVerts.push(x, rowY[0] + 0.26, -0.17, x, rowY[rowY.length - 1] - 0.22, -0.17);
      }
      const gridGeometry = new THREE.BufferGeometry();
      gridGeometry.setAttribute('position', new THREE.Float32BufferAttribute(gridVerts, 3));
      const gridMaterial = new THREE.LineBasicMaterial({
        color: colorDim,
        transparent: true,
        opacity: 0.22,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
      });
      const grid = new THREE.LineSegments(gridGeometry, gridMaterial);
      traceGroup.add(grid);

      const tickSprites = [];
      function makeLabel(text, x, y, width) {
        const labelCanvas = document.createElement('canvas');
        labelCanvas.width = 512;
        labelCanvas.height = 128;
        const ctx = labelCanvas.getContext('2d');
        ctx.clearRect(0, 0, labelCanvas.width, labelCanvas.height);
        ctx.font = '600 42px JetBrains Mono, SFMono-Regular, ui-monospace, Menlo, Consolas, monospace';
        ctx.fillStyle = '#818CF8';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(text, 256, 64);
        const texture = new THREE.CanvasTexture(labelCanvas);
        texture.colorSpace = THREE.SRGBColorSpace;
        const material = new THREE.SpriteMaterial({
          map: texture,
          transparent: true,
          opacity: 0.46,
          depthWrite: false,
        });
        const sprite = new THREE.Sprite(material);
        sprite.position.set(x, y, 0.04);
        sprite.scale.set(width, width * 0.25, 1);
        traceGroup.add(sprite);
        tickSprites.push(sprite);
      }

      makeLabel('0ms', -5.44, -3.22, 0.68);
      makeLabel('900ms', -2.86, -3.22, 0.96);
      makeLabel('1.8s', -0.10, -3.22, 0.76);
      makeLabel('2.7s', 2.58, -3.22, 0.76);
      makeLabel('3.6s', 5.20, -3.22, 0.76);

      const spans = [
        { row: 0, x: -5.46, len: 1.16 },
        { row: 0, x: -3.96, len: 1.86 },
        { row: 0, x: -1.64, len: 2.08 },
        { row: 1, x: -5.18, len: 1.72 },
        { row: 1, x: -2.88, len: 2.42 },
        { row: 1, x: 0.02, len: 2.10 },
        { row: 2, x: -5.28, len: 8.54, waste: true, peel: 1 },
        { row: 2, x: 3.64, len: 1.26 },
        { row: 3, x: -4.86, len: 1.38 },
        { row: 3, x: -2.96, len: 1.94 },
        { row: 3, x: -0.62, len: 1.42 },
        { row: 3, x: 1.44, len: 1.84 },
        { row: 4, x: -4.58, len: 8.88, waste: true, peel: -1 },
        { row: 4, x: 4.62, len: 0.92 },
        { row: 5, x: -5.34, len: 2.52 },
        { row: 5, x: -2.16, len: 1.62 },
        { row: 5, x: 0.30, len: 2.78 },
        { row: 6, x: -5.42, len: 9.38, waste: true, peel: 1 },
        { row: 6, x: 4.20, len: 1.12 },
        { row: 7, x: -4.12, len: 2.24 },
        { row: 7, x: -1.42, len: 1.52 },
        { row: 7, x: 0.70, len: 2.22 },
      ];

      const nonWaste = spans.filter((span) => !span.waste);
      for (let i = 0; i < spans.length; i += 1) {
        const span = spans[i];
        span.id = i;
        span.phase = i * 1.734 + (span.waste ? 0.9 : 0);
        span.depth = ((i % 5) - 2) * 0.08;
        if (!span.waste) span.finalIndex = nonWaste.indexOf(span);
      }

      function clamp(value, min, max) {
        return Math.max(min, Math.min(max, value));
      }

      function smoothstep(edge0, edge1, value) {
        const t = clamp((value - edge0) / (edge1 - edge0), 0, 1);
        return t * t * (3 - 2 * t);
      }

      function makeTubeMaterial(waste, seed) {
        return new THREE.ShaderMaterial({
          transparent: true,
          depthWrite: false,
          blending: THREE.AdditiveBlending,
          uniforms: {
            uTime: { value: 0 },
            uAlpha: { value: 1 },
            uResolve: { value: 0 },
            uSeed: { value: seed },
            uWaste: { value: waste ? 1 : 0 },
            uDim: { value: colorDim },
            uMid: { value: colorMid },
            uLight: { value: colorLight },
            uHot: { value: colorHot },
            uRed: { value: colorWaste },
          },
          vertexShader: `
            varying vec2 vUv;
            varying vec3 vNormal;
            varying vec3 vView;
            void main() {
              vUv = uv;
              vNormal = normalize(normalMatrix * normal);
              vec4 mv = modelViewMatrix * vec4(position, 1.0);
              vView = normalize(-mv.xyz);
              gl_Position = projectionMatrix * mv;
            }
          `,
          fragmentShader: `
            uniform float uTime;
            uniform float uAlpha;
            uniform float uResolve;
            uniform float uSeed;
            uniform float uWaste;
            uniform vec3 uDim;
            uniform vec3 uMid;
            uniform vec3 uLight;
            uniform vec3 uHot;
            uniform vec3 uRed;
            varying vec2 vUv;
            varying vec3 vNormal;
            varying vec3 vView;

            vec3 ramp(float t) {
              vec3 a = mix(uDim, uMid, smoothstep(0.0, 0.48, t));
              vec3 b = mix(uLight, uHot, smoothstep(0.52, 1.0, t));
              return mix(a, b, smoothstep(0.22, 0.92, t));
            }

            void main() {
              vec3 indigo = ramp(vUv.x);
              vec3 base = mix(indigo, uRed, uWaste);
              float rim = pow(1.0 - max(dot(normalize(vNormal), normalize(vView)), 0.0), 2.15);
              float pulse = smoothstep(0.972, 1.0, sin((vUv.x * 34.0) - (uTime * 4.6) + uSeed) * 0.5 + 0.5);
              float core = 0.28 + rim * 0.88 + pulse * (0.30 + 0.42 * uResolve);
              float solved = mix(0.82, 1.36, uResolve);
              gl_FragColor = vec4(base * core * solved, uAlpha * (0.72 + rim * 0.28));
            }
          `,
        });
      }

      const sampleCount = 58;
      const meshes = spans.map((span) => {
        const points = [];
        for (let j = 0; j <= sampleCount; j += 1) {
          points.push(new THREE.Vector3(span.x + span.len * (j / sampleCount), rowY[span.row], 0));
        }
        const material = makeTubeMaterial(Boolean(span.waste), span.phase);
        const radius = span.waste ? 0.052 : 0.048;
        const geometry = new THREE.TubeGeometry(new THREE.CatmullRomCurve3(points), 86, radius, 9, false);
        const mesh = new THREE.Mesh(geometry, material);
        mesh.frustumCulled = false;
        mesh.renderOrder = span.waste ? 4 : 5;
        mesh.userData.span = span;
        mesh.userData.material = material;
        world.add(mesh);
        return mesh;
      });

      const coreMaterial = makeTubeMaterial(false, 31.4);
      coreMaterial.uniforms.uAlpha.value = 0;
      const coreCurve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-3.58, 0, -0.02),
        new THREE.Vector3(-1.45, 0.012, -0.01),
        new THREE.Vector3(1.45, -0.012, -0.01),
        new THREE.Vector3(3.58, 0, -0.02),
      ]);
      const core = new THREE.Mesh(new THREE.TubeGeometry(coreCurve, 120, 0.128, 14, false), coreMaterial);
      core.frustumCulled = false;
      core.renderOrder = 3;
      world.add(core);

      const particleCount = 216;
      const particlePositions = new Float32Array(particleCount * 3);
      const particleSeeds = [];
      const wasteSpans = spans.filter((span) => span.waste);
      for (let i = 0; i < particleCount; i += 1) {
        particleSeeds.push({
          span: wasteSpans[i % wasteSpans.length],
          t: (i % 72) / 71,
          a: i * 2.399,
          r: 0.18 + ((i * 17) % 31) / 31,
        });
      }
      const particleGeometry = new THREE.BufferGeometry();
      particleGeometry.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
      const particleMaterial = new THREE.PointsMaterial({
        color: colorWaste,
        size: 0.052,
        transparent: true,
        opacity: 0,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
        sizeAttenuation: true,
      });
      const particles = new THREE.Points(particleGeometry, particleMaterial);
      particles.frustumCulled = false;
      particles.renderOrder = 12;
      world.add(particles);

      function startPoint(span, t) {
        const x = span.x + span.len * t;
        const row = rowY[span.row];
        const micro = Math.sin(t * Math.PI * 2 + span.phase) * 0.012;
        return new THREE.Vector3(x, row + micro, 0.02);
      }

      function braidPoint(span, t, p, time) {
        const envelope = Math.sin(Math.PI * t);
        const settle = smoothstep(0.64, 0.98, p);
        const turns = 3.16;
        const twist = t * Math.PI * 2 * turns + span.phase + (reduced ? 0 : time * 0.32 * (1 - settle));
        const radius = envelope * mixNumber(0.78, 0.24, settle);
        const x = -4.84 + 9.68 * t - Math.sin(twist) * envelope * 0.16;
        const spine = Math.sin((t - 0.5) * Math.PI * 2) * 0.30 * (1 - settle);
        const y = spine + Math.cos(twist) * radius * 0.62;
        const z = Math.sin(twist) * radius * 1.15 + span.depth;
        return new THREE.Vector3(x, y, z);
      }

      function finalPoint(span, t) {
        const count = nonWaste.length;
        const idx = span.finalIndex;
        const lane = (idx - (count - 1) / 2) * 0.018;
        const x = -3.44 + 6.88 * t;
        const y = lane + Math.sin(t * Math.PI * 2 + span.phase) * 0.006;
        const z = ((idx % 6) - 2.5) * 0.014;
        return new THREE.Vector3(x, y, z);
      }

      function mixNumber(a, b, t) {
        return a + (b - a) * t;
      }

      function samplePoint(span, t, p, time) {
        const wave = clamp((p - t * 0.12) / 0.88, 0, 1);
        const lift = smoothstep(0.02, 0.44, wave);
        const settle = smoothstep(0.55, 0.98, wave);
        const from = startPoint(span, t);
        const braid = braidPoint(span, t, p, time);
        const point = from.lerp(braid, lift);
        if (span.waste) {
          const burn = smoothstep(0.38, 0.82, p);
          const outward = span.peel * burn;
          point.x += Math.sin(t * Math.PI * 2 + span.phase) * burn * 0.34;
          point.y += outward * (0.55 + 0.72 * t) + Math.sin(span.phase) * burn * 0.18;
          point.z += burn * (0.82 + t * 0.44);
          return point;
        }
        return point.lerp(finalPoint(span, t), settle);
      }

      function setOpacity(object, opacity) {
        object.material.opacity = opacity;
      }

      function updateParticles(p, time) {
        const burnIn = smoothstep(0.38, 0.58, p);
        const burnOut = 1 - smoothstep(0.70, 0.96, p);
        const visible = burnIn * burnOut;
        particleMaterial.opacity = visible * 0.82;
        for (let i = 0; i < particleCount; i += 1) {
          const seed = particleSeeds[i];
          const base = samplePoint(seed.span, seed.t, p, time);
          const spread = smoothstep(0.42, 0.92, p) * seed.r;
          const angle = seed.a + time * (reduced ? 0 : 0.7);
          particlePositions[i * 3] = base.x + Math.cos(angle) * spread * 0.38;
          particlePositions[i * 3 + 1] = base.y + Math.sin(angle * 1.37) * spread * 0.46;
          particlePositions[i * 3 + 2] = base.z + Math.sin(angle) * spread * 0.70;
        }
        particleGeometry.attributes.position.needsUpdate = true;
      }

      function updateScene(p, time) {
        const traceOpacity = 1 - smoothstep(0.12, 0.48, p);
        gridMaterial.opacity = 0.20 * traceOpacity;
        for (const sprite of tickSprites) setOpacity(sprite, 0.44 * traceOpacity);
        traceGroup.position.z = -0.10 - p * 0.18;
        bgMaterial.uniforms.uTime.value = reduced ? 0 : time;
        grainMaterial.uniforms.uTime.value = reduced ? 0 : time;

        for (const mesh of meshes) {
          const span = mesh.userData.span;
          const points = [];
          for (let j = 0; j <= sampleCount; j += 1) {
            points.push(samplePoint(span, j / sampleCount, p, time));
          }
          mesh.geometry.dispose();
          const settled = smoothstep(0.60, 1.0, p);
          const radius = span.waste ? 0.050 : mixNumber(0.048, 0.062, settled);
          mesh.geometry = new THREE.TubeGeometry(new THREE.CatmullRomCurve3(points), 92, radius, 9, false);
          const material = mesh.userData.material;
          material.uniforms.uTime.value = reduced ? 0 : time;
          material.uniforms.uResolve.value = p;
          material.uniforms.uAlpha.value = span.waste
            ? 0.92 * (1 - smoothstep(0.48, 0.84, p))
            : mixNumber(0.72, 1.0, settled);
        }

        coreMaterial.uniforms.uTime.value = reduced ? 0 : time;
        coreMaterial.uniforms.uResolve.value = p;
        coreMaterial.uniforms.uAlpha.value = smoothstep(0.70, 1.0, p) * 0.36;
        updateParticles(p, time);
        world.rotation.x = -0.08 * smoothstep(0.16, 0.58, p) * (1 - smoothstep(0.82, 1.0, p));
        world.rotation.y = Math.sin(time * 0.18) * 0.035 * (1 - p);
      }

      let viewportAspect = 1;
      function fit() {
        const width = Math.max(1, canvas.clientWidth);
        const height = Math.max(1, canvas.clientHeight);
        viewportAspect = width / height;
        renderer.setPixelRatio(Math.min(2, window.devicePixelRatio || 1));
        renderer.setSize(width, height, false);
        composer.setSize(width, height);
        camera.aspect = viewportAspect;
        const fov = THREE.MathUtils.degToRad(camera.fov);
        const baseWidth = 12.62;
        const baseHeight = 7.62;
        const fitByHeight = baseHeight / (2 * Math.tan(fov / 2));
        const fitByWidth = baseWidth / (2 * Math.tan(fov / 2) * viewportAspect);
        camera.position.z = Math.max(fitByHeight, fitByWidth) + 0.68;
        camera.updateProjectionMatrix();
        const distanceToBg = camera.position.z - bg.position.z;
        const visibleHeight = 2 * Math.tan(fov / 2) * distanceToBg;
        const visibleWidth = visibleHeight * viewportAspect;
        bg.scale.set(visibleWidth, visibleHeight, 1);
        grain.position.z = camera.position.z - 0.8;
        grain.scale.set(2 * Math.tan(fov / 2) * 0.8 * viewportAspect, 2 * Math.tan(fov / 2) * 0.8, 1);
        if (reduced) {
          updateScene(1, 0);
          composer.render();
        }
      }

      const resizeObserver = new ResizeObserver(fit);
      resizeObserver.observe(canvas);
      fit();

      let progress = reduced ? 1 : 0;
      let target = progress;
      let auto = reduced ? 1 : -0.08;
      let userScrubbed = false;
      const clock = new THREE.Clock();

      function scrub(clientX) {
        userScrubbed = true;
        target = clamp(clientX / Math.max(1, window.innerWidth), 0, 1);
      }

      window.addEventListener('pointerdown', (event) => scrub(event.clientX));
      window.addEventListener('pointermove', (event) => scrub(event.clientX));

      function frame() {
        const dt = Math.min(0.05, clock.getDelta());
        const time = clock.elapsedTime;
        if (!userScrubbed) {
          auto = Math.min(1, auto + dt / 4.4);
          target = clamp(auto, 0, 1);
        }
        progress += (target - progress) * Math.min(1, dt * (userScrubbed ? 6.8 : 3.2));
        if (!userScrubbed && auto >= 1 && Math.abs(target - progress) < 0.0009) progress = 1;
        updateScene(progress, time);
        composer.render();
        requestAnimationFrame(frame);
      }

      if (reduced) {
        updateScene(1, 0);
        composer.render();
      } else {
        frame();
      }
    </script>
  </body>
</html>
