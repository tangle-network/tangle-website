<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>From Trace to Fiber - Tangle lab</title>
  </head>
  <body>
    <div id="scroller" aria-hidden="true"><div id="spacer"></div></div>
    <canvas id="c" aria-label="From Trace to Fiber"></canvas>
    <div class="grain" aria-hidden="true"></div>
    <div class="vig" aria-hidden="true"></div>
    <div class="cap">
      <h1>From Trace to Fiber</h1>
      <p>three.js / vertical scroll / trace bars braid into one indigo fiber</p>
    </div>
    <div class="hint" id="hint">scroll</div>

    <script>
      import * as THREE from 'three';
      import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
      import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
      import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canvas = document.getElementById('c');
      const scroller = document.getElementById('scroller');
      const hint = document.getElementById('hint');

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: false,
        powerPreference: 'high-performance',
      });
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.setPixelRatio(Math.min(2, devicePixelRatio || 1));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 0.9;
      renderer.setClearColor('#080814', 1);

      const scene = new THREE.Scene();
      scene.background = new THREE.Color('#080814');
      scene.fog = new THREE.FogExp2('#080814', 0.058);

      const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 120);
      camera.position.set(0, 0, 13.4);
      let fittedCameraZ = camera.position.z;

      const composer = new EffectComposer(renderer);
      composer.addPass(new RenderPass(scene, camera));
      const bloom = new UnrealBloomPass(new THREE.Vector2(1, 1), 0.42, 0.62, 0.02);
      composer.addPass(bloom);

      const C = {
        bg0: new THREE.Color('#080814'),
        bg1: new THREE.Color('#11122D'),
        ink0: new THREE.Color('#4F46E5'),
        ink1: new THREE.Color('#6366F1'),
        ink2: new THREE.Color('#818CF8'),
        ink3: new THREE.Color('#C7C9F5'),
        red: new THREE.Color('#E11D48'),
      };

      const world = new THREE.Group();
      world.position.y = 0.22;
      scene.add(world);

      const bgMaterial = new THREE.ShaderMaterial({
        depthWrite: false,
        depthTest: false,
        uniforms: {
          uLow: { value: C.bg0 },
          uHigh: { value: C.bg1 },
          uGlow: { value: C.ink0 },
        },
        vertexShader: `
          varying vec2 vUv;
          void main() {
            vUv = uv;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          precision highp float;
          uniform vec3 uLow;
          uniform vec3 uHigh;
          uniform vec3 uGlow;
          varying vec2 vUv;
          void main() {
            float y = smoothstep(0.0, 1.0, vUv.y);
            float d = distance(vUv, vec2(0.54, 0.53));
            float basin = 1.0 - smoothstep(0.18, 0.86, d);
            vec3 col = mix(uLow, uHigh, y * 0.9);
            col += uGlow * basin * 0.05;
            col *= 1.0 - smoothstep(0.42, 0.98, d) * 0.22;
            gl_FragColor = vec4(col, 1.0);
          }
        `,
      });
      const bg = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), bgMaterial);
      bg.position.z = -16;
      bg.renderOrder = -100;
      scene.add(bg);

      const traceGroup = new THREE.Group();
      world.add(traceGroup);

      const rowY = [2.76, 2.0, 1.24, 0.48, -0.28, -1.04, -1.8, -2.56];
      const traceLeft = -5.72;
      const traceRight = 5.86;
      const sampleCount = 64;

      const spans = [
        { row: 0, x: -5.48, len: 1.1 },
        { row: 0, x: -4.0, len: 1.72 },
        { row: 0, x: -1.72, len: 1.92 },
        { row: 0, x: 0.62, len: 1.18 },
        { row: 1, x: -5.2, len: 1.44 },
        { row: 1, x: -3.28, len: 2.08 },
        { row: 1, x: -0.72, len: 1.74 },
        { row: 1, x: 1.5, len: 1.2 },
        { row: 2, x: -5.36, len: 8.66, waste: true, peel: 1 },
        { row: 2, x: 3.62, len: 1.12 },
        { row: 3, x: -4.92, len: 1.42 },
        { row: 3, x: -2.92, len: 1.64 },
        { row: 3, x: -0.86, len: 1.28 },
        { row: 3, x: 0.94, len: 1.86 },
        { row: 4, x: -4.72, len: 8.96, waste: true, peel: -1 },
        { row: 4, x: 4.54, len: 0.96 },
        { row: 5, x: -5.34, len: 2.32 },
        { row: 5, x: -2.34, len: 1.48 },
        { row: 5, x: -0.32, len: 2.18 },
        { row: 5, x: 2.36, len: 1.12 },
        { row: 6, x: -5.42, len: 9.28, waste: true, peel: 1 },
        { row: 6, x: 4.18, len: 1.02 },
        { row: 7, x: -4.22, len: 2.0 },
        { row: 7, x: -1.68, len: 1.28 },
        { row: 7, x: 0.18, len: 2.34 },
      ];

      const nonWaste = spans.filter((span) => !span.waste);
      for (let i = 0; i < spans.length; i += 1) {
        const span = spans[i];
        span.id = i;
        span.seed = 0.117 + i * 0.071;
        span.phase = i * 1.618 + (span.waste ? 0.82 : 0);
        span.depth = ((i % 7) - 3) * 0.052;
        if (!span.waste) span.finalIndex = nonWaste.indexOf(span);
      }

      function clamp(value, min, max) {
        return Math.max(min, Math.min(max, value));
      }

      function smoothstep(edge0, edge1, value) {
        const t = clamp((value - edge0) / (edge1 - edge0), 0, 1);
        return t * t * (3 - 2 * t);
      }

      function mixNumber(a, b, t) {
        return a + (b - a) * t;
      }

      function makeLabel(text, x, y, width) {
        const labelCanvas = document.createElement('canvas');
        labelCanvas.width = 512;
        labelCanvas.height = 128;
        const ctx = labelCanvas.getContext('2d');
        ctx.clearRect(0, 0, labelCanvas.width, labelCanvas.height);
        ctx.font = '600 40px JetBrains Mono, SFMono-Regular, ui-monospace, Menlo, Consolas, monospace';
        ctx.fillStyle = '#818CF8';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(text, 256, 64);
        const texture = new THREE.CanvasTexture(labelCanvas);
        texture.colorSpace = THREE.SRGBColorSpace;
        const material = new THREE.SpriteMaterial({
          map: texture,
          transparent: true,
          opacity: 0.34,
          depthWrite: false,
          depthTest: false,
        });
        const sprite = new THREE.Sprite(material);
        sprite.position.set(x, y, 0.08);
        sprite.scale.set(width, width * 0.25, 1);
        sprite.renderOrder = 20;
        traceGroup.add(sprite);
        return sprite;
      }

      const tickSprites = [
        makeLabel('0ms', -5.46, -3.12, 0.62),
        makeLabel('900ms', -2.72, -3.12, 0.92),
        makeLabel('1.8s', 0.0, -3.12, 0.72),
        makeLabel('2.7s', 2.72, -3.12, 0.72),
        makeLabel('3.6s', 5.32, -3.12, 0.72),
      ];

      const gridVerts = [];
      for (const y of rowY) {
        gridVerts.push(traceLeft, y, -0.24, traceRight, y, -0.24);
      }
      for (let i = 0; i <= 8; i += 1) {
        const x = traceLeft + (traceRight - traceLeft) * (i / 8);
        gridVerts.push(x, rowY[0] + 0.24, -0.26, x, rowY[rowY.length - 1] - 0.18, -0.26);
      }
      const gridGeometry = new THREE.BufferGeometry();
      gridGeometry.setAttribute('position', new THREE.Float32BufferAttribute(gridVerts, 3));
      const gridMaterial = new THREE.LineBasicMaterial({
        color: C.ink0,
        transparent: true,
        opacity: 0.18,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
      });
      const grid = new THREE.LineSegments(gridGeometry, gridMaterial);
      traceGroup.add(grid);

      function makeFiberMaterial(waste, seed) {
        return new THREE.ShaderMaterial({
          transparent: true,
          depthWrite: false,
          blending: THREE.AdditiveBlending,
          uniforms: {
            uTime: { value: 0 },
            uAlpha: { value: 1 },
            uResolve: { value: 0 },
            uSeed: { value: seed },
            uWaste: { value: waste ? 1 : 0 },
            uDim: { value: C.ink0 },
            uMid: { value: C.ink1 },
            uLight: { value: C.ink2 },
            uHot: { value: C.ink3 },
            uRed: { value: C.red },
          },
          vertexShader: `
            varying vec2 vUv;
            varying vec3 vN;
            varying vec3 vV;
            void main() {
              vUv = uv;
              vN = normalize(normalMatrix * normal);
              vec4 mv = modelViewMatrix * vec4(position, 1.0);
              vV = normalize(-mv.xyz);
              gl_Position = projectionMatrix * mv;
            }
          `,
          fragmentShader: `
            precision highp float;
            uniform float uTime;
            uniform float uAlpha;
            uniform float uResolve;
            uniform float uSeed;
            uniform float uWaste;
            uniform vec3 uDim;
            uniform vec3 uMid;
            uniform vec3 uLight;
            uniform vec3 uHot;
            uniform vec3 uRed;
            varying vec2 vUv;
            varying vec3 vN;
            varying vec3 vV;

            vec3 ramp(float t) {
              vec3 a = mix(uDim, uMid, smoothstep(0.0, 0.52, t));
              vec3 b = mix(uLight, uHot, smoothstep(0.45, 1.0, t));
              return mix(a, b, smoothstep(0.18, 0.94, t));
            }

            float packet(float x, float c, float w) {
              return exp(-pow((x - c) / w, 2.0));
            }

            void main() {
              vec3 indigo = ramp(vUv.x);
              vec3 red = uRed * 0.42;
              vec3 base = mix(indigo, red, uWaste);
              float view = max(dot(normalize(vN), normalize(vV)), 0.0);
              float rim = pow(1.0 - view, 2.35);
              float speed = mix(0.11, 0.24, uResolve) * mix(1.0, 0.12, uWaste);
              float w = mix(0.066, 0.026, uResolve);
              float p0 = packet(vUv.x, fract(uTime * speed + uSeed), w);
              float p1 = packet(vUv.x, fract(uTime * speed * 0.78 + uSeed + 0.37), w * 1.18);
              float p2 = packet(vUv.x, fract(uTime * speed * 1.26 + uSeed + 0.71), w * 0.86);
              float pulses = (p0 + p1 + p2) * mix(0.18, 0.9, uResolve) * mix(1.0, 0.34, uWaste);
              float body = 0.082 + rim * 0.24;
              vec3 col = base * (body + pulses * 0.32);
              col += indigo * pulses * 0.055 * (1.0 - uWaste);
              float alpha = uAlpha * (0.16 + rim * 0.28 + pulses * 0.22) * mix(1.0, 0.64, uWaste);
              gl_FragColor = vec4(col, alpha);
            }
          `,
        });
      }

      function makeCoreMaterial(seed) {
        return new THREE.ShaderMaterial({
          transparent: true,
          depthWrite: false,
          blending: THREE.AdditiveBlending,
          uniforms: {
            uTime: { value: 0 },
            uAlpha: { value: 0 },
            uSeed: { value: seed },
            uDim: { value: C.ink0 },
            uMid: { value: C.ink1 },
            uLight: { value: C.ink2 },
            uHot: { value: C.ink3 },
          },
          vertexShader: `
            varying vec2 vUv;
            varying vec3 vN;
            varying vec3 vV;
            void main() {
              vUv = uv;
              vN = normalize(normalMatrix * normal);
              vec4 mv = modelViewMatrix * vec4(position, 1.0);
              vV = normalize(-mv.xyz);
              gl_Position = projectionMatrix * mv;
            }
          `,
          fragmentShader: `
            precision highp float;
            uniform float uTime;
            uniform float uAlpha;
            uniform float uSeed;
            uniform vec3 uDim;
            uniform vec3 uMid;
            uniform vec3 uLight;
            uniform vec3 uHot;
            varying vec2 vUv;
            varying vec3 vN;
            varying vec3 vV;

            vec3 ramp(float t) {
              vec3 a = mix(uDim, uMid, smoothstep(0.0, 0.48, t));
              vec3 b = mix(uLight, uHot, smoothstep(0.5, 1.0, t));
              return mix(a, b, smoothstep(0.2, 0.92, t));
            }

            float packet(float x, float c, float w) {
              return exp(-pow((x - c) / w, 2.0));
            }

            void main() {
              float view = max(dot(normalize(vN), normalize(vV)), 0.0);
              float rim = pow(1.0 - view, 2.1);
              float p0 = packet(vUv.x, fract(uTime * 0.31 + uSeed), 0.028);
              float p1 = packet(vUv.x, fract(uTime * 0.24 + uSeed + 0.52), 0.034);
              vec3 base = ramp(vUv.x);
              float pulses = p0 + p1 * 0.82;
              vec3 col = base * (0.1 + rim * 0.28 + pulses * 0.44);
              float alpha = uAlpha * (0.18 + rim * 0.25 + pulses * 0.2);
              gl_FragColor = vec4(col, alpha);
            }
          `,
        });
      }

      function tubeFor(points, radius, segments) {
        return new THREE.TubeGeometry(new THREE.CatmullRomCurve3(points), segments, radius, 8, false);
      }

      function startPoint(span, t, time, p) {
        const jitter = (1 - smoothstep(0.0, 0.38, p)) * (reduced ? 0 : 0.018);
        const x = span.x + span.len * t;
        const y = rowY[span.row] + Math.sin(time * 0.9 + span.phase + t * 5.0) * jitter;
        const z = span.depth + Math.cos(time * 0.8 + span.phase + t * 3.0) * jitter;
        return new THREE.Vector3(x, y, z);
      }

      function braidPoint(span, t, p, time) {
        const local = smoothstep(0.02, 0.7, p);
        const settle = smoothstep(0.64, 0.98, p);
        const envelope = Math.sin(Math.PI * t);
        const turns = 3.7;
        const spin = t * Math.PI * 2 * turns + span.phase + (reduced ? 0 : time * 0.28 * (1 - settle));
        const radius = envelope * mixNumber(0.92, 0.2, settle);
        const x = -4.92 + 9.84 * t;
        const wave = Math.sin((t - 0.5) * Math.PI * 2) * 0.34 * (1 - settle);
        const y = wave + Math.cos(spin) * radius * 0.58;
        const z = Math.sin(spin) * radius * 1.08 + span.depth * (1 - settle * 0.7);
        const lift = smoothstep(0.0, 0.42, local);
        return new THREE.Vector3(x, y + lift * 0.08, z);
      }

      function finalPoint(span, t) {
        const count = nonWaste.length;
        const idx = span.finalIndex;
        const lane = (idx - (count - 1) / 2) * 0.012;
        const x = -3.36 + 6.72 * t;
        const y = lane + Math.sin(t * Math.PI * 2 + span.phase) * 0.004;
        const z = ((idx % 5) - 2) * 0.012;
        return new THREE.Vector3(x, y, z);
      }

      function wastePoint(span, t, p, time) {
        const base = braidPoint(span, t, p, time);
        const peel = smoothstep(0.36, 0.78, p);
        const ash = smoothstep(0.62, 1.0, p);
        base.x += Math.sin(t * Math.PI * 2 + span.phase) * peel * 0.42;
        base.y += span.peel * peel * (0.58 + t * 0.74) + Math.sin(span.phase) * peel * 0.1;
        base.z += peel * (0.68 + t * 0.48) + ash * 0.34;
        return base;
      }

      function samplePoint(span, t, p, time) {
        const wave = clamp((p - t * 0.1) / 0.9, 0, 1);
        const lift = smoothstep(0.03, 0.42, wave);
        const settle = smoothstep(0.56, 0.98, wave);
        const from = startPoint(span, t, time, p);
        const braided = span.waste ? wastePoint(span, t, p, time) : braidPoint(span, t, p, time);
        const point = from.lerp(braided, lift);
        if (span.waste) return point;
        return point.lerp(finalPoint(span, t), settle);
      }

      const meshes = spans.map((span) => {
        const points = [];
        for (let j = 0; j <= sampleCount; j += 1) {
          points.push(samplePoint(span, j / sampleCount, reduced ? 1 : 0, 0));
        }
        const material = makeFiberMaterial(Boolean(span.waste), span.seed);
        const radius = span.waste ? 0.044 : 0.046;
        const mesh = new THREE.Mesh(tubeFor(points, radius, 88), material);
        mesh.frustumCulled = false;
        mesh.renderOrder = span.waste ? 7 : 8;
        mesh.userData = { span, material, radius };
        world.add(mesh);
        return mesh;
      });

      const coreMaterial = makeCoreMaterial(0.41);
      const corePoints = [
        new THREE.Vector3(-3.36, 0.004, -0.035),
        new THREE.Vector3(-1.15, 0.0, -0.02),
        new THREE.Vector3(1.15, 0.0, -0.02),
        new THREE.Vector3(3.36, -0.004, -0.035),
      ];
      const core = new THREE.Mesh(tubeFor(corePoints, 0.112, 132), coreMaterial);
      core.frustumCulled = false;
      core.renderOrder = 6;
      world.add(core);

      const wasteSpans = spans.filter((span) => span.waste);
      const particleCount = 174;
      const particlePositions = new Float32Array(particleCount * 3);
      const particleSeeds = [];
      for (let i = 0; i < particleCount; i += 1) {
        particleSeeds.push({
          span: wasteSpans[i % wasteSpans.length],
          t: ((i * 13) % 97) / 96,
          angle: i * 2.399,
          spread: 0.14 + ((i * 19) % 37) / 37,
        });
      }
      const particleGeometry = new THREE.BufferGeometry();
      particleGeometry.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
      const particleMaterial = new THREE.PointsMaterial({
        color: C.red,
        size: 0.044,
        transparent: true,
        opacity: 0,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
        sizeAttenuation: true,
      });
      const particles = new THREE.Points(particleGeometry, particleMaterial);
      particles.frustumCulled = false;
      particles.renderOrder = 18;
      world.add(particles);

      function updateParticles(p, time) {
        const appear = smoothstep(0.36, 0.58, p);
        const vanish = 1 - smoothstep(0.66, 0.94, p);
        const visible = appear * vanish;
        particleMaterial.opacity = visible * 0.34;
        for (let i = 0; i < particleCount; i += 1) {
          const seed = particleSeeds[i];
          const base = samplePoint(seed.span, seed.t, p, time);
          const spread = smoothstep(0.42, 0.88, p) * seed.spread;
          const angle = seed.angle + (reduced ? 0 : time * 0.46);
          particlePositions[i * 3] = base.x + Math.cos(angle) * spread * 0.32;
          particlePositions[i * 3 + 1] = base.y + Math.sin(angle * 1.37) * spread * 0.34;
          particlePositions[i * 3 + 2] = base.z + Math.sin(angle) * spread * 0.5;
        }
        particleGeometry.attributes.position.needsUpdate = true;
      }

      function setSpriteOpacity(sprite, opacity) {
        sprite.material.opacity = opacity;
      }

      function updateScene(p, time) {
        const traceOpacity = 1 - smoothstep(0.08, 0.42, p);
        gridMaterial.opacity = 0.18 * traceOpacity;
        for (const sprite of tickSprites) setSpriteOpacity(sprite, 0.34 * traceOpacity);
        traceGroup.position.z = -0.12 - p * 0.14;

        for (const mesh of meshes) {
          const { span, material } = mesh.userData;
          const points = [];
          for (let j = 0; j <= sampleCount; j += 1) {
            points.push(samplePoint(span, j / sampleCount, p, time));
          }
          mesh.geometry.dispose();
          const settled = smoothstep(0.58, 1.0, p);
          const radius = span.waste ? 0.044 : mixNumber(0.046, 0.058, settled);
          mesh.geometry = tubeFor(points, radius, 94);
          material.uniforms.uTime.value = reduced ? 0 : time;
          material.uniforms.uResolve.value = p;
          material.uniforms.uAlpha.value = span.waste
            ? 0.56 * (1 - smoothstep(0.48, 0.84, p))
            : mixNumber(0.5, 0.82, settled);
        }

        coreMaterial.uniforms.uTime.value = reduced ? 0 : time;
        coreMaterial.uniforms.uAlpha.value = smoothstep(0.68, 1.0, p) * 0.54;
        updateParticles(p, time);

        const braidDepth = smoothstep(0.16, 0.68, p) * (1 - smoothstep(0.84, 1.0, p));
        world.rotation.x = -0.06 * braidDepth;
        world.rotation.y = Math.sin(time * 0.14) * 0.04 * (1 - smoothstep(0.72, 1.0, p));
        world.position.y = 0.22 - smoothstep(0.72, 1.0, p) * 0.06;
        camera.position.z = fittedCameraZ - smoothstep(0.5, 1.0, p) * 1.04;
      }

      function fit() {
        const width = Math.max(1, innerWidth);
        const height = Math.max(1, innerHeight);
        renderer.setPixelRatio(Math.min(2, devicePixelRatio || 1));
        renderer.setSize(width, height, false);
        composer.setSize(width, height);
        camera.aspect = width / height;
        const fov = THREE.MathUtils.degToRad(camera.fov);
        const baseWidth = 12.6;
        const baseHeight = 7.32;
        const fitByHeight = baseHeight / (2 * Math.tan(fov / 2));
        const fitByWidth = baseWidth / (2 * Math.tan(fov / 2) * camera.aspect);
        fittedCameraZ = Math.max(fitByHeight, fitByWidth) + 0.68;
        camera.position.z = fittedCameraZ;
        camera.updateProjectionMatrix();

        const distanceToBg = camera.position.z - bg.position.z;
        const visibleHeight = 2 * Math.tan(fov / 2) * distanceToBg;
        const visibleWidth = visibleHeight * camera.aspect;
        bg.scale.set(visibleWidth, visibleHeight, 1);

        if (reduced) {
          updateScene(1, 0);
          composer.render();
        }
      }

      addEventListener('resize', fit);
      fit();

      let target = reduced ? 1 : 0;
      let resolve = reduced ? 1 : 0;
      const readScroll = () => {
        const max = scroller.scrollHeight - innerHeight;
        target = max > 0 ? clamp(scroller.scrollTop / max, 0, 1) : 1;
        if (target > 0.02 && hint) hint.style.opacity = '0';
      };
      scroller.addEventListener('scroll', readScroll, { passive: true });
      readScroll();

      const clock = new THREE.Clock();

      function frame() {
        requestAnimationFrame(frame);
        const time = clock.elapsedTime;
        resolve += (target - resolve) * 0.08;
        updateScene(resolve, time);
        composer.render();
      }

      if (!reduced) {
        frame();
      }
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #080814;
  }

  #c {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    display: block;
  }

  #scroller {
    position: fixed;
    inset: 0;
    z-index: 3;
    overflow-y: scroll;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  #spacer {
    height: 340vh;
  }

  #scroller::-webkit-scrollbar {
    width: 0;
