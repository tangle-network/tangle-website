---
import { metricBars } from '@tangle-network/charts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BenchHead from '../../components/BenchHead.astro';
import Figure from '../../components/Figure.astro';
import { drawnWidth, niceMax } from '../../data/benchmarks/grid';
import { boards, harnessLabel, identity, type AppliedBoard } from '../../data/benchmarks/applied';
import '@tangle-network/charts/figure.css';
import '../../styles/bench.css';

const usd = (x: number) => `$${x.toFixed(2)}`;
const wide = (b: AppliedBoard) => b.rows.length > 3;
const facts = (b: AppliedBoard, r: AppliedBoard['rows'][number]) => [`Harness: ${harnessLabel(r)}`, ...(r.cost === undefined ? [] : [`Cost: ${usd(r.cost)}`]), `Run: ${b.date}`];
const named = (b: AppliedBoard) => Object.fromEntries(b.rows.map((r) => [r.id, identity(r)]));

const scores = (b: AppliedBoard) => {
  const format = (v: number) => (b.percent ? `${(v * 100).toFixed(1)}%` : v.toFixed(1));
  const rows = [...b.rows].sort((x, y) => y.score - x.score);
  return metricBars(rows.map((r) => ({
    id: r.id, label: `${r.model} on ${harnessLabel(r)}`, value: r.score,
    ...(r.detail ? { detail: r.detail } : {}),
    interval: { lower: r.lower, upper: r.upper, level: 0.95, method: b.interval },
    observations: { count: Number(r.samples.match(/\d+/g)!.at(-1)), label: r.samples.replace(/^[\d of]+/, '').trim() },
    facts: facts(b, r),
  })), { id: b.id, measure: b.measure, unit: '', domain: [0, b.max], formatValue: format, identities: named(b), width: drawnWidth(wide(b) ? 6 : 2) });
};

const costs = (b: AppliedBoard) => {
  const rows = b.rows.filter((r) => r.cost !== undefined).sort((x, y) => x.cost! - y.cost!);
  return metricBars(rows.map((r) => ({ id: r.id, label: `${r.model} on ${harnessLabel(r)}`, value: r.cost!, observations: { count: Number(r.samples.match(/\d+/g)!.at(-1)), label: r.samples.replace(/^[\d of]+/, '').trim() }, facts: facts(b, r) })),
    { id: `${b.id}-cost`, measure: 'US dollars', unit: '', domain: [0, niceMax(Math.max(...rows.map((r) => r.cost!)))], formatValue: usd, identities: Object.fromEntries(rows.map((r) => [r.id, identity(r)])), width: drawnWidth(wide(b) ? 6 : 3) });
};

const best = (b: AppliedBoard) => b.rows.reduce((x, y) => (y.score > x.score ? y : x));
const updated = boards.map((b) => b.date).sort().at(-1)!;
const tax = boards.find((b) => b.id === 'tax')!;
const summary = `Agent profiles compared on tax, legal and app-building work: ${best(tax).model} on ${harnessLabel(best(tax))} leads tax returns at ${(best(tax).score * 100).toFixed(1)}% line accuracy.`;
---

<BaseLayout paper title="Applied AI benchmarks" description={summary}>
  <article class="bench">
    <BenchHead regime="applied" title="Applied AI benchmarks" status={`Each bar is a model and harness. Whiskers are 95% confidence. Updated ${updated}.`} />

    <div class="bench-grid">
      {boards.map((b) => <Figure title={b.title} span={wide(b) ? 6 : 2} figure={scores(b)} />)}
      {boards.filter((b) => b.costTitle).map((b) => <Figure title={b.costTitle!} span={wide(b) ? 6 : 3} figure={costs(b)} />)}
    </div>

    <footer class="bench-method">
      <p>{boards.map((b, i) => <>{i ? ' ' : ''}{b.title}: <a href={b.url}>{b.by}</a>, {b.date}.</>)} Tax shows the five configurations that finished all 51 returns; three others did not finish.</p>
    </footer>
  </article>
</BaseLayout>
