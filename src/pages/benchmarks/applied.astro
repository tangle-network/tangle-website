---
import { metricBars } from '@tangle-network/charts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BenchHead from '../../components/BenchHead.astro';
import Figure from '../../components/Figure.astro';
import { drawnWidth, niceMax } from '../../data/benchmarks/grid';
import { boards, harnessLabel, identity, type AppliedBoard } from '../../data/benchmarks/applied';
import '@tangle-network/charts/figure.css';
import '../../styles/bench.css';

const usd = (x: number) => `$${x.toFixed(2)}`;
const wide = (b: AppliedBoard) => b.rows.length > 3;
type Row = AppliedBoard['rows'][number];
const named = (rows: Row[]) => Object.fromEntries(rows.map((r) => [r.id, identity(r)]));
const observed = (r: Row) => ({ count: Number(r.samples.match(/\d+/g)!.at(-1)), label: r.samples.replace(/^[\d of]+/, '').trim() });

const scores = (b: AppliedBoard) => {
  const format = (v: number) => (b.percent ? `${(v * 100).toFixed(1)}%` : v.toFixed(1));
  const rows = [...b.rows].sort((x, y) => y.score - x.score);
  return metricBars(rows.map((r) => ({
    id: r.id, label: `${r.model} on ${harnessLabel(r)}`, value: r.score,
    ...(r.detail ? { detail: r.detail } : {}),
    interval: { lower: r.lower, upper: r.upper, level: 0.95, method: b.interval },
    observations: observed(r),
  })), { id: b.id, measure: b.measure, unit: '', domain: [0, b.max], formatValue: format, identities: named(rows), width: drawnWidth(wide(b) ? 6 : 2) });
};

const costs = (b: AppliedBoard) => {
  const rows = b.rows.filter((r) => r.cost !== undefined).sort((x, y) => x.cost! - y.cost!);
  return metricBars(rows.map((r) => ({ id: r.id, label: `${r.model} on ${harnessLabel(r)}`, value: r.cost!, observations: observed(r) })),
    { id: `${b.id}-cost`, measure: b.costTitle!, unit: '', domain: [0, niceMax(Math.max(...rows.map((r) => r.cost!)))], formatValue: usd, identities: named(rows), width: drawnWidth(wide(b) ? 6 : 3) });
};

const tax = boards.find((b) => b.id === 'tax')!, legal = boards.find((b) => b.id === 'legal')!;
const count = (b: AppliedBoard) => b.rows[0].samples.match(/\d+/)![0];
const best = tax.rows.reduce((x, y) => (y.score > x.score ? y : x));
const summary = `Models and agents scored on ${count(tax)} tax returns and ${count(legal)} legal cases: ${best.model} on ${harnessLabel(best)} gets ${(best.score * 100).toFixed(1)}% of tax return lines right.`;
// What each board measures, from its source: TaxCalcBench's README and build-tax-board.mjs; the legal agent's matrix record.
const method: Record<string, string> = {
  tax: `${count(tax)} returns from tax year 2024. Line accuracy is the share of graded Form 1040 lines that match the expected amount; cost is the mean per return. Direct API call is one model call per return, with no agent or tools. Setups that did not finish every return are left out.`,
  legal: `${count(legal)} synthetic client cases, each scored out of 100 by a deterministic checker on six measures, such as fee and jurisdiction accuracy.`,
};
---

<BaseLayout paper title="Applied AI benchmarks" description={summary}>
  <article class="bench">
    <BenchHead regime="applied" title="Applied AI benchmarks" status={`Models and agents scored on ${count(tax)} tax returns and ${count(legal)} legal cases.`} />

    <div class="bench-grid">
      {boards.map((b) => <Figure title={b.title} span={wide(b) ? 6 : 2} figure={scores(b)} />)}
      {boards.filter((b) => b.costTitle).map((b) => <Figure title={b.costTitle!} span={wide(b) ? 6 : 3} figure={costs(b)} />)}
    </div>

    <footer class="bench-method">
      <p>{boards.map((b, i) => <>{i ? ' ' : ''}{b.title}: <a href={b.url}>{b.by}</a>, {b.date}. {method[b.id] ?? ''}</>)} Whiskers are 95% confidence intervals.</p>
    </footer>
  </article>
</BaseLayout>
