---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { boardsByCategory } from '../../data/benchmarks/index';

const categories = boardsByCategory();
const statusLabel: Record<string, string> = { live: 'results published', partial: 'partial results', 'awaiting-run': 'awaiting run' };
---
<BaseLayout
  title="Agent benchmarks"
  description="Compare AI agents on tax calculations and public API coding tasks with held-out grading, run dates, costs, and confidence intervals."
  bodyClass="page-editorial"
>
  <section class="bx-hero">
    <div class="shell">
      <h1>Compare agents on real tax and coding tasks.</h1>
      <p>These AI agent benchmark boards test model-and-harness combinations on line-by-line tax calculations or public API implementation tasks kept out of the configuration process. Each board reports the score, sample size, run date, and grading method. Open one to see what was tested, how a pass was decided, and where the benchmark came from.</p>
      <p class="bx-method"><a href="/blog/agent-readiness-index-methodology">Read the benchmark methodology</a>. “Academic” identifies a public research suite; “proprietary” means task prompts stay private. “Results published” means measured rows and their run dates are available on the board.</p>
      <nav class="bx-cats">
        {categories.map((c) => <a href={`#cat-${c.category.toLowerCase()}`}>{c.category}</a>)}
      </nav>
    </div>
  </section>

  <section class="bx-body">
    <div class="shell">
      {categories.map((c) => (
        <div class="bx-cat" id={`cat-${c.category.toLowerCase()}`}>
          <h2>{c.category}</h2>
          <div class="bx-grid">
            {c.boards.map((b) => {
              const ranked = [...b.rows].sort((x, y) => y.score - x.score).slice(0, 3);
              return (
                <a class="bx-card" href={`/benchmarks/${b.id}`}>
                  <div class="bx-card-top">
                    <span class="bx-badge">{b.benchSource}</span>
                    <span class={`bx-st s-${b.status}`}>{statusLabel[b.status]}</span>
                  </div>
                  <h3>{b.domain}</h3>
                  <div class="bx-count mono"><strong>{b.rows.length}</strong> profile{b.rows.length === 1 ? '' : 's'} tested · <strong>{b.taskCount ?? '—'}</strong> tasks</div>
                  <p class="bx-blurb">{b.blurb}</p>
                  {ranked.length > 0 ? (
                    <div class="bx-top">
                      {ranked.map((r, i) => (
                        <div class="bx-top-row">
                          <span class="bx-top-rank mono">{i + 1}</span>
                          <span class="bx-top-model">{r.model}<small>{r.harness && r.harness !== 'router' ? r.harness : 'direct model call'}</small></span>
                          <span class="bx-top-score mono">{(r.score * 100).toFixed(1)}% <small>{b.metricLabel ?? 'score'}</small></span>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div class="bx-top awaiting mono">awaiting first run</div>
                  )}
                  <span class="bx-view">View details →</span>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .shell { width: min(74rem, 92vw); margin: 0 auto; }
  .mono { font-family: var(--font-mono); font-feature-settings: 'tnum'; }

  .bx-hero { background: var(--paper-1); padding: 5rem 0 3rem; border-bottom: 1px solid var(--hairline-light); }
  .bx-hero h1 { margin: 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.035em; color: var(--ink); font-size: clamp(2.2rem, 4vw, 3.4rem); max-width: 20ch; }
  .bx-hero p { margin: 1.1rem 0 0; color: var(--ink-secondary); font-size: clamp(1.1rem, 1.4vw, 1.28rem); line-height: 1.6; max-width: 48rem; }
  .bx-hero .bx-method { font-size: 0.95rem; max-width: 55rem; }
  .bx-method a { color: #4F46E5; font-weight: 600; }
  .bx-cats { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1.8rem; }
  .bx-cats a { padding: 0.4rem 0.9rem; border-radius: 999px; border: 1px solid var(--hairline-light); color: #4F46E5; font-size: 0.88rem; text-decoration: none; transition: all 0.15s; }
  .bx-cats a:hover { border-color: rgba(79,70,229,0.5); background: rgba(79,70,229,0.06); }

  .bx-body { background: var(--paper-0); padding: 3rem 0 6rem; }
  .bx-cat { margin-bottom: 3rem; scroll-margin-top: 2rem; }
  .bx-cat h2 { margin: 0 0 1.2rem; font-family: var(--font-display); font-weight: 600; color: var(--ink); font-size: 1.5rem; letter-spacing: -0.02em; }
  .bx-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: 1.1rem; }
  .bx-card { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--hairline-light); box-shadow: 0 8px 26px rgba(25,28,60,0.05); border-radius: 15px; padding: 1.3rem 1.4rem 1.2rem; text-decoration: none; transition: transform 0.15s, border-color 0.15s; }
  .bx-card:hover { transform: translateY(-3px); border-color: rgba(79,70,229,0.4); box-shadow: 0 16px 40px rgba(79,70,229,0.12); }
  .bx-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; }
  .bx-badge { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; color: #4F46E5; background: rgba(79,70,229,0.1); border: 1px solid rgba(79,70,229,0.22); padding: 0.2rem 0.55rem; border-radius: 6px; }
  .bx-st { font-family: var(--font-mono); font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.14rem 0.45rem; border-radius: 5px; }
  .s-live { background: rgba(16,185,129,0.2); color: #6ee7b7; }
  .s-partial { background: rgba(79,70,229,0.14); color: #4F46E5; }
  .s-awaiting-run { background: var(--paper-2); color: var(--ink-muted); }
  .bx-card h3 { margin: 0; font-family: var(--font-display); font-weight: 600; color: var(--ink); font-size: 1.35rem; letter-spacing: -0.01em; }
  .bx-count { margin-top: 0.4rem; color: var(--ink-muted); font-size: 0.8rem; }
  .bx-count strong { color: #4F46E5; }
  .bx-blurb { margin: 0.7rem 0 0; color: var(--ink-secondary); font-size: 0.92rem; line-height: 1.5; flex: 1; }
  .bx-top { margin: 1.1rem 0 1rem; border-top: 1px solid var(--hairline-light); padding-top: 0.9rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .bx-top.awaiting { color: var(--ink-muted); font-size: 0.8rem; padding-top: 0.9rem; }
  .bx-top-row { display: grid; grid-template-columns: 1.2rem 1fr auto; align-items: center; gap: 0.6rem; }
  .bx-top-rank { color: var(--ink-muted); font-size: 0.82rem; }
  .bx-top-model { color: var(--ink); font-size: 0.9rem; font-weight: 500; }
  .bx-top-model small { display: block; color: var(--ink-muted); font: 500 0.68rem/1.3 var(--font-mono); }
  .bx-top-score { color: #4F46E5; font-size: 0.9rem; font-weight: 700; text-align: right; }
  .bx-top-score small { display: block; color: var(--ink-muted); font-size: 0.62rem; font-weight: 500; }
  .bx-view { color: #4F46E5; font-size: 0.86rem; font-weight: 600; }
  .bx-card:hover .bx-view { color: #4338CA; }
</style>
