---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { boards } from '../../data/benchmarks/index';

const pct = (value: number) => `${(value * 100).toFixed(1)}%`;

const standard = [
  {
    title: 'Registered before it ran',
    body: 'The tasks, the agent profiles, the grader and the comparisons that order the ranking are sealed before the first attempt. An attempt run outside that plan does not count.',
  },
  {
    title: 'Every attempt graded, with repeated cells',
    body: 'Each task × profile cell runs at least twice, and every attempt receives one grade. Missing, duplicate, unknown-cost, or quarantined attempts keep the board unpublished.',
  },
  {
    title: 'Costed from receipts',
    body: 'The cost of every attempt comes from router receipts, so cost per solved task is measured, not estimated.',
  },
  {
    title: 'Each rank supported by its comparison',
    body: 'Each adjacent rank needs a registered comparison on the same tasks and runs. Its task-clustered and exact paired intervals must both clear the minimum effect registered before the campaign.',
  },
];
---

<BaseLayout
  title="Agent benchmarks"
  description="VerticalBench compares named agent configurations on held-out tasks. A ranked board needs complete, repeated, graded, receipt-costed runs and a supported lead."
>
  <section class="max-w-6xl mx-auto px-6 pt-32 pb-16">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight max-w-4xl text-slate-950">Agent benchmarks</h1>
    <p class="mt-6 max-w-3xl text-lg text-slate-700 leading-relaxed">
      VerticalBench tests agent profiles on held-out tasks. A profile names the harness, model, tools and their pinned configuration.
      A published board would show each tested profile, its solved tasks, and receipt-backed cost per solved task.
    </p>
    <p class="mt-4 max-w-3xl text-slate-700 leading-relaxed">
      {boards.length === 0
        ? 'No board is published yet. One-repetition results stay unranked. A board appears only when its campaign passes every check below.'
        : 'A board appears only when its campaign passes every check below, and shows only that campaign\'s recorded results.'}
    </p>
  </section>

  {boards.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pb-16">
      <div class="border border-slate-200 bg-white overflow-x-auto">
        <table class="w-full min-w-[48rem] text-left text-sm">
          <thead class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-600">
            <tr>
              <th class="px-5 py-4 font-medium">Suite</th>
              <th class="px-5 py-4 font-medium">Campaign</th>
              <th class="px-5 py-4 font-medium">Tasks × profiles × runs</th>
              <th class="px-5 py-4 font-medium">First place</th>
              <th class="px-5 py-4 font-medium">Solved</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            {boards.map((board) => {
              const leader = board.profiles[0]!;
              return (
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-5 py-5">
                    <a class="font-medium text-slate-950 hover:text-indigo-700" href={`/benchmarks/${board.suite.id}`}>
                      {board.suite.name}
                    </a>
                  </td>
                  <td class="px-5 py-5 font-mono text-xs text-slate-700 whitespace-nowrap">
                    {board.campaign.completedAt.slice(0, 10)}
                  </td>
                  <td class="px-5 py-5 font-mono text-xs text-slate-700 whitespace-nowrap">
                    {board.tasks.length} × {board.profiles.length} × {board.campaign.repetitions}
                  </td>
                  <td class="px-5 py-5 text-slate-950">{leader.label}</td>
                  <td class="px-5 py-5 font-mono text-xs text-slate-700 whitespace-nowrap">
                    {pct(leader.solveRate)} <span class="text-slate-600">({pct(leader.interval.lower)}–{pct(leader.interval.upper)})</span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="max-w-6xl mx-auto px-6 pb-24">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-950">What a campaign must prove to publish</h2>
    <div class="mt-8 grid gap-px bg-slate-200 md:grid-cols-2 border border-slate-200">
      {standard.map((item) => (
        <div class="bg-white p-6">
          <h3 class="font-medium text-slate-950">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-700">{item.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 max-w-3xl text-sm leading-relaxed text-slate-600">
      The <a href="https://github.com/tangle-network/tangle-website/blob/master/src/data/benchmarks/board-record.ts" class="underline hover:text-indigo-700">site verifier</a>
      checks each published board's digest, task × profile cells, repeated attempts, receipts and paired comparisons.
      A failed record stops the build. A campaign refused by the publisher writes no board, so it has no page here.
    </p>
  </section>
</BaseLayout>
