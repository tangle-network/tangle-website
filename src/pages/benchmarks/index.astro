---
import { formatSpanDuration as time, latencyRange, metricBars, timeSeries } from '@tangle-network/charts';
import { Metric, MetricStrip } from '@tangle-network/ui/primitives';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BenchHead from '../../components/BenchHead.astro';
import Figure from '../../components/Figure.astro';
import { drawnWidth, niceMax } from '../../data/benchmarks/grid';
import snapshot from '../../data/benchmarks/sandbox.json';
import '@tangle-network/charts/figure.css';
import '../../styles/bench.css';

const { headline, memory, panels, passed, source, trends, window } = snapshot;
type Panel = (typeof panels)[number];
type Row = Panel['rows'][number] & { logo?: string; p90?: number };

const slug = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const marks = (rows: { label: string; logo?: string }[]) => Object.fromEntries(rows.flatMap((r) => (r.logo ? [[r.label, { model: { label: r.label, src: r.logo } }]] : [])));
const band = (b: number[] | null) => (b ? { lo: b[0], hi: b[1] } : null);

const range = ({ title, rows, span = 4 }: Panel & { span?: number }) =>
  latencyRange((rows as Row[]).map((r) => {
    const p50 = band(r.p50_band), p95 = band(r.p95_band);
    return {
      id: r.label, label: r.label, p50Ms: r.p50, p95Ms: r.p95, n: r.n,
      ...(p50 ? { p50Band: [p50.lo, p50.hi] as const } : {}),
      ...(p95 ? { p95Band: [p95.lo, p95.hi] as const } : {}),
      facts: [...(r.p90 ? [`p90: ${time(r.p90)}`] : []), ...(r.failed ? [`Failed: ${r.failed} of ${r.attempts}`] : [])],
    };
  }), { id: slug(title), measure: title, minN: 1, identities: marks(rows as Row[]), width: drawnWidth(span) });

const daily = ({ title, days }: (typeof trends)[number]) => {
  const values = days.flatMap((d) => [d.p50, d.p95]);
  const points = (key: 'p50' | 'p95') => days.map((d, i) => ({ x: i, y: d[key], observations: { count: d.n, label: 'samples' } }));
  return timeSeries([{ id: 'p50', label: 'p50', points: points('p50') }, { id: 'p95', label: 'p95', colorIndex: 1, points: points('p95') }], {
    id: slug(title), width: drawnWidth(4), dense: true, crosshair: true, formatY: time,
    x: { label: 'Day', domain: [0, days.length - 1], categories: days.map((d, i) => ({ at: i, label: d.day.slice(5) })) },
    y: { label: 'Time', unit: '', scale: 'log', domain: [Math.min(...values) / 1.3, Math.max(...values) * 1.3] },
  });
};

const memoryFigure = metricBars(memory.map((r) => ({
  id: r.label, label: r.label, value: r.p50,
  interval: { lower: r.p50_band[0], upper: r.p50_band[1], level: 0.95, method: 'binomial-ranks' as const },
  observations: { count: r.n, label: 'runs' }, facts: r.p95 ? [`p95: ${r.p95} MB`] : [],
})), { id: 'memory', measure: 'MB', unit: '', domain: [0, niceMax(Math.max(...memory.map((r) => r.p50_band[1])))], formatValue: (v) => v.toFixed(0), identities: marks(memory), width: drawnWidth(6) });

const pct = (x: number) => `${Math.round(x * 100)}%`;
const passedFigure = metricBars(passed.map((r) => ({
  id: r.label, label: r.label, value: r.rate, detail: `${r.passed}/${r.attempts}`,
  interval: { lower: r.lower, upper: r.upper, level: 0.95, method: 'wilson' as const },
  observations: { count: r.attempts, label: 'runs' },
})), { id: 'passed', measure: 'Share of runs', unit: '', domain: [0, 1], formatValue: pct, width: drawnWidth(6) });

const [first, second] = [headline[0], headline[2]];
const summary = `A new sandbox in ${time(first.p50)} at the median and ${time(first.p95)} at p95, a coding agent's first reply in ${time(second.p50)}, over ${window.samples.toLocaleString('en-US')} production runs in the last 7 days.`;
---

<BaseLayout paper title="Sandbox benchmarks" description={summary}>
  <article class="bench">
    <BenchHead regime="stack" title="Sandbox benchmarks" status={`Last 7 days, ${window.samples.toLocaleString('en-US')} production runs. Bands are 95% confidence.`} />

    <MetricStrip columns={6} className="bench-stats">
      {headline.map((h) => <Metric label={h.label} value={time(h.p50)} hint={h.p95 ? `p95 ${time(h.p95)}` : undefined} />)}
    </MetricStrip>

    <div class="bench-grid">
      {panels.slice(0, 6).map((p) => <Figure title={p.title} figure={range(p)} />)}
      {trends.map((t) => <Figure title={t.title} figure={daily(t)} />)}
      {panels.slice(6).map((p: Panel & { span?: number }) => <Figure title={p.title} span={p.span} figure={range(p)} />)}
      <Figure title="Peak memory by coding agent" span={6} figure={memoryFigure} />
      <Figure title="Runs that passed their checks" span={6} figure={passedFigure} />
    </div>

    <footer class="bench-method">
      <p>From the <a href={source}>production facts feed</a>. Test runs, not customer traffic. Samples taken while a release landed are left out.</p>
    </footer>
  </article>
</BaseLayout>
