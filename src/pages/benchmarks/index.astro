---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { boardsByCategory } from '../../data/benchmarks/index';

const categories = boardsByCategory();
const statusLabel: Record<string, string> = { live: 'live', partial: 'partial', 'awaiting-run': 'awaiting run' };
---
<BaseLayout
  title="Agent benchmarks"
  description="Per-domain leaderboards ranking agent profiles on real held-out tasks: tax, legal, creative, and vertical app builds. Real measured runs, click into any benchmark for the full ranking."
>
  <section class="bx-hero">
    <div class="shell">
      <h1>The standard for real agent performance.</h1>
      <p>We rank agent profiles on real, industry-grade task suites, not generic benchmarks. Pick a benchmark to see which model and harness combinations win, scored on held-out tasks with the numbers attached.</p>
      <nav class="bx-cats">
        {categories.map((c) => <a href={`#cat-${c.category.toLowerCase()}`}>{c.category}</a>)}
      </nav>
    </div>
  </section>

  <section class="bx-body">
    <div class="shell">
      {categories.map((c) => (
        <div class="bx-cat" id={`cat-${c.category.toLowerCase()}`}>
          <h2>{c.category}</h2>
          <div class="bx-grid">
            {c.boards.map((b) => {
              const ranked = [...b.rows].sort((x, y) => y.score - x.score).slice(0, 3);
              return (
                <a class="bx-card" href={`/benchmarks/${b.id}`}>
                  <div class="bx-card-top">
                    <span class="bx-badge">{b.benchSource}</span>
                    <span class={`bx-st s-${b.status}`}>{statusLabel[b.status]}</span>
                  </div>
                  <h3>{b.domain}</h3>
                  <div class="bx-count mono"><strong>{b.rows.length}</strong> profile{b.rows.length === 1 ? '' : 's'} tested · <strong>{b.taskCount ?? '—'}</strong> tasks</div>
                  <p class="bx-blurb">{b.blurb}</p>
                  {ranked.length > 0 ? (
                    <div class="bx-top">
                      {ranked.map((r, i) => (
                        <div class="bx-top-row">
                          <span class="bx-top-rank mono">{i + 1}</span>
                          <span class="bx-top-model">{r.model}</span>
                          <span class="bx-top-score mono">{(r.score * 100).toFixed(1)}</span>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div class="bx-top awaiting mono">awaiting first run</div>
                  )}
                  <span class="bx-view">View details →</span>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .shell { width: min(74rem, 92vw); margin: 0 auto; }
  .mono { font-family: var(--font-mono); font-feature-settings: 'tnum'; }

  .bx-hero { background: #0c0b1d; padding: 5rem 0 3rem; border-bottom: 1px solid rgba(199,201,238,0.1); }
  .bx-hero h1 { margin: 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.035em; color: #fff; font-size: clamp(2.2rem, 4vw, 3.4rem); max-width: 20ch; }
  .bx-hero p { margin: 1.1rem 0 0; color: rgba(237,237,244,0.72); font-size: clamp(1.1rem, 1.4vw, 1.28rem); line-height: 1.6; max-width: 48rem; }
  .bx-cats { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1.8rem; }
  .bx-cats a { padding: 0.4rem 0.9rem; border-radius: 999px; border: 1px solid rgba(199,201,238,0.18); color: #c7c9f5; font-size: 0.88rem; text-decoration: none; transition: all 0.15s; }
  .bx-cats a:hover { border-color: rgba(129,140,248,0.5); background: rgba(129,140,248,0.08); }

  .bx-body { background: #080814; padding: 3rem 0 6rem; }
  .bx-cat { margin-bottom: 3rem; scroll-margin-top: 2rem; }
  .bx-cat h2 { margin: 0 0 1.2rem; font-family: var(--font-display); font-weight: 600; color: #fff; font-size: 1.5rem; letter-spacing: -0.02em; }
  .bx-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: 1.1rem; }
  .bx-card { display: flex; flex-direction: column; background: #100f24; border: 1px solid rgba(199,201,238,0.14); border-radius: 15px; padding: 1.3rem 1.4rem 1.2rem; text-decoration: none; transition: transform 0.15s, border-color 0.15s; }
  .bx-card:hover { transform: translateY(-3px); border-color: rgba(129,140,248,0.5); }
  .bx-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; }
  .bx-badge { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; color: #a5aafc; background: rgba(129,140,248,0.12); border: 1px solid rgba(129,140,248,0.25); padding: 0.2rem 0.55rem; border-radius: 6px; }
  .bx-st { font-family: var(--font-mono); font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.14rem 0.45rem; border-radius: 5px; }
  .s-live { background: rgba(16,185,129,0.2); color: #6ee7b7; }
  .s-partial { background: rgba(129,140,248,0.18); color: #c7c9f5; }
  .s-awaiting-run { background: rgba(94,94,122,0.25); color: #9a9ac2; }
  .bx-card h3 { margin: 0; font-family: var(--font-display); font-weight: 600; color: #fff; font-size: 1.35rem; letter-spacing: -0.01em; }
  .bx-count { margin-top: 0.4rem; color: #8888b0; font-size: 0.8rem; }
  .bx-count strong { color: #c7c9f5; }
  .bx-blurb { margin: 0.7rem 0 0; color: #9a9ac2; font-size: 0.92rem; line-height: 1.5; flex: 1; }
  .bx-top { margin: 1.1rem 0 1rem; border-top: 1px solid rgba(199,201,238,0.1); padding-top: 0.9rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .bx-top.awaiting { color: #6f6f97; font-size: 0.8rem; padding-top: 0.9rem; }
  .bx-top-row { display: grid; grid-template-columns: 1.2rem 1fr auto; align-items: center; gap: 0.6rem; }
  .bx-top-rank { color: #6f6f97; font-size: 0.82rem; }
  .bx-top-model { color: #ededf4; font-size: 0.9rem; font-weight: 500; }
  .bx-top-score { color: #a5aafc; font-size: 0.9rem; font-weight: 700; }
  .bx-view { color: #818cf8; font-size: 0.86rem; font-weight: 600; }
  .bx-card:hover .bx-view { color: #a5aafc; }
</style>
