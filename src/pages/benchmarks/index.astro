---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BenchmarkReport from '../../components/BenchmarkReport.astro';
import { boards } from '../../data/benchmarks/index';

const pct = (value: number) => `${(value * 100).toFixed(1)}%`;
const usd = (value: number | null) => value === null ? '—' : `$${value.toFixed(value < 1 ? 3 : 2)}`;
const seconds = (value: number) => `${(value / 1000).toLocaleString('en-US', { maximumFractionDigits: 1 })}s`;

const standard = [
  {
    title: 'Sealed before the first attempt',
    body: 'Each configuration fixes its harness, model, and tools. Tasks, grades, and comparisons are registered before the run.',
  },
  {
    title: 'Every cell repeated and graded',
    body: 'Every task runs at least twice with each configuration. The registered grader checks each attempt: runner tests, or App Grade operating the app in a browser. Missing or disputed grades prevent publication.',
  },
  {
    title: 'Costed from receipts',
    body: 'Cost per pass divides total model spend, including unsuccessful attempts, by successful attempts. Sandbox charges are excluded.',
  },
  {
    title: 'A ranking needs a supported comparison',
    body: 'Complete results can publish without a ranking. Ranking adjacent configurations requires registered comparisons whose bootstrap and exact paired-result intervals support the improvement at 95% confidence or higher.',
  },
];
---

<BaseLayout
  title="Agent benchmarks"
  description="Compare coding agents on the same tasks by success rate, model cost, and runtime."
>
  <BenchmarkReport>
    <Fragment slot="hero">
      <h1 class="bench-h1">Agent benchmarks</h1>
      <p class="bench-lede">
        Compare coding agents on the same tasks by success rate, model cost, and runtime.
      </p>
      {boards.length === 0 && <p class="bench-status">No results have passed publication review yet.</p>}
    </Fragment>

    {boards.length > 0 && (
      <section class="bench-section" id="boards">
        <h2 class="bench-h2">Results</h2>
        {boards.map((board) => (
          <article class="bench-suite">
            <h3 class="bench-h3"><a href={`/benchmarks/${board.suite.id}/`}>{board.suite.name}</a></h3>
            <p class="bench-small">
              {board.campaign.completedAt.slice(0, 10)} · {board.tasks.length} tasks · {board.campaign.repetitions} runs per task
              · {board.grader.kind === 'app-grade' ? `Pass: App Grade ${board.grader.passTier} or better` : `Pass: ${board.grader.pass}`}
              {' · '}<a href={`/benchmarks/${board.suite.id}.json`} download title={board.digest}>Download data</a>
            </p>
            <div class="bench-table bench-board-desktop">
              <table class="tgc-table">
                <thead>
                  <tr>
                    <th scope="col">Configuration</th>
                    <th scope="col" class="tgc-n">Passed / attempts</th>
                    <th scope="col" class="tgc-n">Success rate</th>
                    <th scope="col" class="tgc-n">Cost per pass</th>
                    <th scope="col" class="tgc-n">Median run</th>
                  </tr>
                </thead>
                <tbody>
                  {board.profiles.map((profile) => (
                    <tr>
                      <th scope="row">{profile.label}</th>
                      <td class="tgc-n">{profile.solved} / {profile.attempts}</td>
                      <td class="tgc-n">{pct(profile.rate)}</td>
                      <td class="tgc-n">{usd(profile.cost.perSolvedUsd)}</td>
                      <td class="tgc-n">{seconds(profile.medianWallMs)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <ul class="bench-board-list">
              {board.profiles.map((profile) => (
                <li>
                  <p class="bench-configuration">{profile.label}</p>
                  <dl class="bench-metrics">
                    <div><dt>Passed / attempts</dt><dd>{profile.solved} / {profile.attempts}</dd></div>
                    <div><dt>Success rate</dt><dd>{pct(profile.rate)}</dd></div>
                    <div><dt>Cost per pass</dt><dd>{usd(profile.cost.perSolvedUsd)}</dd></div>
                    <div><dt>Median run</dt><dd>{seconds(profile.medianWallMs)}</dd></div>
                  </dl>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </section>
    )}

    <details class="bench-section bench-details" id="standard">
      <summary>Methodology</summary>
      <ol class="bench-steps">
        {standard.map((item, index) => (
          <li>
            <span class="bench-num">{String(index + 1).padStart(2, '0')} </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </details>

    <details class="bench-section bench-details" id="check">
      <summary>Verify the data</summary>
      <p class="bench-prose">
        Each board publishes its record as JSON, and the record's digest covers every field.
        The <a href="https://github.com/tangle-network/tangle-website/blob/master/src/data/benchmarks/board-record.ts">verifier</a> recomputes every total at build time and stops the build on any mismatch.
      </p>
      <ul>
        {boards.map((board) => <li><a href={`/benchmarks/${board.suite.id}.json`}>{board.suite.name}</a><br /><span class="bench-digest">{board.digest}</span></li>)}
      </ul>
    </details>
  </BenchmarkReport>
</BaseLayout>

<style>
  .bench-suite + .bench-suite { margin-top: 40px; }
  .bench-suite .bench-h3 { margin-top: 0; }
  .bench-board-list .bench-configuration { color: var(--text-primary); font-weight: 600; }
  .bench-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 12px 0 0; }
  .bench-metrics dt { color: var(--text-secondary); font-size: 12px; line-height: 18px; }
  .bench-metrics dd { margin: 2px 0 0; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 16px; }
</style>
