---
import { latencyRange, type LatencyRangeRow } from '@tangle-network/charts';
import { Metric, MetricStrip } from '@tangle-network/ui/primitives';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BenchHead from '../../components/BenchHead.astro';
import Figure from '../../components/Figure.astro';
import { branches, burst100, bursts, day, feed, firstCall, firstCommand, firstText, forks, lifecycle, seconds, type Row } from '../../data/benchmarks/sandbox';
import '@tangle-network/charts/figure.css';
import '../../styles/bench.css';

const width = 1160;
// Fewer than 5 samples support no p95.
const timed = (r: Row): LatencyRangeRow => ({ id: r.label, label: r.label, p50Ms: r.value, p95Ms: r.n >= 5 ? (r.whisker ?? null) : null, n: r.n, facts: r.facts });

// Coding agents by the id the facts feed uses.
const agents: Record<string, { name: string; logo?: string }> = {
  'claude-code': { name: 'Claude Code', logo: '/images/harness/claude-code.svg' },
  codex: { name: 'Codex', logo: '/images/harness/codex.png' },
  opencode: { name: 'OpenCode', logo: '/images/harness/opencode.svg' },
  hermes: { name: 'Hermes', logo: '/images/harness/hermes.png' },
  openclaw: { name: 'OpenClaw', logo: '/images/harness/openclaw.png' },
  'kimi-code': { name: 'Kimi Code', logo: '/images/harness/kimi-code.png' },
  pi: { name: 'Pi', logo: '/images/harness/pi.svg' },
  prime: { name: 'Prime Agent', logo: '/images/harness/prime-agent.png' },
  'factory-droids': { name: 'Factory Droid' },
  acp: { name: 'ACP' },
};
const agentRows = firstText.rows.map((r) => ({ ...r, id: r.label, name: agents[r.label]?.name ?? r.label })).sort((a, b) => a.value - b.value);
const agentMarks = Object.fromEntries(agentRows.flatMap((r) => (agents[r.id]?.logo ? [[r.id, { model: { label: r.name, src: agents[r.id].logo! } }]] : [])));

// The public 100-at-once board with Tangle's one row placed by median.
const board = burst100.computesdk;
const tangle = burst100.tangle;
const names: Record<string, string> = { e2b: 'E2B', 'cloud-run': 'Cloud Run', computesdk: 'ComputeSDK' };
const providerName = (id: string) => names[id] ?? id.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const boardRows: LatencyRangeRow[] = [
  ...board.rows.map((r) => ({ id: r.provider, label: providerName(r.provider), p50Ms: r.median_ms, p95Ms: r.p95_ms, n: board.iterations, extra: `${Math.round(r.success_rate * 100)}%`, facts: [`ComputeSDK board, ${day(board.timestamp)}`] })),
  { id: 'tangle', label: tangle.production_changed ? 'Tangle ✱' : 'Tangle', p50Ms: tangle.p50_ms, p95Ms: tangle.p95_ms, n: 100, extra: `${tangle.reached}%`, facts: [`Run ${day(tangle.at)}`, ...(tangle.production_changed ? ['A release landed during this run'] : [])] },
].sort((a, b) => a.p50Ms - b.p50Ms);
const place = boardRows.findIndex((r) => r.id === 'tangle') + 1;

const updated = [firstText.run.started_at, lifecycle.run.started_at, tangle.at].map(day).sort().at(-1)!;
const summary = `A new sandbox in ${seconds(lifecycle.rows[0].value)}, a coding agent's first reply in ${seconds(agentRows[0].value)}, and 100 sandboxes at once in ${seconds(tangle.p50_ms)}, #${place} of ${boardRows.length} clouds.`;
---

<BaseLayout paper title="Sandbox leaderboard" description={summary}>
  <article class="bench">
    <BenchHead regime="stack" title="Sandbox leaderboard" updated={updated} />

    <MetricStrip columns={4} className="bench-stats">
      <Metric label="New sandbox" value={seconds(lifecycle.rows[0].value)} />
      <Metric label="First command" value={seconds(firstCommand.together.p50_ms!)} />
      <Metric label="First agent reply" value={seconds(agentRows[0].value)} hint={agentRows[0].name} />
      <Metric label="100 at once" value={seconds(tangle.p50_ms)} hint={`#${place} of ${boardRows.length} clouds`} />
    </MetricStrip>

    <Figure title="100 sandboxes at once" figure={latencyRange(boardRows, { id: 'clouds', measure: 'time to interactive', minN: 1, ranked: true, highlight: ['tangle'], heads: { value: 'median', extra: 'reached' }, width })} />
    <Figure title="First reply from a coding agent" figure={latencyRange(agentRows.map((r) => ({ ...timed(r), id: r.id, label: r.name })), { id: 'agents', measure: 'create to first text', minN: 1, scale: 'linear', ranked: true, identities: agentMarks, width })} />
    <Figure title="Every sandbox operation" figure={latencyRange(lifecycle.rows.map((r) => ({ ...timed(r), compareMs: r.desktop })), { id: 'verbs', measure: 'time per operation', minN: 1, scale: 'linear', heads: { value: 'base', compare: 'desktop' }, width })} />
    <Figure title="Bursts, branches and forks" figure={latencyRange([...bursts.rows, { label: '100 at once', value: tangle.p50_ms, n: tangle.reached, facts: [`${tangle.reached} of 100 reached a first command`, `p95 ${seconds(tangle.p95_ms)}`] }, ...branches.rows, ...forks.rows].map(timed), { id: 'many', measure: 'time to first command', minN: 1, scale: 'linear', width })} />
    <Figure title="First model call" figure={latencyRange(firstCall.rows.map(timed), { id: 'first-call', measure: 'first Router call', minN: 1, scale: 'linear', width })} />

    <footer class="bench-method">
      {tangle.production_changed && <p>✱ A release landed during this run, so the <a href={feed.source}>facts feed</a> marks it invalid.</p>}
      <p>Clouds from ComputeSDK's <a href={board.source}>burst board</a>, {day(board.timestamp)}. Tangle runs the same test on production. These are test runs, not customer traffic.</p>
    </footer>
  </article>
</BaseLayout>
