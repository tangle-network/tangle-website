---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { boards } from '../../data/benchmarks/index';

const pct = (value: number) => `${(value * 100).toFixed(1)}%`;

const standard = [
  {
    title: 'Registered before it ran',
    body: 'The tasks, the agent profiles, the grader and the comparisons that order the ranking are sealed before the first attempt. An attempt run outside that plan does not count.',
  },
  {
    title: 'Every cell graded, twice or more',
    body: 'Each task × profile cell runs at least twice and gets exactly one grade. One infrastructure or harness failure withholds the board.',
  },
  {
    title: 'Costed from receipts',
    body: 'The cost of every attempt comes from router receipts, so cost per solved task is measured, not estimated.',
  },
  {
    title: 'Ranked by a supported difference',
    body: 'A profile ranks above the next only when a paired comparison over the same tasks and runs clears the minimum effect registered before the campaign, on both a task-clustered bootstrap interval and an exact paired interval.',
  },
];
---

<BaseLayout
  title="Agent benchmarks"
  description="Boards that rank agent profiles by held-out tasks solved and cost per solved task. A board publishes only when its campaign was registered before it ran, graded every cell twice or more, costed every attempt from receipts, and separated its ranking by paired comparisons."
>
  <section class="max-w-6xl mx-auto px-6 pt-32 pb-16">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight max-w-4xl">Agent benchmarks</h1>
    <p class="mt-6 max-w-3xl text-lg text-text-secondary leading-relaxed">
      Each board ranks agent profiles (a harness, a model and its tools) by how many held-out tasks they solve,
      and what each solved task cost.
    </p>
    <p class="mt-4 max-w-3xl text-text-secondary leading-relaxed">
      {boards.length === 0
        ? 'No board has published yet. A board appears only when its campaign passes every check below.'
        : 'A board appears only when its campaign passes every check below, and shows only that campaign\'s recorded results.'}
    </p>
  </section>

  {boards.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pb-16">
      <div class="border border-white/15 bg-white/[0.03] overflow-x-auto">
        <table class="w-full min-w-[48rem] text-left text-sm">
          <thead class="border-b border-white/15 text-xs uppercase tracking-wide text-text-muted">
            <tr>
              <th class="px-5 py-4 font-medium">Suite</th>
              <th class="px-5 py-4 font-medium">Campaign</th>
              <th class="px-5 py-4 font-medium">Tasks × profiles × runs</th>
              <th class="px-5 py-4 font-medium">First place</th>
              <th class="px-5 py-4 font-medium">Solved</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            {boards.map((board) => {
              const leader = board.profiles[0]!;
              return (
                <tr class="hover:bg-white/[0.04] transition-colors">
                  <td class="px-5 py-5">
                    <a class="font-medium text-text-primary hover:text-indigo-200" href={`/benchmarks/${board.suite.id}`}>
                      {board.suite.name}
                    </a>
                  </td>
                  <td class="px-5 py-5 font-mono text-xs text-text-secondary whitespace-nowrap">
                    {board.campaign.completedAt.slice(0, 10)}
                  </td>
                  <td class="px-5 py-5 font-mono text-xs text-text-secondary whitespace-nowrap">
                    {board.tasks.length} × {board.profiles.length} × {board.campaign.repetitions}
                  </td>
                  <td class="px-5 py-5 text-text-primary">{leader.label}</td>
                  <td class="px-5 py-5 font-mono text-xs text-text-secondary whitespace-nowrap">
                    {pct(leader.solveRate)} <span class="text-text-muted">({pct(leader.interval.lower)}–{pct(leader.interval.upper)})</span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="max-w-6xl mx-auto px-6 pb-24">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight">What a campaign must prove to publish</h2>
    <div class="mt-8 grid gap-px bg-white/15 md:grid-cols-2 border border-white/15">
      {standard.map((item) => (
        <div class="bg-bg-dark p-6">
          <h3 class="font-medium text-text-primary">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">{item.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 max-w-3xl text-sm leading-relaxed text-text-muted">
      The site checks each board when it builds. It recomputes the board's digest and every total from its cells,
      and a board that fails a check stops the deploy. A campaign that fails its decision writes no board, so it has
      no page here.
    </p>
  </section>
</BaseLayout>
