---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { assessedSuites, publishingSuites } from '../../data/benchmarks/index';
import { gateTally, type GateOutcome } from '../../data/benchmarks/standard';

const suites = assessedSuites;
const publishing = publishingSuites();
const total = suites.length;

const headline =
  publishing.length === 0
    ? `${total} suites measured. None publishes a ranking yet.`
    : `${total} suites measured. ${publishing.length} publish a ranking.`;

const gateColumns = [
  {
    id: 'graded' as const,
    short: 'Every cell graded',
    requirement: 'Every task × configuration cell runs to completion and receives a valid grade.',
    why: 'A configuration scored over fewer tasks than its neighbours is not on the same board as them.',
  },
  {
    id: 'clean' as const,
    short: 'No harness failure',
    requirement: 'Zero infrastructure or harness failures among the graded cells.',
    why: 'A cell that never reached the model measures the runner, and scoring it as a task failure blames the agent for it.',
  },
  {
    id: 'stable' as const,
    short: 'Ranking survives rerun',
    requirement: 'Large and repeated enough that the ranking cannot flip on rerun.',
    why: 'Overlapping confidence intervals over one unrepeated sweep order the rows by luck.',
  },
];

const outcomeClass: Record<GateOutcome, string> = {
  met: 'text-emerald-300',
  unmet: 'text-red-300',
  unproven: 'text-amber-300',
};
const outcomeMark: Record<GateOutcome, string> = { met: 'met', unmet: 'unmet', unproven: 'unproven' };

function cellCoverage(suite: (typeof suites)[number]): string {
  const { cellsGraded, cellsExpected } = suite.assessment;
  if (cellsExpected === null) return 'not broken out';
  return `${cellsGraded} / ${cellsExpected}`;
}

function shape(suite: (typeof suites)[number]): string {
  const { taskCount, configCount } = suite.assessment;
  if (taskCount === null || configCount === null) return `${suite.assessment.withheldRows} configurations`;
  return `${taskCount} × ${configCount}`;
}
---

<BaseLayout
  title="Agent benchmarks"
  description="Tangle measures agent configurations on held-out domain suites and publishes a ranking only when the run passes three gates: every cell graded, no harness failure, and a ranking that survives rerun. Every suite's current gate result is on this page."
>
  <section class="max-w-6xl mx-auto px-6 pt-32 pb-16">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight max-w-4xl">{headline}</h1>
    <div class="mt-6 max-w-3xl space-y-4 text-text-secondary leading-relaxed">
      <p>
        Each suite below grades an agent on held-out tasks in one domain, by executing what the agent
        produced against a hidden contract. No model scores its own work.
      </p>
      <p>
        A ranking is published only when its run passes three gates. Every suite here has a real
        measured run behind it, and every one of those runs fails or cannot prove at least one gate,
        so the scores stay in the run record and off this page. The gate result for each suite is
        computed from that record, not asserted beside it.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-4">
    <div class="border border-white/15 bg-white/[0.03] overflow-x-auto">
      <table class="w-full min-w-[56rem] text-left text-sm">
        <thead class="border-b border-white/15 text-xs uppercase tracking-wide text-text-muted">
          <tr>
            <th class="px-5 py-4 font-medium">Suite</th>
            <th class="px-5 py-4 font-medium">Run</th>
            <th class="px-5 py-4 font-medium">Tasks × configs</th>
            <th class="px-5 py-4 font-medium">Cells graded</th>
            <th class="px-5 py-4 font-medium">Reps</th>
            {gateColumns.map((column) => (
              <th class="px-5 py-4 font-medium" title={column.requirement}>{column.short}</th>
            ))}
          </tr>
        </thead>
        <tbody class="divide-y divide-white/10">
          {suites.map((suite) => (
            <tr class="hover:bg-white/[0.04] transition-colors">
              <td class="px-5 py-5">
                <a class="font-medium text-text-primary hover:text-indigo-200" href={`/benchmarks/${suite.id}`}>
                  {suite.domain}
                </a>
                <div class="mt-1 text-xs text-text-muted">{suite.category} · {suite.by}</div>
              </td>
              <td class="px-5 py-5 font-mono text-xs text-text-secondary whitespace-nowrap">
                {suite.assessment.runDate}
              </td>
              <td class="px-5 py-5 font-mono text-xs text-text-secondary whitespace-nowrap">{shape(suite)}</td>
              <td class="px-5 py-5 font-mono text-xs text-text-secondary whitespace-nowrap">{cellCoverage(suite)}</td>
              <td class="px-5 py-5 font-mono text-xs text-text-secondary">{suite.assessment.repetitions ?? '—'}</td>
              {gateColumns.map((column) => {
                const gate = suite.assessment.gates.find((entry) => entry.id === column.id)!;
                return (
                  <td class={`px-5 py-5 text-xs ${outcomeClass[gate.outcome]}`} title={gate.finding}>
                    {outcomeMark[gate.outcome]}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-text-muted">
      A cell is one task run by one agent configuration. <span class="text-amber-300">Unproven</span> means the
      run record does not carry the field that would decide the gate, which fails closed in the same way as
      <span class="text-red-300">unmet</span>. Open a suite for the measured finding behind each result.
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 pt-16 pb-24">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight">The three gates, and how many suites clear them</h2>
    <div class="mt-8 grid gap-px bg-white/15 md:grid-cols-3 border border-white/15">
      {gateColumns.map((column) => {
        const tally = gateTally(suites, column.id);
        return (
          <div class="bg-bg-dark p-6">
            <div class="font-mono text-2xl text-text-primary">{tally.met}<span class="text-text-muted"> / {tally.total}</span></div>
            <h3 class="mt-3 font-medium text-text-primary">{column.short}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-secondary">{column.requirement}</p>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">{column.why}</p>
          </div>
        );
      })}
    </div>
    <div class="mt-10 max-w-3xl space-y-4 text-text-secondary leading-relaxed">
      <p>
        The standard is recorded on
        <a class="text-indigo-300 hover:text-indigo-200" href="https://github.com/tangle-network/blueprint-agent" target="_blank" rel="noopener">blueprint-agent</a>
        and was applied when the earlier boards came down: a board that cannot prove all three from its own
        data does not publish. The gates run over each run record at build time, so a sweep that clears
        them publishes its ranking on the next deploy, and no edit to this site can publish one that does not.
      </p>
      <p>
        The method behind the scoring is written up in
        <a class="text-indigo-300 hover:text-indigo-200" href="/blog/agent-readiness-index-methodology">how these runs are scored and reported</a>.
      </p>
    </div>
  </section>
</BaseLayout>
