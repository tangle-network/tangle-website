---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BenchmarkReport from '../../components/BenchmarkReport.astro';
import BenchmarkExplorer from '../../components/BenchmarkExplorer.astro';
import { boardChartIdentities, boardReportInput, numberFigures, reportFigures } from '../../data/benchmarks/figures';
import { boards } from '../../data/benchmarks/index';

const board = boards[0];
const input = board ? boardReportInput(board) : null;
const figures = input ? numberFigures(reportFigures(input, { orientation: 'vertical', identities: boardChartIdentities(board) })) : null;
const suiteNames: Record<string, string> = {
  'meilisearch-apps': 'Meilisearch',
  'typesense-apps': 'Typesense',
};

const standard = [
  {
    title: 'Sealed before the first attempt',
    body: 'Each configuration fixes its harness, model, and tools. Tasks, grades, and comparisons are registered before the run.',
  },
  {
    title: 'Every cell repeated and graded',
    body: 'Every task runs at least twice with each configuration. The registered grader checks each attempt: runner tests, or App Grade operating the app in a browser. Missing or disputed grades prevent publication.',
  },
  {
    title: 'Costed from receipts',
    body: 'Cost per pass divides total model spend, including unsuccessful attempts, by successful attempts. Sandbox charges are excluded.',
  },
  {
    title: 'A ranking needs a supported comparison',
    body: 'Complete results can publish without a ranking. Ranking adjacent configurations requires registered comparisons whose bootstrap and exact paired-result intervals support the improvement at 95% confidence or higher.',
  },
];
---

<BaseLayout
  title="Agent benchmarks"
  description="Compare coding agents on the same tasks by success rate, model cost, and runtime."
>
  <BenchmarkReport wide>
    <Fragment slot="hero">
      <h1 class="bench-h1">Agent benchmarks</h1>

      {boards.length === 0 && <p class="bench-status">No results have passed publication review yet.</p>}
    </Fragment>

    {board && input && figures && (
      <section class="bench-section" id="boards">
        <nav class="benchmark-suites" aria-label="Benchmarks">
          {boards.map((suite) => <a href={`/benchmarks/${suite.suite.id}/`} aria-current={suite.suite.id === board.suite.id ? 'page' : undefined}>{suiteNames[suite.suite.id] ?? suite.suite.name}</a>)}
        </nav>
        <p class="bench-meta">
          {board.campaign.completedAt.slice(0, 10)} · {board.tasks.length} tasks · {board.campaign.repetitions} runs per task
          · {board.grader.kind === 'app-grade' ? `Pass: browser-tested app, grade ${board.grader.passTier} or better` : `Pass: ${board.grader.pass}`}
        </p>
        <BenchmarkExplorer input={input} figures={figures} />
        <p class="bench-small"><a href={`/benchmarks/${board.suite.id}/`}>Task inputs and source data</a></p>
      </section>
    )}

    <details class="bench-section bench-details" id="standard">
      <summary>Methodology</summary>
      <ol class="bench-steps">
        {standard.map((item, index) => (
          <li>
            <span class="bench-num">{String(index + 1).padStart(2, '0')} </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </details>

    <details class="bench-section bench-details" id="check">
      <summary>Verify the data</summary>
      <p class="bench-prose">
        Each board publishes its record as JSON, and the record's digest covers every field.
        The <a href="https://github.com/tangle-network/tangle-website/blob/master/src/data/benchmarks/board-record.ts">verifier</a> recomputes every total at build time and stops the build on any mismatch.
      </p>
      <ul>
        {boards.map((board) => <li><a href={`/benchmarks/${board.suite.id}.json`}>{board.suite.name}</a><br /><span class="bench-digest">{board.digest}</span></li>)}
      </ul>
    </details>
  </BenchmarkReport>
</BaseLayout>



<style>
  .benchmark-suites { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
  .benchmark-suites a { padding: 8px 12px; border: 1px solid var(--chart-rule); border-radius: 8px; font-size: 13px; text-decoration: none; }
  .benchmark-suites a[aria-current="page"] { color: var(--text-primary); background: var(--depth-3); border-color: var(--accent-text); }
  .bench-meta { margin-bottom: 20px; }
</style>
