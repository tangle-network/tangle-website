---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BenchmarkReport from '../../components/BenchmarkReport.astro';
import { boards } from '../../data/benchmarks/index';

const pct = (value: number) => `${(value * 100).toFixed(1)}%`;

const standard = [
  {
    title: 'Sealed before the first attempt',
    body: 'Tasks, setups, grader and comparisons are fixed in advance. An attempt outside that plan does not count.',
  },
  {
    title: 'Every cell repeated and graded',
    body: 'Every task runs at least twice with every setup, and every attempt gets one grade. A missing, duplicate, unknown-cost or quarantined attempt blocks the board.',
  },
  {
    title: 'Costed from receipts',
    body: 'Cost is the router-billed model spend of every attempt, passed or not. Sandbox charges are excluded.',
  },
  {
    title: 'Every rank step backed by a comparison',
    body: 'Adjacent setups need a registered comparison on the same tasks and runs. Its task-clustered and exact intervals must both clear the minimum effect registered in advance.',
  },
];
---

<BaseLayout
  title="Agent benchmarks"
  description="VerticalBench ranks pinned agent setups by the held-out tasks they pass and what each pass costs. A board publishes only when its campaign passes four checks."
>
  <BenchmarkReport>
    <Fragment slot="hero">
      <h1 class="bench-h1">Agent benchmarks</h1>
      <p class="bench-lede">
        VerticalBench ranks pinned agent setups by the held-out tasks they pass and what each pass costs.
        A setup is one harness, model, toolset and configuration.
      </p>
      <p class="bench-status">
        {boards.length === 0
          ? 'No board is published yet. A board appears when a campaign passes the four checks below.'
          : `${boards.length} ${boards.length === 1 ? 'board is' : 'boards are'} published. Each passed the four checks below.`}
      </p>
    </Fragment>

    {boards.length > 0 && (
      <section class="bench-section" id="boards">
        <h2 class="bench-h2">Boards</h2>
        <div class="bench-table">
          <table class="tgc-table">
            <thead>
              <tr>
                <th scope="col">Suite</th>
                <th scope="col" class="tgc-n">Completed</th>
                <th scope="col" class="tgc-n">Tasks × setups × runs</th>
                <th scope="col">First</th>
                <th scope="col" class="tgc-n">Pass rate (95% interval)</th>
              </tr>
            </thead>
            <tbody>
              {boards.map((board) => {
                const first = board.profiles[0]!;
                return (
                  <tr>
                    <th scope="row"><a href={`/benchmarks/${board.suite.id}/`}>{board.suite.name}</a></th>
                    <td class="tgc-n">{board.campaign.completedAt.slice(0, 10)}</td>
                    <td class="tgc-n">{board.tasks.length} × {board.profiles.length} × {board.campaign.repetitions}</td>
                    <td>{first.label}</td>
                    <td class="tgc-n">{pct(first.solveRate)} ({pct(first.interval.lower)}–{pct(first.interval.upper)})</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="bench-section" id="standard">
      <h2 class="bench-h2">What a board must prove</h2>
      <ol class="bench-steps">
        {standard.map((item, index) => (
          <li>
            <span class="bench-num">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="bench-section" id="check">
      <h2 class="bench-h2">How to check a board</h2>
      <p class="bench-prose">
        Each board publishes its record as JSON, and the record's digest covers every field.
        The <a href="https://github.com/tangle-network/tangle-website/blob/master/src/data/benchmarks/board-record.ts">verifier</a> recomputes every total at build time and stops the build on any mismatch.
      </p>
    </section>
  </BenchmarkReport>
</BaseLayout>
