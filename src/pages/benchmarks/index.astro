---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { boards } from '../../data/benchmarks/index';

const pct = (value: number) => `${(value * 100).toFixed(1)}%`;

const standard = [
  {
    title: 'Registered before it ran',
    body: 'The tasks, the agent profiles, the grader and the comparisons that order the ranking are sealed before the first attempt. An attempt run outside that plan does not count.',
  },
  {
    title: 'Every attempt graded, with repeated cells',
    body: 'Each task × setup cell runs at least twice, and every attempt receives one grade. One repetition cannot establish a stable rank. Missing, duplicate, unknown-cost, or quarantined attempts stop publication. The publisher also refuses comparisons without enough paired attempts to detect the registered minimum improvement.',
  },
  {
    title: 'Costed from receipts',
    body: 'Router receipts record model calls and their billed cost for each attempt. The board reports receipt-backed model-call cost per solved task. It excludes sandbox and support charges.',
  },
  {
    title: 'Each rank supported by its comparison',
    body: 'Each adjacent rank needs a registered comparison on the same tasks and repetitions. Two confidence intervals estimate the lead in solved-task rate: one groups paired outcomes by task, and one uses exact paired outcomes. Both lower bounds must exceed the minimum improvement registered before the campaign. The intervals use at least 95% confidence after adjustment for the planned comparisons.',
  },
];
---

<BaseLayout
  title="Agent benchmarks"
  description="VerticalBench compares named agent configurations on held-out tasks. A ranked board needs complete, repeated, graded, receipt-costed runs and a supported lead."
>
  <div class="bg-bg-dark">
  <section class="max-w-6xl mx-auto px-6 pt-32 pb-16">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight max-w-4xl">Agent benchmarks</h1>
    <p class="mt-6 max-w-3xl text-lg text-text-secondary leading-relaxed">
      VerticalBench compares pinned agent setups on held-out tasks. Each setup names a harness, model,
      tools, and configuration. A published board would show each setup's solve rate and receipt-backed
      model-call cost per solved task.
    </p>
    <p class="mt-4 max-w-3xl text-text-secondary leading-relaxed">
      {boards.length === 0
        ? 'No board is published yet. One repetition cannot establish a stable rank, so one-repetition results stay unranked. A board appears only when its campaign passes every check below.'
        : 'One repetition cannot establish a stable rank, so one-repetition results stay unranked. A board appears only when its campaign passes every check below, and shows only that campaign\'s recorded results.'}
    </p>
  </section>

  {boards.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pb-16">
      <div class="border border-white/15 bg-white/[0.03] overflow-x-auto">
        <table class="w-full min-w-[48rem] text-left text-sm">
          <thead class="border-b border-white/15 text-xs uppercase tracking-wide text-text-muted">
            <tr>
              <th class="px-5 py-4 font-medium">Suite</th>
              <th class="px-5 py-4 font-medium">Campaign</th>
              <th class="px-5 py-4 font-medium">Tasks × profiles × runs</th>
              <th class="px-5 py-4 font-medium">First place</th>
              <th class="px-5 py-4 font-medium">Solved</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            {boards.map((board) => {
              const leader = board.profiles[0]!;
              return (
                <tr class="hover:bg-white/[0.04] transition-colors">
                  <td class="px-5 py-5">
                    <a class="font-medium text-text-primary hover:text-indigo-200" href={`/benchmarks/${board.suite.id}`}>
                      {board.suite.name}
                    </a>
                  </td>
                  <td class="px-5 py-5 font-mono text-xs text-text-secondary whitespace-nowrap">
                    {board.campaign.completedAt.slice(0, 10)}
                  </td>
                  <td class="px-5 py-5 font-mono text-xs text-text-secondary whitespace-nowrap">
                    {board.tasks.length} × {board.profiles.length} × {board.campaign.repetitions}
                  </td>
                  <td class="px-5 py-5 text-text-primary">{leader.label}</td>
                  <td class="px-5 py-5 font-mono text-xs text-text-secondary whitespace-nowrap">
                    {pct(leader.solveRate)} <span class="text-text-muted">({pct(leader.interval.lower)}–{pct(leader.interval.upper)})</span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="max-w-6xl mx-auto px-6 pb-24">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight">What a campaign must prove to publish</h2>
    <div class="mt-8 grid gap-px bg-white/15 md:grid-cols-2 border border-white/15">
      {standard.map((item) => (
        <div class="bg-bg-dark p-6">
          <h3 class="font-medium text-text-primary">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">{item.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 max-w-3xl text-sm leading-relaxed text-text-muted">
      The <a href="https://github.com/tangle-network/tangle-website/blob/master/src/data/benchmarks/board-record.ts" class="underline hover:text-text-primary">board-record verifier</a> checks
      each published board's digest, task × setup cells, repeated attempts, receipts, and paired comparisons.
      A failed record stops the build. A campaign refused by the publisher writes no board, so it has no page here.
    </p>
  </section>
  </div>
</BaseLayout>
