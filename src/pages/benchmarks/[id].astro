---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BenchmarkReport from '../../components/BenchmarkReport.astro';
import BenchmarkExplorer from '../../components/BenchmarkExplorer.astro';
import BenchmarkTaskPrompts from '../../components/BenchmarkTaskPrompts.astro';
import { boards, boardById } from '../../data/benchmarks/index';
import { boardChartIdentities, boardReportInput, numberFigures, reportFigures } from '../../data/benchmarks/figures';
import { taskPromptsFor } from '../../data/benchmarks/task-sources';
import { benchmarkDescription } from '../../data/benchmarks/catalog';

export function getStaticPaths() {
  return boards.map((board) => ({ params: { id: board.suite.id } }));
}

const board = boardById(Astro.params.id!)!;
const { campaign, grader } = board;
const suiteTitles: Record<string, string> = {
  'meilisearch-apps': 'Meilisearch app benchmark',
  'typesense-apps': 'Typesense app benchmark',
};
const title = suiteTitles[board.suite.id] ?? board.suite.name;
const description = benchmarkDescription(board);
const tasks = taskPromptsFor(board);
const input = boardReportInput(board);
const figures = numberFigures(reportFigures(input, { orientation: 'vertical', identities: boardChartIdentities(board) }));
// A verified board always has a rate chart and a task grid to draw; a refusal
// there means the record and the library disagree, so the build stops.
for (const slot of [figures.board[0]!, figures.tasks[0]!]) {
  if ('refusal' in slot) throw new Error(`benchmark board ${board.suite.id}: ${slot.refusal.id} not drawn: ${slot.refusal.refused}`);
}

const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
const passRule = grader.kind === 'app-grade' ? `Pass: browser-tested app, App Grade ${grader.passTier} or better` : 'pass by runner verification';
const meta = [
  campaign.completedAt.slice(0, 10),
  `${plural(board.tasks.length, 'task')} × ${plural(board.profiles.length, 'setup')} × ${plural(campaign.repetitions, 'run')}`,
  passRule,
].join(' · ');
---

<BaseLayout
  title={title}
  description={description.description}
>
  <BenchmarkReport wide>
    <Fragment slot="hero">
      <a class="bench-back" href="/benchmarks/">All benchmarks</a>
      <h1 class="bench-h1">{title}</h1>
      <p class="benchmark-description">{description.description} <a href="#task-prompts">Tasks and sources</a></p>
      <p class="bench-meta">{meta}</p>
      <nav class="benchmark-suites" aria-label="Benchmarks">
        {boards.map((suite) => <a href={`/benchmarks/${suite.suite.id}/`} aria-current={suite.suite.id === board.suite.id ? 'page' : undefined}>{suiteTitles[suite.suite.id]?.replace(' app benchmark', '') ?? suite.suite.name}</a>)}
      </nav>
    </Fragment>

    <section class="bench-section" id="board">
      <BenchmarkExplorer figures={figures}>
        <BenchmarkTaskPrompts slot="tasks" tasks={tasks} />
      </BenchmarkExplorer>
    </section>

  </BenchmarkReport>
</BaseLayout>

<style>
  .benchmark-description { margin: 16px 0 0; max-width: 78ch; font-size: 18px; line-height: 1.6; color: var(--text-secondary); }
  .benchmark-description a { color: var(--accent-text); white-space: nowrap; text-underline-offset: 3px; }
  .benchmark-suites { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 20px; }
  .benchmark-suites a { padding: 10px 16px; border: 1px solid var(--chart-rule); border-radius: 8px; font-size: 17px; text-decoration: none; }
  .benchmark-suites a[aria-current="page"] { color: var(--text-primary); background: var(--depth-3); border-color: var(--accent-text); }
</style>
