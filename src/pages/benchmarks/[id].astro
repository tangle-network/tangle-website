---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BenchBar from '../../components/charts/BenchBar.tsx';
import { boards, boardById } from '../../data/benchmarks/index';

export function getStaticPaths() {
  return boards.map((b) => ({ params: { id: b.id } }));
}

const { id } = Astro.params;
const b = boardById(id!);
if (!b) return Astro.redirect('/benchmarks');
const statusLabel: Record<string, string> = { live: 'live', partial: 'partial', 'awaiting-run': 'awaiting run' };
---
<BaseLayout
  title={`${b.domain} benchmark`}
  description={`${b.domain}: ${b.blurb} Ranked leaderboard of agent profiles on held-out tasks.`}
  bodyClass="page-editorial"
>
  <section class="bd-hero">
    <div class="shell">
      <a class="bd-back" href="/benchmarks">← All benchmarks</a>
      <div class="bd-head">
        <div>
          <div class="bd-crumbs mono"><span class="bd-badge">{b.benchSource}</span><span>{b.category}</span></div>
          <h1>{b.domain}</h1>
          <p>{b.blurb}</p>
        </div>
        <dl class="bd-facts mono">
          <div><dt>profiles</dt><dd>{b.rows.length}</dd></div>
          <div><dt>tasks</dt><dd>{b.taskCount ?? '—'}</dd></div>
          <div><dt>metric</dt><dd class="bd-metric">{b.metricLabel ?? '—'}</dd></div>
          <div><dt>status</dt><dd class={`s-${b.status}`}>{statusLabel[b.status]}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="bd-body">
    <div class="shell">
      <div class="bd-chart">
        <BenchBar client:visible rows={b.rows} metricLabel={b.metricLabel ?? 'Score'} />
      </div>
      <footer class="bd-meta mono">
        <span>source: {b.source}</span>
        {b.lastRun && <span>· last run {b.lastRun}</span>}
      </footer>
    </div>
  </section>
</BaseLayout>
<style>
  .shell { width: min(72rem, 92vw); margin: 0 auto; }
  .mono { font-family: var(--font-mono); font-feature-settings: 'tnum'; }

  .bd-hero { background: var(--paper-1); padding: 2.5rem 0 3rem; border-bottom: 1px solid var(--hairline-light); }
  .bd-back { color: #4F46E5; font-size: 0.9rem; text-decoration: none; font-weight: 500; }
  .bd-back:hover { color: #4338CA; }
  .bd-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; margin-top: 1.5rem; flex-wrap: wrap; }
  .bd-crumbs { display: flex; align-items: center; gap: 0.6rem; color: var(--ink-muted); font-size: 0.82rem; }
  .bd-badge { color: #4F46E5; background: rgba(79,70,229,0.1); border: 1px solid rgba(79,70,229,0.25); padding: 0.18rem 0.5rem; border-radius: 6px; text-transform: uppercase; font-size: 0.66rem; letter-spacing: 0.03em; }
  .bd-head h1 { margin: 0.6rem 0 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.03em; color: var(--ink); font-size: clamp(2.2rem, 4vw, 3.2rem); }
  .bd-head p { margin: 0.7rem 0 0; color: var(--ink-secondary); font-size: 1.15rem; line-height: 1.55; max-width: 44rem; }
  .bd-facts { display: flex; border: 1px solid var(--hairline-light); border-radius: 12px; overflow: hidden; flex-shrink: 0; background: #fff; }
  .bd-facts div { padding: 0.8rem 1.2rem; }
  .bd-facts div + div { border-left: 1px solid var(--hairline-light); }
  .bd-facts dt { margin: 0; color: var(--ink-muted); font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .bd-facts dd { margin: 0.3rem 0 0; color: var(--ink); font-size: 1.25rem; font-weight: 600; }
  .bd-facts dd.s-partial { color: #4F46E5; } .bd-facts dd.s-awaiting-run { color: var(--ink-muted); } .bd-facts dd.s-live { color: #047857; }
  .bd-facts dd.bd-metric { font-size: 0.82rem; font-weight: 500; color: var(--ink-secondary); max-width: 8rem; line-height: 1.2; }

  .bd-body { background: var(--paper-0); padding: 3rem 0 6rem; min-height: 50vh; }
  .bd-chart { background: #fff; border: 1px solid var(--hairline-light); border-radius: 16px; padding: 1.8rem 2rem 1.6rem; box-shadow: 0 12px 40px rgba(25,28,60,0.06); }
  .bd-meta { margin-top: 1.4rem; color: var(--ink-muted); font-size: 0.82rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }

  /* Vertical column chart (BenchBar island -> global), light editorial theme */
  .bd-chart :global(.vbb-controls) { display: flex; justify-content: flex-end; align-items: center; margin-bottom: 1.6rem; }
  .bd-chart :global(.vbb-sort) { display: flex; gap: 0.35rem; align-items: center; }
  .bd-chart :global(.vbb-sort button) { background: var(--paper-1); border: 1px solid var(--hairline-light); color: var(--ink-secondary); font-family: inherit; font-size: 0.76rem; padding: 0.2rem 0.55rem; border-radius: 6px; cursor: pointer; }
  .bd-chart :global(.vbb-sort button.on) { background: #4f46e5; border-color: #4f46e5; color: #fff; }

  /* Scientific plot: a fixed-height band on a TRUE 0-100% axis. Bars, gridlines,
     ticks, target and CI whiskers all position by `bottom: <pct>%` inside the
     band, where 0% = 0 accuracy and 100% = full accuracy. No axis truncation. */
  .bd-chart :global(.vbb-plot) { --band: 17rem; --gutter: 2.2rem; position: relative; padding: 1.9rem 0 0 var(--gutter); }
  .bd-chart :global(.vbb-ytitle) { position: absolute; left: -0.2rem; top: 50%; transform: rotate(-90deg) translateX(50%); transform-origin: left center; color: var(--ink-muted); font-size: 0.66rem; letter-spacing: 0.04em; white-space: nowrap; }
  .bd-chart :global(.vbb-band) { position: relative; height: var(--band); }
  /* horizontal gridlines + y tick labels at each 20% stop */
  .bd-chart :global(.vbb-grid) { position: absolute; left: 0; right: 0; height: 0; border-top: 1px solid var(--hairline-light); }
  .bd-chart :global(.vbb-grid:first-child) { border-top-color: var(--ink-muted); opacity: 0.5; }
  .bd-chart :global(.vbb-tick) { position: absolute; left: calc(-1 * var(--gutter)); bottom: -0.55rem; width: calc(var(--gutter) - 0.4rem); text-align: right; color: var(--ink-muted); font-size: 0.64rem; }
  /* columns fill the band; bars anchored to the 0% baseline */
  .bd-chart :global(.vbb-cols) { position: absolute; inset: 0; display: flex; align-items: flex-end; justify-content: flex-start; gap: 0.9rem; z-index: 2; }
  .bd-chart :global(.vbb-col) { position: relative; width: 3.6rem; height: 100%; display: flex; align-items: flex-end; justify-content: center; }
  .bd-chart :global(.vbb-bar) { position: relative; width: 3.4rem; border-radius: 5px 5px 0 0; min-height: 2px; transition: height 0.9s cubic-bezier(0.2,0.7,0.2,1), filter 0.12s; }
  .bd-chart :global(.vbb-col.hover) :global(.vbb-bar) { filter: brightness(0.94); }
  .bd-chart :global(.vbb-val) { position: absolute; top: -1.5rem; left: 50%; transform: translateX(-50%); color: var(--ink); font-size: 0.88rem; font-weight: 700; }
  /* 95% CI whisker, centered on the column, in band coordinates */
  .bd-chart :global(.vbb-err) { position: absolute; left: 50%; width: 0; border-left: 1.5px solid rgba(25,28,60,0.55); transform: translateX(-50%); z-index: 4; }
  .bd-chart :global(.vbb-cap) { position: absolute; left: 50%; transform: translateX(-50%); width: 0.7rem; border-top: 1.5px solid rgba(25,28,60,0.55); }
  .bd-chart :global(.vbb-cap-hi) { top: 0; } .bd-chart :global(.vbb-cap-lo) { bottom: 0; }
  /* feet: labels below the band, same column widths + gap so they align */
  .bd-chart :global(.vbb-feet) { display: flex; justify-content: flex-start; gap: 0.9rem; padding-top: 0.7rem; }
  .bd-chart :global(.vbb-foot) { width: 3.6rem; display: flex; flex-direction: column; align-items: center; gap: 0.28rem; }
  .bd-chart :global(.vbb-logo) { width: 1.5rem; height: 1.5rem; object-fit: contain; border-radius: 5px; background: #fff; border: 1px solid var(--hairline-light); padding: 3px; }
  .bd-chart :global(.vbb-name) { color: var(--ink); font-size: 0.76rem; font-weight: 600; text-align: center; line-height: 1.15; max-width: 5rem; word-break: break-word; }
  .bd-chart :global(.vbb-pv) { color: var(--ink-muted); font-size: 0.6rem; text-align: center; line-height: 1.1; }
  .bd-chart :global(.vbb-n) { color: var(--ink-muted); font-size: 0.6rem; opacity: 0.8; }
  .bd-chart :global(.vbb-tip) { position: absolute; bottom: calc(100% + 0.5rem); left: 50%; transform: translateX(-50%); z-index: 9; background: #1a1936; border: 1px solid rgba(129,140,248,0.4); border-radius: 10px; padding: 0.8rem 1rem; box-shadow: 0 14px 40px rgba(25,28,60,0.25); min-width: 14rem; }
  .bd-chart :global(.vbb-tip-h) { color: #fff; font-size: 0.85rem; font-weight: 700; margin-bottom: 0.5rem; white-space: nowrap; }
  .bd-chart :global(.vbb-tip-grid) { display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 1rem; font-size: 0.78rem; }
  .bd-chart :global(.vbb-tip-grid span) { color: #9a9ac2; }
  .bd-chart :global(.vbb-tip-grid b) { color: #fff; text-align: right; }
  .bd-chart :global(.vbb-note) { margin: 1.4rem 0 0; color: var(--ink-muted); font-size: 0.72rem; line-height: 1.5; }
  .bd-chart :global(.bb-empty) { border: 1px dashed var(--hairline-light); border-radius: 14px; padding: 3rem 2rem; text-align: center; }
  .bd-chart :global(.bb-empty-badge) { display: inline-block; font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-muted); background: var(--paper-2); padding: 0.25rem 0.7rem; border-radius: 999px; }
  .bd-chart :global(.bb-empty p) { margin: 1rem auto 0; color: var(--ink-secondary); font-size: 0.95rem; line-height: 1.55; max-width: 34rem; }
  @media (max-width: 680px) {
    .bd-chart :global(.vbb-cols), .bd-chart :global(.vbb-feet) { gap: 0.5rem; }
    .bd-chart :global(.vbb-col), .bd-chart :global(.vbb-foot) { width: 2.6rem; }
    .bd-chart :global(.vbb-bar) { width: 2.4rem; }
    .bd-chart :global(.vbb-name) { font-size: 0.62rem; }
  }
</style>
