---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BenchBar from '../../components/charts/BenchBar.tsx';
import { boards, boardById } from '../../data/benchmarks/index';

export function getStaticPaths() {
  return boards.map((b) => ({ params: { id: b.id } }));
}

const { id } = Astro.params;
const b = boardById(id!);
if (!b) return Astro.redirect('/benchmarks');
const statusLabel: Record<string, string> = { live: 'live', partial: 'partial', 'awaiting-run': 'awaiting run' };
---
<BaseLayout
  title={`${b.domain} benchmark`}
  description={`${b.domain}: ${b.blurb} Ranked leaderboard of agent profiles on held-out tasks.`}
>
  <section class="bd-hero">
    <div class="shell">
      <a class="bd-back" href="/benchmarks">← All benchmarks</a>
      <div class="bd-head">
        <div>
          <div class="bd-crumbs mono"><span class="bd-badge">{b.benchSource}</span><span>{b.category}</span></div>
          <h1>{b.domain}</h1>
          <p>{b.blurb}</p>
        </div>
        <dl class="bd-facts mono">
          <div><dt>profiles</dt><dd>{b.rows.length}</dd></div>
          <div><dt>tasks</dt><dd>{b.taskCount ?? '—'}</dd></div>
          <div><dt>target</dt><dd>{(b.target * 100).toFixed(0)}</dd></div>
          <div><dt>status</dt><dd class={`s-${b.status}`}>{statusLabel[b.status]}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="bd-body">
    <div class="shell">
      <div class="bd-chart">
        <BenchBar client:visible rows={b.rows} target={b.target} metricLabel={b.metricLabel ?? 'Score'} />
      </div>
      <footer class="bd-meta mono">
        <span>source: {b.source}</span>
        {b.lastRun && <span>· last run {b.lastRun}</span>}
      </footer>
    </div>
  </section>
</BaseLayout>

<style>
  .shell { width: min(72rem, 92vw); margin: 0 auto; }
  .mono { font-family: var(--font-mono); font-feature-settings: 'tnum'; }

  .bd-hero { background: #0c0b1d; padding: 2.5rem 0 3rem; border-bottom: 1px solid rgba(199,201,238,0.1); }
  .bd-back { color: #818cf8; font-size: 0.9rem; text-decoration: none; }
  .bd-back:hover { color: #a5aafc; }
  .bd-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; margin-top: 1.5rem; flex-wrap: wrap; }
  .bd-crumbs { display: flex; align-items: center; gap: 0.6rem; color: #8888b0; font-size: 0.82rem; }
  .bd-badge { color: #a5aafc; background: rgba(129,140,248,0.12); border: 1px solid rgba(129,140,248,0.25); padding: 0.18rem 0.5rem; border-radius: 6px; text-transform: uppercase; font-size: 0.66rem; letter-spacing: 0.03em; }
  .bd-head h1 { margin: 0.6rem 0 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.03em; color: #fff; font-size: clamp(2.2rem, 4vw, 3.2rem); }
  .bd-head p { margin: 0.7rem 0 0; color: rgba(237,237,244,0.72); font-size: 1.15rem; line-height: 1.55; max-width: 44rem; }
  .bd-facts { display: flex; border: 1px solid rgba(199,201,238,0.14); border-radius: 12px; overflow: hidden; flex-shrink: 0; }
  .bd-facts div { padding: 0.8rem 1.2rem; }
  .bd-facts div + div { border-left: 1px solid rgba(199,201,238,0.12); }
  .bd-facts dt { margin: 0; color: #6f6f97; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .bd-facts dd { margin: 0.3rem 0 0; color: #ededf4; font-size: 1.25rem; font-weight: 600; }
  .bd-facts dd.s-partial { color: #c7c9f5; } .bd-facts dd.s-awaiting-run { color: #9a9ac2; } .bd-facts dd.s-live { color: #6ee7b7; }

  .bd-body { background: #080814; padding: 3rem 0 6rem; min-height: 50vh; }
  .bd-meta { margin-top: 1.6rem; color: #6f6f97; font-size: 0.82rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }

  /* BenchBar island -> global */
  .bd-chart :global(.bb-controls) { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.4rem; flex-wrap: wrap; gap: 1rem; }
  .bd-chart :global(.bb-axis-label) { color: #8888b0; font-family: var(--font-mono); font-size: 0.82rem; }
  .bd-chart :global(.bb-sort) { color: #6f6f97; font-size: 0.8rem; display: flex; gap: 0.35rem; align-items: center; }
  .bd-chart :global(.bb-sort button) { background: rgba(129,140,248,0.08); border: 1px solid rgba(129,140,248,0.2); color: #9a9ac2; font-family: inherit; font-size: 0.76rem; padding: 0.2rem 0.55rem; border-radius: 6px; cursor: pointer; }
  .bd-chart :global(.bb-sort button.on) { background: #4f46e5; border-color: #6d63ff; color: #fff; }

  /* one continuous plot: --gutter = label column, chart area is shared */
  .bd-chart :global(.bb-plot) { --gutter: 16rem; position: relative; padding-bottom: 1.6rem; }
  /* full-height gridlines + target rule across every bar */
  .bd-chart :global(.bb-grid) { position: absolute; left: var(--gutter); right: 0; top: 0; bottom: 1.6rem; pointer-events: none; }
  .bd-chart :global(.bb-gridline) { position: absolute; top: 0; bottom: 1.1rem; width: 1px; background: rgba(199,201,238,0.08); }
  .bd-chart :global(.bb-gridval) { position: absolute; bottom: -1.1rem; left: 0; transform: translateX(-50%); color: #6f6f97; font-size: 0.72rem; }
  .bd-chart :global(.bb-targetrule) { position: absolute; top: -0.2rem; bottom: 1.1rem; width: 2px; background: rgba(199,201,238,0.45); }
  .bd-chart :global(.bb-targetlbl) { position: absolute; top: -1.15rem; left: 50%; transform: translateX(-50%); white-space: nowrap; color: #a5aafc; font-size: 0.68rem; }

  .bd-chart :global(.bb-bar) { position: relative; display: grid; grid-template-columns: var(--gutter) 1fr; align-items: center; height: 2.4rem; }
  .bd-chart :global(.bb-bar.hover) :global(.bb-track), .bd-chart :global(.bb-bar.hover) { }
  .bd-chart :global(.bb-y) { display: flex; align-items: baseline; gap: 0.5rem; padding-right: 1rem; overflow: hidden; }
  .bd-chart :global(.bb-rank) { color: #6f6f97; font-size: 0.82rem; flex: none; width: 1.2rem; }
  .bd-chart :global(.bb-model) { color: #ededf4; font-size: 0.95rem; font-weight: 600; white-space: nowrap; }
  .bd-chart :global(.bb-tag) { color: #8888b0; font-size: 0.7rem; padding: 0.08rem 0.38rem; border-radius: 5px; background: rgba(129,140,248,0.1); white-space: nowrap; }
  /* the bar track spans the shared chart area; bars align on one axis */
  .bd-chart :global(.bb-track) { position: relative; height: 1.4rem; }
  .bd-chart :global(.bb-fill) { height: 100%; border-radius: 0 4px 4px 0; display: flex; align-items: center; justify-content: flex-end; padding-right: 0.5rem; min-width: 2.4rem; transition: width 0.9s cubic-bezier(0.2,0.7,0.2,1); }
  .bd-chart :global(.bb-bar.hover) :global(.bb-fill) { filter: brightness(1.15); }
  .bd-chart :global(.bb-val) { color: #0b0b1c; font-size: 0.8rem; font-weight: 700; }
  .bd-chart :global(.bb-tip) { position: absolute; right: 0; top: calc(100% - 0.2rem); z-index: 8; background: #1a1936; border: 1px solid rgba(129,140,248,0.4); border-radius: 10px; padding: 0.8rem 1rem; box-shadow: 0 14px 40px rgba(0,0,0,0.6); min-width: 15rem; }
  .bd-chart :global(.bb-tip-h) { color: #fff; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.5rem; }
  .bd-chart :global(.bb-tip-grid) { display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 1rem; font-size: 0.78rem; }
  .bd-chart :global(.bb-tip-grid span) { color: #8888b0; }
  .bd-chart :global(.bb-tip-grid b) { color: #ededf4; text-align: right; }
  .bd-chart :global(.bb-empty) { border: 1px dashed rgba(199,201,238,0.2); border-radius: 14px; padding: 3rem 2rem; text-align: center; }
  .bd-chart :global(.bb-empty-badge) { display: inline-block; font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: #9a9ac2; background: rgba(94,94,122,0.25); padding: 0.25rem 0.7rem; border-radius: 999px; }
  .bd-chart :global(.bb-empty p) { margin: 1rem auto 0; color: #82829e; font-size: 0.95rem; line-height: 1.55; max-width: 34rem; }
  @media (max-width: 680px) {
    .bd-chart :global(.bb-plot) { --gutter: 9rem; }
    .bd-chart :global(.bb-model) { font-size: 0.85rem; }
    .bd-chart :global(.bb-y) :global(.bb-tag) { display: none; }
  }
</style>
