---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { assessedSuites, suiteById } from '../../data/benchmarks/index';
import type { GateOutcome } from '../../data/benchmarks/standard';

export function getStaticPaths() {
  return assessedSuites.map((suite) => ({ params: { id: suite.id } }));
}

const { id } = Astro.params;
const suite = suiteById(id!);
if (!suite) return Astro.redirect('/benchmarks');

const { assessment } = suite;
const blocked = assessment.gates.filter((gate) => gate.outcome !== 'met');
// Spelled out, because "3 of the three gates" reads as a typo. There are always
// exactly three gates, so this covers every case a page can render.
const blockedPhrase =
  blocked.length === 3
    ? 'none of the three gates is met'
    : blocked.length === 2
      ? 'two of the three gates are not met'
      : 'one of the three gates is not met';

// Rendered only when every gate is met; sorted here so the table order is the
// ranking the gates were tested against, not the record's file order.
const ranking = assessment.publishes ? [...suite.run.rows].sort((a, b) => b.score - a.score) : [];
const pct = (value: number) => `${(value * 100).toFixed(1)}%`;

const outcomeClass: Record<GateOutcome, string> = {
  met: 'text-emerald-300 border-emerald-300/40',
  unmet: 'text-red-300 border-red-300/40',
  unproven: 'text-amber-300 border-amber-300/40',
};

const facts: { label: string; value: string; counts: string }[] = [
  {
    label: 'Run recorded',
    value: assessment.runDate,
    counts: 'the date the sweep was exported to this record',
  },
  {
    label: 'Held-out tasks',
    value: assessment.taskCount === null ? 'not broken out' : String(assessment.taskCount),
    counts: 'distinct tasks in the suite, each graded independently',
  },
  {
    label: 'Agent configurations',
    value: assessment.configCount === null ? String(assessment.withheldRows) : String(assessment.configCount),
    counts: 'distinct AgentProfile × runLoop × execution-environment combinations swept',
  },
  {
    label: 'Cells graded',
    value:
      assessment.cellsExpected === null
        ? 'not broken out'
        : `${assessment.cellsGraded} of ${assessment.cellsExpected}`,
    counts: 'task × configuration pairs that carry a grade, out of the pairs the sweep should contain',
  },
  {
    label: 'Cells with no model call',
    value: assessment.cellsGraded === 0 ? 'not recorded' : String(assessment.cellsWithoutModelCall),
    counts: 'graded cells that recorded zero input and zero output tokens',
  },
  {
    label: 'Repetitions per cell',
    value: assessment.repetitions === null ? 'not recorded' : String(assessment.repetitions),
    counts: 'times each task × configuration pair was run',
  },
  assessment.publishes
    ? {
        label: 'Scored configurations published',
        value: String(assessment.withheldRows),
        counts: `rows in the run record with a measured ${suite.metricLabel.toLowerCase()}, all of them ranked above`,
      }
    : {
        label: 'Scored configurations withheld',
        value: String(assessment.withheldRows),
        counts: `rows in the run record with a measured ${suite.metricLabel.toLowerCase()}, none of them published`,
      },
];
---

<BaseLayout
  title={`${suite.domain} benchmark`}
  description={`${suite.domain}: what the suite grades, the coverage its last run achieved, and which publishing gate is keeping its ranking unpublished.`}
>
  <section class="max-w-4xl mx-auto px-6 pt-32 pb-12">
    <a class="text-sm text-indigo-300 hover:text-indigo-200" href="/benchmarks">All benchmarks</a>
    <h1 class="mt-6 text-4xl md:text-5xl font-bold tracking-tight">{suite.domain}</h1>
    <p class="mt-6 text-lg text-text-secondary leading-relaxed">{suite.blurb}</p>
    <p class="mt-6 text-text-secondary leading-relaxed">
      {assessment.publishes
        ? `This run clears all three publishing gates, so its ranking is published below.`
        : `No ranking is published for this suite. Its run record holds ${assessment.withheldRows} scored configurations, and ${blockedPhrase}, so no score and no ordering from it appears on this page.`}
    </p>
    {(suite.sourceUrl || suite.paperUrl) && (
      <div class="mt-6 flex flex-wrap gap-6 text-sm">
        {suite.sourceUrl && (
          <a class="text-indigo-300 hover:text-indigo-200" href={suite.sourceUrl} target="_blank" rel="noopener">
            {suite.by} on GitHub
          </a>
        )}
        {suite.paperUrl && (
          <a class="text-indigo-300 hover:text-indigo-200" href={suite.paperUrl} target="_blank" rel="noopener">
            The paper behind the suite
          </a>
        )}
      </div>
    )}
  </section>

  {assessment.publishes && (
    <section class="max-w-4xl mx-auto px-6 pb-16">
      <h2 class="text-2xl font-bold tracking-tight">Ranking</h2>
      <div class="mt-6 overflow-x-auto border border-white/15 bg-white/[0.03]">
        <table class="w-full text-sm">
          <thead class="text-left text-xs uppercase tracking-wide text-text-muted">
            <tr class="border-b border-white/10">
              <th class="px-5 py-3">#</th>
              <th class="px-5 py-3">Configuration</th>
              <th class="px-5 py-3">{suite.metricLabel}</th>
              <th class="px-5 py-3">95% interval</th>
              <th class="px-5 py-3">Graded tasks</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            {ranking.map((row, index) => (
              <tr>
                <td class="px-5 py-3 font-mono text-text-muted">{index + 1}</td>
                <td class="px-5 py-3 text-text-primary">
                  {row.model}{row.harness ? <span class="text-text-muted"> · {row.harness}</span> : null}
                </td>
                <td class="px-5 py-3 font-mono text-text-primary">{pct(row.score)}</td>
                <td class="px-5 py-3 font-mono text-text-secondary">
                  {row.ciLow != null && row.ciHigh != null ? `${pct(row.ciLow)}–${pct(row.ciHigh)}` : '—'}
                </td>
                <td class="px-5 py-3 font-mono text-text-secondary">{row.n}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs leading-relaxed text-text-muted">
        Ordered by {suite.metricLabel.toLowerCase()}. Every row cleared the three gates below on this run.
      </p>
    </section>
  )}

  <section class="max-w-4xl mx-auto px-6 pb-16">
    <h2 class="text-2xl font-bold tracking-tight">How one task is graded</h2>
    <p class="mt-4 text-text-secondary leading-relaxed">{suite.scoredBy}</p>
  </section>

  <section class="max-w-4xl mx-auto px-6 pb-16">
    <h2 class="text-2xl font-bold tracking-tight">What the last run covered</h2>
    <div class="mt-6 border border-white/15 bg-white/[0.03] divide-y divide-white/10">
      {facts.map((fact) => (
        <div class="grid gap-1 px-5 py-4 sm:grid-cols-[14rem_7rem_1fr] sm:items-baseline sm:gap-5">
          <div class="text-sm font-medium text-text-primary">{fact.label}</div>
          <div class="font-mono text-sm text-text-primary">{fact.value}</div>
          <div class="text-xs leading-relaxed text-text-muted">{fact.counts}</div>
        </div>
      ))}
    </div>
    {suite.coverageNote && (
      <div class="mt-6 border-l-2 border-amber-300/50 pl-5">
        <p class="text-sm leading-relaxed text-text-secondary">
          <span class="text-amber-300">Recorded outside the run record.</span> {suite.coverageNote}
        </p>
      </div>
    )}
  </section>

  <section class="max-w-4xl mx-auto px-6 pb-24">
    <h2 class="text-2xl font-bold tracking-tight">The three gates against this run</h2>
    <div class="mt-6 space-y-px bg-white/15 border border-white/15">
      {assessment.gates.map((gate) => (
        <div class="bg-bg-dark p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h3 class="font-medium text-text-primary">{gate.requirement}</h3>
            <span class={`shrink-0 border px-2 py-0.5 text-xs uppercase tracking-wide ${outcomeClass[gate.outcome]}`}>
              {gate.outcome}
            </span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">{gate.finding}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 max-w-2xl text-sm leading-relaxed text-text-muted">
      {assessment.publishes
        ? `Each result above is computed from this suite's run record when the site is built. The ranking stays published only while every gate stays met on the latest run.`
        : `Each result above is computed from this suite's run record when the site is built. Rerunning the sweep so that every cell is graded, no cell loses its model call, and the top row separates from the runner-up over repeated passes is what publishes the ranking here.`}
    </p>
  </section>
</BaseLayout>
