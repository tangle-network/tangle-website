---
import BaseLayout from '../layouts/BaseLayout.astro';

const releases = [
  {
    date: '2026-09-16',
    title: 'Benchmark boards removed',
    body: 'Removed the agent benchmark boards. Some runs had no recorded result or failed before the agent made a model call, and no board had enough tasks and repeated runs to give a stable ranking. A board will be published again only when every run completes and receives a valid grade.',
    links: [
      { label: 'Benchmark methodology', href: '/blog/agent-readiness-index-methodology' },
    ],
  },
  {
    date: '2026-07-28',
    title: 'Service transparency update',
    body: 'Added pages where customers can check current service health, review security practices, and inspect current privacy and service terms.',
    links: [
      { label: 'Service status', href: '/status/' },
      { label: 'Security information', href: '/security/' },
      { label: 'Privacy Policy', href: '/privacy-policy' },
      { label: 'Terms of Service', href: '/terms-of-service' },
    ],
  },
  {
    date: '2026-07-27',
    title: 'Website and benchmarks update',
    body: 'Refreshed the agent benchmark boards and published the method for comparing whether coding agents implement current public API behavior.',
    links: [
      { label: 'Readiness methodology', href: '/blog/agent-readiness-index-methodology' },
    ],
  },
];
---

<BaseLayout title="Release Notes" description="Public updates to Tangle services and website.">
  <section class="max-w-3xl mx-auto px-6 pt-32 pb-24">
    <p class="text-sm font-medium text-indigo-300 mb-4">Release notes</p>
    <h1 class="text-4xl md:text-5xl font-bold">Public updates</h1>
    <p class="mt-5 text-text-secondary leading-relaxed">Tangle provides infrastructure for running and evaluating AI agents. For teams evaluating or operating those services, these notes list public changes from newest to oldest so you can check what changed before relying on a service, policy, benchmark, or guide. For code-level changelogs, inspect the Tangle <a class="underline text-text-primary" href="https://github.com/tangle-network">GitHub organization</a>.</p>

    <ol class="mt-16 border-l border-white/15">
      {releases.map((release) => (
        <li class="relative pl-8 pb-12 last:pb-0">
          <span class="absolute -left-[5px] top-2 block h-[9px] w-[9px] rounded-full bg-indigo-300"></span>
          <time class="font-mono text-xs text-text-muted">{release.date}</time>
          <h2 class="mt-2 text-xl font-semibold text-text-primary">{release.title}</h2>
          <p class="mt-3 text-text-secondary leading-relaxed">{release.body}</p>
          <p class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
            {release.links.map((link) => <a class="underline text-text-primary" href={link.href}>{link.label}</a>)}
          </p>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
