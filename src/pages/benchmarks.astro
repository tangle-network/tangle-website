---
import BaseLayout from '../layouts/BaseLayout.astro';
import DomainBar from '../components/charts/DomainBar.tsx';
import { benchmarks } from '../data/benchmarks/index';
---
<BaseLayout
  title="Agent benchmarks"
  description="How Tangle agents score on real task domains: tax, legal, creative, and vertical app builds. Held-out evaluations, honest provenance, no invented numbers."
>
  <section class="bm-hero">
    <div class="shell">
      <h1>Agent benchmarks.</h1>
      <p>How Tangle agents score on real task domains. Every number here comes from a held-out eval run, with its source and sample size attached. Domains without a trustworthy baseline are shown as pending, not padded.</p>
    </div>
  </section>

  <section class="bm-body">
    <div class="shell">
      {benchmarks.map((b) => (
        <article class="bm-card">
          <header class="bm-card-head">
            <div>
              <h2>{b.title}</h2>
              <p class="bm-sub">{b.subtitle}</p>
            </div>
            <div class="bm-profile mono">
              {b.agentProfile.harness && <span class="bm-chip">{b.agentProfile.harness}</span>}
              {b.agentProfile.model && <span class="bm-chip dim">{b.agentProfile.model}</span>}
            </div>
          </header>

          <div class="bm-chart">
            <DomainBar
              client:visible
              domains={b.domains.length ? b.domains : undefined}
              layers={b.layers && b.layers.length ? b.layers : undefined}
              showTarget={b.domains.length > 0}
            />
          </div>

          <footer class="bm-meta mono">
            <span>source: {b.source}</span>
            {b.date && <span>· {b.date}</span>}
            {b.sessionCount && <span>· {b.sessionCount} sessions</span>}
            <p class="bm-method">{b.method}</p>
          </footer>
        </article>
      ))}

      <p class="bm-note mono">More domains land as their eval runs publish. This page is generated from a typed benchmark format, so each new run is a data drop, not a rebuild.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .shell { width: min(72rem, 92vw); margin: 0 auto; }
  .mono { font-family: var(--font-mono); font-feature-settings: 'tnum'; }

  .bm-hero { background: #0c0b1d; padding: 5rem 0 3rem; border-bottom: 1px solid rgba(199,201,238,0.1); }
  .bm-hero h1 { margin: 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.035em; color: #fff; font-size: clamp(2.4rem, 4.5vw, 3.8rem); }
  .bm-hero p { margin: 1.1rem 0 0; color: rgba(237,237,244,0.72); font-size: clamp(1.1rem, 1.4vw, 1.3rem); line-height: 1.6; max-width: 46rem; }

  .bm-body { background: #080814; padding: 3.5rem 0 6rem; }
  .bm-card { background: #100f24; border: 1px solid rgba(199,201,238,0.14); border-radius: 16px; padding: 1.8rem 1.9rem 1.5rem; margin-bottom: 1.5rem; }
  .bm-card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; margin-bottom: 1.6rem; flex-wrap: wrap; }
  .bm-card-head h2 { margin: 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em; color: #fff; font-size: 1.45rem; }
  .bm-sub { margin: 0.4rem 0 0; color: #9a9ac2; font-size: 1rem; line-height: 1.5; }
  .bm-profile { display: flex; gap: 0.4rem; flex-shrink: 0; }
  .bm-chip { padding: 0.32rem 0.7rem; border-radius: 8px; background: rgba(129,140,248,0.12); border: 1px solid rgba(129,140,248,0.28); color: #c7c9f5; font-size: 0.8rem; }
  .bm-chip.dim { background: transparent; color: #8888b0; }

  .bm-meta { margin-top: 1.6rem; padding-top: 1.1rem; border-top: 1px solid rgba(199,201,238,0.1); color: #6f6f97; font-size: 0.82rem; display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: baseline; }
  .bm-method { width: 100%; margin: 0.5rem 0 0; color: #82829e; line-height: 1.5; }
  .bm-note { margin-top: 2rem; color: #6f6f97; font-size: 0.85rem; text-align: center; }

  /* chart (styles the React island, so global) */
  .bm-chart :global(.dbar) { display: flex; flex-direction: column; gap: 0.75rem; }
  .bm-chart :global(.dbar-row) { display: grid; grid-template-columns: 11rem 1fr; align-items: center; gap: 1rem; position: relative; }
  .bm-chart :global(.dbar-label) { color: #ededf4; font-size: 0.98rem; font-weight: 500; text-align: right; }
  .bm-chart :global(.dbar-track) { position: relative; height: 2.2rem; background: rgba(129,140,248,0.06); border: 1px solid rgba(129,140,248,0.12); border-radius: 8px; overflow: hidden; }
  .bm-chart :global(.dbar-fill) { height: 100%; border-radius: 7px 0 0 7px; display: flex; align-items: center; justify-content: flex-end; padding-right: 0.7rem; min-width: 2.5rem; transition: width 0.9s cubic-bezier(0.2,0.7,0.2,1); }
  .bm-chart :global(.dbar-val) { font-family: var(--font-mono); font-feature-settings: 'tnum'; font-size: 0.82rem; font-weight: 700; color: #0b0b1c; }
  .bm-chart :global(.dbar-empty) { height: 100%; display: flex; align-items: center; padding-left: 0.8rem; color: #6f6f97; font-family: var(--font-mono); font-size: 0.78rem;
    background-image: repeating-linear-gradient(45deg, rgba(129,140,248,0.05) 0 8px, transparent 8px 16px); }
  .bm-chart :global(.dbar-tick) { position: absolute; top: -3px; bottom: -3px; width: 2px; background: rgba(199,201,238,0.55); }
  .bm-chart :global(.dbar-tip) { position: absolute; left: 11rem; top: 2.5rem; z-index: 5; background: #1a1936; border: 1px solid rgba(129,140,248,0.35); border-radius: 8px; padding: 0.55rem 0.75rem; font-family: var(--font-mono); font-size: 0.78rem; color: #c7c9f5; box-shadow: 0 10px 30px rgba(0,0,0,0.5); max-width: 26rem; }
  .bm-chart :global(.dbar-tip-note) { margin-top: 0.3rem; color: #9a9ac2; line-height: 1.4; }
  .bm-chart :global(.dbar-legend) { margin-top: 0.6rem; color: #6f6f97; font-size: 0.8rem; padding-left: 12rem; }
  @media (max-width: 620px) {
    .bm-chart :global(.dbar-row) { grid-template-columns: 6.5rem 1fr; }
    .bm-chart :global(.dbar-label) { font-size: 0.85rem; }
    .bm-chart :global(.dbar-legend), .bm-chart :global(.dbar-tip) { padding-left: 0; left: 0; }
  }
</style>
