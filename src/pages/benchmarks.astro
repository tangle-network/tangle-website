---
import BaseLayout from '../layouts/BaseLayout.astro';
import Leaderboard from '../components/charts/Leaderboard.tsx';
import { boards } from '../data/benchmarks/index';

const statusLabel: Record<string, string> = {
  live: 'live', partial: 'partial', 'awaiting-run': 'awaiting run',
};
---
<BaseLayout
  title="Agent benchmarks"
  description="Per-domain leaderboards ranking agent profiles on real held-out tasks: tax, legal, creative, and vertical app builds. Real measured runs only."
>
  <section class="bm-hero">
    <div class="shell">
      <h1>Agent benchmarks.</h1>
      <p>Per domain, we rank agent profiles on held-out tasks. Pick a domain to see which model and harness combinations win. Every score is a measured run; domains still being swept are marked, not padded.</p>
    </div>
  </section>

  <section class="bm-body">
    <div class="shell">
      <div class="bm-tabs" role="tablist">
        {boards.map((b, i) => (
          <button class={`bm-tab${i === 0 ? ' on' : ''}`} data-tab={b.id} role="tab">
            {b.domain}
            <span class={`bm-status s-${b.status}`}>{statusLabel[b.status]}</span>
          </button>
        ))}
      </div>

      {boards.map((b, i) => (
        <div class={`bm-panel${i === 0 ? ' on' : ''}`} data-panel={b.id}>
          <div class="bm-panel-head">
            <div>
              <h2>{b.domain}</h2>
              <p class="bm-blurb">{b.blurb}</p>
            </div>
            <dl class="bm-facts mono">
              <div><dt>tasks</dt><dd>{b.taskCount ?? '—'}</dd></div>
              <div><dt>target</dt><dd>{(b.target * 100).toFixed(0)}</dd></div>
              <div><dt>last run</dt><dd>{b.lastRun ?? '—'}</dd></div>
            </dl>
          </div>

          <Leaderboard client:visible rows={b.rows} target={b.target} status={b.status} />

          <p class="bm-src mono">source: {b.source}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll('.bm-tab');
  const panels = document.querySelectorAll('.bm-panel');
  tabs.forEach((t) => t.addEventListener('click', () => {
    const id = (t as HTMLElement).dataset.tab;
    tabs.forEach((x) => x.classList.toggle('on', x === t));
    panels.forEach((p) => p.classList.toggle('on', (p as HTMLElement).dataset.panel === id));
  }));
</script>

<style>
  .shell { width: min(72rem, 92vw); margin: 0 auto; }
  .mono { font-family: var(--font-mono); font-feature-settings: 'tnum'; }

  .bm-hero { background: #0c0b1d; padding: 5rem 0 3rem; border-bottom: 1px solid rgba(199,201,238,0.1); }
  .bm-hero h1 { margin: 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.035em; color: #fff; font-size: clamp(2.4rem, 4.5vw, 3.8rem); }
  .bm-hero p { margin: 1.1rem 0 0; color: rgba(237,237,244,0.72); font-size: clamp(1.1rem, 1.4vw, 1.3rem); line-height: 1.6; max-width: 48rem; }

  .bm-body { background: #080814; padding: 2.5rem 0 6rem; min-height: 60vh; }
  .bm-tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; border-bottom: 1px solid rgba(199,201,238,0.12); padding-bottom: 1.2rem; margin-bottom: 2rem; }
  .bm-tab { display: inline-flex; align-items: center; gap: 0.5rem; background: transparent; border: 1px solid rgba(199,201,238,0.16); color: #9a9ac2; font-family: var(--font-sans); font-size: 1rem; font-weight: 600; padding: 0.6rem 1.1rem; border-radius: 10px; cursor: pointer; transition: all 0.15s; }
  .bm-tab:hover { border-color: rgba(129,140,248,0.4); color: #ededf4; }
  .bm-tab.on { background: #4f46e5; border-color: #6d63ff; color: #fff; }
  .bm-status { font-family: var(--font-mono); font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.12rem 0.4rem; border-radius: 5px; }
  .s-live { background: rgba(16,185,129,0.2); color: #6ee7b7; }
  .s-partial { background: rgba(129,140,248,0.2); color: #c7c9f5; }
  .s-awaiting-run { background: rgba(94,94,122,0.25); color: #9a9ac2; }
  .bm-tab.on .bm-status { background: rgba(255,255,255,0.2); color: #fff; }

  .bm-panel { display: none; }
  .bm-panel.on { display: block; }
  .bm-panel-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; margin-bottom: 1.8rem; flex-wrap: wrap; }
  .bm-panel-head h2 { margin: 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em; color: #fff; font-size: 1.8rem; }
  .bm-blurb { margin: 0.5rem 0 0; color: #9a9ac2; font-size: 1.05rem; line-height: 1.55; max-width: 40rem; }
  .bm-facts { display: flex; gap: 0; border: 1px solid rgba(199,201,238,0.14); border-radius: 10px; overflow: hidden; flex-shrink: 0; }
  .bm-facts div { padding: 0.7rem 1.1rem; }
  .bm-facts div + div { border-left: 1px solid rgba(199,201,238,0.12); }
  .bm-facts dt { margin: 0; color: #6f6f97; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .bm-facts dd { margin: 0.25rem 0 0; color: #ededf4; font-size: 1.2rem; font-weight: 600; }
  .bm-src { margin-top: 1.4rem; color: #6f6f97; font-size: 0.8rem; }

  /* leaderboard (React island -> global) */
  .bm-panel :global(.lb) { border: 1px solid rgba(199,201,238,0.14); border-radius: 14px; overflow: hidden; }
  .bm-panel :global(.lb-head), .bm-panel :global(.lb-row) {
    display: grid; grid-template-columns: 3rem 1fr 12rem 4rem 8rem; align-items: center; gap: 1rem; padding: 0.85rem 1.2rem; }
  .bm-panel :global(.lb-head) { background: rgba(129,140,248,0.06); border-bottom: 1px solid rgba(199,201,238,0.12); }
  .bm-panel :global(.lb-th), .bm-panel :global(.lb-th-rank), .bm-panel :global(.lb-th-model) {
    background: none; border: none; color: #8888b0; font-family: var(--font-mono); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.05em; text-align: left; cursor: pointer; padding: 0; }
  .bm-panel :global(.lb-th-rank) { cursor: default; }
  .bm-panel :global(.lb-th.on) { color: #c7c9f5; }
  .bm-panel :global(.lb-row) { border-bottom: 1px solid rgba(199,201,238,0.07); }
  .bm-panel :global(.lb-row:last-child) { border-bottom: none; }
  .bm-panel :global(.lb-row.hl) { background: rgba(129,140,248,0.06); }
  .bm-panel :global(.lb-rank) { color: #6f6f97; font-family: var(--font-mono); font-size: 0.95rem; }
  .bm-panel :global(.lb-model-name) { color: #ededf4; font-size: 1rem; font-weight: 600; }
  .bm-panel :global(.lb-harness), .bm-panel :global(.lb-pv) { display: inline-block; margin-left: 0.5rem; color: #8888b0; font-size: 0.76rem; padding: 0.1rem 0.45rem; border-radius: 5px; background: rgba(129,140,248,0.08); }
  .bm-panel :global(.lb-score) { display: flex; align-items: center; gap: 0.7rem; }
  .bm-panel :global(.lb-bar-track) { position: relative; flex: 1; height: 0.7rem; background: rgba(129,140,248,0.08); border-radius: 5px; overflow: hidden; }
  .bm-panel :global(.lb-bar) { height: 100%; border-radius: 5px; transition: width 0.9s cubic-bezier(0.2,0.7,0.2,1); }
  .bm-panel :global(.lb-target) { position: absolute; top: -2px; bottom: -2px; width: 2px; background: rgba(199,201,238,0.5); }
  .bm-panel :global(.lb-score-val) { color: #fff; font-size: 0.95rem; font-weight: 700; min-width: 3rem; text-align: right; }
  .bm-panel :global(.lb-n), .bm-panel :global(.lb-cost) { color: #9a9ac2; font-size: 0.9rem; }
  .bm-panel :global(.lb-partial) { padding: 0.9rem 1.2rem; color: #8888b0; font-size: 0.8rem; background: rgba(129,140,248,0.04); margin: 0; }
  .bm-panel :global(.lb-empty) { border: 1px dashed rgba(199,201,238,0.2); border-radius: 14px; padding: 2.5rem 2rem; text-align: center; }
  .bm-panel :global(.lb-empty-badge) { display: inline-block; font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: #9a9ac2; background: rgba(94,94,122,0.25); padding: 0.25rem 0.7rem; border-radius: 999px; }
  .bm-panel :global(.lb-empty p) { margin: 1rem auto 0; color: #82829e; font-size: 0.95rem; line-height: 1.55; max-width: 34rem; }
  @media (max-width: 680px) {
    .bm-panel :global(.lb-head), .bm-panel :global(.lb-row) { grid-template-columns: 2rem 1fr 8rem; }
    .bm-panel :global(.lb-th:nth-child(4)), .bm-panel :global(.lb-th:nth-child(5)),
    .bm-panel :global(.lb-n), .bm-panel :global(.lb-cost) { display: none; }
  }
</style>
