---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { partners, partnerBoard } from '../../data/partners/index';

// Card status is derived, never asserted: a partner reads as measured only when
// its board exists and carries rows, matching the rule the benchmark boards
// follow. Everything else reads as pending.
const cards = partners.map((p) => ({ partner: p, board: partnerBoard(p) }));
---
<BaseLayout
  title="Partners"
  description="The companies whose surfaces the Tangle benchmarks are built on: what each one runs, what the task suite measures, and whether a measured run has completed."
  bodyClass="page-editorial"
>
  <section class="px-hero">
    <div class="shell">
      <h1>Partners</h1>
      <p>
        A benchmark is only as real as the surface it is built on. These are the companies whose
        chains, APIs, and developer stacks the task suites are written against, with what each suite
        measures and whether it has been run.
      </p>
      <p class="px-flip">
        <a href="/benchmarks">Browse the benchmark boards &rarr;</a>
      </p>
    </div>
  </section>

  <section class="px-body">
    <div class="shell">
      <div class="px-grid">
        {cards.map(({ partner, board }) => (
          <a class="px-card" href={`/partners/${partner.slug}`}>
            <div class="px-card-top">
              <span class="px-badge">{partner.role}</span>
              <span class={`px-st ${board ? 's-live' : 's-pending'}`}>{board ? 'measured' : 'measurement pending'}</span>
            </div>
            <h2>{partner.name}</h2>
            <p class="px-blurb">{partner.summary}</p>
            <div class="px-meta mono">
              {partner.taskCount && <span><strong>{partner.taskCount}</strong> tasks authored</span>}
              {partner.corpus && <span><strong>{partner.corpus.total}</strong> community projects</span>}
            </div>
            <span class="px-view">Read the detail &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .shell { width: min(74rem, 92vw); margin: 0 auto; }
  .mono { font-family: var(--font-mono); font-feature-settings: 'tnum'; }

  .px-hero { background: var(--paper-1); padding: 5rem 0 3rem; border-bottom: 1px solid var(--hairline-light); }
  .px-hero h1 { margin: 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.035em; color: var(--ink); font-size: clamp(2.2rem, 4vw, 3.4rem); }
  .px-hero p { margin: 1.1rem 0 0; color: var(--ink-secondary); font-size: clamp(1.1rem, 1.4vw, 1.28rem); line-height: 1.6; max-width: 48rem; }
  .px-flip { margin: 0.9rem 0 0; font-size: 0.95rem; }
  .px-flip a { color: #4F46E5; font-weight: 600; text-decoration: none; }
  .px-flip a:hover { color: #4338CA; }

  .px-body { background: var(--paper-0); padding: 3rem 0 6rem; }
  .px-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(21rem, 1fr)); gap: 1.1rem; }
  .px-card { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--hairline-light); box-shadow: 0 8px 26px rgba(25,28,60,0.05); border-radius: 15px; padding: 1.3rem 1.4rem 1.2rem; text-decoration: none; transition: transform 0.15s, border-color 0.15s; }
  .px-card:hover { transform: translateY(-3px); border-color: rgba(79,70,229,0.4); box-shadow: 0 16px 40px rgba(79,70,229,0.12); }
  .px-card-top { display: flex; justify-content: space-between; align-items: center; gap: 0.6rem; margin-bottom: 0.8rem; }
  .px-badge { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; color: #4F46E5; background: rgba(79,70,229,0.1); border: 1px solid rgba(79,70,229,0.22); padding: 0.2rem 0.55rem; border-radius: 6px; }
  .px-st { font-family: var(--font-mono); font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.14rem 0.45rem; border-radius: 5px; white-space: nowrap; }
  .s-live { background: rgba(16,185,129,0.2); color: #047857; }
  .s-pending { background: var(--paper-2); color: var(--ink-muted); }
  .px-card h2 { margin: 0; font-family: var(--font-display); font-weight: 600; color: var(--ink); font-size: 1.45rem; letter-spacing: -0.015em; }
  .px-blurb { margin: 0.7rem 0 0; color: var(--ink-secondary); font-size: 0.94rem; line-height: 1.55; flex: 1; }
  .px-meta { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1rem 0 0.9rem; padding-top: 0.9rem; border-top: 1px solid var(--hairline-light); color: var(--ink-muted); font-size: 0.78rem; }
  .px-meta strong { color: #4F46E5; }
  .px-view { color: #4F46E5; font-size: 0.86rem; font-weight: 600; }
  .px-card:hover .px-view { color: #4338CA; }
</style>
