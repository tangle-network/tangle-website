---
import BaseLayout from '../layouts/BaseLayout.astro';
import SandboxQuickstart from '../components/SandboxQuickstart.astro';
import AnyCloud from '../components/AnyCloud.astro';
import { PLANS, planPrice } from '../data/plans.mjs';

const canonicalUrl = 'https://tangle.tools/';
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${canonicalUrl}#organization`,
      name: 'Tangle',
      legalName: 'Tangle Technologies, Inc.',
      url: canonicalUrl,
      logo: 'https://tangle.tools/icons/tangle-icon-512.png',
      description:
        'Tangle provides isolated runtimes, model routing, browser automation, and evaluation tools for AI agents.',
      sameAs: [
        'https://twitter.com/tangle_network',
        'https://github.com/tangle-network',
        'https://www.youtube.com/@TangleNetwork',
        'https://discord.com/invite/cv8EfJu3Tn',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalUrl}#website`,
      name: 'Tangle',
      url: canonicalUrl,
      publisher: { '@id': `${canonicalUrl}#organization` },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: 'Run AI agents',
      description:
        'Run agents in isolated sandboxes, capture their work, compare changes, and review the evidence before deployment.',
      isPartOf: { '@id': `${canonicalUrl}#website` },
      about: { '@id': `${canonicalUrl}#organization` },
      inLanguage: 'en-US',
    },
  ],
};

// Harness commands and launch IDs are separate: Prime's CLI is prime-agent,
// while the Sandbox launch API accepts prime.
// NanoClaw mark: https://nanoclaw.dev/favicon-192x192.png
// Prime mark: https://github.com/PrimeIntellect-ai.png?size=256
// What one key meters into one balance, drawn by the pricing section.
const bills = [
  { id: 'sandboxes', name: 'Sandboxes', unit: 'sandbox hours', y: 45 },
  { id: 'router', name: 'Router', unit: 'tokens per turn', y: 115 },
  { id: 'intelligence', name: 'Intelligence', unit: 'traces', y: 185 },
];

const harnesses = [
  { cmd: 'claude', harness: 'claude-code', name: 'Claude Code', logo: '/images/harness/claude-code.svg' },
  { cmd: 'codex', harness: 'codex', name: 'Codex', logo: '/images/harness/codex.png' },
  { cmd: 'opencode', harness: 'opencode', name: 'OpenCode', logo: '/images/harness/opencode.svg' },
  { cmd: 'hermes', harness: 'hermes', name: 'Hermes', logo: '/images/harness/hermes.png' },
  { cmd: 'openclaw', harness: 'openclaw', name: 'OpenClaw', logo: '/images/harness/openclaw.png' },
  { cmd: 'nanoclaw', harness: 'nanoclaw', name: 'NanoClaw', logo: '/images/harness/nanoclaw-5c87dee8.png' },
  { cmd: 'kimi', harness: 'kimi-code', name: 'Kimi Code', logo: '/images/harness/kimi-code.png' },
  { cmd: 'pi', harness: 'pi', name: 'Pi', logo: '/images/harness/pi.svg' },
  { cmd: 'prime-agent', harness: 'prime', name: 'Prime Agent', logo: '/images/harness/prime-agent.png' },
];

---

<BaseLayout
  title="Run AI agents"
  description="Run AI agents in isolated sandboxes, capture their work, compare changes, and review the evidence before deployment."
>
  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />


  <!-- ===== HERO (dark): a field of sandboxes; each light is one agent's own machine ===== -->
  <section class="hero" aria-labelledby="hero-title" data-cta-placement="hero">
    <div class="hero-art" aria-hidden="true">
      <canvas id="hero-field" data-harnesses={harnesses.map((h) => h.harness).join(' ')}></canvas>
    </div>

    <div class="shell">
      <div class="hero-copy">
        <h1 id="hero-title">
          Run agents.
          <span class="grad-text">Make them better.</span>
        </h1>
        <p>
          Run agents in isolated sandboxes. Connect models and tools,
          automate workflows, and build products on Tangle.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="https://sandbox.tangle.tools/dashboard" target="_blank" rel="noopener noreferrer">Open the workbench</a>
          <a class="btn btn-ghost" href="https://docs.tangle.tools" target="_blank" rel="noopener noreferrer">Read the docs</a>
        </div>
      </div>
    </div>
  </section>

  <SandboxQuickstart />

  <!-- ========= SANDBOX (dark): harnesses run, traces emit ========= -->
  <section class="sb-section" aria-labelledby="sb-title">
    <div class="sb-flow static">
      <div class="sb-sticky">
        <div class="shell">
          <div class="sb-head">
            <h2 id="sb-title">Every harness, instantly at your fingertips.</h2>
            <p>
              Run them interactively or in the background.
            </p>
          </div>

          <div class="sb-diagram">
          <div class="sb-rail" style={`--harness-columns: ${harnesses.length}`} aria-label="Coding harnesses preinstalled in every sandbox">
            {harnesses.map((h, i) => (
              <a
                class="sb-tile"
                data-i={i}
                style={`--bank-row: ${i < 5 ? i + 1 : i - 4}; --list-row: ${i + 1}; --bank-column: ${i < 5 ? 1 : 3}`}
                href={`https://sandbox.tangle.tools/dashboard/new?harness=${h.harness}`}
                aria-label={`Create a sandbox for ${h.name}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <img class="sb-logo" src={h.logo} alt={`${h.name} mark`} width="48" height="48" loading="lazy" />
                <span class="sb-name">{h.name}</span>
                <code class="mono sb-cmd">$ {h.cmd}</code>
                <span class="sb-run mono">Start <span aria-hidden="true">↗</span></span>
              </a>
            ))}
          </div>

          <svg class="sb-lines" aria-hidden="true">
            <defs>
              <linearGradient id="sb-grad" gradientUnits="userSpaceOnUse" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" style="stop-color: var(--brand-glow)" />
                <stop offset="100%" style="stop-color: var(--btn-primary-bg)" />
              </linearGradient>
            </defs>
            {harnesses.map(() => (
              <path
                class="sb-line"
                fill="none"
                stroke="url(#sb-grad)"
                stroke-width="2"
                stroke-linecap="round"
                pathLength="1"
                vector-effect="non-scaling-stroke"
              />
            ))}

          </svg>
          <div class="sb-node"><img src="/brand/tangle-icon-filled.svg" width="36" height="36" alt="" /><span>Intelligence</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== TAGLINE REVEAL (paper) ==================== -->
  <section class="tagline" data-theme="website" aria-label="What Tangle gives an agent">
    <div class="shell">
      <p class="tagline-text" data-tagline>
        Give every agent its own computer. Run fleets of them under one budget. Read every trace.
      </p>
    </div>
  </section>

  <AnyCloud />

  <!-- ==================== PRICING + CLOSE (paper) ==================== -->
  <section class="pricing" data-theme="website" id="pricing" aria-labelledby="pricing-title" data-cta-placement="pricing">
    <div class="shell">
      <div class="pricing-top">
        <div class="pricing-head reveal">
          <h2 id="pricing-title">One key. <span class="statement-grad">One bill.</span></h2>
          <p>Sandboxes, models and traces share one API key and one balance. Every turn is metered, and a fleet runs under a cap you set.</p>
        </div>
        <figure class="bill reveal" aria-label="One API key meters sandboxes, models and traces into one balance">
          <svg class="bill-svg" viewBox="0 0 560 230" role="img" aria-hidden="true">
            <defs>
              <linearGradient id="bill-grad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" style="stop-color: var(--accent-text)" />
                <stop offset="100%" style="stop-color: var(--brand-glow)" />
              </linearGradient>
            </defs>
            {bills.map((bill) => (
              <g class="bill-flow" data-flow={bill.id}>
                <path class="bill-path" d={`M 118 115 C 180 115, 180 ${bill.y}, 236 ${bill.y}`} />
                <path class="bill-path" d={`M 400 ${bill.y} C 450 ${bill.y}, 450 115, 472 115`} />
                <rect class="bill-node" x="236" y={bill.y - 19} width="164" height="38" rx="10" />
                <text class="bill-label" x="318" y={bill.y + 5}>{bill.name}</text>
                <text class="bill-unit" x="318" y={bill.y + 39}>{bill.unit}</text>
              </g>
            ))}
            <g class="bill-key">
              <rect x="14" y="96" width="104" height="38" rx="19" />
              <text class="bill-label" x="66" y="120">sk-tan-…</text>
              <text class="bill-unit" x="66" y="154">one API key</text>
            </g>
            <g class="bill-balance">
              <circle cx="508" cy="115" r="36" />
              <text class="bill-label bill-dollar" x="508" y="122">$</text>
              <text class="bill-unit" x="508" y="176">one balance</text>
            </g>
          </svg>
        </figure>
      </div>
      <div class="plans reveal" data-plans>
        {PLANS.map((plan) => (
          <article class={`plan${plan.popular ? ' plan-popular' : ''}`} data-plan={plan.id}>
            <h3>{plan.name}</h3>
            <p class="plan-price"><span class="plan-amount">{planPrice(plan)}</span>{plan.monthlyPriceCents > 0 && <span class="plan-per"> / month</span>}</p>
            <p class="plan-credit">{plan.creditsPerMonth > 0 ? `Includes ${planPrice(plan)} of usage each month` : 'Pay as you go'}</p>
            <ul class="plan-features">
              {plan.features.map((feature) => <li>{feature}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <div class="pricing-actions reveal">
        <a class="btn btn-primary" href="https://sandbox.tangle.tools/dashboard/new" target="_blank" rel="noopener noreferrer">Create a sandbox</a>
        <a class="btn btn-ghost" href="https://id.tangle.tools/app/plans" target="_blank" rel="noopener noreferrer">See plans</a>
        <a class="pricing-contact" href="mailto:hello@tangle.tools">Bigger workload? hello@tangle.tools</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduced) {
    document.documentElement.classList.add('js');
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          io.unobserve(entry.target);
        }
      }
    }, { threshold: 0.14 });
    document.querySelectorAll('.reveal').forEach((element) => io.observe(element));
  }


  // Tagline: each word lights up once as it crosses a line 55% down the viewport.
  const tagline = document.querySelector<HTMLElement>('[data-tagline]');
  if (tagline) {
    const words = tagline.textContent!.trim().split(/\s+/);
    tagline.textContent = '';
    words.forEach((word, index) => {
      const span = document.createElement('span');
      span.className = 'w';
      span.textContent = word;
      tagline.append(span);
      if (index < words.length - 1) tagline.append(' ');
    });
    if (!reduced) {
      const lit = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) { entry.target.classList.add('on'); lit.unobserve(entry.target); }
        }
      }, { rootMargin: '0px 0px -45% 0px', threshold: 1 });
      tagline.querySelectorAll('.w').forEach((word) => lit.observe(word));
    } else {
      tagline.querySelectorAll('.w').forEach((word) => word.classList.add('on'));
    }
  }

  const sb = document.querySelector<HTMLElement>('.sb-flow');
  if (sb) {
    const diagram = sb.querySelector<HTMLElement>('.sb-diagram')!;
    const node = sb.querySelector<HTMLElement>('.sb-node')!;
    const svg = sb.querySelector<SVGSVGElement>('.sb-lines')!;
    const tiles = [...sb.querySelectorAll<HTMLElement>('.sb-tile')];
    const lines = [...sb.querySelectorAll<SVGPathElement>('.sb-line')];
    const wide = matchMedia('(min-width: 1381px)');
    const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
    const motion = matchMedia('(min-width: 1381px) and (min-height: 760px) and (prefers-reduced-motion: no-preference)');
    const connect = () => {
      const bounds = diagram.getBoundingClientRect();
      const destination = node.getBoundingClientRect();
      svg.setAttribute('viewBox', `0 0 ${bounds.width} ${bounds.height}`);
      tiles.forEach((tile, index) => {
        const source = tile.getBoundingClientRect();
        if (wide.matches) {
          const x = source.left + source.width / 2 - bounds.left;
          const y = source.bottom - bounds.top;
          const endX = destination.left + destination.width / 2 - bounds.left;
          const endY = destination.top - bounds.top;
          const midY = y + (endY - y) * 0.6;
          lines[index].setAttribute('d', `M ${x} ${y} C ${x} ${midY}, ${endX} ${midY}, ${endX} ${endY}`);
        } else {
          const left = source.left < destination.left;
          const x = (left ? source.right : source.left) - bounds.left;
          const y = source.top + source.height / 2 - bounds.top;
          const endX = (left ? destination.left : destination.right) - bounds.left;
          const endY = destination.top + destination.height / 2 - bounds.top;
          const midX = x + (endX - x) * 0.6;
          lines[index].setAttribute('d', `M ${x} ${y} C ${midX} ${y}, ${midX} ${endY}, ${endX} ${endY}`);
        }
      });
    };
    let queued = false;
    const update = () => {
      queued = false;
      const rect = sb.getBoundingClientRect();
      const progress = motion.matches
        ? Math.min(1, Math.max(0, -rect.top / (sb.offsetHeight - innerHeight)))
        : 1;
      tiles.forEach((tile, index) => tile.classList.toggle('on', progress > 0.06 + index * 0.055));
      lines.forEach((line, index) => {
        const drawn = Math.min(1, Math.max(0, (progress - (0.12 + index * 0.055)) / 0.32));
        line.style.strokeDashoffset = String(1 - drawn);
      });
      sb.classList.toggle('done', progress > 0.88);
    };
    const mode = () => {
      sb.classList.toggle('static', !motion.matches);
      connect();
      update();
    };
    const geometry = new ResizeObserver(connect);
    geometry.observe(diagram);
    geometry.observe(node);
    window.addEventListener('scroll', () => {
      if (!queued) { queued = true; requestAnimationFrame(update); }
    }, { passive: true });
    motion.addEventListener('change', mode);
    wide.addEventListener('change', mode);
    motionPreference.addEventListener('change', mode);
    window.addEventListener('resize', update, { passive: true });
    mode();
  }

  // Hero: a floor of sandboxes running to the horizon, one dot per machine.
  // Agents claim machines one at a time; a fleet claims a block at once and
  // releases it together, inside one outline. Near machines name the harness
  // inside. Canvas 2D, batched by brightness, paused off screen and in hidden
  // tabs; reduced motion draws one still frame.
  const field = document.querySelector<HTMLCanvasElement>('#hero-field');
  const ctx = field?.getContext('2d');
  if (field && ctx) {
    const css = getComputedStyle(field);
    const token = (name: string) => css.getPropertyValue(name).trim();
    const ink = [token('--text-primary'), token('--brand-cool'), token('--brand-glow')];
    const edge = token('--brand-vibrant');
    const mono = token('--font-mono') || 'monospace';
    const names = (field.dataset.harnesses ?? '').split(' ').filter(Boolean);
    const COLS = 120, ROWS = 64, GAP = 0.22, SPEED = 0.00022, LEVELS = 8; // SPEED: rows per ms
    const born = new Float64Array(COLS * ROWS), dies = new Float64Array(COLS * ROWS);
    const kind = new Uint8Array(COLS * ROWS), tag = new Uint8Array(COLS * ROWS);
    const fleets: { col: number; row: number; w: number; d: number; born: number; dies: number }[] = [];
    let seed = 20261030;
    const random = () => { // mulberry32: a seeded, even spread, so every visit opens the same way
      let t = (seed = (seed + 0x6d2b79f5) | 0);
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
    const motion = !reduced;
    const view = { W: 0, H: 0, horizon: 0, focal: 1, height: 6, cx: 0, near: 1, narrow: false };
    let clock = 0, depth = 0, far = ROWS - 1, nextOne = 0, nextFleet = 1800, camX = 0, aimX = 0, dpr = 1;

    const slot = (row: number, col: number) => (row % ROWS) * COLS + col;
    const zOf = (row: number) => row - depth + view.near - 1;
    const sx = (x: number, z: number) => view.cx + (view.focal * (x - camX)) / z;
    const sy = (z: number) => view.horizon + (view.focal * view.height) / z;
    const colAt = (px: number, z: number) => Math.floor(((px - view.cx) * z) / view.focal + camX + COLS / 2);
    const veil = (px: number) => (view.narrow ? 1 : Math.min(1, Math.max(0, (px - view.W * 0.4) / (view.W * 0.2))));
    const fade = (z: number) => Math.max(0, 1 - (z - view.near) / ROWS) ** 1.6;
    const light = (row: number, col: number, start: number, end: number, k: number) => {
      if (col < 0 || col >= COLS) return;
      const i = slot(row, col);
      if (k === 1 && kind[i] === 2 && clock < dies[i]) return; // a fleet's machines stay its own
      born[i] = start; dies[i] = end; kind[i] = k; tag[i] = (row * 5 + col * 3) % Math.max(1, names.length);
    };
    // A fleet claims a block that touches no other fleet, lit outward from its middle.
    const claimFleet = (lo: number, hi: number, w: number, d: number, life: number) => {
      const { row, col } = spot(lo, hi, w, 0.52);
      if (!fleets.every((f) => row > f.row + f.d || row + d < f.row || col > f.col + f.w || col + w < f.col)) return false;
      for (let r = 0; r < d; r++) for (let c = 0; c < w; c++) light(row + r, col + c, clock + (Math.abs(c - w / 2) + r) * 80, clock + life, 2);
      fleets.push({ col, row, w, d, born: clock, dies: clock + life });
      return true;
    };
    const glow = (start: number, end: number, rise: number) => {
      const up = Math.min(1, Math.max(0, (clock - start) / rise));
      const down = clock < end ? 1 : Math.max(0, 1 - (clock - end) / 1400);
      return (1 - (1 - up) ** 3) * down;
    };
    // A random machine on screen and clear of the headline, `lo`..`hi` rows from the front.
    const spot = (lo: number, hi: number, w = 1, edge = 0.46) => {
      const row = Math.floor(depth) + lo + Math.floor(random() ** 0.7 * (hi - lo)); // most machines are far away
      const z = zOf(row) + 0.5;
      const left = Math.max(colAt(view.narrow ? 0 : view.W * edge, z), 0), right = Math.min(colAt(view.W, z) - w, COLS - w);
      return { row, col: left + Math.floor(random() * Math.max(1, right - left)) };
    };

    const step = (dt: number) => {
      clock += dt;
      if (motion) depth += dt * SPEED;
      const front = Math.floor(depth);
      while (far < front + ROWS - 1) { far++; for (let c = 0; c < COLS; c++) kind[slot(far, c)] = 0; }
      for (; clock >= nextOne; nextOne += 8 + random() * 14) {
        const { row, col } = spot(1, ROWS - 2);
        light(row, col, nextOne, nextOne + 2200 + random() * 5000, 1);
      }
      if (clock >= nextFleet) {
        nextFleet += 1600 + random() * 1400;
        claimFleet(2, 26, 3 + Math.floor(random() * 6), 2 + Math.floor(random() * 4), 3400 + random() * 2600);
      }
      for (let i = fleets.length - 1; i >= 0; i--) if (clock > fleets[i].dies + 1400 || fleets[i].row < front) fleets.splice(i, 1);
      camX += (aimX - camX) * Math.min(1, dt / 500);
    };

    const quad = (path: Path2D, x0: number, x1: number, z0: number, z1: number) => {
      path.moveTo(sx(x0, z0), sy(z0)); path.lineTo(sx(x1, z0), sy(z0));
      path.lineTo(sx(x1, z1), sy(z1)); path.lineTo(sx(x0, z1), sy(z1)); path.closePath();
    };
    const draw = () => {
      const { W, H } = view;
      if (!W || !H) return;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      // Light on the horizon: the field keeps going.
      const dawn = ctx.createRadialGradient(view.cx, view.horizon, 0, view.cx, view.horizon, W * 0.55);
      dawn.addColorStop(0, ink[1]); dawn.addColorStop(1, 'transparent');
      ctx.globalAlpha = 0.12; ctx.fillStyle = dawn;
      ctx.setTransform(dpr, 0, 0, dpr * 0.22, 0, view.horizon * dpr * 0.78);
      ctx.fillRect(0, -H * 5, W, H * 10);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // Batch every quad into one path per kind and brightness level.
      const dots = Array.from({ length: LEVELS }, () => new Path2D());
      const halo = ink.map(() => Array.from({ length: LEVELS }, () => new Path2D()));
      const core = ink.map(() => Array.from({ length: LEVELS }, () => new Path2D()));
      const labels: [string, number, number, number][] = [];
      const front = Math.floor(depth);
      for (let row = front; row < front + ROWS; row++) {
        const z0 = zOf(row) + GAP, z1 = zOf(row) + 1 - GAP;
        if (z1 < view.near * 0.8) continue;
        const zm = (z0 + z1) / 2, ym = sy(zm), size = view.focal / zm, haze = fade(z0);
        const first = Math.max(0, colAt(-size, zm)), last = Math.min(COLS - 1, colAt(W + size, zm));
        for (let c = first; c <= last; c++) {
          const x0 = c - COLS / 2 + GAP, x1 = c - COLS / 2 + 1 - GAP, xm = sx((x0 + x1) / 2, zm);
          const i = slot(row, c), shade = haze * veil(xm);
          if (shade < 0.02) continue;
          const b = kind[i] ? glow(born[i], dies[i], 450) : 0;
          if (kind[i] && b <= 0 && clock > dies[i]) kind[i] = 0;
          if (b * shade < 0.04) {
            const r = Math.max(0.6, size * 0.03);
            dots[Math.min(LEVELS - 1, Math.floor(shade * LEVELS))].rect(xm - r, ym - r, r * 2, r * 2);
            continue;
          }
          const level = Math.min(LEVELS - 1, Math.floor(b * shade * LEVELS));
          if (size < 40) quad(halo[kind[i]][level], x0 - 0.3, x1 + 0.3, z0 - 0.3, z1 + 0.3);
          quad(core[kind[i]][level], x0, x1, z0, z1);
          if (kind[i] === 1 && size > 80 && b > 0.5 && sy(z1) < H - 8 && names.length) labels.push([names[tag[i]], xm, sy(z1) - 12, b * shade]);
        }
      }
      ctx.fillStyle = ink[0];
      dots.forEach((path, level) => { ctx.globalAlpha = 0.05 + 0.25 * (level / LEVELS); ctx.fill(path); });
      ctx.globalCompositeOperation = 'lighter';
      for (const k of [1, 2]) {
        ctx.fillStyle = ink[k];
        halo[k].forEach((path, level) => { ctx.globalAlpha = 0.14 * (level + 1) / LEVELS; ctx.fill(path); });
        core[k].forEach((path, level) => { ctx.globalAlpha = (k === 2 ? 1 : 0.6) * (level + 1) / LEVELS; ctx.fill(path); });
      }
      ctx.globalCompositeOperation = 'source-over';
      ctx.font = `500 12px ${mono}`; ctx.textAlign = 'center'; ctx.textBaseline = 'bottom'; ctx.fillStyle = ink[0];
      for (const [name, x, y, a] of labels.slice(0, 4)) { ctx.globalAlpha = a * 0.8; ctx.fillText(name, x, y); }
      // One outline per fleet: the machines it holds under one budget.
      ctx.strokeStyle = edge; ctx.lineWidth = 1.5;
      for (const fleet of fleets) {
        const z0 = zOf(fleet.row) - 0.05, z1 = zOf(fleet.row + fleet.d) + 0.05;
        if (z0 < view.near * 0.8) continue;
        const x0 = fleet.col - COLS / 2 - 0.05, x1 = fleet.col + fleet.w - COLS / 2 + 0.05;
        const outline = new Path2D();
        quad(outline, x0, x1, z0, z1);
        ctx.globalAlpha = glow(fleet.born, fleet.dies, 700) * fade(z0) * veil(sx((x0 + x1) / 2, z0)) * 0.9;
        ctx.stroke(outline);
      }
      ctx.globalAlpha = 1;
    };

    const fit = () => {
      dpr = Math.min(2, window.devicePixelRatio || 1);
      const W = field.clientWidth, H = field.clientHeight, narrow = W < 860;
      const horizon = H * (narrow ? 0.06 : 0.26), height = 6;
      const focal = H * (narrow ? 1.1 : 0.9);
      Object.assign(view, { W, H, narrow, horizon, height, focal, cx: W * (narrow ? 0.5 : 0.68), near: (focal * height) / (H - horizon) });
      field.width = Math.round(W * dpr);
      field.height = Math.round(H * dpr);
      draw();
    };

    let running = false, visible = true, last = 0;
    const frame = (time: number) => {
      if (!running) return;
      step(last ? Math.min(50, time - last) : 16);
      last = time;
      draw();
      requestAnimationFrame(frame);
    };
    const play = () => {
      if (running || !motion || !visible || document.hidden) return;
      running = true; last = 0;
      requestAnimationFrame(frame);
    };
    fit();
    for (let t = 0; t < (motion ? 4000 : 6000); t += 20) step(20); // open on a field already at work
    for (let tries = 0; tries < 8 && !claimFleet(4, 12, 8, 5, 6400); tries++); // then a fleet claims its block
    if (!motion) for (let t = 0; t < 1200; t += 20) step(20);
    draw();
    new ResizeObserver(fit).observe(field);
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible) play(); else running = false;
    }).observe(field);
    document.addEventListener('visibilitychange', () => { if (document.hidden) running = false; else play(); });
    addEventListener('pointermove', (event) => { aimX = (event.clientX / innerWidth - 0.5) * 3; }, { passive: true });
    play();
    field.classList.add('ready');
  }

</script>

