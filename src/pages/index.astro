---
import BaseLayout from '../layouts/BaseLayout.astro';
import SandboxQuickstart from '../components/SandboxQuickstart.astro';
import RunStory from '../components/RunStory.astro';

const canonicalUrl = 'https://tangle.tools/';
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${canonicalUrl}#organization`,
      name: 'Tangle',
      legalName: 'Tangle Technologies, Inc.',
      url: canonicalUrl,
      logo: 'https://tangle.tools/icons/tangle-icon-512.png',
      description:
        'Tangle provides isolated runtimes, model routing, browser automation, and evaluation tools for AI agents.',
      sameAs: [
        'https://twitter.com/tangle_network',
        'https://github.com/tangle-network',
        'https://www.youtube.com/@TangleNetwork',
        'https://discord.com/invite/cv8EfJu3Tn',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalUrl}#website`,
      name: 'Tangle',
      url: canonicalUrl,
      publisher: { '@id': `${canonicalUrl}#organization` },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: 'Run AI agents',
      description:
        'Run agents in isolated sandboxes, capture their work, compare changes, and review the evidence before deployment.',
      isPartOf: { '@id': `${canonicalUrl}#website` },
      about: { '@id': `${canonicalUrl}#organization` },
      inLanguage: 'en-US',
    },
  ],
};

const products = [
  {
    name: 'Sandboxes',
    line: 'Isolated computers for agents: shell, files, browser, any coding harness.',
    href: 'https://sandbox.tangle.tools',
    domain: 'sandbox.tangle.tools',
    hue: 'cyan',
  },
  {
    name: 'Intelligence',
    line: 'Analyze traces and compare runs before and after a change.',
    href: 'https://intelligence.tangle.tools',
    domain: 'intelligence.tangle.tools',
    hue: 'magenta',
  },
  {
    name: 'Inference',
    line: 'OpenAI-compatible access to multiple model providers through one API.',
    href: 'https://router.tangle.tools',
    domain: 'router.tangle.tools',
    hue: 'indigo',
  },
];

// Harness commands and launch IDs are separate: Prime's CLI is prime-agent,
// while the Sandbox launch API accepts prime.
// NanoClaw mark: https://nanoclaw.dev/favicon-192x192.png
// Prime mark: https://github.com/PrimeIntellect-ai.png?size=256
const harnesses = [
  { cmd: 'claude', harness: 'claude-code', name: 'Claude Code', logo: '/images/harness/claude-code.svg' },
  { cmd: 'codex', harness: 'codex', name: 'Codex', logo: '/images/harness/codex.png' },
  { cmd: 'opencode', harness: 'opencode', name: 'OpenCode', logo: '/images/harness/opencode.svg' },
  { cmd: 'hermes', harness: 'hermes', name: 'Hermes', logo: '/images/harness/hermes.png' },
  { cmd: 'openclaw', harness: 'openclaw', name: 'OpenClaw', logo: '/images/harness/openclaw.png' },
  { cmd: 'nanoclaw', harness: 'nanoclaw', name: 'NanoClaw', logo: '/images/harness/nanoclaw-5c87dee8.png' },
  { cmd: 'kimi', harness: 'kimi-code', name: 'Kimi Code', logo: '/images/harness/kimi-code.png' },
  { cmd: 'pi', harness: 'pi', name: 'Pi', logo: '/images/harness/pi.svg' },
  { cmd: 'prime-agent', harness: 'prime', name: 'Prime Agent', logo: '/images/harness/prime-agent.png' },
];

---

<BaseLayout
  title="Run AI agents"
  description="Run AI agents in isolated sandboxes, capture their work, compare changes, and review the evidence before deployment."
>
  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

  <!-- No-JS: the scroll stories can't run, so collapse both pinned tracks to a
       plain visible stack. Only renders with JS off; !important beats the
       scoped base rules that hide un-revealed stages. -->
  <noscript>
    <style>
      .sb-flow { height: auto !important; }
      .sb-sticky { position: static !important; height: auto !important; overflow: visible !important; padding: 4.5rem 0 !important; }
      .sb-tile { opacity: 1 !important; }
      .sb-line { stroke-dashoffset: 0 !important; }
      .sb-node { opacity: 1 !important; }
      .pricing-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.3rem; margin-top: 2rem; }
  .pricing-contact { color: #4F46E5; font-weight: 600; text-decoration: underline; text-underline-offset: 0.18em; }
</style>
  </noscript>

  <!-- ============================ HERO (dark, video) ============================ -->
  <section class="hero" aria-labelledby="hero-title" data-cta-placement="hero">
    <div class="hero-art" aria-hidden="true">
      <canvas id="hero-knot"></canvas>
      <img class="hero-poster" src="/images/brand/knot-poster.webp" alt="" loading="eager" />
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="shell">
      <div class="hero-copy">
        <h1 id="hero-title">
          Run agents.
          <span class="grad-text">Make them better.</span>
        </h1>
        <p>
          Run agents in isolated sandboxes. Connect models and tools,
          automate workflows, and build products on Tangle.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="https://sandbox.tangle.tools/dashboard" target="_blank" rel="noopener noreferrer">Open the workbench</a>
          <a class="btn btn-ghost" href="https://docs.tangle.tools" target="_blank" rel="noopener noreferrer">Read the docs</a>
        </div>
      </div>
    </div>
  </section>

  <SandboxQuickstart />

  <!-- ========= SANDBOX (dark): harnesses run, traces emit ========= -->
  <section class="sb-section" aria-labelledby="sb-title">
    <div class="sb-flow static">
      <div class="sb-sticky">
        <div class="shell">
          <div class="sb-head">
            <h2 id="sb-title">Give every agent an isolated workspace.</h2>
            <p>
              Run coding agents interactively or in the background.
            </p>
          </div>

          <div class="sb-diagram">
          <div class="sb-rail" style={`--harness-columns: ${harnesses.length}`} aria-label="Coding harnesses preinstalled in every sandbox">
            {harnesses.map((h, i) => (
              <a
                class="sb-tile"
                data-i={i}
                style={`--bank-row: ${i < 5 ? i + 1 : i - 4}; --list-row: ${i + 1}; --bank-column: ${i < 5 ? 1 : 3}`}
                href={`https://sandbox.tangle.tools/dashboard/new?harness=${h.harness}`}
                aria-label={`Create a sandbox for ${h.name}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <img class="sb-logo" src={h.logo} alt={`${h.name} mark`} width="48" height="48" loading="lazy" />
                <span class="sb-name">{h.name}</span>
                <code class="mono sb-cmd">$ {h.cmd}</code>
                <span class="sb-run mono">Start <span aria-hidden="true">↗</span></span>
              </a>
            ))}
          </div>

          <svg class="sb-lines" aria-hidden="true">
            <defs>
              <linearGradient id="sb-grad" gradientUnits="userSpaceOnUse" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#A5AAFC" />
                <stop offset="100%" stop-color="#4F46E5" />
              </linearGradient>
            </defs>
            {harnesses.map(() => (
              <path
                class="sb-line"
                fill="none"
                stroke="url(#sb-grad)"
                stroke-width="2"
                stroke-linecap="round"
                pathLength="1"
                vector-effect="non-scaling-stroke"
              />
            ))}

          </svg>
          <div class="sb-node"><img src="/brand/tangle-icon-filled.svg" width="36" height="36" alt="" /><span>Intelligence</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <RunStory />

  <!-- ==================== PRODUCTS (paper, gradient cards) ==================== -->
  <section class="products-section" aria-labelledby="products-title" data-cta-placement="product-cards">
    <div class="shell">
      <h2 id="products-title" class="statement reveal">
        Build your product <span class="statement-grad">on Tangle.</span>
      </h2>
      <p class="product-intro reveal">One API key for compute, inference, and intelligence.</p>

      <div class="product-cards reveal">
        {products.map((p) => (
          <a class={`p-card p-card-${p.hue}`} href={p.href} target="_blank" rel="noopener noreferrer">
            <div class="p-card-art" aria-hidden="true"></div>
            <div class="p-card-body">
              <h3>{p.name}</h3>
              <p>{p.line}</p>
              <span class="p-card-link mono">{p.domain}</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>


  <!-- ==================== PRICING (paper) ==================== -->
  <section class="pricing" aria-labelledby="pricing-title" data-cta-placement="pricing">
    <div class="shell">
      <div class="pricing-head reveal">
        <h2 id="pricing-title">Start with a free account.</h2>
        <p>The Free plan has no included credit. Add prepaid credit before using AI models. Sign in to compare paid plans, included usage, and limits before checkout.</p>
      </div>
      <div class="pricing-actions reveal">
        <a class="btn btn-primary" href="https://id.tangle.tools/app/plans" target="_blank" rel="noopener noreferrer">Sign in to see plans</a>
        <a class="pricing-contact" href="mailto:hello@tangle.tools">Discuss an infrastructure workload</a>
      </div>
    </div>
  </section>

  <!-- ==================== CLOSE (dark) ==================== -->
  <section class="close-section" aria-labelledby="close-title" data-cta-placement="closing">
    <div class="shell close-inner">
      <h2 id="close-title">Build your next workflow <span class="grad-text-inline">with us.</span></h2>
      <p class="close-copy">Bring us the work you want to automate. We’ll build it with your team.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="mailto:hello@tangle.tools">Talk to Tangle</a>
        <a class="btn btn-ghost" href="https://sandbox.tangle.tools/dashboard" target="_blank" rel="noopener noreferrer">Start building</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = window.matchMedia('(min-width: 861px)').matches;

  if (!reduced) {
    document.documentElement.classList.add('js');
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          io.unobserve(entry.target);
        }
      }
    }, { threshold: 0.14 });
    document.querySelectorAll('.reveal').forEach((element) => io.observe(element));
  }

  const sb = document.querySelector<HTMLElement>('.sb-flow');
  if (sb) {
    const diagram = sb.querySelector<HTMLElement>('.sb-diagram')!;
    const node = sb.querySelector<HTMLElement>('.sb-node')!;
    const svg = sb.querySelector<SVGSVGElement>('.sb-lines')!;
    const tiles = [...sb.querySelectorAll<HTMLElement>('.sb-tile')];
    const lines = [...sb.querySelectorAll<SVGPathElement>('.sb-line')];
    const wide = matchMedia('(min-width: 1381px)');
    const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
    const motion = matchMedia('(min-width: 1381px) and (min-height: 760px) and (prefers-reduced-motion: no-preference)');
    const connect = () => {
      const bounds = diagram.getBoundingClientRect();
      const destination = node.getBoundingClientRect();
      svg.setAttribute('viewBox', `0 0 ${bounds.width} ${bounds.height}`);
      tiles.forEach((tile, index) => {
        const source = tile.getBoundingClientRect();
        if (wide.matches) {
          const x = source.left + source.width / 2 - bounds.left;
          const y = source.bottom - bounds.top;
          const endX = destination.left + destination.width / 2 - bounds.left;
          const endY = destination.top - bounds.top;
          const midY = y + (endY - y) * 0.6;
          lines[index].setAttribute('d', `M ${x} ${y} C ${x} ${midY}, ${endX} ${midY}, ${endX} ${endY}`);
        } else {
          const left = source.left < destination.left;
          const x = (left ? source.right : source.left) - bounds.left;
          const y = source.top + source.height / 2 - bounds.top;
          const endX = (left ? destination.left : destination.right) - bounds.left;
          const endY = destination.top + destination.height / 2 - bounds.top;
          const midX = x + (endX - x) * 0.6;
          lines[index].setAttribute('d', `M ${x} ${y} C ${midX} ${y}, ${midX} ${endY}, ${endX} ${endY}`);
        }
      });
    };
    let queued = false;
    const update = () => {
      queued = false;
      const rect = sb.getBoundingClientRect();
      const progress = motion.matches
        ? Math.min(1, Math.max(0, -rect.top / (sb.offsetHeight - innerHeight)))
        : 1;
      tiles.forEach((tile, index) => tile.classList.toggle('on', progress > 0.06 + index * 0.055));
      lines.forEach((line, index) => {
        const drawn = Math.min(1, Math.max(0, (progress - (0.12 + index * 0.055)) / 0.32));
        line.style.strokeDashoffset = String(1 - drawn);
      });
      sb.classList.toggle('done', progress > 0.88);
    };
    const mode = () => {
      sb.classList.toggle('static', !motion.matches);
      connect();
      update();
    };
    const geometry = new ResizeObserver(connect);
    geometry.observe(diagram);
    geometry.observe(node);
    window.addEventListener('scroll', () => {
      if (!queued) { queued = true; requestAnimationFrame(update); }
    }, { passive: true });
    motion.addEventListener('change', mode);
    wide.addEventListener('change', mode);
    motionPreference.addEventListener('change', mode);
    window.addEventListener('resize', update, { passive: true });
    mode();
  }

  // Initialize the content diagrams before the optional WebGL artwork.
  // Hero brand object: fiber-optic torus knot, dispersion shader, bloom.
  const knotCanvas = document.getElementById('hero-knot');
  if (knotCanvas && !reduced && wide) {
    const renderer = new THREE.WebGLRenderer({ canvas: knotCanvas, antialias: true });
    renderer.setPixelRatio(Math.min(2, window.devicePixelRatio));
    const scene = new THREE.Scene();
    scene.background = new THREE.Color('#080814');
    const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
    camera.position.set(0, 0, 8.6);

    const stops = ['#C7C9F5', '#818CF8', '#6366F1', '#4F46E5'].map((c) => new THREE.Color(c));
    const uniforms = {
      uTime: { value: 0 },
      uC0: { value: stops[0] }, uC1: { value: stops[1] },
      uC2: { value: stops[2] }, uC3: { value: stops[3] },
    };
    const vert = `varying vec2 vUv; varying vec3 vNormal; varying vec3 vView;
      void main() { vUv = uv; vNormal = normalize(normalMatrix * normal);
        vec4 mv = modelViewMatrix * vec4(position, 1.0); vView = normalize(-mv.xyz);
        gl_Position = projectionMatrix * mv; }`;
    const material = new THREE.ShaderMaterial({
      uniforms,
      vertexShader: vert,
      fragmentShader: `uniform float uTime; uniform vec3 uC0; uniform vec3 uC1; uniform vec3 uC2; uniform vec3 uC3;
        varying vec2 vUv; varying vec3 vNormal; varying vec3 vView;
        vec3 ramp(float t) { t = fract(t);
          if (t < 0.3333) return mix(uC0, uC1, smoothstep(0.0, 1.0, t / 0.3333));
          if (t < 0.6666) return mix(uC1, uC2, smoothstep(0.0, 1.0, (t - 0.3333) / 0.3333));
          return mix(uC2, uC3, smoothstep(0.0, 1.0, (t - 0.6666) / 0.3334)); }
        void main() {
          vec3 base = ramp(vUv.x + uTime * 0.03);
          float fresnel = pow(1.0 - max(dot(vNormal, vView), 0.0), 2.2);
          float pulse = smoothstep(0.965, 1.0, sin((vUv.x - uTime * 0.06) * 40.0) * 0.5 + 0.5);
          vec3 color = base * (0.22 + 0.62 * fresnel) + base * pulse * 0.85;
          gl_FragColor = vec4(color, 1.0); }`,
    });
    const knot = new THREE.Mesh(new THREE.TorusKnotGeometry(1.6, 0.12, 520, 48, 2, 3), material);
    knot.position.x = 1.7;
    scene.add(knot);
    const halo = new THREE.Mesh(
      new THREE.TorusKnotGeometry(1.6, 0.22, 260, 32, 2, 3),
      new THREE.ShaderMaterial({
        uniforms, vertexShader: vert,
        fragmentShader: `uniform vec3 uC1; varying vec3 vNormal; varying vec3 vView;
          void main() { float f = pow(1.0 - max(dot(vNormal, vView), 0.0), 3.0);
            gl_FragColor = vec4(uC1 * f * 0.28, 1.0); }`,
        blending: THREE.AdditiveBlending, side: THREE.BackSide, depthWrite: false,
      }),
    );
    halo.position.x = 1.7;
    scene.add(halo);

    const composer = new EffectComposer(renderer);
    composer.addPass(new RenderPass(scene, camera));
    composer.addPass(new UnrealBloomPass(new THREE.Vector2(1, 1), 0.6, 0.42, 0.28));

    const fit = () => {
      const w = knotCanvas.clientWidth, h = knotCanvas.clientHeight;
      renderer.setSize(w, h, false);
      composer.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    };
    new ResizeObserver(fit).observe(knotCanvas);
    fit();

    let rx = 0.42, ry = -0.28, visible = true;
    addEventListener('pointermove', (e) => {
      ry = -0.28 + (e.clientX / innerWidth - 0.5) * 0.35;
      rx = 0.42 + (e.clientY / innerHeight - 0.5) * 0.25;
    });
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(knotCanvas);

    const clock = new THREE.Clock();
    const frame = () => {
      requestAnimationFrame(frame);
      if (!visible) return;
      const t = clock.getElapsedTime();
      uniforms.uTime.value = t;
      knot.rotation.z = t * 0.045;
      knot.rotation.x += (rx - knot.rotation.x) * 0.04;
      knot.rotation.y += (ry - knot.rotation.y) * 0.04;
      halo.rotation.copy(knot.rotation);
      composer.render();
    };
    frame();
    knotCanvas.classList.add('ready');
  } else {
    document.documentElement.classList.add('static-hero');
  }


</script>

<style>
  /* ---------- shared ---------- */
  .shell {
    position: relative;
    z-index: 1;
    width: min(78rem, 90vw);
    margin: 0 auto;
  }

  .mono {
    font-family: var(--font-mono);
    font-feature-settings: 'tnum';
  }

  section h1,
  section h2,
  section h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  section h2 {
    font-size: clamp(2rem, 3vw, 2.9rem);
    line-height: 1.1;
  }

  /* Product sections carry more display presence than utility sections. */
  .run-head h2,
  .loop-head h2,
  .wire-copy h2 {
    font-size: clamp(2.3rem, 3.6vw, 3.5rem);
    letter-spacing: -0.032em;
  }

  :global(html.js) .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.2, 0.6, 0.2, 1), transform 0.6s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  :global(html.js) .reveal.in-view {
    opacity: 1;
    transform: none;
  }

  .aurora {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 1;
  }


  .grad-text {
    display: block;
    background-image: linear-gradient(92deg, #C7C9F5 0%, #818CF8 40%, #4F46E5 75%, #C7C9F5 100%);
    background-size: 220% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: #A5AAFC; /* fallback */
    animation: gradDrift 9s ease-in-out infinite alternate;
  }

  @keyframes gradDrift {
    from { background-position: 0% 50%; }
    to { background-position: 100% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .grad-text { animation: none; }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.8rem;
    padding: 0.75rem 1.3rem;
    border-radius: 9px;
    font-family: var(--font-sans);
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.16s ease, background 0.16s ease, border-color 0.16s ease;
  }

  .btn:hover { transform: translateY(-1px); }

  .btn-primary {
    background: #4f46e5;
    border: 1px solid #6d63ff;
    color: #ffffff;
  }

  .btn-ghost {
    background: rgba(237, 237, 244, 0.06);
    border: 1px solid rgba(237, 237, 244, 0.18);
    color: #ffffff;
  }

  .code-pane {
    overflow: hidden;
    border: 1px solid rgba(199, 201, 238, 0.14);
    border-radius: 10px;
    background: #14132a;
  }

  .pane-head {
    display: flex;
    align-items: center;
    min-height: 2.7rem;
    padding: 0 1.1rem;
    border-bottom: 1px solid rgba(199, 201, 238, 0.1);
    color: rgba(237, 237, 244, 0.6);
    font-size: 0.92rem;
  }

  .code-pane pre {
    margin: 0;
    padding: 1.2rem 1.3rem;
    overflow-x: auto;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(237, 237, 244, 0.88);
  }

  .add { color: #6ee7b7; display: block; }
  .del { color: #fb7185; display: block; }

  /* ---------- hero (dark, video) ---------- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 82vh;
    overflow: hidden;
    background: linear-gradient(160deg, #080814 0%, #0c0b1d 52%, #11122d 100%);
    border-bottom: 1px solid rgba(199, 201, 238, 0.1);
  }

  .hero-art {
    position: absolute;
    inset: 0;
  }

  #hero-knot {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s ease;
  }

  #hero-knot.ready { opacity: 1; }

  .hero-poster {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% center;
    opacity: 0.92;
  }

  :global(html.static-hero) #hero-knot { display: none; }
  :global(html.static-hero) .hero-poster { display: block; }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(8, 8, 20, 0.95) 0%, rgba(8, 8, 20, 0.9) 38%, rgba(8, 8, 20, 0.4) 58%, rgba(8, 8, 20, 0) 74%),
      linear-gradient(180deg, rgba(8, 8, 20, 0) 60%, rgba(8, 8, 20, 0.42) 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    #hero-knot { display: none; }
    .hero-poster { display: block; }
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    padding: 7.5rem 0 6rem;
  }

  .hero-copy h1 {
    color: #ffffff;
