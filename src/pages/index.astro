---
import BaseLayout from '../layouts/BaseLayout.astro';

const canonicalUrl = 'https://tangle.tools/';
const homeSpeedPercent = Number(import.meta.env.PUBLIC_HOME_SPEED_PERCENT ?? '0');
if (!Number.isInteger(homeSpeedPercent) || homeSpeedPercent < 0 || homeSpeedPercent > 100) {
  throw new Error('PUBLIC_HOME_SPEED_PERCENT must be an integer from 0 to 100');
}
const homeBuildRevision = process.env.TANGLE_BUILD_REVISION ?? 'local';
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${canonicalUrl}#organization`,
      name: 'Tangle',
      legalName: 'Tangle Technologies, Inc.',
      url: canonicalUrl,
      logo: 'https://tangle.tools/icons/tangle-icon-512.png',
      description:
        'Tangle is an infrastructure company for AI agents, with a product lab and a research lab.',
      sameAs: [
        'https://twitter.com/tangle_network',
        'https://github.com/tangle-network',
        'https://www.youtube.com/@TangleNetwork',
        'https://discord.com/invite/cv8EfJu3Tn',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalUrl}#website`,
      name: 'Tangle',
      url: canonicalUrl,
      publisher: { '@id': `${canonicalUrl}#organization` },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: 'AI agent infrastructure for building and running agents',
      description:
        'Developers and teams use Tangle sandboxes, runtime, router, integrations, and observability to build and inspect AI agents.',
      isPartOf: { '@id': `${canonicalUrl}#website` },
      about: { '@id': `${canonicalUrl}#organization` },
      inLanguage: 'en-US',
    },
  ],
};

// Session-trace waterfall (illustrative run, internally consistent: the three
// full-suite spans total 33.1s of the 38.2s run).
const spans = [
  { name: 'run · fix flaky checkout test', kind: 'run', l: 0, w: 100, d: '38.2s', ind: 0 },
  { name: 'claude-sonnet-5 · plan', kind: 'llm', l: 1, w: 5.5, d: '2.1s', ind: 1 },
  { name: 'read · checkout.test.ts', kind: 'tool', l: 7, w: 1.6, d: '0.5s', ind: 1 },
  { name: 'pnpm test · full suite', kind: 'shell', l: 9, w: 33.5, d: '12.8s', ind: 1, waste: true },
  { name: 'edit · retry-policy.ts', kind: 'edit', l: 43.5, w: 5, d: '1.9s', ind: 1 },
  { name: 'pnpm test · full suite', kind: 'shell', l: 49.5, w: 29.8, d: '11.4s', ind: 1, waste: true },
  { name: 'edit · checkout.test.ts', kind: 'edit', l: 80.5, w: 2.3, d: '0.9s', ind: 1 },
  { name: 'pnpm test · full suite', kind: 'shell', l: 84, w: 15.2, d: '8.9s', ind: 1, waste: true },
];

// Real SDK usage, verified against products/sandbox/sdk/README.md in
// agent-dev-container. Do not invent APIs.
const sandboxSnippet = `import { Sandbox } from '@tangle-network/sandbox'

const box = await new Sandbox({
  apiKey: process.env.TANGLE_API_KEY,
}).create({ image: 'universal' })

await box.exec('claude -p "fix the flaky checkout test"')`;

const products = [
  {
    name: 'Sandboxes',
    line: 'Isolated computers for agents: shell, files, browser, any coding harness.',
    href: 'https://sandbox.tangle.tools',
    domain: 'sandbox.tangle.tools',
    hue: 'cyan',
    art: '/images/brand/cards/card-sandbox.webp',
  },
  {
    name: 'Intelligence',
    line: 'Analyze traces and compare candidate changes against held-out cases.',
    href: 'https://intelligence.tangle.tools',
    domain: 'intelligence.tangle.tools',
    hue: 'magenta',
    art: '/images/brand/cards/card-intelligence.webp',
  },
  {
    name: 'Router',
    line: 'OpenAI-compatible access to multiple model providers through one API.',
    href: 'https://router.tangle.tools',
    domain: 'router.tangle.tools',
    hue: 'indigo',
    art: '/images/brand/cards/card-inference.webp',
  },
];

// Coding harnesses preinstalled in every sandbox image. Marks are the
// canonical org avatars (GitHub); pi ships a designed monogram.
const harnesses = [
  { cmd: 'claude', name: 'Claude Code', logo: '/images/harness/claude-code.svg' },
  { cmd: 'codex', name: 'Codex', logo: '/images/harness/codex.png' },
  { cmd: 'opencode', name: 'OpenCode', logo: '/images/harness/opencode.svg' },
  { cmd: 'hermes', name: 'Hermes', logo: '/images/harness/hermes.png' },
  { cmd: 'openclaw', name: 'OpenClaw', logo: '/images/harness/openclaw.png' },
  { cmd: 'nanoclaw', name: 'NanoClaw', logo: '/images/harness/nanoclaw.png' },
  { cmd: 'kimi', name: 'Kimi Code', logo: '/images/harness/kimi-code.png' },
  { cmd: 'pi', name: 'Pi', logo: '/images/harness/pi.svg' },
];

const pricingTiers = [
  {
    name: 'Free', price: '$0', desc: 'Get started with Tangle.', cta: 'Start free',
    features: ['$2 in monthly credit', '1 concurrent sandbox', '60 requests/minute', 'Community support'],
  },
  {
    name: 'Pro', price: '$29', desc: 'Production usage for individuals and small teams.', cta: 'Start Pro', recommended: true,
    features: ['$30 in monthly credit', '25 concurrent sandboxes', '300 requests/minute', 'Overage at the same per-second rates', 'Priority scheduling'],
  },
  {
    name: 'Enterprise', price: '$99', desc: 'High-scale workloads and dedicated support.', cta: 'Choose Enterprise',
    features: ['$120 in monthly credit', 'Unlimited concurrent sandboxes', 'Discounted compute rates', '1000 requests/minute', 'Dedicated support'],
  },
];
---

<BaseLayout
  title="AI Agent Infrastructure for Building and Running Agents"
  description="Developers and teams use Tangle sandboxes, runtime, router, integrations, and observability to build and inspect AI agents."
  image="/images/og-self-improving-agents.png"
  imageAlt="Tangle"
  homeSpeedPercent={homeSpeedPercent}
  homeBuildRevision={homeBuildRevision}
>
  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

  <!-- No-JS: the scroll stories can't run, so collapse both pinned tracks to a
       plain visible stack. Only renders with JS off; !important beats the
       scoped base rules that hide un-revealed stages. -->
  <noscript>
    <style>
      .sb-flow, .intel-flow { height: auto !important; }
      .sb-sticky, .intel-sticky { position: static !important; height: auto !important; overflow: visible !important; padding: 4.5rem 0 !important; }
      .sb-tile { opacity: 1 !important; }
      .sb-line { stroke-dashoffset: 0 !important; }
      .sb-node, .sb-node-label { opacity: 1 !important; }
      .istage-area { min-height: 0 !important; }
      .istage { position: static !important; inset: auto !important; grid-template-columns: 1fr !important; gap: 1.4rem !important; opacity: 1 !important; pointer-events: auto !important; margin-bottom: 2.5rem !important; }
      .istage .icopy, .istage .ipane { opacity: 1 !important; transform: none !important; }
      .ship-fan { position: static !important; height: auto !important; display: grid !important; gap: 1rem !important; }
      .ship-card { position: static !important; width: auto !important; opacity: 1 !important; transform: none !important; }
      .intel-step { display: none !important; }
    </style>
  </noscript>

  <!-- ============================ HERO (dark, video) ============================ -->
  <section class="hero" aria-labelledby="hero-title" data-cta-placement="hero">
    <div class="hero-art" aria-hidden="true">
      <canvas id="hero-knot"></canvas>
      <img class="hero-poster" src="/images/brand/knot-poster.webp" alt="" loading="eager" />
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="shell">
      <div class="hero-copy">
        <h1 id="hero-title">
          Run agents in sandboxes&nbsp;
          <span class="grad-text">with routing and traces.</span>
        </h1>
        <p>
          Tangle gives developers and teams infrastructure for AI agents: isolated sandboxes,
          an agent runtime, model routing, approved integrations, and observability. Build an
          agent, run it, and inspect its traces before changing its behavior.
        </p>
        <p class="hero-developer">Sandbox and Router are live developer entry points. A hospitality guest-request assistant is the first packaged use case, in preview.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#infrastructure">Explore infrastructure</a>
          <a class="btn btn-ghost" href="https://docs.tangle.tools" target="_blank" rel="noopener noreferrer">Developer docs</a>
        </div>
      </div>
    </div>
  </section>

  <section id="assistant-preview" class="assistant-preview" aria-labelledby="assistant-preview-title">
    <div class="shell assistant-preview-inner">
      <h2 id="assistant-preview-title">Hospitality guest requests are the first hosted assistant preview</h2>
      <p>
        This preview aims to turn a guest message into an assigned task and alert a person
        when work is overdue. The full request-to-resolution flow is still being tested with
        a design partner. It is a hospitality workflow preview, not a general assistant platform.
      </p>
    </div>
  </section>

  <!-- ========= SANDBOX (dark): harnesses run, traces emit ========= -->
  <section class="sb-section" aria-labelledby="sb-title">
    <div class="sb-flow">
      <div class="sb-sticky">
        <div class="shell">
          <div class="sb-head">
            <h2 id="sb-title">Give every agent an isolated workspace.</h2>
            <p>
              Coding harnesses, tool-calling agents, long-running workflows: each gets a real
              computer in a Tangle Sandbox with files, a terminal, and browser access.
            </p>
          </div>

          <div class="sb-rail" aria-label="Coding harnesses preinstalled in every sandbox">
            {harnesses.map((h, i) => (
              <div class="sb-tile" data-i={i}>
                <img class="sb-logo" src={h.logo} alt={`${h.name} mark`} width="48" height="48" loading="lazy" />
                <span class="sb-name">{h.name}</span>
                <code class="mono sb-cmd">$ {h.cmd}</code>
                <span class="sb-run mono">running</span>
              </div>
            ))}
          </div>

          <svg class="sb-lines" viewBox="0 0 1160 300" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="sb-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#A5AAFC" />
                <stop offset="100%" stop-color="#4F46E5" />
              </linearGradient>
            </defs>
            {harnesses.map((_, i) => (
              <path
                class="sb-line"
                d={`M ${73 + i * 145} 0 C ${73 + i * 145} 150, 580 170, 580 268`}
                fill="none"
                stroke="url(#sb-grad)"
                stroke-width="2"
                stroke-linecap="round"
                pathLength="1"
              />
            ))}
            <circle class="sb-node" cx="580" cy="272" r="6" fill="#6366F1" />
            <text class="sb-node-label" x="596" y="277">traces</text>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ========= INTELLIGENCE (paper): split scroll story ========= -->
  <section class="intel-section" aria-labelledby="intel-title">
    <div class="intel-flow" data-stage="0">
      <div class="intel-sticky">
        <div class="shell">
          <h2 id="intel-title" class="intel-h2">Turn each run into a reviewable record.</h2>

          <div class="istage-area">
            <!-- stage 0: the trace -->
            <div class="istage istage-0" aria-label="Stage one: capture an agent run">
              <div class="icopy">
                <h3>Capture the run</h3>
                <p>
                  Record model calls, tool use, timing, tokens, and cost so a result can be
                  inspected after the agent finishes.
                </p>
              </div>
              <div class="ipane">
                <div class="wf-card">
                  <div class="wf-head mono"><span>illustrative trace · checkout-agent</span><span>38.2s</span></div>
                  {spans.map((sp) => (
                    <div class={`wf-row ind-${sp.ind}`}>
                      <span class="wf-name mono">{sp.name}</span>
                      <span class="wf-track"><i class={`wf-bar k-${sp.kind}`} style={`--l:${sp.l}%; --w:${sp.w}%`}></i></span>
                      <span class="wf-dur mono">{sp.d}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- stage 1: the analysis -->
            <div class="istage istage-1" aria-label="Stage two: compare repeated failures">
              <div class="icopy">
                <h3>Find what repeats</h3>
                <p>
                  Analyze multiple runs to find recurring failures and expensive steps worth
                  testing as candidate changes.
                </p>
              </div>
              <div class="ipane">
                <div class="wf-card wf-analyzed">
                  <div class="wf-head mono"><span>illustrative trace · checkout-agent</span><span>38.2s</span></div>
                  {spans.map((sp) => (
                    <div class={`wf-row ind-${sp.ind} ${sp.waste ? 'is-waste' : ''}`}>
                      <span class="wf-name mono">{sp.name}</span>
                      <span class="wf-track"><i class={`wf-bar k-${sp.kind}`} style={`--l:${sp.l}%; --w:${sp.w}%`}></i></span>
                      <span class="wf-dur mono">{sp.d}</span>
                    </div>
                  ))}
                </div>
                <aside class="ann-card">
                  <span class="mono ann-label">trace review</span>
                  <p>
                    Illustrative analysis: 33.1s of this 38.2s run re-ran tests that could not have
                    changed. Compare the proposed fix on held-out cases before adopting it.
                  </p>
                </aside>
              </div>
            </div>

            <!-- stage 2: review proposed changes -->
            <div class="istage istage-2" aria-label="Stage three: review proposed changes in existing tools">
              <div class="icopy">
                <h3>Review changes where you work</h3>
                <p>
                  Turn measured findings into a pull request, issue, skill proposal, or team
                  summary. A person decides what ships.
                </p>
              </div>
              <div class="ipane">
                <div class="ship-fan">
                  <article class="ship-card">
                    <header><img src="/images/logos/github.svg" alt="GitHub" width="22" height="22" /><b>Pull request</b><span class="chip chip-merged">example</span></header>
                    <p class="mono ship-ref">tangle/faster-test-loop</p>
                    <p>Run the failing test file after each edit. Full suite once before finishing.</p>
                  </article>
                  <article class="ship-card">
                    <header><img src="/images/logos/linear.svg" alt="Linear" width="22" height="22" /><b>Issue</b><span class="chip chip-done">example</span></header>
                    <p class="mono ship-ref">TAN-312</p>
                    <p>Adopt the failing-test-first loop across all coding agents.</p>
                  </article>
                  <article class="ship-card">
                    <header><img src="/brand/tangle-icon-filled.svg" alt="Tangle" width="22" height="22" /><b>Skill proposal</b><span class="chip chip-live">review</span></header>
                    <p class="mono ship-ref">skills/testing.md</p>
                    <p>Proposed testing guidance is ready for review.</p>
                  </article>
                  <article class="ship-card">
                    <header><img src="/images/logos/slack.svg" alt="Slack" width="22" height="22" /><b>#eng-agents</b><span class="chip chip-note">draft</span></header>
                    <p class="mono ship-ref">summary</p>
                    <p>Candidate passed the selected cases; review the results before rollout.</p>
                  </article>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="intel-step" data-step="0"></div>
      <div class="intel-step" data-step="1"></div>
      <div class="intel-step" data-step="2"></div>
    </div>
  </section>

  <!-- ==================== PRODUCTS (paper, gradient cards) ==================== -->
  <section id="infrastructure" class="products-section" aria-labelledby="products-title" data-cta-placement="product-cards">
    <div class="shell">
      <h2 id="products-title" class="statement reveal">
        Infrastructure for <span class="statement-grad">each agent run</span>.
      </h2>
      <p class="developer-path reveal">
        The five layers are sandbox, runtime, router, integrations, and observability.{' '}
        <a href="https://docs.tangle.tools/sandbox">Sandbox</a>{' '}and{' '}
        <a href="https://docs.tangle.tools/gateway">Router</a> have live developer entry points.
        Runtime executes agent profiles in sandboxes. Integrations connect approved external
        services through grants.{' '}
        <a href="https://docs.tangle.tools/intelligence">Intelligence</a> is the hosted dashboard for agent traces.
        Send traces through OpenTelemetry or a Tangle SDK, or run an agent in Sandbox to record its work there.
      </p>
      <p class="developer-path reveal">
        Tangle plans an on-prem infrastructure option for teams that must keep agents and data
        in their own environment. An installation path is not available today.
      </p>

      <div class="product-cards reveal">
        {products.map((p) => (
          <a class={`p-card p-card-${p.hue}`} href={p.href} target="_blank" rel="noopener noreferrer">
            <div class="p-card-art" aria-hidden="true"><img src={p.art} alt="" loading="lazy" decoding="async" width="600" height="400" /></div>
            <div class="p-card-body">
              <h3>{p.name}</h3>
              <p>{p.line}</p>
              <span class="p-card-link mono">{p.domain}</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>


  <!-- ==================== PRICING (paper) ==================== -->
  <section class="pricing" aria-labelledby="pricing-title" data-cta-placement="pricing">
    <div class="shell">
      <div class="pricing-head reveal">
        <h2 id="pricing-title">Simple, usage-based pricing.</h2>
        <p>Start free. Every plan includes monthly credit and pays the same per-second compute rates.</p>
      </div>
      <div class="tiers reveal">
        {pricingTiers.map((t) => (
          <div class={`tier${t.recommended ? ' tier-rec' : ''}`}>
            {t.recommended && <span class="tier-badge mono">Recommended</span>}
            <span class="tier-name">{t.name}</span>
            <div class="tier-price"><strong>{t.price}</strong><span class="mono">/mo</span></div>
            <span class="tier-desc">{t.desc}</span>
            <ul class="tier-feats">
              {t.features.map((f) => (
                <li><span class="tick" aria-hidden="true">✓</span>{f}</li>
              ))}
            </ul>
            <a class={`tier-cta${t.recommended ? ' tier-cta-rec' : ''}`} href="https://id.tangle.tools/app/plans" target="_blank" rel="noopener noreferrer">{t.cta}</a>
          </div>
        ))}
      </div>
      <p class="pricing-note mono reveal">Billed at <a href="https://id.tangle.tools/app/plans" target="_blank" rel="noopener noreferrer">id.tangle.tools</a>. One key for inference, compute, and intelligence. Ask about Enterprise support and availability at <a href="mailto:hello@tangle.tools">hello@tangle.tools</a>.</p>
    </div>
  </section>

  <!-- ==================== CLOSE (dark) ==================== -->
  <section class="close-section" aria-labelledby="close-title" data-cta-placement="closing">
    <div class="shell close-inner">
      <h2 id="close-title">Build agents on <span class="grad-text-inline">Tangle infrastructure.</span></h2>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#infrastructure">Explore infrastructure</a>
        <a class="btn btn-ghost" href="https://docs.tangle.tools" target="_blank" rel="noopener noreferrer">Developer docs</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  import { startMotion } from '../scripts/homepage-motion.mjs';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = window.matchMedia('(min-width: 861px)').matches;
  const flow = document.querySelector('.intel-flow');

  startMotion(reduced, flow);
  const loadRum = () => import('../scripts/homepage-rum.mjs')
    .then(({ startRum }) => startRum())
    .catch(() => { window.__homeRumReady = false; });
  const afterLoad = () => {
    if ('requestIdleCallback' in window) requestIdleCallback(loadRum, { timeout: 1500 });
    else setTimeout(loadRum, 0);
  };
  if (document.readyState === 'complete') afterLoad();
  else addEventListener('load', afterLoad, { once: true });

  if (document.documentElement.dataset.homeSpeed === 'fast') {
    document.documentElement.classList.add('static-hero');
  } else {
    import('../scripts/homepage-hero-3d.mjs')
      .then(({ startHero }) => startHero(reduced, wide))
      .catch(() => document.documentElement.classList.add('static-hero'));
  }
</script>

<style>
  /* ---------- shared ---------- */
  .shell {
    position: relative;
    z-index: 1;
    width: min(78rem, 90vw);
    margin: 0 auto;
  }

  .mono {
    font-family: var(--font-mono);
    font-feature-settings: 'tnum';
  }

  section h1,
  section h2,
  section h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  section h2 {
    font-size: clamp(2rem, 3vw, 2.9rem);
    line-height: 1.1;
  }

  /* Product sections carry more display presence than utility sections. */
  .run-head h2,
  .loop-head h2,
  .wire-copy h2 {
    font-size: clamp(2.3rem, 3.6vw, 3.5rem);
    letter-spacing: -0.032em;
  }

  :global(html.js) .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.2, 0.6, 0.2, 1), transform 0.6s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  :global(html.js) .reveal.in-view {
    opacity: 1;
    transform: none;
  }

  .aurora {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 1;
  }


  .grad-text {
    display: block;
    background-image: linear-gradient(92deg, #C7C9F5 0%, #818CF8 40%, #4F46E5 75%, #C7C9F5 100%);
    background-size: 220% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: #A5AAFC; /* fallback */
    animation: gradDrift 9s ease-in-out infinite alternate;
  }

  @keyframes gradDrift {
    from { background-position: 0% 50%; }
    to { background-position: 100% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .grad-text { animation: none; }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.8rem;
    padding: 0.75rem 1.3rem;
    border-radius: 9px;
    font-family: var(--font-sans);
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.16s ease, background 0.16s ease, border-color 0.16s ease;
  }

  .btn:hover { transform: translateY(-1px); }

  .btn-primary {
    background: #4f46e5;
    border: 1px solid #6d63ff;
    color: #ffffff;
  }

  .btn-ghost {
    background: rgba(237, 237, 244, 0.06);
    border: 1px solid rgba(237, 237, 244, 0.18);
    color: #ffffff;
  }

  .code-pane {
    overflow: hidden;
    border: 1px solid rgba(199, 201, 238, 0.14);
    border-radius: 10px;
    background: #14132a;
  }

  .pane-head {
    display: flex;
    align-items: center;
    min-height: 2.7rem;
    padding: 0 1.1rem;
    border-bottom: 1px solid rgba(199, 201, 238, 0.1);
    color: rgba(237, 237, 244, 0.6);
    font-size: 0.92rem;
  }

  .code-pane pre {
    margin: 0;
    padding: 1.2rem 1.3rem;
    overflow-x: auto;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(237, 237, 244, 0.88);
  }

  .add { color: #6ee7b7; display: block; }
  .del { color: #fb7185; display: block; }

  /* ---------- hero (dark, video) ---------- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 82vh;
    overflow: hidden;
    background: linear-gradient(160deg, #080814 0%, #0c0b1d 52%, #11122d 100%);
    border-bottom: 1px solid rgba(199, 201, 238, 0.1);
  }

  .hero-art {
    position: absolute;
    inset: 0;
  }

  #hero-knot {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s ease;
  }

  #hero-knot.ready { opacity: 1; }

  .hero-poster {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% center;
    opacity: 0.92;
  }

  :global(html.static-hero) #hero-knot { display: none; }
  :global(html.static-hero) .hero-poster { display: block; }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(8, 8, 20, 0.98) 0%, rgba(8, 8, 20, 0.94) 54%, rgba(8, 8, 20, 0.55) 70%, rgba(8, 8, 20, 0) 87%),
      linear-gradient(180deg, rgba(8, 8, 20, 0) 60%, rgba(8, 8, 20, 0.42) 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    #hero-knot { display: none; }
    .hero-poster { display: block; }
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    padding: 7.5rem 0 6rem;
  }

  .hero-eyebrow {
    display: block;
    margin-bottom: 1.2rem;
    color: #aeb3ff;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    color: #ffffff;
    font-size: clamp(3.2rem, 5.6vw, 5.6rem);
    line-height: 1.04;
    letter-spacing: -0.036em;
  }

  .hero-copy > p:first-of-type {
    max-width: 44rem;
    margin: 1.5rem 0 0;
    color: rgba(240, 240, 250, 0.88);
    font-size: clamp(1.25rem, 1.6vw, 1.55rem);
    line-height: 1.6;
  }

  .hero-developer {
    margin-top: 1rem;
    color: rgba(240, 240, 250, 0.76);
    font-size: 1rem;
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .assistant-preview {
    background: var(--paper-0);
    color: var(--ink);
  }

  .assistant-preview-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: center;
    gap: 2rem;
    padding: 3rem 0;
  }

  .assistant-preview h2 {
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
    line-height: 1.15;
  }

  .assistant-preview p {
    color: var(--ink-secondary);
    font-size: 1.12rem;
    line-height: 1.55;
  }

  .developer-path {
    max-width: 48rem;
    margin: 1.5rem 0 0;
    color: var(--ink-secondary);
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .developer-path a {
    color: #4338ca;
    text-underline-offset: 0.2em;
  }
  /* ---------- intelligence split story (paper) ---------- */
  .intel-section {
    background: var(--paper-0);
    color: var(--ink);
  }

  .intel-flow { position: relative; height: 280vh; }

  .intel-sticky {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    height: 100vh;
    overflow: hidden;
  }

  .intel-step { position: absolute; width: 1px; height: 27%; left: 0; }
  .intel-step[data-step="0"] { top: 0; }
  .intel-step[data-step="1"] { top: 27%; }
  .intel-step[data-step="2"] { top: 54%; }

  .intel-h2 {
    color: var(--ink);
    font-size: clamp(2.3rem, 3.6vw, 3.5rem);
    letter-spacing: -0.032em;
  }

  .istage-area { position: relative; min-height: 32rem; margin-top: 2.4rem; }

  .istage {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(16rem, 0.6fr) minmax(0, 1.4fr);
    gap: 3.5rem;
    align-items: center;
    opacity: 0;
    pointer-events: none;
  }

  .istage .icopy,
  .istage .ipane {
    transition: opacity 0.55s cubic-bezier(0.2, 0.6, 0.2, 1), transform 0.55s cubic-bezier(0.2, 0.6, 0.2, 1);
    opacity: 0;
  }

  .istage .icopy { transform: translateX(-26px); }
  .istage .ipane { transform: translateX(52px); }

  .intel-flow[data-stage="0"] .istage-0,
  .intel-flow[data-stage="1"] .istage-1,
  .intel-flow[data-stage="2"] .istage-2 { opacity: 1; pointer-events: auto; }

  .intel-flow[data-stage="0"] .istage-0 .icopy,
  .intel-flow[data-stage="0"] .istage-0 .ipane,
  .intel-flow[data-stage="1"] .istage-1 .icopy,
  .intel-flow[data-stage="1"] .istage-1 .ipane,
  .intel-flow[data-stage="2"] .istage-2 .icopy,
  .intel-flow[data-stage="2"] .istage-2 .ipane { opacity: 1; transform: none; }

  /* exited stages leave to the left */
  .intel-flow[data-stage="1"] .istage-0 .icopy,
  .intel-flow[data-stage="2"] .istage-0 .icopy,
  .intel-flow[data-stage="2"] .istage-1 .icopy { transform: translateX(26px); }
  .intel-flow[data-stage="1"] .istage-0 .ipane,
  .intel-flow[data-stage="2"] .istage-0 .ipane,
  .intel-flow[data-stage="2"] .istage-1 .ipane { transform: translateX(-52px); }

  .icopy h3 {
    color: var(--ink);
    font-size: clamp(1.5rem, 2vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.024em;
  }

  .icopy p {
    margin: 0.9rem 0 0;
    color: var(--ink-secondary);
    font-size: clamp(1.15rem, 1.4vw, 1.35rem);
    line-height: 1.6;
  }

  /* static fallback */
  .intel-flow.static { height: auto; }
  .intel-flow.static .intel-sticky { position: static; height: auto; overflow: visible; padding: 4.5rem 0; }
  .intel-flow.static .istage-area { min-height: 0; }
  .intel-flow.static .istage {
    position: static;
    grid-template-columns: 1fr;
    gap: 1.2rem;
    opacity: 1;
    pointer-events: auto;
    margin-bottom: 3rem;
  }
  .intel-flow.static .icopy,
  .intel-flow.static .ipane { opacity: 1; transform: none; }
  .intel-flow.static .intel-step { display: none; }

  /* ---- session-trace waterfall ---- */
  .wf-card {
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #d8d8ea;
    border-radius: 14px;
    box-shadow: 0 28px 80px rgba(79, 70, 229, 0.1);
  }

  .wf-head {
    display: flex;
    justify-content: space-between;
    padding: 0.85rem 1.4rem;
    border-bottom: 1px solid #ececf6;
    color: var(--ink-muted);
    font-size: 0.88rem;
  }

  .wf-row {
    display: grid;
    grid-template-columns: minmax(11rem, 16rem) minmax(0, 1fr) 3.6rem;
    gap: 1rem;
    align-items: center;
    padding: 0.42rem 1.4rem;
  }

  .wf-row:first-of-type { padding-top: 0.9rem; }
  .wf-row:last-of-type { padding-bottom: 1.1rem; }

  .wf-name {
    color: var(--ink);
    font-size: 0.86rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ind-1 .wf-name { padding-left: 1.2rem; }

  .wf-track {
    position: relative;
    height: 0.85rem;
    background: var(--paper-0);
    border-radius: 4px;
  }

  .wf-bar {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--l);
    width: var(--w);
    border-radius: 4px;
  }

  .k-run { background: linear-gradient(90deg, #6366F1, #818CF8); opacity: 0.35; }
  .k-llm { background: #818CF8; }
  .k-tool { background: #A5AAFC; }
  .k-shell { background: #4F46E5; }
  .k-edit { background: #4338CA; }

  .wf-dur {
    color: var(--ink-muted);
    font-size: 0.8rem;
    text-align: right;
  }

  /* analyzed variant */
  .wf-analyzed .wf-row:not(.is-waste):not(:first-of-type) { opacity: 0.42; }
  .wf-analyzed .is-waste .wf-bar {
    box-shadow: 0 0 0 2px rgba(190, 18, 60, 0.45), 0 0 18px rgba(190, 18, 60, 0.25);
  }
  .wf-analyzed .is-waste .wf-name,
  .wf-analyzed .is-waste .wf-dur { color: #be123c; }

  .ann-card {
    width: min(34rem, 92%);
    margin: -1.4rem auto 0;
    position: relative;
    padding: 1.15rem 1.5rem;
    background: #ffffff;
    border: 1px solid #d8d8ea;
    border-left: 3px solid #4F46E5;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(79, 70, 229, 0.16);
  }

  .ann-label {
    color: #4F46E5;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .ann-card p {
    margin: 0.5rem 0 0;
    color: var(--ink);
    font-size: 1.08rem;
    line-height: 1.55;
  }

  /* ---- ship fan ---- */
  /* Dealt-cards canvas: each artifact lands tilted as scroll progresses.
     JS drives per-card transforms from the CHOREO config (top of script);
     these rules only define the resting surface and the static fallback. */
  .ship-fan {
    position: relative;
    height: 24rem;
  }

  .ship-card {
    position: absolute;
    width: min(21rem, 78%);
    padding: 1.15rem 1.3rem 1.2rem;
    background: #ffffff;
    border: 1px solid #d8d8ea;
    border-radius: 13px;
    box-shadow: 0 24px 60px rgba(25, 28, 60, 0.16);
    opacity: 0;
    will-change: transform, opacity;
  }

  .ship-card:nth-child(1) { top: 0; left: 2%; }
  .ship-card:nth-child(2) { top: 8%; right: 0; }
  .ship-card:nth-child(3) { bottom: 6%; left: 8%; }
  .ship-card:nth-child(4) { bottom: 0; right: 5%; }

  .intel-flow.static .ship-fan { height: auto; display: grid; gap: 1rem; }
  .intel-flow.static .ship-card { position: static; width: auto; opacity: 1; transform: none; }

  .ship-card header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .ship-card header img {
    width: 22px;
    height: 22px;
    border-radius: 5px;
  }

  /* dark marks need a dark chip behind them on white cards */
  .ship-card header img[src*="github"],
  .ship-card header img[src*="slack"] {
    padding: 3px;
    background: #11122d;
  }

  .ship-card header b {
    color: var(--ink);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .chip {
    margin-left: auto;
    padding: 0.18rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .chip-merged { background: rgba(99, 102, 241, 0.12); color: #4338CA; font-weight: 700; }
  .chip-done { background: rgba(4, 120, 87, 0.1); color: #047857; font-weight: 600; }
  .chip-live { background: rgba(129, 140, 248, 0.14); color: #4F46E5; font-weight: 600; }
  .chip-note { background: var(--paper-1); color: var(--ink-muted); }

  .ship-ref { margin: 0.55rem 0 0; color: var(--ink-muted); font-size: 0.82rem; }

  .ship-card > p:last-child {
    margin: 0.4rem 0 0;
    color: var(--ink-secondary);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  /* ---------- products (paper, gradient cards) ---------- */
  .products-section {
    background: var(--paper-0);
    color: var(--ink);
    padding: 5.5rem 0 5rem;
  }

  .statement {
    max-width: 56rem;
    color: var(--ink);
    font-size: clamp(2.2rem, 3.6vw, 3.3rem);
    line-height: 1.1;
  }

  .statement-grad {
    background-image: linear-gradient(92deg, #818CF8 0%, #6366F1 50%, #4F46E5 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: #4F46E5; /* fallback */
  }

  @supports not (background-clip: text) {
    .statement-grad { color: #4F46E5; -webkit-text-fill-color: currentColor; }
  }

  .product-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
    margin-top: 2.6rem;
  }

  .p-card {
    position: relative;
    display: flex;
    min-height: 22rem;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgba(25, 28, 60, 0.14);
    text-decoration: none;
    box-shadow: 0 22px 60px rgba(25, 28, 60, 0.14);
    transition: transform 0.25s cubic-bezier(0.2, 0.6, 0.2, 1), box-shadow 0.25s ease;
  }

  .p-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 32px 80px rgba(25, 28, 60, 0.22);
  }

  /* The control path retains the original card backgrounds. */
  .p-card-art {
    position: absolute;
    inset: 0;
    background-color: #0c0b1d;
    background-size: cover;
    background-position: center;
    transition: transform 0.4s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .p-card:hover .p-card-art { transform: scale(1.04); }

  :global(html:not([data-home-speed='fast'])) .p-card-cyan .p-card-art {
    background-image: url('/images/brand/cards/card-sandbox.webp');
  }

  :global(html:not([data-home-speed='fast'])) .p-card-magenta .p-card-art {
    background-image: url('/images/brand/cards/card-intelligence.webp');
  }

  :global(html:not([data-home-speed='fast'])) .p-card-indigo .p-card-art {
    background-image: url('/images/brand/cards/card-inference.webp');
  }

  :global(html:not([data-home-speed='fast'])) .p-card-art img { display: none; }

  .p-card-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .p-card-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.45rem;
    width: 100%;
    padding: 1.4rem 1.4rem 1.3rem;
    background: linear-gradient(180deg, transparent 0%, rgba(8, 8, 20, 0.32) 42%, rgba(8, 8, 20, 0.78) 100%);
  }

  .p-card-body h3 {
    color: #ffffff;
    font-size: 1.8rem;
    letter-spacing: -0.022em;
  }

  .p-card-body p {
    margin: 0;
    max-width: 24rem;
    color: rgba(240, 240, 250, 0.9);
    font-size: 1.18rem;
    line-height: 1.55;
  }

  .p-card-link {
    margin-top: 0.6rem;
    color: rgba(240, 240, 250, 0.66);
    font-size: 0.92rem;
  }

  .p-card:hover .p-card-link { color: #ffffff; }

  /* ---------- sandbox chapter (dark, scroll-driven) ---------- */
  .sb-section {
    background: linear-gradient(180deg, #0c0b1d 0%, #11122d 100%);
    border-top: 1px solid rgba(199, 201, 238, 0.08);
  }

  .sb-flow {
    position: relative;
    height: 180vh;
  }

  .sb-sticky {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    height: 100vh;
    overflow: hidden;
  }

  .sb-head {
    display: grid;
    grid-template-columns: minmax(14rem, 0.55fr) minmax(0, 1.45fr);
    gap: 2.5rem;
    align-items: start;
  }

  .sb-head h2 {
    color: #ffffff;
    font-size: clamp(2.3rem, 3.6vw, 3.5rem);
    letter-spacing: -0.032em;
  }

  .sb-head p {
    margin: 0;
    color: rgba(237, 237, 244, 0.8);
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    line-height: 1.6;
    max-width: 46rem;
  }

  .sb-rail {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.7rem;
    margin-top: 2.6rem;
  }

  .sb-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    padding: 1.1rem 0.6rem 0.9rem;
    border: 1px solid rgba(199, 201, 238, 0.12);
    border-radius: 12px;
    background: #12112a;
    text-align: center;
    opacity: 0.38;
    transition: opacity 0.45s ease, border-color 0.45s ease, box-shadow 0.45s ease, transform 0.45s ease;
  }

  .sb-tile.on {
    opacity: 1;
    border-color: rgba(129, 140, 248, 0.45);
    box-shadow: 0 10px 40px rgba(99, 102, 241, 0.16);
    transform: translateY(-3px);
  }

  .sb-logo {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    object-fit: cover;
    box-shadow: inset 0 0 0 1px rgba(199, 201, 238, 0.14);
  }

  .sb-name {
    color: #ededf4;
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .sb-cmd {
    color: rgba(198, 200, 226, 0.66);
    font-size: 0.85rem;
  }

  .sb-run {
    color: #A5AAFC;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .sb-tile.on .sb-run { opacity: 1; }

  .sb-lines {
    display: block;
    width: 100%;
    height: clamp(11rem, 24vh, 15rem);
    margin-top: 0.4rem;
  }

  .sb-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .sb-node {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .sb-flow.done .sb-node {
    opacity: 1;
    filter: drop-shadow(0 0 10px rgba(99, 102, 241, 0.9));
  }

  .sb-node-label {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: rgba(198, 200, 226, 0.7);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .sb-flow.done .sb-node-label { opacity: 1; }

  /* static fallback */
  .sb-flow.static { height: auto; }
  .sb-flow.static .sb-sticky { position: static; height: auto; padding: 4.5rem 0; }
  .sb-flow.static .sb-tile { opacity: 1; }
  .sb-flow.static .sb-tile .sb-run { opacity: 0; }
  .sb-flow.static .sb-line { stroke-dashoffset: 0; }
  .sb-flow.static .sb-node, .sb-flow.static .sb-node-label { opacity: 1; }

  /* ---------- intelligence scroll flow (paper) ---------- */
  .intel-section {
    background: var(--paper-0);
    color: var(--ink);
    padding: 6.5rem 0 0;
  }

  .intel-head {
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
  }

  .intel-head h2 {
    color: var(--ink);
    font-size: clamp(2.3rem, 3.6vw, 3.5rem);
    letter-spacing: -0.032em;
  }

  .intel-head p {
    margin: 1.2rem 0 0;
    color: var(--ink-secondary);
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    line-height: 1.6;
  }

  .intel-flow {
    position: relative;
    height: 280vh;
  }

  .intel-sticky {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    overflow: hidden;
  }

  .intel-step {
    position: absolute;
    width: 1px;
    height: 33.4%;
    left: 0;
  }

  .intel-step[data-step="0"] { top: 0; }
  .intel-step[data-step="1"] { top: 27%; }
  .intel-step[data-step="2"] { top: 54%; }

  .stage-nav {
    display: flex;
    gap: 2.2rem;
    margin-bottom: 2.4rem;
    padding: 0;
    list-style: none;
  }

  .stage-nav li {
    position: relative;
    padding-bottom: 0.5rem;
    color: var(--ink-muted);
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .stage-nav li::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 2px;
    background: linear-gradient(90deg, #818CF8, #4F46E5);
    transition: right 0.45s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .intel-flow[data-stage="0"] .stage-nav li[data-for="0"],
  .intel-flow[data-stage="1"] .stage-nav li[data-for="1"],
  .intel-flow[data-stage="2"] .stage-nav li[data-for="2"] {
    color: var(--ink);
  }

  .intel-flow[data-stage="0"] .stage-nav li[data-for="0"]::after,
  .intel-flow[data-stage="1"] .stage-nav li[data-for="1"]::after,
  .intel-flow[data-stage="2"] .stage-nav li[data-for="2"]::after {
    right: 0;
  }

  .stage-area {
    position: relative;
    width: min(56rem, 92vw);
    min-height: 30rem;
  }

  .stage {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    opacity: 0;
    transform: translateY(56px);
    transition: opacity 0.55s cubic-bezier(0.2, 0.6, 0.2, 1), transform 0.55s cubic-bezier(0.2, 0.6, 0.2, 1);
    pointer-events: none;
  }

  .intel-flow[data-stage="0"] .stage-0,
  .intel-flow[data-stage="1"] .stage-1,
  .intel-flow[data-stage="2"] .stage-2 {
    opacity: 1;
    transform: none;
    pointer-events: auto;
