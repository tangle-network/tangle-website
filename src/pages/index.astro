---
import BaseLayout from '../layouts/BaseLayout.astro';
import SandboxQuickstart from '../components/SandboxQuickstart.astro';
import LiveDemo from '../components/LiveDemo.tsx';
import { Section, InstallRow, RunTrace, HarnessStrip, BillingProof, PlanTable, InstallCloser } from '@tangle-network/ui/marketing';
import { PLANS } from '../data/plans.mjs';
import record from '../data/runs/sandboxes/fix-a-test.json';
import source from '../examples/sandboxes/fix-a-test.mts?raw';

const description = 'Tangle runs your agents on their own Linux machines, routes their model calls and records every step.';
const run = {
  url: '/runs/sandboxes/fix-a-test.json', recordedAt: record.run.recordedAt,
  runId: record.run.id, sha: record.source.sha256,
  sdk: record.run.sdk['@tangle-network/sandbox'], costUsd: record.run.costUsd,
  ms: Math.max(...record.events.map(event => event.atMs + ('durationMs' in event ? event.durationMs : 0))),
};
const task = source.match(/box\.prompt\("([^"]+)"/)?.[1];
const repo = source.match(/git: \{ url: "https:\/\/github.com\/([^"]+)"/)?.[1];
const backend = source.match(/backend: \{ type: "([^"]+)"/)?.[1];
if (!task || !repo || !backend) throw new Error('The hero must bind to the recorded example source.');
const pricingUrl = 'https://sandbox.tangle.tools/v1/pricing/sandboxes';
const response = await fetch(pricingUrl);
if (!response.ok) throw new Error(`Sandbox pricing returned ${response.status}`);
const pricing = await response.json();
const pool = pricing.pools.general;
const rate = {
  size: '2 vCPU · 4096 MB · 2 GB',
  perHour: Math.max(pool.minChargeHourUsd, 2 * pool.cpuCoreHourUsd + 4 * pool.memoryGBHourUsd + 2 * pool.diskGBHourUsd),
  minimum: pool.minChargeHourUsd, href: pricingUrl,
};
const harnesses = [
  { id: 'claude-code', name: 'Claude Code', logo: '/images/harness/claude-code.svg' },
  { id: 'codex', name: 'Codex', logo: '/images/harness/codex.png' },
  { id: 'opencode', name: 'OpenCode', logo: '/images/harness/opencode.svg' },
  { id: 'pi', name: 'Pi', logo: '/images/harness/pi.svg' },
  { id: 'kimi-code', name: 'Kimi Code', logo: '/images/harness/kimi-code.png' },
  { id: 'hermes', name: 'Hermes', logo: '/images/harness/hermes.png' },
  { id: 'openclaw', name: 'OpenClaw', logo: '/images/harness/openclaw.png' },
  { id: 'prime', name: 'Prime Agent', logo: '/images/harness/prime-agent.png' },
];
const commands = [
  '# Claude Pro or Max: `claude setup-token` prints the token',
  'tangle secret create CLAUDE_TOKEN --value-stdin <<< "$CLAUDE_CODE_OAUTH_TOKEN"',
  'tangle sandbox create --name my-claude --backend claude-code \\\n    --cli-auth CLAUDE_TOKEN \\\n    --git-url https://github.com/your-org/your-repo --idle-timeout 900',
  'tangle agent prompt my-claude "Find the failing test and fix it." \\\n    --session fix-tests --stream',
];
const rows = [
  { credential: 'Claude subscription', billedTo: 'Your Claude plan' },
  { credential: 'ChatGPT plan or OpenAI key', billedTo: 'Your ChatGPT plan or OpenAI account' },
  { credential: 'Coding plan', billedTo: 'That provider' },
  { credential: 'Tangle Router (default)', billedTo: 'Your Tangle credit' },
];
const before = source.split('\n').find(line => line.includes('git: { url:'))!;
const after = before.replace('https://github.com/tangle-network/sandbox-demo', 'https://github.com/your-org/your-repo');
---
<BaseLayout title="Infrastructure for AI agents" description={description} bodyClass="home-page">
  <Section id="top" heading="Infrastructure for AI agents." sub={description} level={1} align="center">
    <div class="mk-actions">
      <a class="mk-btn mk-primary" href="https://sandbox.tangle.tools/dashboard/new">Create a sandbox</a>
      <InstallRow command="npm install @tangle-network/sandbox" />
    </div>
    <RunTrace run={run} events={record.events} task={task} repo={repo} backend={backend} />
  </Section>
  <Section id="agents" heading="Your coding agent, installed.">
    <HarnessStrip harnesses={harnesses} hrefTemplate="https://sandbox.tangle.tools/dashboard/new?harness={id}" liveLabel="Run Pi now, no account">
      <LiveDemo client:visible />
    </HarnessStrip>
  </Section>
  <SandboxQuickstart />
  <!-- Keys waits for the egress run record, per ship gate 2. -->
  <Section id="claude" heading="Claude Code runs on your Claude plan." sub="Store the token from `claude setup-token` once. The create request carries only the secret's name, and the agent's model calls bill to your plan." link={{ label: 'Claude Code subscription ↗', href: 'https://sandbox.tangle.tools/docs/cloud-agents/claude-code' }}>
    <BillingProof title="~/your-repo" commands={commands} rows={rows} foot="Tangle bills sandbox compute per second in every case." />
  </Section>
  <!-- Phase 2 inserts <BudgetSection /> here from the editor branch. Its chart and receipt must state only what the current run record proves. -->
  <Section id="pricing" heading="One key. One bill." sub="Compute, inference and observability draw on one balance.">
    <PlanTable plans={PLANS} names={{ free: 'Free', pro: 'Pro', enterprise: 'Team' }} rate={rate}
      actions={[{ label: 'Create a sandbox', href: 'https://sandbox.tangle.tools/dashboard/new', primary: true }, { label: 'See plans', href: 'https://id.tangle.tools/app/plans' }]}
      more={{ label: 'Cost and limits ↗', href: 'https://docs.tangle.tools/sandbox/cost' }} />
  </Section>
  <InstallCloser heading="Run Claude Code on your public repo." file={{ path: 'sandboxes/fix-a-test.mts', source }}
    line={source.split('\n').findIndex(line => line === before) + 1} before={before} after={after}
    commands={['npm install @tangle-network/sandbox', 'export TANGLE_API_KEY=sk-tan-…', 'npx tsx fix-a-test.mts']}
    actions={[{ label: 'Get an API key', href: 'https://sandbox.tangle.tools/dashboard/api-keys' }, { label: 'Copy fix-a-test.mts', copy: source }]} />
</BaseLayout>
<script>
  // Keep the existing live session state machine; only its ready action changes.
  const slot = document.querySelector('.mk-live-slot');
  if (slot) {
    const update = () => {
      const button = slot.querySelector('[data-track="demo-start"]');
      if (button?.textContent === 'Try Pi live') button.textContent = 'Run Pi now, no account';
    };
    new MutationObserver(update).observe(slot, { childList: true, subtree: true });
    update();
  }
</script>
