---
import '@fontsource-variable/source-serif-4/wght.css';
import FleetRun from '../components/FleetRun.astro';
import BenchmarkResult from '../components/BenchmarkResult.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SandboxQuickstart from '../components/SandboxQuickstart.astro';
import { loadCatalog } from '../data/harness-catalog.mjs';
import { PLANS, formatUsdCents, planPrice } from '../data/plans.mjs';

const canonicalUrl = 'https://tangle.tools/';
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${canonicalUrl}#organization`,
      name: 'Tangle',
      legalName: 'Tangle Technologies, Inc.',
      url: canonicalUrl,
      logo: 'https://tangle.tools/icons/tangle-icon-512.png',
      description:
        'Tangle provides isolated runtimes, model routing, browser automation, and evaluation tools for AI agents.',
      sameAs: [
        'https://twitter.com/tangle_network',
        'https://github.com/tangle-network',
        'https://www.youtube.com/@TangleNetwork',
        'https://discord.com/invite/cv8EfJu3Tn',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalUrl}#website`,
      name: 'Tangle',
      url: canonicalUrl,
      publisher: { '@id': `${canonicalUrl}#organization` },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: 'Run AI agents',
      description:
        'Tangle gives coding agents isolated machines, routes their model calls and records each run.',
      isPartOf: { '@id': `${canonicalUrl}#website` },
      about: { '@id': `${canonicalUrl}#organization` },
      inLanguage: 'en-US',
    },
  ],
};

const pricing = await fetch('https://sandbox.tangle.tools/v1/pricing/sandboxes');
if (!pricing.ok) throw new Error(`Sandbox pricing returned ${pricing.status}`);
const rate = (await pricing.json()).pools.general;
const hourlyPrice = new Intl.NumberFormat('en-US', {
  style: 'currency', currency: 'USD', maximumFractionDigits: 4,
}).format(rate.minChargeHourUsd);
type Agent = { id: string; name: string; logo?: string | null; launchHref?: string | null };
const { catalog } = await loadCatalog();
const agents: Agent[] = catalog.harnesses;
const launchable = agents.filter((agent): agent is Agent & { launchHref: string } => Boolean(agent.launchHref));
const cliAgents = agents.filter((agent) => !agent.launchHref);

---

<BaseLayout
  title="Run coding agents across clouds"
  bodyClass="company-home"
  description="Tangle gives coding agents isolated machines, routes their model calls and records each run."
>
  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />


  <section class="hero" aria-labelledby="hero-title" data-cta-placement="hero">
    <picture class="hero-art">
      <source media="(max-width: 700px)" srcset="/images/company-switchyard-mobile.webp" width="760" height="597" />
      <img src="/images/company-switchyard.webp" width="1654" height="923" alt="" fetchpriority="high" />
    </picture>
    <div class="shell">
      <div class="hero-copy">
        <h1 id="hero-title">Run your coding agent across clouds.</h1>
        <p>Give Claude Code or Codex a job in your repo. It keeps working when you close your laptop.</p>
        <a class="hero-action" href="#quickstart">Explore the examples <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <SandboxQuickstart />

  <section class="routing" aria-labelledby="routing-title">
    <div class="shell routing-spread">
      <FleetRun />
      <div class="routing-copy">
        <h2 id="routing-title">Put two models to work on the same repo.</h2>
        <p>Two agents use DeepSeek Flash to check imports and write docs. While they work, a third uses GLM to fix a failing test. Each gets its own checkout.</p>
        <a class="hero-action" href="/?example=fleets%2Fmix-models#quickstart">See how to split the work <span aria-hidden="true">↑</span></a>
      </div>
    </div>
  </section>

  <section class="run-story" data-theme="website" aria-labelledby="run-story-title">
    <div class="shell routing-spread">
      <div class="routing-copy">
        <h2 id="run-story-title">Benchmark coding agents on your own repo.</h2>
        <p>Give Claude Code and Codex the same bug report, the same model and separate copies of your repo. Let your test suite grade each fix.</p>
        <BenchmarkResult />
        <a class="hero-action" href="/?example=evals%2Fcompare-harnesses#quickstart">Open the recorded comparison <span aria-hidden="true">↑</span></a>
      </div>
      <img src="/images/compare-agent-runs.webp" alt="" width="1020" height="680" loading="lazy" decoding="async" />
    </div>
  </section>

  <!-- Each agent in the catalog links to its own supported setup. -->
  <section class="rail" data-theme="website" aria-labelledby="rail-title">
    <div class="shell">
      <h2 id="rail-title">Choose your coding agent.</h2>
      <div class="rail-grid" aria-label="Launch from the dashboard">
        {launchable.map((agent) => (
          <a class="rail-tile" href={agent.launchHref} aria-label={`Create a sandbox for ${agent.name}`} data-harness={agent.id}>
            {agent.logo && <img class="rail-logo" src={agent.logo} alt="" width="40" height="40" loading="lazy" />}
            <span class="rail-name">{agent.name}</span>
          </a>
        ))}
      </div>
      <div class="rail-more">
        <h3>Configure with the CLI or API</h3>
        <ul>
          {cliAgents.map((agent) => (
            <li data-harness={agent.id}>
              {agent.logo && <img class="rail-logo" src={agent.logo} alt="" width="24" height="24" loading="lazy" />}
              {agent.name}
            </li>
          ))}
        </ul>
        <a href="https://sandbox.tangle.tools/docs/cloud-agents">CLI and API setup</a>
      </div>
    </div>
  </section>

  <!-- ==================== ONE KEY, ONE BILL (paper) ==================== -->
  <section class="pricing" data-theme="website" id="pricing" aria-labelledby="pricing-title" data-cta-placement="pricing">
    <div class="shell">
      <div class="pricing-top">
        <div class="pricing-head">
          <h2 id="pricing-title">One key. One bill.</h2>
          <p>Your sandbox time and model calls draw from the same balance.</p>
        </div>
        <dl class="usage-rates">
          <div><dt>Sandbox compute</dt><dd><a href="https://sandbox.tangle.tools/pricing">From {hourlyPrice} per hour</a></dd></div>
          <div><dt>Model calls</dt><dd><a href="https://router.tangle.tools/models">Rates by model</a></dd></div>
        </dl>
      </div>
      <div class="plans" data-plans>
        {PLANS.map((plan) => (
          <article class="plan" data-plan={plan.id}>
            <h3>{plan.name}</h3>
            <p class="plan-price">
              <span class="plan-amount">{planPrice(plan)}</span>{plan.monthlyPriceCents > 0 && <span class="plan-per"> / month</span>}
            </p>
            <p class="plan-credit">{plan.creditsPerMonth > 0 ? `${formatUsdCents(plan.creditsPerMonth)} in monthly credit` : 'No included credit'}</p>
            <ul class="plan-features">
              {plan.features.map((feature) => <li>{feature}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <div class="pricing-actions">
        <a class="btn btn-primary" href="https://sandbox.tangle.tools/dashboard/new" target="_blank" rel="noopener noreferrer">Create a sandbox</a>
        <a class="btn btn-ghost" href="https://id.tangle.tools/app/plans" target="_blank" rel="noopener noreferrer">See plans</a>
      </div>
    </div>
  </section>

</BaseLayout>



<style>
  /* ---------- shared ---------- */
  .shell, :global(#quickstart .quickstart-inner) {
    position: relative;
    z-index: 1;
    width: min(78rem, 90vw);
    margin: 0 auto;
  }

  section h1,
  section h2,
  section h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  section h2 {
    font-size: clamp(2rem, 3vw, 2.9rem);
    line-height: 1.1;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.8rem;
    padding: 0.75rem 1.3rem;
    border-radius: 9px;
    font-family: var(--font-sans);
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.16s ease, background 0.16s ease, border-color 0.16s ease;
  }

  .btn:hover { transform: translateY(-1px); }
  .btn:active { transform: scale(0.98); }

  .btn-primary {
    background: var(--btn-primary-bg);
    border: 1px solid var(--btn-primary-hover);
    color: var(--btn-primary-text);
  }

  .btn-ghost {
    background: rgba(237, 237, 244, 0.06);
    border: 1px solid rgba(237, 237, 244, 0.18);
    color: var(--text-primary);
  }

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    min-height: clamp(32rem, 43vw, 45rem);
    background: var(--depth-1);
  }
  .hero-art, .hero-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-art img { object-fit: cover; object-position: center 49%; }
  .hero-art::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, color-mix(in srgb, var(--depth-1) 72%, transparent), transparent 58%);
  }
  .hero-copy { max-width: min(37vw, 35rem); padding-block: 2rem clamp(5rem, 9vw, 9rem); }
  .hero-copy h1 {
    font-family: var(--font-reading);
    font-size: clamp(3.2rem, 5.1vw, 5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -.052em;
    color: var(--text-primary);
  }
  .hero-copy p {
    max-width: 25rem;
    margin: 1.4rem 0 0;
    color: var(--text-primary);
    font-size: var(--font-size-xl);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .hero-action {
    display: inline-flex;
    align-items: center;
    gap: .65em;
    margin-top: 1.4rem;
    color: var(--text-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: .4em;
  }
  .hero-action:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .routing { background: var(--depth-1); color: var(--text-primary); }
  .routing-spread {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(2rem, 5vw, 5rem);
  }
  .routing-spread img {
    display: block;
    width: 100%;
    height: auto;
    mask-image: linear-gradient(to right, transparent, black 3%, black 96%, transparent), linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);
    mask-composite: intersect;
  }
  .routing-copy { max-width: 30rem; }
  .routing-copy h2 {
    font-family: var(--font-reading);
    font-weight: 500;
    font-size: clamp(2.6rem, 4vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -.045em;
  }
  .routing-copy p { margin: 1.2rem 0 0; font-size: var(--font-size-lg); line-height: 1.55; text-wrap: pretty; }
  /* The directory sits on paper alongside plans. */
  .run-story { background: var(--longform-paper); color: var(--longform-ink); }
  .run-story .routing-spread { grid-template-columns: 1fr 1.1fr; }
  .run-story .routing-spread img { mask-image: none; }
  .run-story .routing-copy { min-width: 0; }
  @media (max-width: 700px) { .run-story .routing-spread { grid-template-columns: minmax(0, 1fr); } }
  .rail { padding: clamp(3rem, 5vw, 5rem) 0; background: var(--longform-paper); }
  #rail-title { font-family: var(--font-reading); font-weight: 500; color: var(--text-primary); letter-spacing: -0.032em; }
  .rail-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.7rem; margin-top: 3.2rem; }
  .rail-tile { display: grid; grid-template-columns: 40px 1fr; gap: 0.8rem; align-items: center; padding: 0.9rem 1rem; border: 1px solid var(--border-default); border-radius: 12px; background: var(--bg-card); text-decoration: none; transition: border-color 0.2s ease, background 0.2s ease; }
  .rail-tile:hover, .rail-tile:focus-visible { border-color: var(--accent-text); background: var(--md3-surface-container-low); }
  .rail-tile:focus-visible { outline: 2px solid var(--brand-glow); outline-offset: 2px; }
  .rail-logo { display: block; flex: none; border-radius: 20%; object-fit: contain; background: var(--longform-paper); }
  .rail-name { color: var(--text-primary); font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; }
  .rail-more { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-default); }
  .rail-more h3 { margin: 0 0 .8rem; color: var(--text-primary); font-size: 1rem; }
  .rail-more ul { display: flex; flex-wrap: wrap; gap: .7rem 1.2rem; padding: 0; margin: 0 0 .9rem; list-style: none; }
  .rail-more li { display: flex; align-items: center; gap: .45rem; color: var(--text-primary); font-weight: 500; }
  .rail-more a { margin: 0; font-size: .875rem; color: var(--text-secondary); }
  .rail-more a { text-decoration: underline; text-underline-offset: .2em; }

  /* ---------- one key, one bill (paper) ---------- */
  .pricing { color: var(--longform-ink); background: var(--longform-paper); }
  .pricing > .shell { border-top: 1px solid var(--longform-rule); padding-block: clamp(3rem, 6vw, 6rem) 2.5rem; }
  .pricing-top { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(2rem, 7vw, 8rem); align-items: center; }
  .pricing-head h2, .plan-amount { font-family: var(--font-reading); font-weight: 500; letter-spacing: -.045em; }
  .pricing-head h2 { font-size: clamp(2.75rem, 5vw, 5rem); line-height: 1.05; }
  .pricing-head p { max-width: 27rem; margin: 1rem 0 0; color: var(--longform-ink-muted); font-size: var(--font-size-lg); line-height: 1.5; }
  .usage-rates { margin: 0; }
  .usage-rates div { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-block: .95rem; border-bottom: 1px solid var(--longform-rule); }
  .usage-rates dt { font-weight: 600; }
  .usage-rates dd { margin: 0; text-align: right; }
  .usage-rates a, .pricing .btn-ghost { color: var(--longform-ink); text-decoration: underline; text-underline-offset: .22em; }
  .pricing a:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 4px; }
  .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-block: clamp(2.4rem, 4.5vw, 4.5rem) 2rem; border-block: 1px solid var(--longform-rule); }
  .plan { margin-block: 1.75rem; padding-inline: clamp(1.1rem, 3vw, 3rem); }
  .plan:first-child { padding-inline-start: 0; }
  .plan:last-child { padding-inline-end: 0; }
  .plan + .plan { border-inline-start: 1px solid var(--longform-rule); }
  .plan h3 { font-size: var(--font-size-lg); font-weight: 600; }
  .plan-price { margin: .7rem 0 0; }
  .plan-amount { font-size: clamp(2.5rem, 3.5vw, 3.5rem); line-height: 1; }
  .plan-per, .plan-features { color: var(--longform-ink-muted); }
  .plan-credit { margin: .4rem 0 0; }
  .plan-features { list-style: none; padding: 0; margin: 1.1rem 0 0; line-height: 1.45; }
  .plan-features li + li { margin-top: .45rem; }
  .pricing-actions { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
  .pricing .btn-ghost { padding-inline: .2rem; background: transparent; border: 0; }

  /* ---------- responsive ---------- */
  @media (max-width: 980px) {
    .rail-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .shell, :global(#quickstart .quickstart-inner) { width: min(92vw, 78rem); }
    .rail-grid, .plans, .pricing-top { grid-template-columns: minmax(0, 1fr); }
    .pricing-top { gap: 1rem; }
    .plan { margin-block: 0; padding: 1.4rem 0; }
    .plan + .plan { border-inline-start: 0; border-top: 1px solid var(--longform-rule); }
  }

  @media (max-width: 700px) {
    .routing-spread { grid-template-columns: 1fr; gap: 1.5rem; padding-block: 2.75rem; }
    .routing-copy { grid-row: 1; }
    .hero { display: flex; flex-direction: column; align-items: stretch; min-height: 0; }
    .hero-copy { max-width: 30rem; padding-block: 2.75rem 1rem; }
    .hero-copy h1 { font-size: clamp(2.75rem, 10vw, 3.75rem); }
    .hero-copy p { font-size: var(--text-lead); margin-top: 1rem; }
    .hero-art { position: relative; order: 2; height: auto; aspect-ratio: 1.9; }
    .hero-art img { object-position: center 55%; }
    .hero-art::after { background: linear-gradient(var(--depth-1), transparent 30%); }
  }
</style>
