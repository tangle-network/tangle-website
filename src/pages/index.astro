---
import '@fontsource-variable/source-serif-4/wght.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import SandboxQuickstart from '../components/SandboxQuickstart.astro';
import { loadCatalog } from '../data/harness-catalog.mjs';
import { PLANS, planPrice } from '../data/plans.mjs';

const canonicalUrl = 'https://tangle.tools/';
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${canonicalUrl}#organization`,
      name: 'Tangle',
      legalName: 'Tangle Technologies, Inc.',
      url: canonicalUrl,
      logo: 'https://tangle.tools/icons/tangle-icon-512.png',
      description:
        'Tangle provides isolated runtimes, model routing, browser automation, and evaluation tools for AI agents.',
      sameAs: [
        'https://twitter.com/tangle_network',
        'https://github.com/tangle-network',
        'https://www.youtube.com/@TangleNetwork',
        'https://discord.com/invite/cv8EfJu3Tn',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalUrl}#website`,
      name: 'Tangle',
      url: canonicalUrl,
      publisher: { '@id': `${canonicalUrl}#organization` },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: 'Run AI agents',
      description:
        'Tangle gives coding agents isolated machines, routes their model calls and records each run.',
      isPartOf: { '@id': `${canonicalUrl}#website` },
      about: { '@id': `${canonicalUrl}#organization` },
      inLanguage: 'en-US',
    },
  ],
};

const pricing = await fetch('https://sandbox.tangle.tools/v1/pricing/sandboxes');
if (!pricing.ok) throw new Error(`Sandbox pricing returned ${pricing.status}`);
const rate = (await pricing.json()).pools.general;
const perHour = (n: number) => `$${n.toFixed(n < 0.01 ? 4 : 3)}`;
// What one key meters into one balance, drawn by the pricing figure.
const bills = [
  { id: 'compute', name: 'Sandboxes', unit: `from ${perHour(rate.minChargeHourUsd)} an hour`, y: 45 },
  { id: 'inference', name: 'Inference', unit: 'model tokens, at the listed price', y: 115 },
  { id: 'observability', name: 'Observability', unit: 'traces and evals', y: 185 },
];

type Agent = { id: string; name: string; logo?: string | null; launchHref?: string | null };
const { catalog } = await loadCatalog();
const agents: Agent[] = catalog.harnesses;
const launchable = agents.filter((agent): agent is Agent & { launchHref: string } => Boolean(agent.launchHref));
const cliAgents = agents.filter((agent) => !agent.launchHref);

---

<BaseLayout
  title="Run coding agents across clouds"
  bodyClass="company-home"
  description="Tangle gives coding agents isolated machines, routes their model calls and records each run."
>
  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />


  <section class="hero" aria-labelledby="hero-title" data-cta-placement="hero">
    <picture class="hero-art">
      <source media="(max-width: 700px)" srcset="/images/company-switchyard-mobile.webp" width="760" height="597" />
      <img src="/images/company-switchyard.webp" width="1654" height="923" alt="" fetchpriority="high" />
    </picture>
    <div class="shell">
      <div class="hero-copy">
        <h1 id="hero-title">Run your coding agent across clouds.</h1>
        <p>Run code in Sandbox, call models through Router, and see what your agent changed.</p>
        <a class="hero-action" href="#quickstart">Explore the examples <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <SandboxQuickstart />

  <section class="routing" aria-labelledby="routing-title">
    <div class="shell routing-spread">
      <img src="/images/router-workshop.webp" alt="" width="1080" height="720" loading="lazy" decoding="async" />
      <div class="routing-copy">
        <h2 id="routing-title">Change models without moving your agent.</h2>
        <p>Point your OpenAI-compatible client at Tangle Router. Choose the model with each request, wherever your agent runs.</p>
        <a class="hero-action" href="https://router.tangle.tools/models">Explore models <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <!-- Each agent in the catalog links to its own supported setup. -->
  <section class="rail" data-theme="website" aria-labelledby="rail-title">
    <div class="shell">
      <h2 id="rail-title">Choose your coding agent.</h2>
      <div class="rail-grid" aria-label="Launch from the dashboard">
        {launchable.map((agent) => (
          <a class="rail-tile" href={agent.launchHref} aria-label={`Create a sandbox for ${agent.name}`} data-harness={agent.id}>
            {agent.logo && <img class="rail-logo" src={agent.logo} alt="" width="40" height="40" loading="lazy" />}
            <span class="rail-name">{agent.name}</span>
          </a>
        ))}
      </div>
      <div class="rail-more">
        <h3>Configure with the CLI or API</h3>
        <ul>
          {cliAgents.map((agent) => (
            <li data-harness={agent.id}>
              {agent.logo && <img src={agent.logo} alt="" width="24" height="24" loading="lazy" />}
              {agent.name}
            </li>
          ))}
        </ul>
        <a href="https://sandbox.tangle.tools/docs/cloud-agents">CLI and API setup</a>
      </div>
    </div>
  </section>

  <!-- ==================== ONE KEY, ONE BILL (paper) ==================== -->
  <section class="pricing" data-theme="website" id="pricing" aria-labelledby="pricing-title" data-cta-placement="pricing">
    <div class="shell">
      <div class="pricing-top">
        <div class="pricing-head">
          <h2 id="pricing-title">One key. <span class="grad-text">One bill.</span></h2>
          <p>Compute, inference and observability, on one balance.</p>
        </div>
        <figure class="bill" aria-label="One API key meters compute, inference and observability into one balance">
          <svg class="bill-svg" viewBox="0 0 560 230" role="img" aria-hidden="true">
            <defs>
              <linearGradient id="bill-grad" gradientUnits="userSpaceOnUse" x1="118" y1="0" x2="472" y2="0">
                <stop offset="0%" style="stop-color: var(--accent-text)" />
                <stop offset="100%" style="stop-color: var(--brand-glow)" />
              </linearGradient>
            </defs>
            {bills.map((bill) => (
              <g class="bill-flow" data-flow={bill.id}>
                <path class="bill-path" d={`M 118 115 C 180 115, 180 ${bill.y}, 236 ${bill.y}`} />
                <path class="bill-path" d={`M 400 ${bill.y} C 450 ${bill.y}, 450 115, 472 115`} />
                <rect class="bill-node" x="236" y={bill.y - 19} width="164" height="38" rx="10" />
                <text class="bill-label" font-size="15" x="318" y={bill.y + 5}>{bill.name}</text>
                <text class="bill-unit" font-size="11" x="318" y={bill.y + 36}>{bill.unit}</text>
              </g>
            ))}
            <g class="bill-key">
              <rect x="14" y="96" width="104" height="38" rx="19" />
              <text class="bill-label" font-size="15" x="66" y="120">sk-tan-…</text>
            </g>
            <g class="bill-balance">
              <circle cx="508" cy="115" r="36" />
              <text class="bill-label" font-size="22" x="508" y="122">$</text>
            </g>
          </svg>
        </figure>
      </div>
      <div class="plans" data-plans>
        {PLANS.map((plan) => (
          <article class={`plan${plan.popular ? ' plan-popular' : ''}`} data-plan={plan.id}>
            <h3>{plan.name}</h3>
            <p class="plan-price"><span class="plan-amount">{planPrice(plan)}</span>{plan.monthlyPriceCents > 0 && <span class="plan-per"> / month</span>}</p>
            <p class="plan-credit">{plan.creditsPerMonth > 0 ? `Your ${planPrice(plan)} comes back as credit each month` : 'No included credit'}</p>
            <ul class="plan-features">
              {plan.features.map((feature) => <li>{feature}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <div class="pricing-actions">
        <a class="btn btn-primary" href="https://sandbox.tangle.tools/dashboard/new" target="_blank" rel="noopener noreferrer">Create a sandbox</a>
        <a class="btn btn-ghost" href="https://id.tangle.tools/app/plans" target="_blank" rel="noopener noreferrer">See plans</a>
      </div>
    </div>
  </section>

</BaseLayout>



<style>
  /* ---------- shared ---------- */
  .shell, :global(#quickstart .quickstart-inner) {
    position: relative;
    z-index: 1;
    width: min(78rem, 90vw);
    margin: 0 auto;
  }

  .mono {
    font-family: var(--font-mono);
    font-feature-settings: 'tnum';
  }

  section h1,
  section h2,
  section h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  section h2 {
    font-size: clamp(2rem, 3vw, 2.9rem);
    line-height: 1.1;
  }

  .grad-text {
    display: block;
    background-image: linear-gradient(92deg, var(--brand-purple) 0%, var(--brand-cool) 40%, var(--btn-primary-bg) 75%, var(--brand-purple) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--brand-glow); /* fallback */
    /* background-clip: text paints only the line box; descenders need room. */
    padding-bottom: 0.1em;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.8rem;
    padding: 0.75rem 1.3rem;
    border-radius: 9px;
    font-family: var(--font-sans);
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.16s ease, background 0.16s ease, border-color 0.16s ease;
  }

  .btn:hover { transform: translateY(-1px); }
  .btn:active { transform: scale(0.98); }

  .btn-primary {
    background: var(--btn-primary-bg);
    border: 1px solid var(--btn-primary-hover);
    color: var(--btn-primary-text);
  }

  .btn-ghost {
    background: rgba(237, 237, 244, 0.06);
    border: 1px solid rgba(237, 237, 244, 0.18);
    color: var(--text-primary);
  }

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    min-height: clamp(32rem, 43vw, 45rem);
    background: var(--depth-1);
  }
  .hero-art, .hero-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-art img { object-fit: cover; object-position: center 49%; }
  .hero-art::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, color-mix(in srgb, var(--depth-1) 72%, transparent), transparent 58%);
  }
  .hero-copy { max-width: min(37vw, 35rem); padding-block: 2rem clamp(5rem, 9vw, 9rem); }
  .hero-copy h1 {
    font-family: 'Source Serif 4 Variable', Georgia, serif;
    font-size: clamp(3.2rem, 5.1vw, 5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -.052em;
    color: var(--text-primary);
  }
  .hero-copy p {
    max-width: 25rem;
    margin: 1.4rem 0 0;
    color: var(--text-primary);
    font-size: var(--font-size-xl);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .hero-action {
    display: inline-flex;
    align-items: center;
    gap: .65em;
    margin-top: 1.4rem;
    color: var(--text-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: .4em;
  }
  .hero-action:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .routing { background: var(--depth-1); color: var(--text-primary); }
  .routing-spread {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(2rem, 5vw, 5rem);
  }
  .routing-spread img {
    display: block;
    width: 100%;
    height: auto;
    mask-image: linear-gradient(to right, transparent, black 3%, black 96%, transparent), linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);
    mask-composite: intersect;
  }
  .routing-copy { max-width: 30rem; }
  .routing-copy h2 {
    font-family: 'Source Serif 4 Variable', Georgia, serif;
    font-weight: 500;
    font-size: clamp(2.6rem, 4vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -.045em;
  }
  .routing-copy p { margin: 1.2rem 0 0; font-size: var(--font-size-lg); line-height: 1.55; text-wrap: pretty; }
  /* The directory sits on paper alongside plans. */
  .rail { padding: clamp(3rem, 5vw, 5rem) 0; background: var(--longform-paper); }
  #rail-title { color: var(--text-primary); letter-spacing: -0.032em; }
  .rail-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.7rem; margin-top: 3.2rem; }
  .rail-tile { display: grid; grid-template-columns: 40px 1fr; gap: 0.8rem; align-items: center; padding: 0.9rem 1rem; border: 1px solid var(--border-default); border-radius: 12px; background: var(--bg-card); text-decoration: none; transition: border-color 0.2s ease, background 0.2s ease; }
  .rail-tile:hover, .rail-tile:focus-visible { border-color: var(--accent-text); background: var(--md3-surface-container-low); }
  .rail-tile:focus-visible { outline: 2px solid var(--brand-glow); outline-offset: 2px; }
  .rail-logo { width: 40px; height: 40px; border-radius: 9px; object-fit: cover; box-shadow: inset 0 0 0 1px rgba(199, 201, 238, 0.14); }
  .rail-name { color: var(--text-primary); font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; }
  .rail-more { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-default); }
  .rail-more h3 { margin: 0 0 .8rem; color: var(--text-primary); font-size: 1rem; }
  .rail-more ul { display: flex; flex-wrap: wrap; gap: .7rem 1.2rem; padding: 0; margin: 0 0 .9rem; list-style: none; }
  .rail-more li { display: flex; align-items: center; gap: .45rem; color: var(--text-primary); font-weight: 500; }
  .rail-more img { width: 24px; height: 24px; padding: 2px; object-fit: contain; border-radius: 4px; background: var(--text-primary); }
  .rail-more a { margin: 0; font-size: .875rem; color: var(--text-secondary); }
  .rail-more a { text-decoration: underline; text-underline-offset: .2em; }

  /* ---------- one key, one bill (paper) ---------- */
  .pricing { background: var(--bg-root); color: var(--text-primary); padding: 8rem 0 7.5rem; }
  .pricing-top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 3rem; align-items: center; }
  .pricing-head h2 { margin: 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.032em; color: var(--text-primary); font-size: clamp(2.3rem, 3.6vw, 3.5rem); line-height: 1.05; }
  .pricing-head p { margin: 1.1rem 0 0; color: var(--text-secondary); font-size: clamp(1.15rem, 1.4vw, 1.35rem); line-height: 1.6; max-width: 32rem; }
  .bill { margin: 0; }
  .bill-svg { display: block; width: 100%; height: auto; overflow: visible; font-family: var(--font-sans); }
  .bill-path { fill: none; stroke: url(#bill-grad); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 5 9; animation: billFlow 1.4s linear infinite; }
  .bill-node, .bill-key rect, .bill-balance circle { fill: var(--bg-card); stroke: var(--md3-outline-variant); stroke-width: 1.5; transition: stroke 0.3s ease, fill 0.3s ease; }
  .bill-label { fill: var(--text-primary); font-weight: 600; text-anchor: middle; }
  .bill-unit { fill: var(--text-muted); text-anchor: middle; }
  .bill-key rect { stroke: var(--accent-text); }
  .bill-balance circle { stroke: var(--accent-text); stroke-width: 2; }
  .bill-flow:hover .bill-path { stroke: var(--accent-text); stroke-width: 3; }
  .bill-flow:hover .bill-node { fill: var(--accent-surface-strong); stroke: var(--accent-text); }
  @keyframes billFlow { to { stroke-dashoffset: -28; } }
  @media (prefers-reduced-motion: reduce) { .bill-path { animation: none; stroke-dasharray: none; } }
  .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 4rem; }
  .plan { display: flex; flex-direction: column; padding: 1.5rem 1.5rem 1.6rem; border: 1px solid var(--md3-outline-variant); border-radius: 14px; background: var(--bg-card); }
  .plan-popular { border-color: var(--accent-text); }
  .plan h3 { margin: 0; font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; letter-spacing: -0.015em; color: var(--text-primary); }
  .plan-price { margin: 0.9rem 0 0; color: var(--text-primary); }
  .plan-amount { font-family: var(--font-display); font-size: clamp(2.2rem, 3vw, 2.8rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
  .plan-per { color: var(--text-muted); font-size: 0.95rem; }
  .plan-credit { margin: 0.5rem 0 0; color: var(--accent-text); font-size: 0.95rem; font-weight: 600; }
  .plan-features { margin: 1.2rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; color: var(--text-secondary); font-size: 0.98rem; line-height: 1.5; }
  .plan-features li { padding-left: 1.1rem; position: relative; }
  .plan-features li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--accent-text); }
  .pricing-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.3rem; margin-top: 2rem; }
  .pricing .btn-ghost { background: var(--bg-card); border-color: var(--md3-outline-variant); color: var(--text-primary); }

  /* ---------- responsive ---------- */
  @media (max-width: 980px) {
    .rail-grid, .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pricing-top { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
  }
  @media (max-width: 720px) {
    .shell, :global(#quickstart .quickstart-inner) { width: min(92vw, 78rem); }
    .rail-grid, .plans { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 700px) {
    .routing-spread { grid-template-columns: 1fr; gap: 1.5rem; padding-block: 2.75rem; }
    .routing-copy { grid-row: 1; }
    .hero { display: flex; flex-direction: column; align-items: stretch; min-height: 0; }
    .hero-copy { max-width: 30rem; padding-block: 2.75rem 1rem; }
    .hero-copy h1 { font-size: clamp(2.75rem, 10vw, 3.75rem); }
    .hero-copy p { font-size: var(--text-lead); margin-top: 1rem; }
    .hero-art { position: relative; order: 2; height: auto; aspect-ratio: 1.9; }
    .hero-art img { object-position: center 55%; }
    .hero-art::after { background: linear-gradient(var(--depth-1), transparent 30%); }
  }
</style>
