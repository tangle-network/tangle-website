---
import BaseLayout from '../layouts/BaseLayout.astro';
import Examples from '../components/Examples.astro';
import { EGRESS_TERMS_URL, egressLede, egressNotes, egressRows } from '../data/egressTerms.mjs';

const canonicalUrl = 'https://tangle.tools/';
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${canonicalUrl}#organization`,
      name: 'Tangle',
      legalName: 'Tangle Technologies, Inc.',
      url: canonicalUrl,
      logo: 'https://tangle.tools/icons/tangle-icon-512.png',
      description:
        'Tangle provides isolated runtimes, model routing, browser automation, and evaluation tools for AI agents.',
      sameAs: [
        'https://twitter.com/tangle_network',
        'https://github.com/tangle-network',
        'https://www.youtube.com/@TangleNetwork',
        'https://discord.com/invite/cv8EfJu3Tn',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalUrl}#website`,
      name: 'Tangle',
      url: canonicalUrl,
      publisher: { '@id': `${canonicalUrl}#organization` },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: 'A computer for every agent',
      description: 'Isolated sandboxes that run for days, fleets, traces and evals for AI agents on one API key.',
      isPartOf: { '@id': `${canonicalUrl}#website` },
      about: { '@id': `${canonicalUrl}#organization` },
      inLanguage: 'en-US',
    },
  ],
};

const products = [
  {
    name: 'Sandboxes',
    line: 'Isolated computers for agents: shell, files, browser, supported coding harnesses.',
    href: 'https://sandbox.tangle.tools',
    domain: 'sandbox.tangle.tools',
    hue: 'cyan',
  },
  {
    name: 'Intelligence',
    line: 'Analyze traces and compare runs before and after a change.',
    href: 'https://intelligence.tangle.tools',
    domain: 'intelligence.tangle.tools',
    hue: 'magenta',
  },
  {
    name: 'Router',
    line: 'OpenAI-compatible access to many models through one API.',
    href: 'https://router.tangle.tools',
    domain: 'router.tangle.tools',
    hue: 'indigo',
  },
];

// Harness commands and launch IDs are separate: Prime's CLI is prime-agent,
// while the Sandbox launch API accepts prime.
// NanoClaw mark: https://nanoclaw.dev/favicon-192x192.png
// Prime mark: https://github.com/PrimeIntellect-ai.png?size=256
const harnesses = [
  { cmd: 'claude', harness: 'claude-code', name: 'Claude Code', logo: '/images/harness/claude-code.svg' },
  { cmd: 'codex', harness: 'codex', name: 'Codex', logo: '/images/harness/codex.png' },
  { cmd: 'opencode', harness: 'opencode', name: 'OpenCode', logo: '/images/harness/opencode.svg' },
  { cmd: 'hermes', harness: 'hermes', name: 'Hermes', logo: '/images/harness/hermes.png' },
  { cmd: 'openclaw', harness: 'openclaw', name: 'OpenClaw', logo: '/images/harness/openclaw.png' },
  { cmd: 'nanoclaw', harness: 'nanoclaw', name: 'NanoClaw', logo: '/images/harness/nanoclaw-5c87dee8.png' },
  { cmd: 'kimi', harness: 'kimi-code', name: 'Kimi Code', logo: '/images/harness/kimi-code.png' },
  { cmd: 'pi', harness: 'pi', name: 'Pi', logo: '/images/harness/pi.svg' },
  { cmd: 'prime-agent', harness: 'prime', name: 'Prime Agent', logo: '/images/harness/prime-agent.png' },
];

---

<BaseLayout
  title="A computer for every agent"
  description="Isolated sandboxes that run for days, fleets, traces and evals for AI agents on one API key."
>
  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

  <!-- ============================ HERO (dark) ============================ -->
  <section class="hero" aria-labelledby="hero-title" data-cta-placement="hero">
    <div class="hero-art" aria-hidden="true">
      <canvas id="hero-knot"></canvas>
      <img class="hero-poster" src="/images/brand/knot-poster.webp" alt="" loading="eager" />
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="shell">
      <div class="hero-copy">
        <h1 id="hero-title">A computer for every agent.</h1>
        <p>Sandboxes that run for days, fleets of them, traces and evals, every harness preinstalled. One API key.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="https://sandbox.tangle.tools/dashboard/new" target="_blank" rel="noopener noreferrer">Create a sandbox</a>
          <a class="btn btn-ghost" href="https://docs.tangle.tools" target="_blank" rel="noopener noreferrer">Read the docs</a>
        </div>
      </div>
    </div>
  </section>

  <Examples />

  <!-- ==================== HARNESSES (dark) ==================== -->
  <section class="sb-section" id="harnesses" aria-labelledby="sb-title" data-cta-placement="harnesses">
    <div class="shell">
      <div class="sb-head">
        <h2 id="sb-title">Every harness, instantly at your fingertips.</h2>
        <p>Run them interactively or in the background.</p>
      </div>

      <div class="sb-rail" style={`--harness-columns: ${harnesses.length}`} aria-label="Coding harnesses preinstalled in every sandbox">
        {harnesses.map((h) => (
          <a
            class="sb-tile"
            href={`https://sandbox.tangle.tools/dashboard/new?harness=${h.harness}`}
            aria-label={`Create a sandbox for ${h.name}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img class="sb-logo" src={h.logo} alt={`${h.name} mark`} width="48" height="48" loading="lazy" />
            <span class="sb-name">{h.name}</span>
            <code class="mono sb-cmd">$ {h.cmd}</code>
            <span class="sb-run mono">Start <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== PRODUCTS (paper, gradient cards) ==================== -->
  <section class="products-section" data-theme="website" aria-labelledby="products-title" data-cta-placement="product-cards">
    <div class="shell">
      <h2 id="products-title" class="statement reveal">Build on Tangle.</h2>
      <p class="product-intro reveal">Sandboxes, Router, and Intelligence share one API key.</p>

      <div class="product-cards reveal">
        {products.map((p) => (
          <a class={`p-card p-card-${p.hue}`} href={p.href} target="_blank" rel="noopener noreferrer">
            <div class="p-card-art" aria-hidden="true"></div>
            <div class="p-card-body">
              <h3>{p.name}</h3>
              <p>{p.line}</p>
              <span class="p-card-link mono">{p.domain}</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>


  <!-- ==================== PRICING + CLOSE (dark) ==================== -->
  <section class="close-section" id="pricing" aria-labelledby="pricing-title" data-cta-placement="closing">
    <div class="shell close-inner">
      <h2 id="pricing-title">Start free.</h2>
      <div class="egress-table-wrap" data-egress-terms>
        <table class="egress-table" aria-label="Egress included each month">
          <thead>
            <tr><th scope="col">Plan</th><th scope="col">Egress each month</th><th scope="col">Beyond</th></tr>
          </thead>
          <tbody>
            {egressRows().map((row) => (
              <tr data-egress-plan={row.id}><th scope="row">{row.name}</th><td>{row.included}</td><td>{row.beyond}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="egress-note">{egressLede()} <a class="egress-source" href={EGRESS_TERMS_URL}>Terms</a> · <a class="egress-source" href="https://id.tangle.tools/app/plans" target="_blank" rel="noopener noreferrer">Plans and limits</a></p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="https://sandbox.tangle.tools/dashboard/new" target="_blank" rel="noopener noreferrer">Create a sandbox</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = window.matchMedia('(min-width: 861px)').matches;

  if (!reduced) {
    document.documentElement.classList.add('js');
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          io.unobserve(entry.target);
        }
      }
    }, { threshold: 0.14 });
    document.querySelectorAll('.reveal').forEach((element) => io.observe(element));
  }

  // Initialize the content diagrams before the optional WebGL artwork.
  // Hero brand object: fiber-optic torus knot, dispersion shader, bloom.
  const knotCanvas = document.getElementById('hero-knot');
  if (knotCanvas && !reduced && wide) {
    const renderer = new THREE.WebGLRenderer({ canvas: knotCanvas, antialias: true });
    renderer.setPixelRatio(Math.min(2, window.devicePixelRatio));
    const scene = new THREE.Scene();
    // WebGL cannot read CSS variables, so the scene resolves Brand's tokens once.
    const brandToken = (name: string) => getComputedStyle(knotCanvas).getPropertyValue(name).trim();
    scene.background = new THREE.Color(brandToken('--md3-surface-container-lowest'));
    const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
    camera.position.set(0, 0, 8.6);

    const stops = ['--brand-purple', '--brand-cool', '--brand-vibrant', '--btn-primary-bg'].map((t) => new THREE.Color(brandToken(t)));
    const uniforms = {
      uTime: { value: 0 },
      uC0: { value: stops[0] }, uC1: { value: stops[1] },
      uC2: { value: stops[2] }, uC3: { value: stops[3] },
    };
    const vert = `varying vec2 vUv; varying vec3 vNormal; varying vec3 vView;
      void main() { vUv = uv; vNormal = normalize(normalMatrix * normal);
        vec4 mv = modelViewMatrix * vec4(position, 1.0); vView = normalize(-mv.xyz);
        gl_Position = projectionMatrix * mv; }`;
    const material = new THREE.ShaderMaterial({
      uniforms,
      vertexShader: vert,
      fragmentShader: `uniform float uTime; uniform vec3 uC0; uniform vec3 uC1; uniform vec3 uC2; uniform vec3 uC3;
        varying vec2 vUv; varying vec3 vNormal; varying vec3 vView;
        vec3 ramp(float t) { t = fract(t);
          if (t < 0.3333) return mix(uC0, uC1, smoothstep(0.0, 1.0, t / 0.3333));
          if (t < 0.6666) return mix(uC1, uC2, smoothstep(0.0, 1.0, (t - 0.3333) / 0.3333));
          return mix(uC2, uC3, smoothstep(0.0, 1.0, (t - 0.6666) / 0.3334)); }
        void main() {
          vec3 base = ramp(vUv.x + uTime * 0.03);
          float fresnel = pow(1.0 - max(dot(vNormal, vView), 0.0), 2.2);
          float pulse = smoothstep(0.965, 1.0, sin((vUv.x - uTime * 0.06) * 40.0) * 0.5 + 0.5);
          vec3 color = base * (0.22 + 0.62 * fresnel) + base * pulse * 0.85;
          gl_FragColor = vec4(color, 1.0); }`,
    });
    const knot = new THREE.Mesh(new THREE.TorusKnotGeometry(1.6, 0.12, 520, 48, 2, 3), material);
    knot.position.x = 1.7;
    scene.add(knot);
    const halo = new THREE.Mesh(
      new THREE.TorusKnotGeometry(1.6, 0.22, 260, 32, 2, 3),
      new THREE.ShaderMaterial({
        uniforms, vertexShader: vert,
        fragmentShader: `uniform vec3 uC1; varying vec3 vNormal; varying vec3 vView;
          void main() { float f = pow(1.0 - max(dot(vNormal, vView), 0.0), 3.0);
            gl_FragColor = vec4(uC1 * f * 0.28, 1.0); }`,
        blending: THREE.AdditiveBlending, side: THREE.BackSide, depthWrite: false,
      }),
    );
    halo.position.x = 1.7;
    scene.add(halo);

    const composer = new EffectComposer(renderer);
    composer.addPass(new RenderPass(scene, camera));
    composer.addPass(new UnrealBloomPass(new THREE.Vector2(1, 1), 0.6, 0.42, 0.28));

    const fit = () => {
      const w = knotCanvas.clientWidth, h = knotCanvas.clientHeight;
      renderer.setSize(w, h, false);
      composer.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    };
    new ResizeObserver(fit).observe(knotCanvas);
    fit();

    let rx = 0.42, ry = -0.28, visible = true;
    addEventListener('pointermove', (e) => {
      ry = -0.28 + (e.clientX / innerWidth - 0.5) * 0.35;
      rx = 0.42 + (e.clientY / innerHeight - 0.5) * 0.25;
    });
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(knotCanvas);

    const clock = new THREE.Clock();
    const frame = () => {
      requestAnimationFrame(frame);
      if (!visible) return;
      const t = clock.getElapsedTime();
      uniforms.uTime.value = t;
      knot.rotation.z = t * 0.045;
      knot.rotation.x += (rx - knot.rotation.x) * 0.04;
      knot.rotation.y += (ry - knot.rotation.y) * 0.04;
      halo.rotation.copy(knot.rotation);
      composer.render();
    };
    frame();
    knotCanvas.classList.add('ready');
  } else {
    document.documentElement.classList.add('static-hero');
  }


</script>

<style>
  /* ---------- shared ---------- */
  .shell {
    position: relative;
    z-index: 1;
    width: min(78rem, 90vw);
    margin: 0 auto;
  }

  .mono {
    font-family: var(--font-mono);
    font-feature-settings: 'tnum';
  }

  section h1,
  section h2,
  section h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  section h2 {
    font-size: clamp(2rem, 3vw, 2.9rem);
    line-height: 1.1;
  }

  :global(html.js) .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.2, 0.6, 0.2, 1), transform 0.6s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  :global(html.js) .reveal.in-view {
    opacity: 1;
    transform: none;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.8rem;
    padding: 0.75rem 1.3rem;
    border-radius: 9px;
    font-family: var(--font-sans);
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.16s ease, background 0.16s ease, border-color 0.16s ease;
  }

  .btn:hover { transform: translateY(-1px); }

  .btn-primary {
    background: var(--btn-primary-bg);
    border: 1px solid var(--btn-primary-hover);
    color: var(--btn-primary-text);
  }

  .btn-ghost {
    background: rgba(237, 237, 244, 0.06);
    border: 1px solid rgba(237, 237, 244, 0.18);
    color: var(--text-primary);
  }

  /* ---------- hero (dark) ---------- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    overflow: hidden;
    background: linear-gradient(160deg, var(--md3-surface-container-lowest) 0%, var(--depth-1) 52%, var(--md3-surface-container-low) 100%);
    border-bottom: 1px solid rgba(199, 201, 238, 0.1);
  }

  .hero-art {
    position: absolute;
    inset: 0;
  }

  #hero-knot {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s ease;
  }

  #hero-knot.ready { opacity: 1; }

  .hero-poster {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% center;
    opacity: 0.92;
  }

  :global(html.static-hero) #hero-knot { display: none; }
  :global(html.static-hero) .hero-poster { display: block; }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(8, 8, 20, 0.95) 0%, rgba(8, 8, 20, 0.9) 38%, rgba(8, 8, 20, 0.4) 58%, rgba(8, 8, 20, 0) 74%),
      linear-gradient(180deg, rgba(8, 8, 20, 0) 60%, rgba(8, 8, 20, 0.42) 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    #hero-knot { display: none; }
    .hero-poster { display: block; }
  }


  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 48rem;
    padding: 7.5rem 0 6rem;
  }

  .hero-copy h1 {
    color: var(--text-primary);
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 1.04;
    letter-spacing: -0.036em;
  }

  .hero-copy > p:first-of-type {
    max-width: 44rem;
    margin: 1.5rem 0 0;
    color: rgba(240, 240, 250, 0.88);
    font-size: clamp(1.25rem, 1.6vw, 1.55rem);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  /* ---------- products (paper, gradient cards) ---------- */
  .products-section {
    background: var(--bg-root);
    color: var(--text-primary);
    padding: 5.5rem 0 5rem;
  }

  .statement {
    max-width: 56rem;
    color: var(--text-primary);
    font-size: clamp(2.2rem, 3.6vw, 3.3rem);
    line-height: 1.1;
  }

  .product-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
    margin-top: 2.6rem;
  }

  .p-card {
    position: relative;
    display: flex;
    min-height: 22rem;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgba(25, 28, 60, 0.14);
    text-decoration: none;
    box-shadow: 0 22px 60px rgba(25, 28, 60, 0.14);
    transition: transform 0.25s cubic-bezier(0.2, 0.6, 0.2, 1), box-shadow 0.25s ease;
  }

  .p-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 32px 80px rgba(25, 28, 60, 0.22);
  }

  /* Layered chromatic fields, replaced by generated card art when it lands
     (background-image on .p-card-art). The gradient stack is the fallback
     and the loading state. */
  .p-card-art {
    position: absolute;
    inset: 0;
    background-color: var(--brand-strong);
    background-size: cover;
    background-position: center;
    transition: transform 0.4s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .p-card:hover .p-card-art { transform: scale(1.04); }

  /* Generated dispersion card art (Gemini 3 Pro, briefs in gtm assets).
     background-color stays as the loading/fallback state. */
  .p-card-cyan .p-card-art {
    background-image: url('/images/brand/cards/card-sandbox.webp');
  }

  .p-card-magenta .p-card-art {
    background-image: url('/images/brand/cards/card-intelligence.webp');
  }

  .p-card-indigo .p-card-art {
    background-image: url('/images/brand/cards/card-inference.webp');
  }

  .p-card-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.45rem;
    width: 100%;
    padding: 1.4rem 1.4rem 1.3rem;
    background: linear-gradient(180deg, transparent 0%, rgba(8, 8, 20, 0.32) 42%, rgba(8, 8, 20, 0.78) 100%);
  }

  .p-card-body h3 {
    color: var(--on-media);
    font-size: 1.8rem;
    letter-spacing: -0.022em;
  }

  .p-card-body p {
    margin: 0;
    max-width: 24rem;
    color: rgba(240, 240, 250, 0.9);
    font-size: 1.18rem;
    line-height: 1.55;
  }

  .p-card-link {
    margin-top: 0.6rem;
    color: rgba(240, 240, 250, 0.66);
    font-size: 0.92rem;
  }

  .p-card:hover .p-card-link { color: var(--on-media); }

  /* ---------- harnesses (dark) ---------- */
  .sb-section {
    padding: 5.5rem 0;
    background: linear-gradient(180deg, var(--depth-1) 0%, var(--md3-surface-container-low) 100%);
    border-top: 1px solid rgba(199, 201, 238, 0.08);
  }

  .sb-head {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 2.5rem;
    align-items: start;
  }

  .sb-head h2 {
    color: var(--text-primary);
    font-size: clamp(2rem, 3vw, 2.9rem);
    letter-spacing: -0.032em;
  }

  .sb-head p {
    margin: 0;
    color: rgba(237, 237, 244, 0.8);
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    line-height: 1.6;
    max-width: 46rem;
  }

  .sb-rail {
    display: grid;
    grid-template-columns: repeat(var(--harness-columns), minmax(0, 1fr));
    gap: 0.7rem;
    margin-top: 2.6rem;
  }

  .sb-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    padding: 1.1rem 0.6rem 0.9rem;
    border: 1px solid rgba(199, 201, 238, 0.12);
    border-radius: 12px;
    background: var(--md3-surface-container-low);
    text-align: center;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .sb-tile:hover, .sb-tile:focus-visible {
    border-color: var(--brand-cool);
    box-shadow: 0 10px 40px rgba(99, 102, 241, 0.16);
  }

  .sb-tile:focus-visible { outline: 2px solid var(--brand-glow); outline-offset: 4px; }

  .sb-logo {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    object-fit: cover;
    box-shadow: inset 0 0 0 1px rgba(199, 201, 238, 0.14);
  }

  .sb-name {
    color: var(--text-primary);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .sb-cmd {
    white-space: nowrap;
    color: rgba(198, 200, 226, 0.66);
    font-size: 0.85rem;
  }

  .sb-run {
    color: var(--brand-glow);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ---------- pricing table inside the close ---------- */
  .egress-table-wrap { max-width: 40rem; margin: 2.2rem auto 0; text-align: left; border: 1px solid var(--md3-outline-variant); border-radius: 12px; overflow: hidden; }
