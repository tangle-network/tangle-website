---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PostList from '../../../components/PostList.astro'
import { getCollection } from 'astro:content'
import { blogSeriesSlug, getBlogSeriesDetails } from '../../../data/blogSeries'

export async function getStaticPaths() {
  const normalize = (series?: string) => series?.replace(/^['"]|['"]$/g, '') || ''
  const posts = await getCollection('blog', ({ data }) => !data.draft)
  const grouped = new Map<string, typeof posts>()
  for (const post of posts) {
    const name = normalize(post.data.series)
    if (!name) continue
    if (!grouped.has(name)) grouped.set(name, [])
    grouped.get(name)!.push(post)
  }
  return [...grouped.entries()].map(([seriesName, entries]) => ({
    params: { series: blogSeriesSlug(seriesName) },
    props: { seriesName, posts: entries.sort((a, b) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999) || b.data.date.localeCompare(a.data.date)) },
  }))
}

const { seriesName, posts } = Astro.props
const details = getBlogSeriesDetails(seriesName)
const title = details?.title ?? seriesName
---

<BaseLayout paper title={`${title} | Blog`} description={details?.description ?? `Tangle blog posts in the ${title} series.`} bodyClass="page-editorial">
  <div class="series">
    <a href="/blog" class="back">Blog</a>
    <header>
      <h1>{title}</h1>
      {details && <p>{details.premise}</p>}
      {details && <p>{details.decision}</p>}
    </header>
    <PostList posts={posts} />
  </div>
</BaseLayout>

<style>
  .series { width: min(46rem, 92vw); margin: 0 auto; padding: 6.5rem 0 6rem; color: var(--text-primary); }
  .back { display: inline-block; margin-bottom: 1.2rem; font-size: 0.9rem; font-weight: 600; color: var(--accent-text); text-decoration: none; }
  .back::before { content: '← '; }
  .series h1 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 3.6vw, 2.8rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.08; }
  .series header p { margin: 1rem 0 0; color: var(--text-secondary); font-size: 1.05rem; line-height: 1.6; }
  .series header { padding-bottom: 1.6rem; margin-bottom: 0.4rem; }
  @media (max-width: 720px) { .series { padding-top: 5rem; } }
</style>
