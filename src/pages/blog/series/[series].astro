---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PostList from '../../../components/PostList.astro'
import { getBlog, introSeriesSlug } from '../../../data/blogSeries'

export async function getStaticPaths() {
  const { series } = await getBlog()
  return series.map((s) => ({ params: { series: s.slug }, props: { series: s } }))
}

const { series } = Astro.props
const { title, details, network } = series
---

<BaseLayout paper title={`${title} | Blog`} description={details?.description ?? `Tangle blog posts in the ${title} series.`} bodyClass="page-editorial" robots={network ? 'noindex, follow' : undefined}>
  <div class="series">
    <a href={network ? '/blog/network/' : '/blog'} class="back">{network ? 'Tangle Network' : 'Blog'}</a>
    <header>
      {network && <p class="network">These posts are about the Tangle Network protocol, a separate project from Tangle's infrastructure for AI agents. <a href={`/blog/series/${introSeriesSlug}`}>Introduction to Tangle</a> covers the agent infrastructure.</p>}
      <h1>{title}</h1>
      {details && [details.premise, details.decision, details.path].filter(Boolean).map((text) => <p>{text}</p>)}
    </header>
    <PostList posts={series.posts} show="summary" />
  </div>
</BaseLayout>

<style>
  .series { width: min(46rem, 92vw); margin: 0 auto; padding: 6.5rem 0 6rem; color: var(--text-primary); }
  .back { display: inline-block; margin-bottom: 1.2rem; font-size: 0.9rem; font-weight: 600; color: var(--accent-text); text-decoration: none; }
  .back::before { content: '← '; }
  .series h1 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 3.6vw, 2.8rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.08; }
  .series header p { margin: 1rem 0 0; color: var(--text-secondary); font-size: 1.05rem; line-height: 1.6; }
  .series header { padding-bottom: 1.6rem; margin-bottom: 0.4rem; }
  .series header .network { margin: 0 0 1.4rem; padding: 0.8rem 1rem; border: 1px solid var(--border-default); border-left: 3px solid var(--accent-text); border-radius: 0.5rem; font-size: var(--font-size-sm); line-height: 1.55; }
  .network a { color: var(--accent-text); font-weight: 600; }
  @media (max-width: 720px) { .series { padding-top: 5rem; } }
</style>
