---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const normalize = (series?: string) => series?.replace(/^['"]|['"]$/g, '') || '';
  const inSeries = (name: string) => posts
    .filter((post) => normalize(post.data.series) === name)
    .sort((a, b) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999) || b.data.date.localeCompare(a.data.date));
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post, seriesPosts: normalize(post.data.series) ? inSeries(normalize(post.data.series)) : [] },
  }));
}

const { post, seriesPosts } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout
  title={post.data.title}
  summary={post.data.summary}
  date={post.data.date}
  updated={post.data.updated}
  author={post.data.author}
  tags={post.data.tags}
  slug={post.data.slug}
  series={post.data.series}
  seriesPosts={seriesPosts}
>
  <Content />
</BlogLayout>
