---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostList from '../../components/PostList.astro'
import { getBlog, introSeriesSlug, isNetworkPost } from '../../data/blogSeries'

// Posts marked `section: network`, newest series first, then the network posts outside a network series.
const blog = await getBlog()
const series = blog.series.filter((s) => s.network).sort((a, b) => b.latest.localeCompare(a.latest))
const standalone = blog.standalone.filter(isNetworkPost)
---

<BaseLayout
  paper
  title="Tangle Network | Blog"
  description="Posts about the Tangle Network protocol, a separate project from Tangle's infrastructure for AI agents: Blueprints, operators, staking, x402 payments, and on-chain quotes."
  bodyClass="page-editorial"
  robots="noindex, follow"
>
  <div class="network">
    <a href="/blog" class="back">Blog</a>
    <header>
      <h1>Tangle Network</h1>
      <p>The Tangle Network is a protocol where independent operators run services, coordinated by blockchain contracts. It is a separate project from Tangle's infrastructure for AI agents. These posts cover Blueprints, operators, staking, x402 payments, on-chain quotes, and trusted hardware.</p>
      <p>Tangle's agent infrastructure starts at <a href={`/blog/series/${introSeriesSlug}`}>Introduction to Tangle</a>.</p>
    </header>
    {series.map((s) => (
      <section id={s.slug} aria-labelledby={`h-${s.slug}`}>
        <h2 id={`h-${s.slug}`}>{s.title}</h2>
        {s.details && <p>{s.details.description}</p>}
        <PostList posts={s.posts} />
      </section>
    ))}
    {standalone.length > 0 && (
      <section id="other" aria-labelledby="h-other">
        <h2 id="h-other">Other protocol posts</h2>
        <PostList posts={standalone} show="date" />
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .network { width: min(46rem, 92vw); margin: 0 auto; padding: 6.5rem 0 6rem; color: var(--text-primary); }
  .back { display: inline-block; margin-bottom: 1.2rem; font-size: var(--font-size-sm); font-weight: 600; color: var(--accent-text); text-decoration: none; }
  .back::before { content: '← '; }
  h1 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 3.6vw, 2.8rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.08; }
  header { padding-bottom: 2rem; border-bottom: 1px solid var(--chart-ink-muted); }
  header p { margin: 1rem 0 0; color: var(--text-secondary); font-size: var(--font-size-lg); line-height: 1.6; }
  header a { color: var(--accent-text); font-weight: 600; }
  section { margin-top: 3rem; scroll-margin-top: 5rem; }
  h2 { margin: 0 0 0.4rem; font-family: var(--font-display); font-size: var(--font-size-xl); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  section > p { margin: 0 0 1rem; color: var(--text-secondary); font-size: var(--font-size-sm); line-height: 1.55; }
  @media (max-width: 720px) { .network { padding-top: 5rem; } }
</style>
