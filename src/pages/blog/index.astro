---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostList from '../../components/PostList.astro'
import { getCollection } from 'astro:content'
import { blogSeriesSlug, getBlogSeriesDetails } from '../../data/blogSeries'

// The index is a table of contents: every series in reading order, newest series first, then the posts outside any series.
const posts = await getCollection('blog', ({ data }) => !data.draft)
const normalize = (series?: string) => series?.replace(/^['"]|['"]$/g, '') || ''
const inOrder = (a: (typeof posts)[number], b: (typeof posts)[number]) =>
  (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999) || b.data.date.localeCompare(a.data.date)
const grouped = new Map<string, typeof posts>()
for (const post of posts) {
  const key = normalize(post.data.series)
  if (!grouped.has(key)) grouped.set(key, [])
  grouped.get(key)!.push(post)
}
const series = [...grouped.entries()]
  .filter(([name]) => name)
  .map(([name, entries]) => ({
    name,
    slug: blogSeriesSlug(name),
    details: getBlogSeriesDetails(name),
    posts: entries.sort(inOrder),
    latest: entries.reduce((m, p) => (p.data.date > m ? p.data.date : m), ''),
  }))
  .sort((a, b) => b.latest.localeCompare(a.latest))
const standalone = (grouped.get('') ?? []).sort((a, b) => b.data.date.localeCompare(a.data.date))
---

<BaseLayout
  paper
  title="Blog"
  description="Implementation notes and measurements from building agent infrastructure on Tangle, in series that read in order."
  bodyClass="page-editorial"
>
  <div class="blog">
    <header class="blog-head">
      <h1>Blog</h1>
      <p>Notes from building and running agent infrastructure: what we measured, what broke, and the code that runs on Tangle. Each series reads in order.</p>
    </header>
    <div class="blog-body">
      <nav class="blog-nav" aria-label="Series">
        <ol>
          {series.map((s) => (
            <li><a href={`#${s.slug}`}><span>{s.details?.title ?? s.name}</span><span class="count">{s.posts.length}</span></a></li>
          ))}
          {standalone.length > 0 && <li><a href="#standalone"><span>Standalone</span><span class="count">{standalone.length}</span></a></li>}
        </ol>
      </nav>
      <div class="blog-lists">
        {series.map((s) => (
          <section id={s.slug} class="series" aria-labelledby={`h-${s.slug}`}>
            <h2 id={`h-${s.slug}`}><a href={`/blog/series/${s.slug}`}>{s.details?.title ?? s.name}</a></h2>
            {s.details && <p>{s.details.description}</p>}
            <PostList posts={s.posts} />
          </section>
        ))}
        {standalone.length > 0 && (
          <section id="standalone" class="series" aria-labelledby="h-standalone">
            <h2 id="h-standalone">Standalone</h2>
            <PostList posts={standalone} />
          </section>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .blog { width: min(72rem, 92vw); margin: 0 auto; padding: 6.5rem 0 6rem; color: var(--text-primary); }
  .blog-head { max-width: 40rem; padding-bottom: 2rem; border-bottom: 1px solid var(--chart-ink-muted); }
  .blog-head h1 { margin: 0; font-family: var(--font-display); font-size: clamp(2.2rem, 4vw, 3rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.05; }
  .blog-head p { margin: 1rem 0 0; color: var(--text-secondary); font-size: 1.08rem; line-height: 1.6; }
  .blog-body { display: grid; grid-template-columns: 16rem minmax(0, 1fr); gap: 3rem; margin-top: 2rem; }
  .blog-nav { position: sticky; top: 5rem; align-self: start; max-height: calc(100vh - 6rem); overflow-y: auto; }
  .blog-nav ol { margin: 0; padding: 0; list-style: none; }
  .blog-nav a { display: flex; justify-content: space-between; gap: 0.8rem; padding: 0.4rem 0; font-size: 0.92rem; line-height: 1.35; color: var(--text-secondary); text-decoration: none; }
  .blog-nav a:hover, .blog-nav a:focus-visible { color: var(--accent-text); }
  .blog-nav .count { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted); }
  .blog-lists { max-width: 46rem; }
  .series { scroll-margin-top: 5rem; }
  .series + .series { margin-top: 3rem; }
  .series h2 { margin: 0 0 0.4rem; font-family: var(--font-display); font-size: 1.45rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .series h2 a { color: inherit; text-decoration: none; }
  .series h2 a:hover { color: var(--accent-text); }
  .series > p { margin: 0 0 1rem; color: var(--text-secondary); font-size: 0.98rem; line-height: 1.55; }
  @media (max-width: 900px) {
    .blog-body { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .blog-nav { position: static; max-height: none; }
    .blog-nav ol { display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem; }
    .blog-nav a { padding: 0.2rem 0; }
    .blog { padding-top: 5rem; }
  }
</style>
