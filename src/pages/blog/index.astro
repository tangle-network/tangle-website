---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BlogCover from '../../components/BlogCover.astro'
import TopicFilter from '../../components/TopicFilter'
import { getCollection } from 'astro:content'
import { formatDate } from '../../utils/date'
import { blogSeriesSlug, getBlogSeriesDetails } from '../../data/blogSeries'

const posts = await getCollection('blog', ({ data }) => !data.draft)

const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
)

const normalizeSeries = (series?: string) => series?.replace(/^['"]|['"]$/g, '') || 'Standalone'
const topicLabels: Record<string, string> = {
  agents: 'Agents',
  'browser-agent': 'Browser',
  x402: 'x402',
  'tax-agent': 'Tax agent',
  'blueprint-agent': 'Blueprint agent',
  'tangle-protocol': 'Protocol',
  'code-auditor': 'Code audit',
}

const topicOptions = Object.keys(topicLabels).filter((topic) =>
  sortedPosts.some((post) => post.data.tags.includes(topic)),
)

const seriesMap = new Map<string, typeof sortedPosts>()
for (const post of sortedPosts) {
  const series = normalizeSeries(post.data.series)
  if (!seriesMap.has(series)) seriesMap.set(series, [])
  seriesMap.get(series)?.push(post)
}

const seriesGroups = [...seriesMap.entries()]
  .filter(([name]) => name !== 'Standalone')
  .map(([name, entries]) => {
    const ordered = [...entries].sort((a, b) => {
      const orderA = a.data.seriesOrder ?? 999
      const orderB = b.data.seriesOrder ?? 999
      if (orderA !== orderB) return orderA - orderB
      return new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
    })

    const representative = ordered.find((post) => post.data.coverImage || post.data.heroImage) ?? ordered[0]
    const latest = [...entries].sort(
      (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
    )[0]

    return {
      name,
      details: getBlogSeriesDetails(name),
      representative,
      latest,
      topics: [...new Set(entries.flatMap((post) => post.data.tags))],
    }
  })
  .sort((a, b) => {
    if (a.name === 'Standalone') return 1
    if (b.name === 'Standalone') return -1
    return a.name.localeCompare(b.name)
  })
---

<BaseLayout
  title="Blog"
  description="Implementation notes, product essays, research threads, and field reports from the Tangle stack."
  bodyClass="page-editorial"
>
  <section class="blog-page" data-theme="website" aria-labelledby="blog-title">
    <div class="blog-shell">
      <header class="blog-hero">
        <h1 id="blog-title">Technical guides for building reliable AI agents.</h1>
        <p>Tangle builds AI agent infrastructure across sandbox, runtime, router, integrations, and observability. These guides explain implementation choices, measurements, and limits. See the <a class="definition-link" href="/what-is-tangle/">current Tangle definition</a> for layer access and product status.</p>
        <p class="blog-start">New here? Start with <a href="/blog/series/tangle-re-introduction">Tangle Re-Introduction</a> for the protocol or <a href="/blog/series/agent-intent-infrastructure">Agent Intent Infrastructure</a> for agent services.</p>
      </header>

      {topicOptions.length > 0 && (
        <TopicFilter
          client:visible
          topics={topicOptions.map((topic) => ({ id: topic, label: topicLabels[topic] }))}
        />
      )}

      <section class="series-index" aria-labelledby="series-title">
        <div class="section-heading">
          <div>
            <h2 id="series-title">Choose a learning path</h2>
            <p>Each series follows one technical subject from first principles through implementation, measurement, and limits.</p>
          </div>
        </div>

        <div class="series-grid">
          {seriesGroups.map((group) => (
            <a
              href={`/blog/series/${blogSeriesSlug(group.name)}`}
              class="series-card"
              data-series-card
              data-series={group.name}
              data-topics={group.topics.join(' ')}
            >
              <BlogCover
                title={group.details?.title ?? group.name}
                summary={group.details?.premise ?? group.latest.data.summary}
                series={group.name}
                tags={group.topics}
                coverImage={group.representative.data.coverImage}
                imageAlt={group.representative.data.imageAlt || group.name}
              />
              <div class="series-card-copy">
                <h3>{group.details?.title ?? group.name}</h3>
                <p>{group.details?.premise ?? group.latest.data.summary}</p>
                <time datetime={group.latest.data.date}>{formatDate(group.latest.data.date, 'short')}</time>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="post-index" aria-labelledby="post-index-title">
        <div class="section-heading post-index-heading">
          <div>
            <h2 id="post-index-title">All technical articles</h2>
            <p>Browse every article by publication date, or use the topic filter above to narrow the list.</p>
          </div>
        </div>

        <div class="post-list" data-post-list>
          {sortedPosts.map((post) => (
            <a
              href={`/blog/${post.data.slug}`}
              class="post-row"
              data-post-row
              data-series={normalizeSeries(post.data.series)}
              data-topics={post.data.tags.join(' ')}
            >
                  <time datetime={post.data.date}>{formatDate(post.data.date, 'short')}</time>
              <div>
                <h3>{post.data.title}</h3>
                <p>{post.data.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </section>

</BaseLayout>

<style>
  .blog-page {
    min-height: 100vh;
    padding: 8rem 6% 6rem;
    background: var(--depth-1);
    color: var(--text-primary);
  }

  .blog-shell {
    width: min(78rem, 100%);
    margin: 0 auto;
  }

  .blog-hero {
    max-width: 55rem;
    margin-bottom: 3.5rem;
  }

  .blog-hero h1,
  .section-heading h2,
  .series-card h3,
  .post-row h3 {
    margin: 0;
    font-family: var(--font-display);
    letter-spacing: 0;
    color: var(--text-primary);
    text-wrap: balance;
  }

  .blog-hero h1 {
    font-size: clamp(3.2rem, 6vw, 5.5rem);
    font-weight: 600;
    line-height: 1;
  }

  .blog-hero p,
  .section-heading p,
  .series-card p,
  .post-row p {
    color: var(--text-muted);
  }

  .blog-hero p {
    max-width: 44rem;
    margin: 1.25rem 0 0;
    font-size: clamp(1.08rem, 2vw, 1.28rem);
    line-height: 1.58;
  }

  .blog-hero .definition-link {
    color: var(--accent-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .blog-hero .blog-start {
    font-size: 1rem;
  }

  .blog-start a {
    color: var(--accent-text);
    font-weight: 600;
  }

  .series-index {
    margin-top: 3rem;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.2rem;
  }

  .section-heading h2 {
    font-size: clamp(1.7rem, 3vw, 2.55rem);
    font-weight: 600;
    line-height: 1.05;
  }

  .section-heading p {
    max-width: 34rem;
    margin: 0.45rem 0 0;
    font-size: 1rem;
    line-height: 1.55;
  }

  .series-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .series-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border-default);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.74);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 18px 50px rgba(15, 23, 42, 0.06);
  }

  .series-card:hover h3,
  .post-row:hover h3 {
    color: var(--accent-text);
  }

  .series-card-copy {
    padding: 1rem 1rem 1.1rem;
  }

  .series-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.18;
  }

  .series-card p {
    margin: 0.55rem 0 0;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .series-card time,
  .post-row time {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .series-card time {
    margin-top: 0.9rem;
  }

  .post-index {
    margin-top: 4.5rem;
  }

  .post-index-heading {
    align-items: start;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--border-default);
  }

  /* Topic filter governs the whole index (both Series and Archive), so it sits
     directly under the hero and sticks to the top — reachable while reading the
     long archive, instead of buried beside the Archive heading two screens down. */
  .blog-shell :global(.topic-filter) {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 3rem;
    padding: 0.9rem 0;
    background: var(--depth-1);
    border-bottom: 1px solid var(--border-default);
  }

  .post-list {
    border-bottom: 1px solid var(--border-default);
  }

  .post-row {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 2rem;
    padding: 1.35rem 0;
    border-top: 1px solid var(--border-default);
    color: inherit;
    text-decoration: none;
  }

  .post-row h3 {
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    font-weight: 600;
    line-height: 1.18;
  }

  .post-row p {
    max-width: 54rem;
    margin: 0.55rem 0 0;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 980px) {
    .series-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .section-heading {
      align-items: start;
      flex-direction: column;
      gap: 1rem;
    }

    .blog-shell :global(.topic-filter) {
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    /* Don't pin the wrapped pill bar on phones — it would eat ~3 rows of a
       small viewport. Still sits under the hero, so it's seen on landing. */
    .blog-shell :global(.topic-filter) {
      position: static;
      margin-bottom: 2.4rem;
    }

    .blog-page {
      padding: 6.25rem 1rem 4rem;
    }

    .blog-hero {
      margin-bottom: 2.4rem;
    }

    .blog-hero h1 {
      font-size: clamp(2.8rem, 16vw, 4.4rem);
    }

    .series-grid {
      grid-template-columns: 1fr;
    }

    .post-row {
      grid-template-columns: 1fr;
      gap: 0.45rem;
      padding: 1.1rem 0;
    }
  }
</style>
