---
import { formatSpanDuration as time } from '@tangle-network/charts';
import { Code } from 'astro:components';
import ProductLayout from '../../layouts/ProductLayout.astro';
import bench from '../../data/benchmarks/sandbox.json';
import compare from '../../data/compare.json';

// /compare/ sells Tangle against every rival at once, /compare/<slug>/ against one: the buyer's gain, the code that
// shows it, reasons with our proof, how to move, and what every sandbox includes. Every link is ours, and every speed
// figure is a row of the record /benchmarks draws. compare.json holds the copy.
interface Claim { text: string; src: string }
interface Sell {
  headline: string;
  summary: string;
  code: { lang: 'ts' | 'python' | 'bash'; text: string; proof: string; src: string; agent?: string };
  reasons: Claim[];
  switch?: { lang: 'diff' | 'ts'; text: string; intro?: string; rest?: string; restSrc?: string; guide: { label: string; href: string } };
  rows: (keyof typeof compare.tangle)[];
  cta: { label: string; href: string };
}
const rivals = compare.rivals as { slug: string; name: string; sell: Sell }[];
const { tangle } = compare;

export const getStaticPaths = () => [undefined, ...compare.rivals.map((r) => r.slug)].map((rival) => ({ params: { rival } }));

const rival = rivals.find((r) => r.slug === Astro.params.rival);
const page: Sell = rival?.sell ?? (compare.index as Sell);
const name = rival?.name ?? `${rivals.slice(0, 3).map((r) => r.name).join(', ')} and ${rivals.length - 3} more`;
// The title carries the search a buyer types ("Tangle vs <rival>") and the gain.
const title = `Tangle vs ${name}: ${page.headline[0].toLowerCase()}${page.headline.slice(1).replace(/\.$/, '')}`;
const where = (src: string) => { const u = new URL(src); return `${u.host.replace(/^www\./, '')}${u.pathname.replace(/\/$/, '')}${u.hash}`; };
// The first reply of the agent the code starts, from create.
const reply = page.code.agent ? bench.panels.find((p) => p.title === 'First reply, from create')?.rows.find((r) => r.label === page.code.agent) : undefined;
if (page.code.agent && !reply) throw new Error(`compare: /benchmarks has no "First reply, from create" row "${page.code.agent}"`);
const move = rival && page.switch;
---

<ProductLayout title={title} description={page.summary} crumb={rival && { href: '/compare/', label: 'Compare' }}>
  <Code code={page.code.text} lang={page.code.lang} theme="github-dark" />
  <p>{page.code.proof} (<a href={page.code.src}>{where(page.code.src)}</a>).{reply && <> {page.code.agent}'s first reply arrives {time(reply.p50)} after create at p50 and {reply.p95 === null ? 'n/a' : time(reply.p95)} at p95, over {reply.n} measured runs (<a href="/benchmarks/">tangle.tools/benchmarks</a>).</>}</p>

  <h2>What else you get</h2>
  <ul>{page.reasons.map((c) => <li>{c.text} (<a href={c.src}>{where(c.src)}</a>)</li>)}</ul>

  {rival && move ? (
    <>
      <h2>Move your code from {rival.name}</h2>
      {move.intro && <p>{move.intro}</p>}
      <Code code={move.text} lang={move.lang} theme="github-dark" />
      {move.rest && move.restSrc && <p>{move.rest} (<a href={move.restSrc}>{where(move.restSrc)}</a>)</p>}
      <p>For everything else, <a href={move.guide.href}>{move.guide.label}</a>.</p>
    </>
  ) : (
    <>
      <h2>Move your code</h2>
      <ul>{rivals.map((r) => <li><a href={`/compare/${r.slug}/`}>From {r.name}</a>: {r.sell.headline}</li>)}</ul>
    </>
  )}

  <h2>What every sandbox includes</h2>
  <table class="includes">
    <tbody>
      {page.rows.map((id) => (
        <tr>
          <th scope="row">{tangle[id].label}</th>
          <td>{tangle[id].text} (<a href={tangle[id].src}>{where(tangle[id].src)}</a>)</td>
        </tr>
      ))}
    </tbody>
  </table>

  <p><a class="cta" href={page.cta.href}>{page.cta.label}</a></p>
</ProductLayout>

<style>
  /* What every sandbox includes: a label column and its fact, stacked on a phone. */
  table.includes { width: 100%; margin: 0 0 1rem; border-collapse: collapse; }
  table.includes th, table.includes td { padding: 0.85rem 0; border-top: 1px solid var(--border-default); vertical-align: top; text-align: left; font-size: 1rem; line-height: 1.55; }
  table.includes th { width: 12rem; padding-right: 1.5rem; color: var(--text-primary); font-weight: 600; }
  table.includes td { color: var(--text-secondary); }
  @media (max-width: 640px) {
    table.includes th, table.includes td { display: block; width: auto; padding: 0; border: 0; }
    table.includes tr { display: block; padding: 0.85rem 0; border-top: 1px solid var(--border-default); }
    table.includes th { margin-bottom: 0.25rem; }
  }
  /* The one call to action, in the site's primary button colours. */
  a.cta {
    display: inline-flex;
    margin-top: 1.5rem;
    padding: 0.75rem 1.3rem;
    border-radius: 9px;
    background: var(--btn-primary-bg);
    border: 1px solid var(--btn-primary-hover);
    color: var(--btn-primary-text) !important;
    font-family: var(--font-sans);
    font-weight: 600;
    text-decoration: none !important;
  }
</style>
