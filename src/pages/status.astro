---
import BaseLayout from '../layouts/BaseLayout.astro';
import status from '../../public/status/history.json';

const generatedAt = new Date(status.generatedAt);
const generatedLabel = Number.isNaN(generatedAt.valueOf())
  ? 'Unavailable'
  : new Intl.DateTimeFormat('en-US', {
      dateStyle: 'medium',
      timeStyle: 'short',
      timeZone: 'UTC',
    }).format(generatedAt) + ' UTC';

// Status tones come from Brand. A state the collector did not record stays neutral.
const tones = {
  operational: { label: 'Operational', text: 'text-[var(--surface-success-text)]' },
  down: { label: 'Unavailable', text: 'text-[var(--surface-danger-text)]' },
} as const;
const unknownTone = { label: 'Not checked', text: 'text-fg-muted' };

const services = status.services.map((service) => {
  const current = service.current as Partial<typeof service.current> | undefined;
  const tone = tones[current?.status as keyof typeof tones] ?? unknownTone;
  return {
    ...service,
    tone,
    http: current?.httpStatus ?? 'No response',
    latency: typeof current?.latencyMs === 'number' ? `${current.latencyMs} ms` : 'No reading',
    checkedAt: current?.checkedAt ? new Date(current.checkedAt).toISOString().replace('.000Z', 'Z') : 'Not checked',
  };
});
---

<BaseLayout title="Service Status" description="Latest public endpoint checks for Tangle services.">
  <section class="max-w-5xl mx-auto px-6 pt-32 pb-24">
    <h1 class="text-4xl md:text-5xl font-bold">Latest public endpoint checks</h1>
    <p class="mt-5 max-w-2xl text-(--text-secondary) leading-relaxed">
      This page reports the latest HTTP endpoint check for each listed service.
      Checks send GET requests to the configured endpoint. A 2xx response counts as operational.
      The router also requires JSON status <code>ok</code>. Each request has a 12-second timeout.
      It is not an uptime guarantee or incident history.
    </p>

    {services.length === 0 ? (
      <p class="mt-12 border border-(--border-default) px-5 py-8 text-(--text-secondary)">No services are configured for public checks.</p>
    ) : (
      <>
        <ul class="mt-12 border border-(--border-default) bg-surface-container-low divide-y divide-(--border-subtle) md:hidden">
          {services.map((service) => (
            <li class="px-5 py-5">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <a class="font-medium text-fg break-words hover:text-brand-cool" href={service.href}>{service.name}</a>
                  <div class="mt-1 font-mono text-xs text-fg-muted break-all">{service.domain}</div>
                </div>
                <span class={`inline-flex shrink-0 items-center gap-2 text-sm ${service.tone.text}`}>
                  <span class={`h-2 w-2 rounded-full bg-current`} aria-hidden="true"></span>
                  {service.tone.label}
                </span>
              </div>
              <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
                <dt class="text-fg-muted">HTTP</dt><dd class="text-(--text-secondary)">{service.http}</dd>
                <dt class="text-fg-muted">Latency</dt><dd class="text-(--text-secondary)">{service.latency}</dd>
                <dt class="text-fg-muted">Checked</dt><dd class="text-(--text-secondary) font-mono text-xs leading-5 break-all">{service.checkedAt}</dd>
              </dl>
            </li>
          ))}
        </ul>

        <div class="mt-12 hidden md:block border border-(--border-default) bg-surface-container-low">
          <table class="w-full text-left">
            <thead class="border-b border-(--border-default) text-xs uppercase tracking-wide text-fg-muted">
              <tr>
                <th class="px-5 py-4 font-medium">Service</th>
                <th class="px-5 py-4 font-medium">Status</th>
                <th class="px-5 py-4 font-medium">HTTP</th>
                <th class="px-5 py-4 font-medium">Latency</th>
                <th class="px-5 py-4 font-medium">Checked at (UTC)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-(--border-subtle)">
              {services.map((service) => (
                <tr>
                  <td class="px-5 py-5 max-w-[16rem]">
                    <a class="font-medium text-fg break-words hover:text-brand-cool" href={service.href}>{service.name}</a>
                    <div class="mt-1 font-mono text-xs text-fg-muted break-all">{service.domain}</div>
                  </td>
                  <td class="px-5 py-5">
                    <span class={`inline-flex items-center gap-2 whitespace-nowrap ${service.tone.text}`}>
                      <span class={`h-2 w-2 rounded-full bg-current`} aria-hidden="true"></span>
                      {service.tone.label}
                    </span>
                  </td>
                  <td class="px-5 py-5 text-(--text-secondary)">{service.http}</td>
                  <td class="px-5 py-5 text-(--text-secondary) whitespace-nowrap">{service.latency}</td>
                  <td class="px-5 py-5 text-(--text-secondary) whitespace-nowrap">{service.checkedAt}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}

    <div class="mt-8 grid gap-8 md:grid-cols-2 border-t border-(--border-default) pt-8 text-sm leading-relaxed text-(--text-secondary)">
      <p>Latest collection: <span class="text-fg">{generatedLabel}</span>. Each result records a request to the public endpoint shown above.</p>
      <p>For a security concern or service-impacting issue, email <a class="underline text-fg" href="mailto:security@tangle.tools">security@tangle.tools</a>.</p>
    </div>
  </section>
</BaseLayout>
