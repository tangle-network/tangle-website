---
import { PageHeader } from '@tangle-network/ui/primitives';
import BaseLayout from '../../layouts/BaseLayout.astro';

const film = '/films/carbon-copy.mp4';
const poster = '/films/carbon-copy-poster.webp';
---

<BaseLayout
  title="Carbon copy"
  description="A paper press splits one strip into two. Watch the short film, then follow the separate writes in a recorded Tangle Sandbox run."
  image={poster}
  imageAlt="Brass rollers feed two punched paper strips, one printed in red and the other in gold."
  imageSize={{ width: 1280, height: 550 }}
  video={{ url: new URL(film, Astro.site).href, type: 'video/mp4', width: 1280, height: 550 }}
  paper
>
  <article class="film">
    <PageHeader title="Carbon copy" titleId="film-title" />
    <video controls playsinline preload="none" poster={poster} width="1280" height="550"
      aria-labelledby="film-title" aria-describedby="film-description">
      <source src={film} type="video/mp4" />
      <a href={film}>Download Carbon copy</a>
    </video>
    <p id="film-description">A press splits one paper strip into two. In the recorded Sandbox run, both branches inherit <code>base.txt</code>. Each writes its own line.</p>
    <a class="example-link" href="/?example=sandboxes/branch-into-two#quickstart-title">Open the branch example <span aria-hidden="true">↗</span></a>
  </article>
</BaseLayout>

<style>
  .film { width: min(80rem, calc(100% - 2rem)); margin-inline: auto; padding-block: clamp(2.5rem, 6vw, 6rem); }
  .film > :global(header) { margin-bottom: clamp(1.25rem, 3vw, 2.5rem); }
  .film :global(#film-title) { font-family: var(--font-display); font-size: clamp(3rem, 6vw, 5rem); line-height: 1; letter-spacing: -.045em; }
  video { display: block; width: 100%; height: auto; aspect-ratio: 1280 / 550; background: var(--text-primary); }
  p { max-width: 44rem; margin: clamp(1.25rem, 3vw, 2rem) 0 .75rem; font-size: var(--font-size-lg); line-height: 1.6; color: var(--text-secondary); }
  code { font-family: var(--font-mono); }
  .example-link { display: inline-block; color: var(--accent-text); text-decoration: underline; text-underline-offset: .2em; }
  .example-link:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
</style>
