---
import BaseLayout from "./BaseLayout.astro";
import PostList from "../components/PostList.astro";
import { formatDate } from "../utils/date";
import { blogSeriesSlug, getBlogSeriesDetails } from "../data/blogSeries";

interface Props {
  title: string;
  summary: string;
  date: string;
  updated?: string;
  author: string;
  tags: string[];
  slug: string;
  series?: string;
  seriesPosts: { data: { slug: string; title: string; date: string } }[];
}

const { title, summary, date, updated, author, tags, slug, series, seriesPosts } = Astro.props;
const seriesName = series?.replace(/^['"]|['"]$/g, "") || "";
const seriesTitle = seriesName ? getBlogSeriesDetails(seriesName)?.title ?? seriesName : "";
const part = seriesPosts.findIndex((post) => post.data.slug === slug) + 1;
const next = part > 0 ? seriesPosts[part] : undefined;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: summary,
  keywords: [...new Set(tags)],
  author: { "@type": "Person", name: author },
  datePublished: date,
  dateModified: updated || date,
  inLanguage: "en-US",
  publisher: { "@type": "Organization", name: "Tangle Network", url: "https://tangle.tools" },
  mainEntityOfPage: canonicalUrl,
};
---

<BaseLayout paper title={title} description={summary} ogType="article" contentType="blog" bodyClass="page-editorial">
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <div class="post">
    <header class="post-head">
      <p class="post-crumb">
        <a href="/blog">Blog</a>
        {seriesName && <><span aria-hidden="true"> / </span><a href={`/blog/series/${blogSeriesSlug(seriesName)}`}>{seriesTitle}</a></>}
        {part > 0 && seriesPosts.length > 1 && <span class="post-part">part {part} of {seriesPosts.length}</span>}
      </p>
      <h1>{title}</h1>
      <p class="post-summary">{summary}</p>
      <p class="post-meta">
        <span>{author}</span>
        <time datetime={date}>{formatDate(date)}</time>
        {updated && <span>updated <time datetime={updated}>{formatDate(updated)}</time></span>}
      </p>
    </header>

    <div class="post-body">
      <article class="post-article">
        <div class="blog-content">
          <slot />
        </div>
        {next && <p class="post-next">Next in {seriesTitle}: <a href={`/blog/${next.data.slug}`}>{next.data.title}</a></p>}
      </article>
      {seriesPosts.length > 1 && (
        <aside class="post-rail" aria-label={`Posts in ${seriesTitle}`}>
          <p><a href={`/blog/series/${blogSeriesSlug(seriesName)}`}>{seriesTitle}</a></p>
          <PostList posts={seriesPosts} current={slug} compact />
        </aside>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .post { width: min(72rem, 92vw); margin: 0 auto; padding: 6.5rem 0 6rem; color: var(--text-primary); }
  .post-head { max-width: 46rem; }
  .post-crumb { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.4rem; margin: 0 0 1.2rem; font-size: 0.9rem; color: var(--text-muted); }
  .post-crumb a { color: var(--accent-text); font-weight: 600; text-decoration: none; }
  .post-crumb a:hover { text-decoration: underline; }
  .post-part { margin-left: 0.6rem; font-family: var(--font-mono); font-size: 0.8rem; }
  .post-head h1 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.1rem); font-weight: 600; line-height: 1.08; letter-spacing: -0.03em; overflow-wrap: break-word; }
  .post-summary { margin: 1rem 0 0; font-size: clamp(1.05rem, 1.4vw, 1.2rem); line-height: 1.6; color: var(--text-secondary); }
  .post-meta { display: flex; flex-wrap: wrap; gap: 0 1rem; margin: 1rem 0 0; font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-muted); }
  .post-body { display: grid; grid-template-columns: minmax(0, 46rem) minmax(0, 1fr); gap: 4rem; margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid var(--chart-ink-muted); }
  .post-article { min-width: 0; }
  .post-rail { position: sticky; top: 5rem; align-self: start; max-height: calc(100vh - 6rem); overflow-y: auto; font-size: 0.9rem; }
  .post-rail > p { margin: 0 0 0.4rem; font-weight: 600; }
  .post-rail > p a { color: var(--text-primary); text-decoration: none; }
  .post-rail > p a:hover { color: var(--accent-text); }
  .post-next { margin: 3rem 0 0; padding-top: 1.2rem; border-top: 1px solid var(--border-subtle); font-size: 1rem; }
  .post-next a { color: var(--accent-text); font-weight: 600; }
  .blog-content { color: var(--text-primary); font-size: 1.08rem; line-height: 1.7; }
  @media (max-width: 1000px) {
    .post-body { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .post-rail { position: static; max-height: none; padding-top: 1.5rem; border-top: 1px solid var(--border-subtle); }
    .post { padding-top: 5rem; }
  }
  .blog-content :global(h2) {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 2.5em;
    margin-bottom: 0.75em;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .blog-content :global(h3) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 2em;
    margin-bottom: 0.5em;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .blog-content :global(h4) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    line-height: 1.4;
    letter-spacing: 0;
  }

  .blog-content :global(p) {
    margin-bottom: 1.25em;
  }

  .blog-content :global(a) {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }

  .blog-content :global(a:hover) {
    color: var(--text-primary);
  }

  .blog-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .blog-content :global(blockquote) {
    border-left: 3px solid var(--accent-text);
    padding-left: 1.25em;
    margin-left: 0;
    margin-top: 1.5em;
    margin-bottom: 1.5em;
    color: var(--text-secondary);
    font-style: italic;
  }

  .blog-content :global(ul) {
    list-style-type: disc;
    padding-left: 1.5em;
    margin-bottom: 1.25em;
  }

  .blog-content :global(ol) {
    list-style-type: decimal;
    padding-left: 1.5em;
    margin-bottom: 1.25em;
  }

  .blog-content :global(li) {
    margin-bottom: 0.5em;
  }

  .blog-content :global(li > ul),
  .blog-content :global(li > ol) {
    margin-top: 0.5em;
    margin-bottom: 0;
  }

  .blog-content :global(pre) {
    background: var(--md3-inverse-surface);
    border: 1px solid var(--border-default);
    border-radius: 12px;
    padding: 1.25em;
    overflow-x: auto;
    margin-top: 1.5em;
    margin-bottom: 1.5em;
    font-size: 0.875em;
    line-height: 1.6;
  }

  .blog-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    border-radius: 0;
    font-family: var(--font-mono);
    color: var(--md3-inverse-on-surface);
    font-size: inherit;
  }

  .blog-content :global(code) {
    background: var(--accent-surface-soft);
    border: 1px solid var(--border-accent);
    border-radius: 6px;
    padding: 0.15em 0.4em;
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--text-primary);
  }

  .blog-content :global(mark),
  .blog-content :global(.highlight),
  .blog-content :global([data-highlighted]) {
    background: var(--bg-selection);
    color: var(--text-primary);
    border-radius: 4px;
    padding: 0.06em 0.22em;
  }

  .blog-content :global(:not(pre) > code span[style]) {
    color: var(--text-primary) !important;
  }

  .blog-content :global(img) {
    width: 100%;
    border-radius: 12px;
    margin-top: 1.5em;
    margin-bottom: 1.5em;
  }

  .blog-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border-default);
    margin-top: 2.5em;
    margin-bottom: 2.5em;
  }

  .blog-content :global(table) {
    display: table;
    width: 100%;
    max-width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin-top: 1.5em;
    margin-bottom: 1.5em;
    font-size: 0.925em;
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    overflow: hidden;
    table-layout: auto;
  }

  .blog-content :global(th) {
    text-align: left;
    padding: 0.75em 1em;
    border-bottom: 1px solid var(--border-default);
    color: var(--text-primary);
    background: var(--md3-surface-container-high);
    font-weight: 600;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .blog-content :global(td) {
    padding: 0.75em 1em;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-primary);
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  .blog-content :global(tr:last-child td) {
    border-bottom: 0;
  }

  @media (max-width: 640px) {
    .blog-content :global(table) {
      display: block;
      width: max-content;
      min-width: 100%;
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .blog-content :global(th),
    .blog-content :global(td) {
      min-width: 9rem;
    }

    .blog-content :global(table.product-comparison),
    .blog-content :global(table.product-comparison tbody),
    .blog-content :global(table.product-comparison tr),
    .blog-content :global(table.product-comparison th[scope="row"]),
    .blog-content :global(table.product-comparison td) {
      display: block;
      width: 100%;
      min-width: 0;
    }

    .blog-content :global(table.product-comparison) {
      overflow: visible;
      border: 0;
      background: transparent;
    }

    .blog-content :global(table.product-comparison thead) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .blog-content :global(table.product-comparison tr) {
      margin-bottom: 1rem;
      border: 1px solid var(--border-default);
      border-radius: 0.75rem;
      overflow: hidden;
      background: var(--bg-card);
    }

    .blog-content :global(table.product-comparison th[scope="row"]) {
      border: 0;
      padding: 0.75rem 0.9rem;
    }

    .blog-content :global(table.product-comparison td) {
      border: 0;
      border-top: 1px solid var(--border-subtle);
      padding: 0.75rem 0.9rem;
    }

    .blog-content :global(table.product-comparison td::before) {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.2rem;
      color: var(--accent-text);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
  }

  @media (max-width: 860px) {
    .blog-hero {
      padding-top: 5.25rem;
    }

    .blog-hero-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .blog-hero {
      padding-left: 1rem;
      padding-right: 1rem;
      padding-bottom: 1.75rem;
    }

    .blog-hero-inner,
    .blog-hero-copy {
      min-width: 0;
    }

    .blog-hero h1 {
      font-size: clamp(2rem, 10vw, 2.55rem);
      line-height: 1.08;
    }

    .blog-hero p {
      max-width: 100%;
      font-size: 1rem;
      overflow-wrap: break-word;
    }

    .blog-article-shell {
      padding: 1.25rem 1rem 3rem;
    }

    .blog-article {
      padding: 1.15rem;
      max-width: 100%;
    }

    .blog-content {
      font-size: 17px;
    }

    .blog-content :global(h2) {
      font-size: 1.6rem;
    }
  }
</style>
