---
// Brand's reading face, self-hosted at its default optical size (latin 50,936 bytes) and preloaded, so it is usually in
// place before the first paint.
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import BaseLayout from "./BaseLayout.astro";
import PostList from "../components/PostList.astro";
import { formatDate } from "../utils/date";
import { blogSeriesSlug, getBlogSeriesDetails } from "../data/blogSeries";

interface Props {
  title: string;
  summary: string;
  date: string;
  updated?: string;
  author: string;
  tags: string[];
  slug: string;
  series?: string;
  seriesPosts: { data: { slug: string; title: string; date: string } }[];
  crumb?: { href: string; label: string };
}

const { title, summary, date, updated, author, tags, slug, series, seriesPosts, crumb = { href: "/blog", label: "Blog" } } = Astro.props;
const seriesName = series?.replace(/^['"]|['"]$/g, "") || "";
const seriesTitle = seriesName ? getBlogSeriesDetails(seriesName)?.title ?? seriesName : "";
const network = seriesName && getBlogSeriesDetails(seriesName)?.network;
const part = seriesPosts.findIndex((post) => post.data.slug === slug) + 1;
const next = part > 0 ? seriesPosts[part] : undefined;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: summary,
  keywords: [...new Set(tags)],
  author: { "@type": "Person", name: author },
  datePublished: date,
  dateModified: updated || date,
  inLanguage: "en-US",
  publisher: { "@type": "Organization", name: "Tangle Network", url: "https://tangle.tools" },
  mainEntityOfPage: canonicalUrl,
};
---

<BaseLayout
  paper
  title={title}
  description={summary}
  ogType="article"
  contentType="blog"
  bodyClass="page-editorial page-longform"
  robots={network ? "noindex, follow" : undefined}
>
  <link slot="head" rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <div class="post">
    <header class="post-head">
      <p class="post-crumb">
        <a href={crumb.href}>{crumb.label}</a>
        {seriesName && <><span aria-hidden="true">/</span><a href={`/blog/series/${blogSeriesSlug(seriesName)}`}>{seriesTitle}</a></>}
        {part > 0 && seriesPosts.length > 1 && <span class="post-part">Part {part} of {seriesPosts.length}</span>}
      </p>
      <h1>{title}</h1>
      <p class="post-summary">{summary}</p>
      <p class="post-meta">
        <span>{author}</span>
        <time datetime={date}>{formatDate(date)}</time>
        {updated && <span>Updated <time datetime={updated}>{formatDate(updated)}</time></span>}
      </p>
    </header>

    <div class="post-body">
      <article class="post-article">
        <div class="blog-content">
          {network && (
            <blockquote>
              This post is about the Tangle Network protocol, a separate project from Tangle's infrastructure for AI agents.{' '}
              <a href="/blog/series/introduction-to-tangle">Introduction to Tangle</a> covers the agent infrastructure.
            </blockquote>
          )}
          <slot />
        </div>
        {next && <p class="post-next">Next in {seriesTitle}: <a href={`/blog/${next.data.slug}`}>{next.data.title}</a></p>}
      </article>
      {seriesPosts.length > 1 && (
        <aside class="post-rail" aria-label={`Posts in ${seriesTitle}`}>
          <p><a href={`/blog/series/${blogSeriesSlug(seriesName)}`}>{seriesTitle}</a></p>
          <PostList posts={seriesPosts} current={slug} compact />
        </aside>
      )}
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* System serifs sized to Source Serif 4's advance widths and vertical metrics (fontTools, latin text frequencies), so
     swapping in the web font moves few line breaks. Georgia covers macOS and Windows; DejaVu Serif covers Linux. */
  @font-face { font-family: "Source Serif 4 Fallback"; src: local("Georgia"); size-adjust: 108.6%; ascent-override: 95.4%; descent-override: 30.85%; line-gap-override: 0%; }
  @font-face { font-family: "Source Serif 4 Fallback DejaVu"; src: local("DejaVu Serif"); size-adjust: 93.35%; ascent-override: 110.98%; descent-override: 35.89%; line-gap-override: 0%; }
</style>

<style>
  /* Long-form reading: Brand's reading face and paper/ink pair, in Brand's 42rem measure. Headings, figures and
     chrome stay in the UI sans; the accent stays Brand indigo. */
  :global(body.page-longform main) {
    color-scheme: light;
    --bg-root: var(--longform-paper);
    --text-primary: var(--longform-ink);
    --text-secondary: var(--longform-ink-muted);
    --text-muted: var(--text-secondary);
    --border-default: var(--longform-rule);
    --border-subtle: var(--border-default);
  }
  .post {
    --measure: var(--reading-max-width, 42rem);
    --reading: "Source Serif 4 Variable", "Source Serif 4 Fallback", "Source Serif 4 Fallback DejaVu", var(--font-reading);
    padding: 4.5rem 1.25rem 6rem;
    color: var(--text-primary);
  }
  .post-head { max-width: var(--measure); margin: 0 auto; padding-bottom: 2.5rem; border-bottom: 1px solid var(--border-default); }
  .post-crumb { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.5rem; margin: 0 0 1.4rem; font-family: var(--font-mono); font-size: var(--font-size-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
  .post-crumb a { color: var(--accent-text); font-weight: 600; text-decoration: none; }
  .post-crumb a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .post-part { color: var(--text-muted); }
  .post-head h1 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 1.35rem + 2.4vw, 2.75rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.025em; overflow-wrap: break-word; text-wrap: balance; }
  .post-summary { margin: 1.1rem 0 0; font-family: var(--reading); font-size: 1.3rem; line-height: 1.5; color: var(--text-secondary); text-wrap: pretty; }
  .post-meta { display: flex; flex-wrap: wrap; gap: 0 1.1rem; margin: 1.4rem 0 0; font-family: var(--font-mono); font-size: var(--font-size-xs); color: var(--text-muted); }
  .post-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, var(--measure)) minmax(0, 1fr); column-gap: 4rem; margin-top: 2.5rem; }
  .post-article { grid-column: 2; min-width: 0; }
  .post-rail { grid-column: 3; justify-self: start; width: min(15rem, 100%); position: sticky; top: 5.5rem; align-self: start; max-height: calc(100vh - 7rem); overflow-y: auto; font-family: var(--font-sans); font-size: var(--font-size-sm); }
  .post-rail > p { margin: 0 0 0.5rem; font-family: var(--font-mono); font-size: var(--font-size-xs); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .post-rail > p a { color: var(--text-muted); text-decoration: none; }
  .post-rail > p a:hover { color: var(--accent-text); }
  .post-next { margin: 3rem 0 0; padding-top: 1.2rem; border-top: 1px solid var(--border-subtle); font-family: var(--font-sans); font-size: var(--font-size-base); }
  .post-next a { color: var(--accent-text); font-weight: 600; }
  @media (max-width: 75rem) {
    .post-body { grid-template-columns: minmax(0, var(--measure)); justify-content: center; row-gap: 3rem; }
    .post-article, .post-rail { grid-column: 1; }
    .post-rail { position: static; width: 100%; max-height: none; padding-top: 1.5rem; border-top: 1px solid var(--border-subtle); }
  }
  @media (max-width: 40rem) {
    .post { padding: 2.75rem 1rem 4rem; }
    .post-summary { font-size: var(--font-size-lg); }
    .post-head { padding-bottom: 1.75rem; }
    .post-body { margin-top: 1.75rem; }
  }

  .blog-content { font-family: var(--reading); font-size: 1.1875rem; line-height: 1.7; color: var(--text-primary); font-variant-numeric: lining-nums proportional-nums; }
  .blog-content :global(:is(p, li, blockquote):not(.post-figure *)) { hanging-punctuation: first; }
  @media (max-width: 40rem) { .blog-content { font-size: 1.0625rem; line-height: 1.65; } }
  .blog-content :global(p:not(.post-figure *)) { margin: 0 0 1.15em; text-wrap: pretty; }
  .blog-content :global(h2) { margin: 2.4em 0 0.6em; font-family: var(--font-display); font-size: var(--font-size-2xl); font-weight: 600; line-height: 1.25; letter-spacing: -0.015em; color: var(--text-primary); text-wrap: balance; }
  .blog-content :global(h3) { margin: 2em 0 0.5em; font-family: var(--font-display); font-size: var(--font-size-xl); font-weight: 600; line-height: 1.3; color: var(--text-primary); }
  .blog-content :global(h4) { margin: 1.6em 0 0.4em; font-family: var(--font-display); font-size: var(--font-size-lg); font-weight: 600; line-height: 1.35; color: var(--text-primary); }
  @media (max-width: 40rem) { .blog-content :global(h2) { font-size: var(--font-size-xl); } }
  .blog-content :global(a:not(.post-figure *)) { color: var(--accent-text); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .blog-content :global(a:hover:not(.post-figure *)) { text-decoration-thickness: 2px; }
  .blog-content :global(strong:not(.post-figure *)) { font-weight: 600; color: var(--text-primary); }
  .blog-content :global(blockquote) { margin: 1.6em 0; padding-left: 1.1em; border-left: 2px solid var(--accent-text); color: var(--text-secondary); font-style: italic; }
  .blog-content :global(ul:not(.post-figure *)) { list-style: disc; padding-left: 1.3em; margin: 0 0 1.15em; }
  .blog-content :global(ol:not(.post-figure *)) { list-style: decimal; padding-left: 1.3em; margin: 0 0 1.15em; }
  .blog-content :global(li:not(.post-figure *)) { margin-bottom: 0.4em; padding-left: 0.2em; }
  .blog-content :global(li > ul), .blog-content :global(li > ol) { margin: 0.4em 0 0; }
  .blog-content :global(pre) { margin: 1.6em 0; padding: 1.1em 1.25em; overflow-x: auto; background: var(--md3-inverse-surface); border-radius: 10px; font-size: var(--font-size-sm); line-height: 1.6; font-variant-numeric: normal; }
  .blog-content :global(pre code) { padding: 0; background: none; border: 0; border-radius: 0; font-family: var(--font-mono); font-size: inherit; color: var(--md3-inverse-on-surface); }
  .blog-content :global(code) { padding: 0.1em 0.35em; background: color-mix(in srgb, var(--text-primary) 6%, transparent); border-radius: 4px; font-family: var(--font-mono); font-size: 0.8em; font-variant-numeric: normal; color: var(--text-primary); }
  .blog-content :global(:not(pre) > code span[style]) { color: var(--text-primary) !important; }
  .blog-content :global(mark), .blog-content :global(.highlight), .blog-content :global([data-highlighted]) { padding: 0.06em 0.22em; background: var(--bg-selection); border-radius: 4px; color: var(--text-primary); }
  .blog-content :global(img) { width: 100%; margin: 1.6em 0; border-radius: 10px; }
  .blog-content :global(hr) { margin: 2.5em 0; border: 0; border-top: 1px solid var(--border-default); }
  /* Tables read as ruled text, in the UI sans with tabular figures. */
  .blog-content :global(table:not(.post-figure *)) { width: 100%; margin: 1.6em 0; border-collapse: collapse; font-family: var(--font-sans); font-size: var(--font-size-sm); line-height: 1.5; font-variant-numeric: tabular-nums lining-nums; }
  .blog-content :global(thead th:not(.post-figure *)) { padding: 0.55em 0.9em 0.55em 0; border-bottom: 1px solid var(--text-primary); text-align: left; font-weight: 600; vertical-align: bottom; }
  /* Row headers read like the cells beside them. */
  .blog-content :global(tbody th:not(.post-figure *)) { padding: 0.6em 0.9em 0.6em 0; border-bottom: 1px solid var(--border-default); text-align: left; font-weight: 600; vertical-align: top; overflow-wrap: anywhere; }
  .blog-content :global(td:not(.post-figure *)) { padding: 0.6em 0.9em 0.6em 0; border-bottom: 1px solid var(--border-default); vertical-align: top; overflow-wrap: anywhere; }
  @media (max-width: 40rem) {
    .blog-content :global(table:not(.post-figure *)) { display: block; max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .blog-content :global(table:has(tr > :nth-child(4)):not(.post-figure *) :is(th, td)) { min-width: 8rem; }
    .blog-content :global(table.product-comparison), .blog-content :global(table.product-comparison tbody), .blog-content :global(table.product-comparison tr), .blog-content :global(table.product-comparison th[scope="row"]), .blog-content :global(table.product-comparison td) { display: block; width: 100%; min-width: 0; }
    .blog-content :global(table.product-comparison thead) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .blog-content :global(table.product-comparison tr) { margin-bottom: 1rem; border-top: 1px solid var(--text-primary); }
    .blog-content :global(table.product-comparison td::before) { content: attr(data-label); display: block; margin-bottom: 0.2rem; color: var(--accent-text); font-size: var(--font-size-xs); font-weight: 700; letter-spacing: 0.04em; }
  }
</style>
