---
import BaseLayout from './BaseLayout.astro';
import BlogCover from '../components/BlogCover.astro';
import { Tag } from '@tangle-network/ui/primitives';
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  summary: string;
  date: string;
  updated?: string;
  author: string;
  tags: string[];
  series?: string;
  seriesOrder?: number;
  coverImage?: string;
  heroImage?: string;
  imageAlt?: string;
}

const { title, summary, date, updated, author, tags, series, seriesOrder, coverImage, heroImage, imageAlt } = Astro.props;
const displayImage = heroImage || coverImage;
const keywords = [...new Set(tags)];
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const imageUrl = displayImage ? new URL(displayImage, Astro.site).toString() : undefined;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: summary,
  keywords,
  author: { '@type': 'Person', name: author },
  datePublished: date,
  dateModified: updated || date,
  inLanguage: 'en-US',
  ...(imageUrl && { image: imageUrl }),
  publisher: {
    '@type': 'Organization',
    name: 'Tangle Network',
    url: 'https://tangle.tools',
  },
  mainEntityOfPage: canonicalUrl,
};

---

<BaseLayout
  title={title}
  description={summary}
  image={displayImage}
  imageAlt={imageAlt || title}
  ogType="article"
  contentType="blog"
  bodyClass="page-editorial"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <div class="blog-page" data-theme="website">
    <section class="blog-hero">
      <div class="blog-hero-inner">
        <header class="blog-hero-copy">
          <a href="/blog" class="blog-back-link">All articles</a>
          <h1>{title}</h1>
          <p>{summary}</p>
          <div class="blog-meta">
            <span>{author}</span>
            <span aria-hidden="true">/</span>
            <time datetime={date}>{formatDate(date)}</time>
            {updated && (
              <>
                <span aria-hidden="true">/</span>
                <span>Updated <time datetime={updated}>{formatDate(updated)}</time></span>
              </>
            )}
          </div>
          {keywords.length > 0 && (
            <ul class="blog-tags" aria-label="Post tags">
              {keywords.map((tag) => (
                <li><Tag>{tag}</Tag></li>
              ))}
            </ul>
          )}
        </header>
        <BlogCover
          title={title}
          summary={summary}
          series={series}
          seriesOrder={seriesOrder}
          tags={tags}
          coverImage={displayImage}
          imageAlt={imageAlt || title}
          variant="hero"
        />
      </div>
    </section>

    <section class="blog-article-shell">
      <article class="blog-article">
        <div class="blog-content">
          <slot />
        </div>
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .blog-page {
    min-height: 100vh;
    overflow-x: clip;
    background: var(--depth-1);
    color: var(--text-primary);
  }

  .blog-hero {
    padding: clamp(5.25rem, 7vw, 6.25rem) 5% 2.5rem;
    background:
      linear-gradient(180deg, var(--bg-card), var(--depth-1)),
      var(--depth-1);
    border-bottom: 1px solid var(--border-subtle);
  }

  .blog-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 29rem);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    max-width: 80rem;
    margin: 0 auto;
  }

  .blog-hero-copy {
    min-width: 0;
  }

  .blog-back-link {
    display: inline-flex;
    align-items: center;
    margin-bottom: 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent-text);
    text-decoration: none;
  }

  .blog-back-link:hover {
    color: var(--text-primary);
  }

  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .blog-tags li {
    min-width: 0;
    max-width: 100%;
  }

  .blog-hero h1 {
    max-width: 56rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.05rem, 4.1vw, 3.45rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: 0;
    color: var(--text-primary);
    overflow-wrap: break-word;
  }

  .blog-hero p {
    max-width: 44rem;
    margin: 1rem 0 0;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.62;
    color: var(--text-secondary);
  }

  .blog-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.1rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .blog-content {
    color: var(--text-primary);
    font-size: 18px;
    line-height: 1.7;
  }

  .blog-article-shell {
    padding: 3.5rem 5% 5.5rem;
    background: var(--depth-1);
  }

  .blog-article {
    max-width: min(100%, 62rem);
    margin: 0 auto;
    padding: clamp(1.5rem, 3vw, 3rem);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    background: var(--bg-card);
    box-shadow: 0 18px 60px rgba(15, 23, 42, 0.08);
  }

  .blog-content :global(h2) {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 2.5em;
    margin-bottom: 0.75em;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .blog-content :global(h3) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 2em;
    margin-bottom: 0.5em;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .blog-content :global(h4) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    line-height: 1.4;
    letter-spacing: 0;
  }

  .blog-content :global(p) {
    margin-bottom: 1.25em;
  }

  .blog-content :global(a) {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }

  .blog-content :global(a:hover) {
    color: var(--text-primary);
  }

  .blog-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .blog-content :global(blockquote) {
    border-left: 3px solid var(--accent-text);
    padding-left: 1.25em;
    margin-left: 0;
    margin-top: 1.5em;
    margin-bottom: 1.5em;
    color: var(--text-secondary);
    font-style: italic;
  }

  .blog-content :global(ul) {
    list-style-type: disc;
    padding-left: 1.5em;
    margin-bottom: 1.25em;
  }

  .blog-content :global(ol) {
    list-style-type: decimal;
    padding-left: 1.5em;
    margin-bottom: 1.25em;
  }

  .blog-content :global(li) {
    margin-bottom: 0.5em;
  }

  .blog-content :global(li > ul),
  .blog-content :global(li > ol) {
    margin-top: 0.5em;
    margin-bottom: 0;
  }

  .blog-content :global(pre) {
    background: var(--md3-inverse-surface);
    border: 1px solid var(--border-default);
    border-radius: 12px;
    padding: 1.25em;
    overflow-x: auto;
    margin-top: 1.5em;
    margin-bottom: 1.5em;
    font-size: 0.875em;
    line-height: 1.6;
  }

  .blog-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    border-radius: 0;
    font-family: var(--font-mono);
    color: var(--md3-inverse-on-surface);
    font-size: inherit;
  }

  .blog-content :global(code) {
    background: var(--accent-surface-soft);
    border: 1px solid var(--border-accent);
    border-radius: 6px;
    padding: 0.15em 0.4em;
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--text-primary);
  }

  .blog-content :global(mark),
  .blog-content :global(.highlight),
  .blog-content :global([data-highlighted]) {
    background: var(--bg-selection);
    color: var(--text-primary);
    border-radius: 4px;
    padding: 0.06em 0.22em;
  }

  .blog-content :global(:not(pre) > code span[style]) {
    color: var(--text-primary) !important;
  }

  .blog-content :global(img) {
    width: 100%;
    border-radius: 12px;
    margin-top: 1.5em;
    margin-bottom: 1.5em;
  }

  .blog-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border-default);
    margin-top: 2.5em;
    margin-bottom: 2.5em;
  }

  .blog-content :global(table) {
    display: table;
    width: 100%;
    max-width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin-top: 1.5em;
    margin-bottom: 1.5em;
    font-size: 0.925em;
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    overflow: hidden;
    table-layout: auto;
  }

  .blog-content :global(th) {
    text-align: left;
    padding: 0.75em 1em;
    border-bottom: 1px solid var(--border-default);
    color: var(--text-primary);
    background: var(--md3-surface-container-high);
    font-weight: 600;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .blog-content :global(td) {
    padding: 0.75em 1em;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-primary);
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  .blog-content :global(tr:last-child td) {
    border-bottom: 0;
  }

  @media (max-width: 640px) {
    .blog-content :global(table) {
      display: block;
      width: max-content;
      min-width: 100%;
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .blog-content :global(th),
    .blog-content :global(td) {
      min-width: 9rem;
    }

    .blog-content :global(table.product-comparison),
    .blog-content :global(table.product-comparison tbody),
    .blog-content :global(table.product-comparison tr),
    .blog-content :global(table.product-comparison th[scope="row"]),
    .blog-content :global(table.product-comparison td) {
      display: block;
      width: 100%;
      min-width: 0;
    }

    .blog-content :global(table.product-comparison) {
      overflow: visible;
      border: 0;
      background: transparent;
    }

    .blog-content :global(table.product-comparison thead) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .blog-content :global(table.product-comparison tr) {
      margin-bottom: 1rem;
      border: 1px solid var(--border-default);
      border-radius: 0.75rem;
      overflow: hidden;
      background: var(--bg-card);
    }

    .blog-content :global(table.product-comparison th[scope="row"]) {
      border: 0;
      padding: 0.75rem 0.9rem;
    }

    .blog-content :global(table.product-comparison td) {
      border: 0;
      border-top: 1px solid var(--border-subtle);
      padding: 0.75rem 0.9rem;
    }

    .blog-content :global(table.product-comparison td::before) {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.2rem;
      color: var(--accent-text);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
  }

  @media (max-width: 860px) {
    .blog-hero {
      padding-top: 5.25rem;
    }

    .blog-hero-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .blog-hero {
      padding-left: 1rem;
      padding-right: 1rem;
      padding-bottom: 1.75rem;
    }

    .blog-hero-inner,
    .blog-hero-copy {
      min-width: 0;
    }

    .blog-hero h1 {
      font-size: clamp(2rem, 10vw, 2.55rem);
      line-height: 1.08;
    }

    .blog-hero p {
      max-width: 100%;
      font-size: 1rem;
      overflow-wrap: break-word;
    }

    .blog-article-shell {
      padding: 1.25rem 1rem 3rem;
    }

    .blog-article {
      padding: 1.15rem;
      max-width: 100%;
    }

    .blog-content {
      font-size: 17px;
    }

    .blog-content :global(h2) {
      font-size: 1.6rem;
    }
  }
</style>
