---
import BaseLayout from './BaseLayout.astro';

// A product page: its claim as the title, one lede, then the page's sections. No byline, date or tags.
interface Props {
  title: string;
  description: string;
  crumb?: { href: string; label: string };
}

const { title, description, crumb } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="product">
    <header class="product-head">
      {crumb && <p class="product-crumb"><a href={crumb.href}>{crumb.label}</a></p>}
      <h1>{title}</h1>
      <p class="product-lede">{description}</p>
    </header>
    <div class="product-body">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .product { background: var(--depth-1); color: var(--text-primary); }
  .product-head, .product-body { max-width: 52rem; margin: 0 auto; padding-left: 1.5rem; padding-right: 1.5rem; }
  .product-head { padding-top: clamp(5rem, 10vw, 8rem); padding-bottom: 2.5rem; }
  .product-crumb { margin: 0 0 1.2rem; font-family: var(--font-mono); font-size: var(--font-size-xs); letter-spacing: 0.06em; text-transform: uppercase; }
  .product-crumb a { color: var(--accent-text); font-weight: 600; text-decoration: none; }
  .product-crumb a:hover { text-decoration: underline; text-underline-offset: 3px; }
  h1 { margin: 0; font-size: clamp(2.2rem, 5vw, 3.5rem); line-height: 1.06; font-weight: 600; letter-spacing: -0.04em; text-wrap: balance; }
  .product-lede { max-width: 44rem; margin: 1.4rem 0 0; color: var(--text-secondary); font-size: clamp(1.1rem, 2vw, 1.3rem); line-height: 1.55; text-wrap: pretty; }
  .product-body { padding-bottom: 6rem; }
  .product-body :global(h2) { margin: 3.5rem 0 1rem; font-size: clamp(1.6rem, 3vw, 2.15rem); line-height: 1.15; font-weight: 600; letter-spacing: -0.03em; }
  .product-body :global(p), .product-body :global(li) { color: var(--text-secondary); font-size: 1.05rem; line-height: 1.65; }
  .product-body :global(p) { margin: 0 0 1rem; }
  .product-body :global(a) { color: var(--accent-text); text-underline-offset: 0.2rem; }
  .product-body :global(ul) { margin: 0; padding-left: 1.2rem; }
  .product-body :global(li + li) { margin-top: 0.5rem; }
  .product-body :global(pre) { margin: 0 0 1rem; padding: 1.1rem 1.25rem; border: 1px solid var(--border-default); border-radius: 10px; overflow-x: auto; font-size: 0.88rem; line-height: 1.55; }
  @media (max-width: 520px) {
    .product-head, .product-body { padding-left: 1.1rem; padding-right: 1.1rem; }
  }
</style>
