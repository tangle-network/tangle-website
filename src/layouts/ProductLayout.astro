---
import BaseLayout from './BaseLayout.astro';

// A product page at the home page's width: the claim beside its proof (the "aside" slot) on the first screen, then
// the page's sections. No byline, date or tags. Sections lay their content out in columns with .product-row.
interface Props {
  title: string;
  description: string;
  crumb?: { href: string; label: string };
}

const { title, description, crumb } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="product">
    <header class="product-hero product-shell">
      <div class="product-hero-copy">
        {crumb && <p class="product-crumb"><a href={crumb.href}>{crumb.label}</a></p>}
        <h1>{title}</h1>
        <p class="product-lede">{description}</p>
        <slot name="action" />
      </div>
      <div class="product-hero-aside">
        <slot name="aside" />
      </div>
    </header>
    <div class="product-body product-shell">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .product { background: var(--depth-1); color: var(--text-primary); }
  /* The home page's shell, so a product page lines up with the header and the home page. */
  .product-shell { width: min(78rem, 90vw); margin: 0 auto; }
  .product-hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(3rem, 5vw, 4.5rem);
  }
  .product-hero > * { min-width: 0; }
  .product-crumb { margin: 0 0 1.1rem; font-family: var(--font-mono); font-size: var(--font-size-xs); letter-spacing: 0.06em; text-transform: uppercase; }
  .product-crumb a { color: var(--accent-text); font-weight: 600; text-decoration: none; }
  .product-crumb a:hover { text-decoration: underline; text-underline-offset: 3px; }
  h1 { margin: 0; font-size: clamp(2.1rem, 3.4vw, 3.1rem); line-height: 1.08; font-weight: 600; letter-spacing: -0.035em; text-wrap: balance; }
  .product-lede { margin: 1.3rem 0 0; color: var(--text-secondary); font-size: clamp(1.05rem, 1.4vw, 1.2rem); line-height: 1.55; text-wrap: pretty; }
  .product-body { padding-bottom: clamp(4rem, 8vw, 7rem); }
  .product :global(h2) { margin: 0 0 1.4rem; font-size: clamp(1.6rem, 2.6vw, 2.2rem); line-height: 1.15; font-weight: 600; letter-spacing: -0.03em; }
  .product-body :global(section) { padding-top: clamp(2.5rem, 5vw, 4rem); border-top: 1px solid var(--border-default); margin-top: clamp(2.5rem, 5vw, 4rem); }
  .product-body :global(section:first-child) { margin-top: 0; }
  .product :global(p), .product :global(li) { color: var(--text-secondary); line-height: 1.6; }
  .product :global(a) { color: var(--accent-text); text-underline-offset: 0.2rem; }
  /* Code keeps its own sideways scroll, so the page never scrolls sideways. */
  .product :global(pre) { max-width: 100%; margin: 0; padding: 1.1rem 1.25rem; border: 1px solid var(--border-default); border-radius: 10px; overflow-x: auto; font-size: 0.84rem; line-height: 1.6; }
  /* Columns inside a section: as many as fit at 17rem each. */
  .product :global(.product-row) { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 1.5rem 2rem; margin: 0; padding: 0; list-style: none; }
  .product :global(.product-row > *) { min-width: 0; }
  @media (max-width: 1100px) {
    .product-hero { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 700px) {
    .product-shell { width: min(92vw, 78rem); }
  }
</style>
