---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { socialMetadata, type SocialVideo } from '@tangle-network/brand/social';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  video?: SocialVideo;
  ogType?: 'website' | 'article';
  contentType?: 'page' | 'blog';
  bodyClass?: string;
  /** Render the page body as paper: the Brand website theme without .dark, on a full-bleed surface. */
  paper?: boolean;
}

const {
  title,
  description = 'Tangle is an infrastructure company for AI agents, with a product lab and a research lab.',
  image = '/images/og-tangle.png',
  imageAlt = image === '/images/og-tangle.png' ? 'Tangle logo beside an indigo knot' : `${title} | Tangle`,
  video,
  ogType = 'website',
  contentType = 'page',
  bodyClass = '',
  paper = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const imageType = image.toLowerCase().endsWith('.webp') ? 'image/webp' : image.toLowerCase().endsWith('.jpg') || image.toLowerCase().endsWith('.jpeg') ? 'image/jpeg' : 'image/png';
const social = socialMetadata({
  url: canonicalUrl.href,
  title: `${title} | Tangle`,
  description,
  type: ogType,
  image: { url: imageUrl.href, type: imageType, width: 1200, height: 630, alt: imageAlt },
  video,
});
---

<!doctype html>
<html lang="en" class="dark" data-theme="website">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | Tangle</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="author" content="Drew Stone" />
    <meta name="application-name" content="Tangle" />
    <meta name="facebook-domain-verification" content="ez837aoe1ezrmngr1xr34ojadpzbvs" />
    <meta name="theme-color" content="#0C0B1D" />
    <link rel="canonical" href={social.canonicalUrl} />
    <link rel="alternate" type="text/markdown" href="/agent-setup.md" title="Agent setup skill" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="LLMs.txt" />
    <link rel="alternate" type="text/plain" href="/ai.txt" title="AI agent instructions" />
    <link rel="agent-manifest" type="application/json" href="/.well-known/tangle-agent.json" />
    <link rel="product-catalog" type="application/json" href="/.well-known/tangle-products.json" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" />

    {social.tags.map((tag) => <meta {...tag} />)}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/tangle-icon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JEQ15MLV6B"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JEQ15MLV6B');
      gtag('config', 'G-R5W7898EVV');
    </script>
  </head>
  <body class:list={['bg-bg-dark text-text-primary min-h-screen flex flex-col', bodyClass]} data-content-type={contentType}>
    <Header />
    <main class="flex-1" data-theme={paper ? 'website' : undefined} style={paper ? 'background: var(--bg-root); color: var(--text-primary)' : undefined}>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/cta-observability.mjs'
    </script>
  </body>
</html>
