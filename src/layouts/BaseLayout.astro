---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SiteNav, SiteFooter } from '@tangle-network/ui/marketing';
import { COMPLIANCE_BADGES } from '../data/compliance';
import statusHistory from '../../public/status/history.json';
import { socialMetadata, type SocialVideo } from '@tangle-network/brand/social';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageSize?: { width: number; height: number };
  video?: SocialVideo;
  ogType?: 'website' | 'article';
  contentType?: 'page' | 'blog';
  bodyClass?: string;
  /** Render the page body as paper: the Brand website theme without .dark, on a full-bleed surface. */
  paper?: boolean;
  /** The robots meta; a page that says noindex is also left out of the sitemap (astro.config.mjs). */
  robots?: string;
}

const {
  title,
  description = 'Tangle is an infrastructure company for AI agents, with a product lab and a research lab.',
  image = '/images/og-tangle.png',
  imageAlt = image === '/images/og-tangle.png' ? 'Tangle logo beside an indigo knot' : `${title} | Tangle`,
  imageSize = { width: 1200, height: 630 },
  video,
  ogType = 'website',
  contentType = 'page',
  bodyClass = '',
  paper = false,
  robots = 'index,follow',
} = Astro.props;

const companyHome = Astro.url.pathname === '/';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const navLinks = [
  { label: 'Sandbox', href: 'https://sandbox.tangle.tools' },
  { label: 'Router', href: 'https://router.tangle.tools' },
  { label: 'Pricing', href: '/#pricing' },
  { label: 'Benchmarks', href: '/benchmarks/' },
  { label: 'Docs', href: 'https://docs.tangle.tools' },
  { label: 'Blog', href: '/blog/' },
];
const footerColumns = [
  { heading: 'Products', links: [
    { label: 'Sandbox', href: 'https://sandbox.tangle.tools' },
    { label: 'Router', href: 'https://router.tangle.tools' },
    { label: 'Intelligence', href: 'https://intelligence.tangle.tools' },
  ] },
  { heading: 'Developers', links: [
    { label: 'Docs', href: 'https://docs.tangle.tools' },
    { label: 'SDK reference', href: 'https://docs.tangle.tools/sandbox/sdk-typescript' },
    { label: 'Benchmarks', href: '/benchmarks/' },
    { label: 'GitHub', href: 'https://github.com/tangle-network' },
    { label: 'llms.txt', href: '/llms.txt' },
  ] },
  { heading: 'Company', links: [
    { label: 'Blog', href: '/blog/' }, { label: 'Compare', href: '/compare/' },
    { label: 'Security', href: '/security/' }, { label: 'Status', href: '/status/' },
    { label: 'Release notes', href: '/releases/' }, { label: 'Brand kit', href: '/brand-kit' },
  ] },
];
const legal = [
  { label: 'Privacy', href: '/privacy-policy' },
  { label: 'Terms', href: '/terms-of-service' },
  { label: 'Sub-processors', href: '/sub-processors' },
  // Gate 5 preserves the current public claim. The compliance owner must
  // reconcile the record before this is rendered through the shared badge.
  ...COMPLIANCE_BADGES.filter(badge => badge.product === 'soc2').map(badge => ({
    label: 'SOC 2 Type II · Trust Center', href: badge.href,
  })),
];
const badges = COMPLIANCE_BADGES.filter(badge => badge.product !== 'soc2');
const imageUrl = new URL(image, Astro.site);
const imageType = image.toLowerCase().endsWith('.webp') ? 'image/webp' : image.toLowerCase().endsWith('.jpg') || image.toLowerCase().endsWith('.jpeg') ? 'image/jpeg' : 'image/png';
const social = socialMetadata({
  url: canonicalUrl.href,
  title: `${title} | Tangle`,
  description,
  type: ogType,
  image: { url: imageUrl.href, type: imageType, ...imageSize, alt: imageAlt },
  video,
});
---

<!doctype html>
<html lang="en" class="dark" data-theme="website" data-build-revision={companyHome ? import.meta.env.TANGLE_BUILD_REVISION : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | Tangle</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="Drew Stone" />
    <meta name="application-name" content="Tangle" />
    <meta name="facebook-domain-verification" content="ez837aoe1ezrmngr1xr34ojadpzbvs" />
    <meta name="theme-color" content="#0C0B1D" />
    <link rel="canonical" href={social.canonicalUrl} />
    <link rel="alternate" type="text/markdown" href="/agent-setup.md" title="Agent setup skill" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="LLMs.txt" />
    <link rel="alternate" type="text/plain" href="/ai.txt" title="AI agent instructions" />
    <link rel="agent-manifest" type="application/json" href="/.well-known/tangle-agent.json" />
    <link rel="product-catalog" type="application/json" href="/.well-known/tangle-products.json" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Brand's UI faces: Inter (UI and headings), JetBrains Mono (code and data) and Geist Mono (the shared recorded editor). Long-form pages add the reading face through the head slot. -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" />
    <slot name="head" />

    {social.tags.map((tag) => <meta {...tag} />)}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-v1.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-v1.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- First-party journey: pages, clicks and demo steps, sent to Platform (id.tangle.tools/v1/events). -->
    <script is:inline src="https://id.tangle.tools/journey.js" data-surface="site" defer></script>

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JEQ15MLV6B"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JEQ15MLV6B');
      gtag('config', 'G-R5W7898EVV');
    </script>
  </head>
  <body class:list={['bg-bg-dark text-text-primary min-h-screen flex flex-col', bodyClass]} data-content-type={contentType}>
    {companyHome ? <Header /> : <div class="site-nav-shell">
      <SiteNav client:load links={navLinks} signIn={{ label: 'Sign in', href: 'https://sandbox.tangle.tools/login' }} primary={{ label: 'Create a sandbox', href: 'https://sandbox.tangle.tools/dashboard/new' }} github="https://github.com/tangle-network" />
    </div>}
    <main class="flex-1" data-theme={paper ? 'website' : undefined}>
      <slot />
    </main>
    {companyHome ? <Footer /> : <SiteFooter status={{ up: statusHistory.services.every(service => service.current.status === 'operational'), href: '/status/' }} email="hello@tangle.tools" columns={footerColumns} legal={legal} badges={badges} github="https://github.com/tangle-network" />}
    <script>
      import '../scripts/cta-observability.mjs'
      import { bindCopyButton, highlightCode } from '@tangle-network/ui/code-presentation';
      document.querySelectorAll<HTMLButtonElement>('[data-marketing-copy]').forEach(button => {
        const status = button.nextElementSibling as HTMLElement;
        bindCopyButton(button, status, () => button.dataset.marketingCopy ?? '');
      });
      // Static React sections do not hydrate; share the same tokenizer here.
      document.querySelectorAll<HTMLElement>('.mk-command-block code').forEach(async code => {
        const lines = await highlightCode(code.textContent ?? '', 'bash').catch(() => null);
        if (!lines) return;
        const fragment = document.createDocumentFragment();
        lines.forEach((line, index) => {
          if (index) fragment.append('\n');
          line.forEach(token => {
            const span = document.createElement('span');
            span.textContent = token.content;
            Object.assign(span.style, token.style);
            fragment.append(span);
          });
        });
        code.replaceChildren(fragment);
      });
    </script>
  </body>
</html>
