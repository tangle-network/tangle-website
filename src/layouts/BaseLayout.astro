---
import globalStylesheet from '../styles/global.css?url';
import homeStylesheet from '../styles/home-global.css?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  contentType?: 'page' | 'blog';
  bodyClass?: string;
  homeSpeedPercent?: number;
  homeBuildRevision?: string;
}

const {
  title,
  description = 'Tangle is an infrastructure company for AI agents, with a product lab and a research lab.',
  image = '/images/og-self-improving-agents.png',
  imageAlt = `${title} | Tangle`,
  ogType = 'website',
  contentType = 'page',
  bodyClass = '',
  homeSpeedPercent,
  homeBuildRevision,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const imageType = image.toLowerCase().endsWith('.webp') ? 'image/webp' : image.toLowerCase().endsWith('.jpg') || image.toLowerCase().endsWith('.jpeg') ? 'image/jpeg' : 'image/png';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {homeSpeedPercent !== undefined && (
      <script is:inline data-speed-percent={homeSpeedPercent} data-build-revision={homeBuildRevision}>
        const percent = Number(document.currentScript?.dataset.speedPercent ?? '0');
        const override = new URLSearchParams(location.search).get('home_speed');
        let fast = percent === 100;
        if (percent > 0 && percent < 100) {
          try {
            const key = 'tangle-home-speed-bucket';
            let bucket = Number(localStorage.getItem(key));
            if (!Number.isInteger(bucket) || bucket < 0 || bucket > 99 || localStorage.getItem(key) === null) {
              bucket = Math.floor(Math.random() * 100);
              localStorage.setItem(key, String(bucket));
            }
            fast = bucket < percent;
          } catch {
            fast = false;
          }
        }
        if (override === 'fast') fast = true;
        if (override === 'control') fast = false;
        document.documentElement.dataset.homeSpeed = fast ? 'fast' : 'control';
        document.documentElement.dataset.homeSpeedPercent = String(percent);
        document.documentElement.dataset.homeBuild = document.currentScript?.dataset.buildRevision ?? 'unknown';
        if (fast) document.documentElement.classList.add('static-hero');
      </script>
    )}
    {homeSpeedPercent !== undefined && (
      <style is:inline>
        html .wf-nav-brand-logo-fast { display: none; }
        html[data-home-speed='fast'] .wf-nav-brand-logo-fast { display: block; }
        html[data-home-speed='fast'] .wf-nav-brand-logo-control { display: none; }
      </style>
    )}
    {homeSpeedPercent === undefined ? (
      <link rel="stylesheet" href={globalStylesheet} />
    ) : (
      <>
        <script is:inline data-control-css={globalStylesheet} data-fast-css={homeStylesheet}>
          const source = document.currentScript.dataset;
          const sheet = document.createElement('link');
          const href = document.documentElement.dataset.homeSpeed === 'fast' ? source.fastCss : source.controlCss;
          if ('blocking' in sheet) {
            sheet.rel = 'stylesheet';
            sheet.setAttribute('blocking', 'render');
            sheet.href = href;
            document.head.append(sheet);
          } else {
            document.write('<link rel="stylesheet" href="' + href + '">');
          }
        </script>
        <noscript><link rel="stylesheet" href={globalStylesheet} /></noscript>
      </>
    )}
    <meta name="generator" content={Astro.generator} />

    <title>{title} | Tangle</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="author" content="Drew Stone" />
    <meta name="application-name" content="Tangle" />
    <meta name="facebook-domain-verification" content="ez837aoe1ezrmngr1xr34ojadpzbvs" />
    <meta name="theme-color" content="#0C0B1D" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="LLMs.txt" />
    <link rel="alternate" type="text/plain" href="/ai.txt" title="AI agent instructions" />
    <link rel="agent-manifest" type="application/json" href="/.well-known/tangle-agent.json" />
    <link rel="product-catalog" type="application/json" href="/.well-known/tangle-products.json" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {homeSpeedPercent === undefined ? (
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" />
    ) : (
      <>
        <script is:inline data-font-css="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap">
          {
            const fontHref = document.currentScript.dataset.fontCss;
            const fast = document.documentElement.dataset.homeSpeed === 'fast';
            if (fast && matchMedia('(max-width: 720px)').matches) {
              document.documentElement.classList.add('system-home-fonts');
            } else if (fast) {
              const font = document.createElement('link');
              font.rel = 'stylesheet';
              font.href = fontHref;
              font.media = 'print';
              font.onload = () => { font.media = 'all'; };
              document.head.append(font);
            } else {
              document.write('<link rel="stylesheet" href="' + fontHref + '">');
            }
          }
        </script>
        <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" /></noscript>
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Tangle" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | Tangle`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@tangle_network" />
    <meta name="twitter:title" content={`${title} | Tangle`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/tangle-icon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google Analytics -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JEQ15MLV6B');
      gtag('config', 'G-R5W7898EVV');
    </script>
    {homeSpeedPercent === undefined ? (
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JEQ15MLV6B"></script>
    ) : (
      <script is:inline data-analytics-src="https://www.googletagmanager.com/gtag/js?id=G-JEQ15MLV6B">
        {
          const analyticsSrc = document.currentScript.dataset.analyticsSrc;
          const loadAnalytics = () => {
            const script = document.createElement('script');
            script.async = true;
            script.src = analyticsSrc;
            document.head.append(script);
          };
          if (document.documentElement.dataset.homeSpeed === 'fast') {
            requestAnimationFrame(() => requestAnimationFrame(loadAnalytics));
          } else {
            loadAnalytics();
          }
        }
      </script>
    )}
  </head>
  <body class:list={['bg-bg-dark text-text-primary min-h-screen flex flex-col', bodyClass]} data-content-type={contentType}>
    <Header speedAwareNav={homeSpeedPercent !== undefined} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/cta-observability.mjs'
    </script>
  </body>
</html>
