---
import ExamplesEditor from './ExamplesEditor';
---

<section class="examples" aria-labelledby="examples-title" data-cta-placement="examples">
  <h2 id="examples-title" class="examples-title">Examples</h2>
  <div class="examples-frame">
    <ExamplesEditor client:visible />
  </div>
</section>

<style>
  .examples { display: flex; flex-direction: column; height: 100svh; min-height: 680px; padding: 3rem 0; background: var(--depth-1); color: var(--text-primary); border-top: 1px solid var(--color-border); }
  .examples-title { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .examples-frame { display: flex; flex-direction: column; flex: 1; min-height: 0; width: min(78rem, 90vw); margin: 0 auto; }
  .examples-frame > :global(astro-island) { display: contents; }
  @media (max-width: 680px) {
    .examples { height: auto; min-height: 0; padding: 2rem 0; }
    .examples-frame { width: calc(100% - 2rem); }
  }
</style>
