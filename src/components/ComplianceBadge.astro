---
// TODO: swap this local component for
//   import { ComplianceBadge } from '@tangle-network/ui';
// once the shared component ships in a published @tangle-network/ui release
// (being built in the brand repo in parallel). The props and visual contract
// below mirror the planned package component so the swap is an import change,
// not a redesign.
import type { ComplianceBadgeStatus } from '../data/compliance';

interface Props {
  status: Exclude<ComplianceBadgeStatus, 'off'>;
  href?: string;
}

const { status, href = '/security/#hipaa' } = Astro.props;

const label = status === 'hipaa-ready' ? 'HIPAA-Ready' : 'HIPAA Compliant';
const description =
  status === 'hipaa-ready'
    ? 'HIPAA-Ready — technical protections in place, compliance program in progress'
    : 'HIPAA Compliant';
---

<a class="cb" href={href} aria-label={description} title={description}>
  <svg class="cb-shield" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
    <path d="m9 12 2 2 4-4" />
  </svg>
  <span class="cb-label mono">{label}</span>
</a>

<style>
  .mono {
    font-family: var(--font-mono);
  }

  .cb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .cb:hover {
    color: var(--text-primary);
    border-color: var(--color-brand-dim);
  }

  .cb:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 4px;
  }

  .cb-shield {
    color: var(--color-brand);
    flex-shrink: 0;
  }

  .cb-label {
    font-size: 0.98rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
</style>
