---
import type { ComplianceBadgeProduct, ComplianceBadgeState } from '../data/compliance';

interface Props {
  product: ComplianceBadgeProduct;
  status: ComplianceBadgeState;
  href?: string;
}

const { product, status, href } = Astro.props;

const label =
  product === 'soc2'
    ? 'SOC 2 Type II · Trust Center'
    : status === 'ready' ? 'HIPAA-Ready' : 'HIPAA Compliant';
const description =
  product === 'soc2'
    ? 'Read SOC 2 Type II audit information in the Tangle Trust Center'
    : status === 'ready'
      ? 'HIPAA-Ready — technical protections in place, compliance program in progress'
      : 'HIPAA Compliant';
const external = href?.startsWith('https://') ?? false;
---

<div class="cb-group">
  {product === 'soc2' && (
    <a class="cb-mark" href="https://www.a-lign.com" target="_blank" rel="noopener noreferrer">
      <img src="/images/a-lign-soc2.png" alt="A-LIGN SOC 2 attestation" width="1300" height="1672" loading="lazy" />
    </a>
  )}
  <a
    class="cb"
    href={href}
    aria-label={description}
    title={description}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
  >
    <span class="cb-label mono">{label}</span>
  </a>
</div>

<style>
  .mono {
    font-family: var(--font-mono);
  }

  .cb-group {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 100%;
  }

  .cb-mark img {
    display: block;
    width: 96px;
    height: auto;
  }

  .cb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .cb:hover {
    color: var(--text-primary);
    border-color: var(--color-brand-dim);
  }

  .cb:focus-visible, .cb-mark:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 4px;
  }

  .cb-label {
    font-size: 0.98rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
</style>
