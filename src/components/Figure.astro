---
// One benchmark chart in the page grid: its title, then the plot from @tangle-network/charts. A figure that refuses its data stops the build.
import { isRefusal, renderFigure, type Figure, type Refusal } from '@tangle-network/charts';
import { drawnWidth } from '../data/benchmarks/grid';
interface Props { title: string; figure: Figure | Refusal; span?: number }
const { title, figure, span = 4 } = Astro.props;
if (isRefusal(figure)) throw new Error(`${title}: ${figure.refused}`);
---
<section class="chart" style={`--span:${span};--drawn:${drawnWidth(span)}px`}>
  <h2>{title}</h2>
  <Fragment set:html={renderFigure(figure, 1, { presentation: 'panel' })} />
</section>
