---
// One benchmark chart: its title, then the plot from @tangle-network/charts. A figure that refuses its data stops the build.
import { isRefusal, renderFigure, type Figure, type Refusal } from '@tangle-network/charts';
interface Props { title: string; figure: Figure | Refusal }
const { title, figure } = Astro.props;
if (isRefusal(figure)) throw new Error(`${title}: ${figure.refused}`);
---
<section class="chart">
  <h2>{title}</h2>
  <Fragment set:html={renderFigure(figure, 1, { presentation: 'plot' })} />
</section>
