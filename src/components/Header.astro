---
const links = [
  { label: 'Sandbox', href: 'https://sandbox.tangle.tools', external: true },
  { label: 'Router', href: 'https://router.tangle.tools', external: true },
  { label: 'Pricing', href: '/#pricing' },
  { label: 'Benchmarks', href: '/benchmarks' },
  { label: 'Company', href: '/#company' },
  { label: 'Blog', href: '/blog' },
  { label: 'Docs', href: 'https://docs.tangle.tools', external: true },
];
---

<nav class="wf-nav">
  <div class="wf-nav-inner">
    <a href="/" aria-current="page" class="wf-nav-brand">
      <img src="/images/webflow/Tnt Logo.png" alt="" loading="lazy" class="wf-nav-brand-logo" />
      <span class="wf-nav-brand-type">Tangle</span>
    </a>
    <div class="wf-nav-menu">
      <div class="wf-nav-menu-wrapper">
        {links.map(({ label, href, external }) => (
          <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} class="wf-nav-menu-link">{label}</a>
        ))}
      </div>
      <a href="https://sandbox.tangle.tools/dashboard" target="_blank" rel="noopener noreferrer" class="wf-nav-cta">
        <span class="wf-nav-cta-text">Open the console</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
    <button class="wf-mobile-icon-wrapper" id="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <svg class="wf-mobile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16" />
        <path d="M4 12h16" />
        <path d="M4 17h16" />
      </svg>
    </button>
    <div class="wf-mobile-menu" id="mobile-menu" aria-hidden="true">
      <button type="button" class="wf-mobile-menu-backdrop" aria-label="Close menu"></button>
      <div class="wf-mobile-menu-panel" role="dialog" aria-modal="true" aria-label="Mobile navigation">
        <div class="wf-mobile-menu-header">
          <span class="wf-mobile-menu-title">Menu</span>
          <button type="button" class="wf-mobile-menu-close" aria-label="Close menu">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19" /></svg>
          </button>
        </div>
        {links.map(({ label, href, external }) => (
          <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} class="wf-mobile-menu-link" data-mobile-menu-link>{label}</a>
        ))}
        <div class="wf-mobile-menu-divider"></div>
        <a href="https://sandbox.tangle.tools/dashboard" target="_blank" rel="noopener noreferrer" class="wf-mobile-menu-link" data-mobile-menu-link>Open the console</a>
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const closeButton = menu?.querySelector('.wf-mobile-menu-close');
  const backdrop = menu?.querySelector('.wf-mobile-menu-backdrop');
  const links = menu?.querySelectorAll('[data-mobile-menu-link]') ?? [];

  const setMenuOpen = (open: boolean) => {
    menu?.classList.toggle('wf-mobile-menu-open', open);
    menu?.setAttribute('aria-hidden', open ? 'false' : 'true');
    toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
    document.body.classList.toggle('wf-mobile-menu-lock', open);
  };

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('wf-mobile-menu-open');
    setMenuOpen(!isOpen);
  });

  closeButton?.addEventListener('click', () => setMenuOpen(false));
  backdrop?.addEventListener('click', () => setMenuOpen(false));
  links.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenuOpen(false);
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 1024) setMenuOpen(false);
  });
</script>

<style is:global>
.company-home { padding-top: 4rem; }
html:has(.company-home) { scroll-padding-top: 4rem; }

.wf-nav {
  position: fixed;
  inset: 0 0 auto;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 4rem;
  background-color: var(--depth-1);
  border-bottom: 1px solid var(--border-default);
}

.wf-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  width: min(78rem, 90vw);
  height: 100%;
  margin: 0 auto;
}

.wf-nav-brand {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  height: 100%;
  cursor: pointer;
  text-decoration: none;
}

.wf-nav-brand-logo {
  display: block;
  width: auto;
  height: 28px;
  max-width: 160px;
}

.wf-nav-brand-type {
  color: var(--text-primary);
  font-family: var(--font-display);
  font-size: 1.08rem;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.015em;
}

.wf-nav-menu {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.25rem;
  height: 100%;
}

.wf-nav-menu-wrapper {
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 0.25rem;
  height: 100%;
}

.wf-nav-menu-link {
  display: inline-flex;
  align-items: center;
  height: 2.25rem;
  padding: 0.5rem 0.875rem;
  border-radius: 8px;
  color: var(--text-secondary);
  font-family: var(--font-sans);
  font-size: 0.98rem;
  font-weight: 500;
  line-height: 1;
  letter-spacing: -0.02em;
  text-decoration: none;
  transition: color 0.16s ease, background-color 0.16s ease;
}

.wf-nav-menu-link:hover {
  background-color: color-mix(in srgb, var(--text-primary) 4%, transparent);
  color: var(--text-primary);
}

.page-editorial .wf-nav-menu-link {
  color: var(--text-primary);
}

/* White on brand-dim clears 4.5:1; hover lifts to the brighter primary. */
.wf-nav-cta {
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.375rem;
  height: 2.25rem;
  padding: 0.75rem 1.25rem;
  border: 1px solid var(--color-brand-dim);
  border-radius: 10px;
  background-color: var(--color-brand-dim);
  color: white;
  font-family: var(--font-sans);
  font-size: 0.9375rem;
  font-weight: 600;
  line-height: 1.2;
  text-decoration: none;
  cursor: pointer;
  transition: background-color 0.16s ease, border-color 0.16s ease, transform 0.1s ease;
}

.wf-nav-cta:hover {
  border-color: var(--brand-primary);
  background-color: var(--brand-primary);
}

.wf-nav-cta:active {
  transform: scale(0.97);
}

.wf-nav-cta-text {
  margin-bottom: 0;
  font-size: 0.95rem;
  font-weight: 600;
}

.wf-mobile-icon-wrapper {
  display: none;
  padding: 0;
  border: 0;
  background: transparent;
  appearance: none;
  cursor: pointer;
}

.wf-mobile-icon {
  width: 32px;
  height: 32px;
}

.wf-mobile-menu {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: none;
}

.wf-mobile-menu-open {
  display: flex;
}

.wf-mobile-menu-backdrop {
  position: absolute;
  inset: 0;
  border: 0;
  background: color-mix(in srgb, var(--md3-surface-container-lowest) 72%, transparent);
  cursor: pointer;
}

.wf-mobile-menu-panel {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100dvh;
  min-height: 100dvh;
  padding: 24px;
  padding-top: max(24px, env(safe-area-inset-top));
  overflow-y: auto;
  overscroll-behavior: contain;
  background-color: var(--depth-1);
}

.wf-mobile-menu-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 0.75rem;
}

.wf-mobile-menu-title {
  color: var(--text-primary);
  font-family: var(--font-display);
  font-size: 1.125rem;
  font-weight: 700;
}

.wf-mobile-menu-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border: 1px solid var(--border-default);
  border-radius: 999px;
  background: color-mix(in srgb, var(--text-primary) 5%, transparent);
  color: var(--text-primary);
  font-size: 1.5rem;
  line-height: 1;
  cursor: pointer;
}

.wf-mobile-menu-link {
  padding: 16px 0;
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: 1.25rem;
  font-weight: 600;
  text-decoration: none;
}

.wf-mobile-menu-divider {
  height: 1px;
  background-color: var(--border-subtle);
}

body.wf-mobile-menu-lock {
  overflow: hidden;
}

@media screen and (max-width: 720px) {
  .wf-nav-inner { width: 92vw; }
}

@media screen and (max-width: 1024px) {
  .wf-nav-menu {
    display: none;
  }

  .wf-mobile-icon-wrapper {
    display: flex;
    align-items: center;
  }
}
</style>
