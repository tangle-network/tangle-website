---
// A leaderboard chart card: value-labelled bars with each entrant's mark, or a log-log scatter of value against whisker.
// When a row is highlighted, every other mark is muted so Tangle reads first.
import type { BoardRow } from './Board.astro';
import { seconds } from '../data/benchmarks/sandbox';
interface Props { title: string; note: string; rows: BoardRow[]; unit?: 'ms' | 'rate' | 'usd'; kind?: 'bars' | 'scatter'; x?: string; y?: string }
const { title, note, rows, unit = 'ms', kind = 'bars', x = 'median', y = 'p95' } = Astro.props;
const text = (v: number) => (unit === 'rate' ? `${Math.round(v * 100)}%` : unit === 'usd' ? `$${v.toFixed(2)}` : seconds(v));
// Bar labels drop the unit the note already names, so ten fit side by side.
const short = (v: number) => (unit === 'ms' ? (v / 1000).toFixed(v < 1000 ? 2 : v < 10_000 ? 1 : 0) : text(v));
const fill = (r: BoardRow) => (r.highlight ? 'var(--chart-accent)' : rows.some((o) => o.highlight) ? 'var(--chart-muted)' : 'var(--chart-accent)');
const tip = (r: BoardRow) => `${r.label}${r.sub ? `, ${r.sub}` : ''}: ${text(r.value)}${kind === 'scatter' && r.whisker != null ? ` ${x}, ${text(r.whisker)} ${y}` : ''}${r.flagged ? ', failed a check' : ''}`;

// Bars: zero-based, scaled to the largest value, names rotated under each mark.
const base = 196, slot = 360 / rows.length, bw = Math.min(slot * 0.68, 30);
const top = Math.max(...rows.map((r) => r.value)) * 1.14;
const bars = rows.map((r, i) => ({ r, cx: 36 + slot * i + slot / 2, h: (r.value / top) * (base - 16) }));

// Scatter: log axes over whole decades, so a 100x spread reads as distance, not as a sliver.
const pts = rows.filter((r) => r.whisker != null);
const decade = (v: number, f: (n: number) => number) => 10 ** f(Math.log10(v));
const lo = decade(Math.min(...pts.map((r) => r.value)), Math.floor), hi = decade(Math.max(...pts.map((r) => r.whisker!)), Math.ceil);
const ticks = Array.from({ length: Math.round(Math.log10(hi / lo)) + 1 }, (_, i) => lo * 10 ** i);
const at = (v: number, a: number, b: number) => a + ((Math.log10(v) - Math.log10(lo)) / Math.log10(hi / lo)) * (b - a);
const labelled = new Set([pts.find((r) => r.highlight && !r.flagged), [...pts].sort((a, b) => a.value - b.value)[0]]);
---
<figure class="chart">
  <figcaption><h3>{title}</h3><p>{note}</p></figcaption>
  {kind === 'bars' ? (
    <svg viewBox="0 0 400 310" role="img" aria-label={`${title}: ${rows.map((r) => `${r.label} ${text(r.value)}`).join(', ')}`}>
      {[0.25, 0.5, 0.75, 1].map((f) => <line class="chart-grid" x1="28" x2="400" y1={base - f * (base - 16)} y2={base - f * (base - 16)} />)}
      {bars.map(({ r, cx, h }) => (
        <g class="chart-mark">
          <title>{tip(r)}</title>
          <rect x={cx - bw / 2} y={base - h} width={bw} height={Math.max(h, 1)} rx="3" fill={fill(r)} />
          <text x={cx} y={base - h - 5} text-anchor="middle" font-size="11" class="chart-value">{short(r.value)}</text>
          {r.logo && <image href={r.logo} x={cx - 8} y={base + 7} width="16" height="16" />}
          <text transform={`translate(${cx + 4} ${base + 32}) rotate(-45)`} text-anchor="end" font-size="11" class="chart-name">{r.label}</text>
        </g>
      ))}
    </svg>
  ) : (
    <svg viewBox="0 0 400 290" role="img" aria-label={`${title}: ${pts.map((r) => `${r.label} ${text(r.value)} ${x}, ${text(r.whisker!)} ${y}`).join('; ')}`}>
      {ticks.map((t) => <g>
        <line class="chart-grid" x1={at(t, 46, 390)} x2={at(t, 46, 390)} y1="24" y2="250" />
        <line class="chart-grid" x1="46" x2="390" y1={at(t, 250, 24)} y2={at(t, 250, 24)} />
        <text x={at(t, 46, 390)} y="266" text-anchor="middle" font-size="11" class="chart-name">{text(t)}</text>
        <text x="40" y={at(t, 250, 24) + 4} text-anchor="end" font-size="11" class="chart-name">{text(t)}</text>
      </g>)}
      <text x="390" y="285" text-anchor="end" font-size="11" class="chart-value">{x} →</text>
      <text x="40" y="10" text-anchor="end" font-size="11" class="chart-value">{y} ↑</text>
      {pts.map((r) => (
        <g class="chart-mark">
          <title>{tip(r)}</title>
          <circle cx={at(r.value, 46, 390)} cy={at(r.whisker!, 250, 24)} r={r.highlight ? 6 : 4.5} fill={r.flagged ? 'none' : fill(r)} stroke={r.flagged ? 'var(--chart-accent)' : 'var(--bg-card)'} stroke-width="1.5" />
          {labelled.has(r) && <text x={at(r.value, 46, 390) + (at(r.value, 46, 390) > 300 ? -9 : 9)} y={at(r.whisker!, 250, 24) + 4} text-anchor={at(r.value, 46, 390) > 300 ? 'end' : 'start'} font-size="11" class="chart-value">{r.label}</text>}
        </g>
      ))}
    </svg>
  )}
</figure>
