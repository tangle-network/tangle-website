---
import RunActions from './RunActions.astro';
import RecordedAgentTimeline from './RecordedAgentTimeline';
import RecordedRunWaterfall from './RecordedRunWaterfall';
import run from '../data/homepageRun.json';

const change = {
  title: 'Handle non-finite durations',
  file: 'formatters.ts',
  additions: 3,
  deletions: 0,
  diff: run.patch,
};
const summary = 'Fixed the uptime formatter. All 18 tests pass.';
---

<section class="run-story" data-theme="website" aria-labelledby="intel-title">
  <div class="story-flow">
    <div class="story-sticky">
      <div class="story-shell">
        <header class="story-heading">
          <h2 id="intel-title">Understand every run.<br />Improve the next.</h2>
          <a class="story-product" href="https://intelligence.tangle.tools">Explore Intelligence <span aria-hidden="true">↗</span></a>
        </header>

        <div class="story-stages">
          <article class="story-stage" data-stage="0">
            <div class="story-copy"><h3>Follow the work.</h3></div>
            <div class="story-pane event-window">
              <header class="window-header">
                <img src="/images/harness/claude-code.svg" width="24" height="24" alt="" />
                <strong>Claude Code</strong>
              </header>
              <div class="event-viewport" tabindex="0" role="region" aria-label="Recorded agent run: Claude reads the formatter, identifies two failing tests, edits the code, and passes all 18 tests.">
                <div class="event-list" inert aria-hidden="true"><RecordedAgentTimeline client:load /></div>
              </div>
              <footer class="window-footer">formatters.ts</footer>
            </div>
          </article>

          <article class="story-stage" data-stage="1">
            <div class="story-copy"><h3>Find what needs to change.</h3></div>
            <div class="story-pane trace-window">
              <header class="window-header"><img src="/brand/tangle-icon-filled.svg" width="24" height="24" alt="Tangle" /><strong>{run.title}</strong></header>
              <RecordedRunWaterfall />
              <div class="trace-finding">
                <span class="failure-count">2 failing tests</span>
                <div><code>NaN</code><code>+Infinity</code><span>→</span><code class="fixed-value">"0s"</code></div>
              </div>
              <div class="test-comparison">
                <div><span>Before</span><strong>{run.before.passed} passed <small>· {run.before.failed} failed</small></strong></div>
                <span class="comparison-arrow" aria-hidden="true">→</span>
                <div><span>After</span><strong class="test-success">{run.after.passed} passed <small>· {run.after.failed} failed</small></strong></div>
              </div>
            </div>
          </article>

          <article class="story-stage" data-stage="2">
            <div class="story-copy"><h3>Review changes where you work.</h3></div>
            <div class="story-pane"><RunActions change={change} summary={summary} /></div>
          </article>
        </div>
        <div class="story-progress" aria-hidden="true"><i></i><i></i><i></i></div>
      </div>
    </div>
  </div>
</section>

<script>
  const story = document.querySelector<HTMLElement>('.run-story');
  if (story) {
    const flow = story.querySelector<HTMLElement>('.story-flow')!;
    const stages = [...story.querySelectorAll<HTMLElement>('.story-stage')];
    const markers = [...story.querySelectorAll<HTMLElement>('.story-progress i')];
    const viewport = story.querySelector<HTMLElement>('.event-viewport')!;
    const media = matchMedia('(min-width: 1100px) and (min-height: 760px) and (prefers-reduced-motion: no-preference)');
    let queued = false;
    const clamp = (value: number) => Math.min(1, Math.max(0, value));
    const update = () => {
      queued = false;
      const progress = media.matches ? clamp(-flow.getBoundingClientRect().top / (flow.offsetHeight - innerHeight)) : 1;
      const active = progress >= 0.75 ? 2 : progress >= 0.48 ? 1 : 0;
      stages.forEach((stage, index) => {
        stage.classList.toggle('active', active === index);
        stage.inert = media.matches && active !== index;
        markers[index].classList.toggle('active', active === index);
      });
      story.classList.toggle('inspect-failure', !media.matches || progress >= 0.57);
      story.style.setProperty('--actions-progress', String(media.matches ? clamp((progress - 0.75) / 0.2) : 1));
      const streamProgress = media.matches ? clamp((progress - 0.025) / 0.4) : 1;
      window.dispatchEvent(new CustomEvent('tangle:run-progress', { detail: { progress: streamProgress } }));
      // React reveals the captured events first; follow the newest visible output.
      requestAnimationFrame(() => {
        viewport.scrollTop = media.matches ? Math.max(0, viewport.scrollHeight - viewport.clientHeight) : 0;
      });
    };
    const setMode = () => {
      story.classList.toggle('is-pinned', media.matches);
      update();
    };
    addEventListener('scroll', () => {
      if (!queued && media.matches) { queued = true; requestAnimationFrame(update); }
    }, { passive: true });
    addEventListener('resize', update, { passive: true });
    addEventListener('tangle:run-ready', update);
    media.addEventListener('change', setMode);
    setMode();
  }
</script>

<style>
  .run-story { background: var(--depth-1); color: var(--text-primary); }
  .story-shell { width: min(78rem, 90vw); margin: auto; }
  .story-sticky { padding: 5.5rem 0; }
  .story-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: 2.5rem; }
  h2, h3 { margin: 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.032em; text-wrap: balance; }
  h2 { font-size: clamp(2rem, 3.4vw, 3.2rem); line-height: 1.1; }
  .story-product { color: var(--accent-text); font-size: 1rem; text-decoration: none; white-space: nowrap; padding-bottom: 0.25rem; }
  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .story-stage { display: grid; grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.45fr); align-items: center; gap: 3rem; margin-top: 4rem; }
  .story-stage:first-child { margin-top: 0; }
  .story-copy, .story-pane { min-width: 0; }
  h3 { font-size: clamp(1.7rem, 2.3vw, 2.3rem); line-height: 1.15; }
  .event-window, .trace-window { overflow: hidden; border: 1px solid var(--md3-outline-variant); border-radius: 14px; background: var(--bg-card); box-shadow: 0 20px 55px rgb(30 24 75 / 8%); }
  .window-header { display: flex; align-items: center; gap: 0.7rem; min-height: 3.4rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--md3-outline-variant); background: var(--md3-surface-container-low); font-size: 0.95rem; }
  .window-header img { flex: none; }
  .event-viewport { height: 24rem; overflow: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: var(--md3-outline-variant) transparent; }
  .window-footer { padding: 0.65rem 1.2rem; border-top: 1px solid var(--md3-outline-variant); color: var(--text-muted); font: 0.8rem var(--font-mono); }
  .trace-finding { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.9rem 1.3rem; border-top: 1px solid var(--md3-outline-variant); background: var(--surface-danger-bg); opacity: 0; transform: translateY(5px); transition: opacity 400ms, transform 400ms; }
  .inspect-failure .trace-finding { opacity: 1; transform: none; }
  .failure-count { color: var(--surface-danger-text); font-size: 0.875rem; font-weight: 600; }
  .trace-finding > div { display: flex; align-items: center; gap: 0.6rem; }
  .trace-finding code { border: 1px solid var(--surface-danger-border); border-radius: 4px; padding: 0.1rem 0.4rem; color: var(--surface-danger-text); font: 0.8rem var(--font-mono); }
  .trace-finding code.fixed-value { color: var(--surface-success-text); border-color: var(--surface-success-border); background: var(--surface-success-bg); }
  .test-comparison { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1.5rem; align-items: center; padding: 1rem 1.3rem; background: var(--md3-surface-container-low); border-top: 1px solid var(--md3-outline-variant); }
  .test-comparison div > span { display: block; color: var(--text-muted); font-size: 0.8rem; margin-bottom: 0.3rem; }
  .test-comparison strong { display: block; font-size: 1rem; }
  .test-comparison small { font-size: 0.875rem; font-weight: 400; }
  .test-success { color: var(--surface-success-text); }
  .comparison-arrow { color: var(--text-muted); font-size: 1.5rem; }
  .story-progress { display: none; gap: 0.4rem; margin-top: 1.75rem; }
  .story-progress i { width: 2rem; height: 3px; border-radius: 2px; background: var(--md3-outline-variant); }
  .story-progress i.active { background: var(--accent-text); }
  :is(a, .event-viewport):focus-visible { outline: 2px solid var(--accent-text); outline-offset: 4px; }
  .is-pinned .story-progress { display: flex; }
  .is-pinned .story-flow { height: 400vh; }
  .is-pinned .story-sticky { position: sticky; top: 0; display: flex; align-items: center; height: 100vh; padding: 3rem 0; }
  .is-pinned .story-stages { position: relative; height: 30rem; }
  .is-pinned .story-stage { position: absolute; inset: 0; margin: 0; visibility: hidden; opacity: 0; transform: translateY(20px); transition: opacity 350ms ease, transform 500ms ease, visibility 350ms; }
  .is-pinned .story-stage.active { visibility: visible; opacity: 1; transform: none; }
  @media (max-width: 1099px), (max-height: 759px) {
    .story-stage { grid-template-columns: minmax(0, 1fr); gap: 1.7rem; }
    .story-copy { max-width: 42rem; }
  }
  @media (max-width: 640px) {
    .story-shell { width: 92vw; }
    .story-sticky { padding: 4rem 0; }
    .story-heading { display: block; }
    .story-product { display: inline-block; margin-top: 1.2rem; }
    .window-header { padding: 0.8rem 1rem; }
    .trace-finding { padding: 0.8rem; gap: 0.6rem; flex-wrap: wrap; }
    .test-comparison { padding: 1rem; gap: 0.5rem; }
    .test-comparison strong { font-size: 0.875rem; }
    .test-comparison small { display: block; }
  }
  @media (prefers-reduced-motion: reduce) { .trace-finding { transition: none; } }
</style>
