---
import RunActions from './RunActions.astro';
import run from '../data/homepageRun.json';

const change = {
  url: run.source.patchUrl,
  title: 'Handle non-finite durations',
  file: 'formatters.ts',
  additions: 3,
  deletions: 0,
  diff: run.patch,
};
const summary = 'Fixed the uptime formatter. All 18 tests pass; existing duration formatting is unchanged.';
---

<section class="run-story" aria-labelledby="intel-title">
  <div class="story-flow">
    <div class="story-sticky">
      <div class="story-shell">
        <header class="story-heading">
          <h2 id="intel-title">Understand every run.<br />Improve the next.</h2>
          <a class="story-product" href="https://intelligence.tangle.tools">Explore Intelligence <span aria-hidden="true">↗</span></a>
        </header>

        <div class="story-stages">
          <article class="story-stage" data-stage="0">
            <div class="story-copy">
              <span class="story-kicker">Execution</span>
              <h3>Follow the work.</h3>
              <p>Every message, tool call, and change. From the first instruction to the result.</p>
              <a class="story-source" href={run.source.url} target="_blank" rel="noopener noreferrer">Open this run <span aria-hidden="true">↗</span></a>
            </div>
            <div class="story-pane event-window">
              <header class="window-header">
                <img src="/images/harness/claude-code.svg" width="24" height="24" alt="" />
                <strong>Claude Code</strong><span>Event stream</span>
              </header>
              <div class="event-viewport" tabindex="0" role="region" aria-label="Claude Code messages and tool output">
                <div class="event-list">
                  <div class="run-prompt"><span>Task</span><p>{run.prompt}</p></div>
                  {run.events.map((event) => (
                    <article class={`run-event event-${event.kind}`}>
                      <header><b>{event.label}</b>{typeof event.atMs === 'number' && <time>+{(event.atMs / 1000).toFixed(2)}s</time>}</header>
                      <p>{event.text}</p>
                      {'output' in event && <pre><code>{event.output}</code></pre>}
                    </article>
                  ))}
                  <p class="run-finished"><span aria-hidden="true">✓</span> 18 tests passed</p>
                </div>
              </div>
              <footer class="window-footer"><span>formatters.ts</span><span>Messages · Tools · Changes</span></footer>
            </div>
          </article>

          <article class="story-stage" data-stage="1">
            <div class="story-copy">
              <span class="story-kicker">Intelligence</span>
              <h3>See how it got there.</h3>
              <p>Inspect the work behind the answer. Find failures, follow the fix, and compare the result.</p>
            </div>
            <div class="story-pane trace-window">
              <header class="window-header"><img src="/brand/tangle-icon-filled.svg" width="24" height="24" alt="Tangle" /><strong>Fix unavailable uptime formatting</strong></header>
              <div class="trace-chart" role="img" aria-label="Tool timeline from a recorded Claude run, from workspace discovery at 3.88 seconds to the final tests at 17.59 seconds. Tools take 27 to 434 milliseconds.">
                <div class="trace-axis"><span>Tool calls</span><div><span>0s</span><span>5s</span><span>10s</span><span>15s</span><span>20s</span></div><span>Duration</span></div>
                {run.tools.map((tool) => (
                  <div class={`trace-row trace-${tool.kind}`}>
                    <span>{tool.name}</span>
                    <div class="trace-track"><i style={`left: ${tool.atMs / 200}%; width: ${tool.durationMs / 200}%;`} /></div>
                    <span class="trace-duration">{tool.durationMs}ms</span>
                  </div>
                ))}
              </div>
              <div class="test-comparison">
                <div><span>Before</span><strong>{run.before.passed} passed <small>· {run.before.failed} failed</small></strong></div>
                <span class="comparison-arrow" aria-hidden="true">→</span>
                <div><span>After</span><strong class="test-success">{run.after.passed} passed <small>· {run.after.failed} failed</small></strong></div>
              </div>
              <div class="trace-result"><span class="result-check" aria-hidden="true">✓</span><p>The fix handles unavailable values.<br />Existing duration formatting stays unchanged.</p></div>
            </div>
          </article>

          <article class="story-stage" data-stage="2">
            <div class="story-copy">
              <span class="story-kicker">Action</span>
              <h3>Review changes where you work.</h3>
              <p>Read the diff. Share the result. Decide what ships.</p>
            </div>
            <div class="story-pane"><RunActions change={change} summary={summary} summaryUrl={run.source.patchUrl} /></div>
          </article>
        </div>

        <nav class="story-nav" aria-label="Run walkthrough" hidden>
          <button type="button" data-target="0" aria-current="step">Follow the run</button>
          <button type="button" data-target="1">Understand it</button>
          <button type="button" data-target="2">Review the change</button>
        </nav>
      </div>
    </div>
  </div>
</section>

<script>
  const story = document.querySelector<HTMLElement>('.run-story');
  if (story) {
    const flow = story.querySelector<HTMLElement>('.story-flow')!;
    const stages = [...story.querySelectorAll<HTMLElement>('.story-stage')];
    const nav = story.querySelector<HTMLElement>('.story-nav')!;
    const buttons = [...nav.querySelectorAll<HTMLButtonElement>('button')];
    const viewport = story.querySelector<HTMLElement>('.event-viewport')!;
    const list = story.querySelector<HTMLElement>('.event-list')!;
    const media = matchMedia('(min-width: 1100px) and (min-height: 760px) and (prefers-reduced-motion: no-preference)');
    const starts = [0, 0.48, 0.75];
    let queued = false;
    const update = () => {
      queued = false;
      if (!media.matches) return;
      const progress = Math.min(1, Math.max(0, -flow.getBoundingClientRect().top / (flow.offsetHeight - innerHeight)));
      const active = progress >= starts[2] ? 2 : progress >= starts[1] ? 1 : 0;
      stages.forEach((stage, index) => {
        stage.classList.toggle('active', active === index);
        stage.inert = active !== index;
      });
      buttons.forEach((button, index) => index === active ? button.setAttribute('aria-current', 'step') : button.removeAttribute('aria-current'));
      // Scroll the actual captured messages. The reader can also scroll this pane.
      const streamProgress = Math.min(1, Math.max(0, (progress - 0.035) / 0.39));
      viewport.scrollTop = streamProgress * Math.max(0, list.scrollHeight - viewport.clientHeight);
    };
    const setMode = () => {
      story.classList.toggle('is-pinned', media.matches);
      nav.hidden = !media.matches;
      if (!media.matches) {
        stages.forEach((stage) => { stage.inert = false; });
        viewport.scrollTop = 0;
      }
      update();
    };
    addEventListener('scroll', () => {
      if (!queued && media.matches) { queued = true; requestAnimationFrame(update); }
    }, { passive: true });
    addEventListener('resize', update, { passive: true });
    media.addEventListener('change', setMode);
    buttons.forEach((button, index) => button.addEventListener('click', () => {
      const top = scrollY + flow.getBoundingClientRect().top;
      scrollTo({ top: top + (flow.offsetHeight - innerHeight) * (starts[index] + 0.015), behavior: 'smooth' });
    }));
    setMode();
  }
</script>

<style>
  .run-story { background: var(--paper-0); color: var(--ink); }
  .story-shell { width: min(78rem, 90vw); margin: auto; }
  .story-sticky { padding: 5.5rem 0; }
  .story-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: 2.5rem; }
  h2, h3 { margin: 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.032em; text-wrap: balance; }
  h2 { font-size: clamp(2rem, 3.4vw, 3.2rem); line-height: 1.1; }
  .story-product, .story-source { color: #5140ca; font-size: 1rem; text-decoration: none; }
  .story-product { white-space: nowrap; padding-bottom: 0.25rem; }
  .story-source { display: inline-block; margin-top: 1.4rem; }
  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .story-stage { display: grid; grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.45fr); align-items: center; gap: 3rem; margin-top: 4rem; }
  .story-stage:first-child { margin-top: 0; }
  .story-copy, .story-pane { min-width: 0; }
  .story-kicker { display: block; margin-bottom: 0.9rem; color: #5140ca; font-size: 0.95rem; font-weight: 600; }
  h3 { font-size: clamp(1.7rem, 2.3vw, 2.3rem); line-height: 1.15; }
  .story-copy p { margin: 1rem 0 0; color: var(--ink-secondary); font-size: clamp(1.1rem, 1.35vw, 1.25rem); line-height: 1.6; }
  .event-window, .trace-window { overflow: hidden; border: 1px solid #d1d3e1; border-radius: 14px; background: #fff; box-shadow: 0 20px 55px rgb(30 24 75 / 8%); }
  .window-header { display: flex; align-items: center; gap: 0.7rem; min-height: 3.4rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid #e3e4ed; background: #f8f8fc; font-size: 0.95rem; }
  .window-header img { flex: none; }
  .window-header > span { margin-left: auto; color: #656776; font-size: 0.875rem; }
  .event-viewport { height: 23rem; overflow: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: #bebdcc transparent; }
  .event-list { padding: 1.2rem 1.4rem; }
  .run-prompt { margin-bottom: 1.3rem; border-left: 2px solid #7966e8; padding-left: 1rem; }
  .run-prompt span { font-size: 0.85rem; font-weight: 600; color: #5140ca; }
  .run-prompt p { margin: 0.35rem 0 0; font-size: 1rem; line-height: 1.55; white-space: pre-line; }
  .run-event { padding: 0.95rem 0; border-top: 1px solid #eeeef4; }
  .run-event header { display: flex; gap: 1rem; align-items: center; font-size: 0.9rem; }
  .run-event b { color: #5140ca; }
  .run-event time { margin-left: auto; font-family: var(--font-mono); color: #656776; font-size: 0.85rem; }
  .run-event p { margin: 0.45rem 0 0; font-size: 1rem; line-height: 1.5; }
  .run-event pre { margin: 0.65rem 0 0; padding: 0.8rem; border: 1px solid #e4e4ee; border-radius: 6px; background: #f5f5fa; color: #343344; overflow-x: auto; font-family: var(--font-mono); font-size: 0.875rem; line-height: 1.6; }
  .run-event code { font: inherit; }
  .event-assistant { padding-left: 0.2rem; }
  .event-assistant b { color: #a74d31; }
  .run-finished { display: flex; align-items: center; gap: 0.6rem; padding-top: 0.75rem; color: #186f47; font-weight: 600; }
  .window-footer { display: flex; justify-content: space-between; gap: 1rem; padding: 0.75rem 1.2rem; border-top: 1px solid #e3e4ed; color: #656776; font-size: 0.8rem; }
  .trace-chart { padding: 1.2rem; }
  .trace-axis, .trace-row { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr) 4.7rem; align-items: center; gap: 0.9rem; }
  .trace-axis { margin-bottom: 0.9rem; color: #656776; font-size: 0.75rem; }
  .trace-axis > div { display: flex; justify-content: space-between; }
  .trace-axis > :last-child { text-align: right; }
  .trace-row { min-height: 2.5rem; font-size: 0.875rem; }
  .trace-track { position: relative; height: 2.5rem; background: repeating-linear-gradient(90deg, #e8e8f1 0 1px, transparent 1px 25%); }
  .trace-track i { position: absolute; top: 0.8rem; height: 0.9rem; min-width: 3px; border-radius: 2px; background: #7966e8; }
  .trace-edit .trace-track i { background: #247455; }
  .trace-duration { font-family: var(--font-mono); color: #656776; text-align: right; font-size: 0.8rem; }
  .test-comparison { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1.5rem; align-items: center; padding: 1.1rem 1.3rem; background: #f7f7fc; border-top: 1px solid #e3e4ed; border-bottom: 1px solid #e3e4ed; }
  .test-comparison div > span { display: block; color: #656776; font-size: 0.8rem; margin-bottom: 0.3rem; }
  .test-comparison strong { display: block; font-size: 1rem; }
  .test-comparison small { font-size: 0.875rem; font-weight: 400; }
  .test-success { color: #186f47; }
  .comparison-arrow { color: #8a819f; font-size: 1.5rem; }
  .trace-result { display: flex; align-items: center; gap: 0.9rem; padding: 1.1rem 1.3rem; }
  .trace-result p { margin: 0; font-size: 0.95rem; line-height: 1.5; }
  .result-check { display: grid; place-items: center; width: 2rem; height: 2rem; flex: none; border-radius: 50%; background: #e0f2e8; color: #186f47; }
  .story-nav { display: flex; gap: 1.8rem; margin-top: 2.2rem; }
  .story-nav[hidden] { display: none; }
  .story-nav button { position: relative; border: 0; border-bottom: 2px solid #d6d3e3; padding: 0.55rem 0; background: none; font: inherit; color: #656776; font-size: 0.875rem; cursor: pointer; }
  .story-nav button[aria-current] { border-color: #6552d7; color: #5140ca; }
  :is(a, button, .event-viewport):focus-visible { outline: 2px solid #6552d7; outline-offset: 4px; }
  .run-story ::selection { background: #dcd6ff; color: #242633; }
  .is-pinned .story-flow { height: 400vh; }
  .is-pinned .story-sticky { position: sticky; top: 0; display: flex; align-items: center; height: 100vh; padding: 3rem 0; }
  .is-pinned .story-stages { position: relative; height: 30rem; }
  .is-pinned .story-stage { position: absolute; inset: 0; margin: 0; visibility: hidden; opacity: 0; transform: translateY(20px); transition: opacity 350ms ease, transform 500ms ease, visibility 350ms; }
  .is-pinned .story-stage.active { visibility: visible; opacity: 1; transform: none; }
  @media (max-width: 1099px), (max-height: 759px) {
    .story-stage { grid-template-columns: minmax(0, 1fr); gap: 1.7rem; }
    .story-copy { max-width: 42rem; }
    .story-kicker { margin-bottom: 0.6rem; }
    .story-copy p { max-width: 36rem; }
  }
  @media (max-width: 640px) {
    .story-shell { width: 92vw; }
    .story-sticky { padding: 4rem 0; }
    .story-heading { display: block; }
    .story-product { display: inline-block; margin-top: 1.2rem; }
    .event-list { padding: 1rem; }
    .window-header { padding: 0.8rem 1rem; }
    .window-footer span:last-child { display: none; }
    .trace-chart { padding: 1rem 0.8rem; }
    .trace-axis, .trace-row { grid-template-columns: 7.4rem minmax(0, 1fr) 3.1rem; gap: 0.5rem; }
    .trace-axis { font-size: 0.7rem; }
    .trace-axis > div span:nth-child(even) { visibility: hidden; }
    .trace-row { font-size: 0.8rem; }
    .trace-duration { font-size: 0.75rem; }
    .test-comparison { padding: 1rem; gap: 0.5rem; }
    .test-comparison strong { font-size: 0.875rem; }
    .test-comparison small { display: block; }
  }
</style>
