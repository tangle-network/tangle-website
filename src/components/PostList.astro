---
// The ordered list of a series' posts: part number, title, date. One list style for the index, a series page and a post's rail.
import { formatDate } from '../utils/date';
interface Props { posts: { data: { slug: string; title: string; date: string } }[]; current?: string; compact?: boolean }
const { posts, current, compact = false } = Astro.props;
---
<ol class:list={['posts', { compact }]}>
  {posts.map((post, i) => (
    <li>
      <a href={`/blog/${post.data.slug}`} aria-current={post.data.slug === current ? 'page' : undefined}>
        <span class="n">{i + 1}</span>
        <span class="t">{post.data.title}</span>
        {!compact && <time datetime={post.data.date}>{formatDate(post.data.date, 'short')}</time>}
      </a>
    </li>
  ))}
</ol>

<style>
  .posts { margin: 0; padding: 0; list-style: none; }
  .posts li { border-top: 1px solid var(--border-subtle); }
  .posts li:last-child { border-bottom: 1px solid var(--border-subtle); }
  .posts a { display: grid; grid-template-columns: 2rem minmax(0, 1fr) auto; align-items: baseline; gap: 0 1rem; padding: 0.7rem 0; color: var(--text-primary); text-decoration: none; }
  .posts a:hover .t, .posts a:focus-visible .t { color: var(--accent-text); }
  .posts a:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; }
  .posts a[aria-current='page'] .t { color: var(--accent-text); font-weight: 600; }
  .posts .n, .posts time { font-family: var(--font-mono); font-feature-settings: 'tnum'; font-size: 0.8rem; color: var(--text-muted); }
  .posts .t { font-size: 1.02rem; line-height: 1.4; font-weight: 500; }
  .posts time { white-space: nowrap; }
  .compact a { grid-template-columns: 1.5rem minmax(0, 1fr); padding: 0.45rem 0; }
  .compact .t { font-size: 0.9rem; font-weight: 400; }
  .compact li, .compact li:last-child { border: 0; }
  @media (max-width: 560px) { .posts a { grid-template-columns: 2rem minmax(0, 1fr); } .posts time { grid-column: 2; } }
</style>
