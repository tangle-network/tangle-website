---
import PairReplay from './PairReplay';

// A terminal session recorded against production by `node scripts/record-examples.mts --session pair`: the commands in
// scripts/sessions/pair.sh, what they printed, and every file the agent wrote. `pnpm check:runs` fails the gate when
// the record is for other commands or its URL served other bytes than the agent wrote.
import record from '../data/sessions/pair.json';
import url from '../data/sessions/pair.json?url&no-inline';
---

<section class="pair dark" data-theme="website" aria-labelledby="pair-title">
  <div class="pair-inner">
    <header class="pair-heading">
      <h2 id="pair-title">Ask for an app. Get a live URL.</h2>
      <a href="https://docs.tangle.tools/sandbox/cloud-agents">Cloud agents <span aria-hidden="true">↗</span></a>
    </header>
    <PairReplay client:visible meta={{ url, recordedAt: record.run.recordedAt, previewUrl: record.run.url }} install="npm install -g @tangle-network/sandbox-cli" />
  </div>
</section>

<style>
  /* One viewport tall, like the examples above it: the window is the section. */
  .pair { display: flex; flex-direction: column; height: 100svh; min-height: 46rem; background: var(--depth-1); color: var(--text-primary); padding: 64px 0 72px; }
  .pair-inner { display: flex; flex-direction: column; flex: 1; min-height: 0; width: min(88rem, 94vw); margin: 0 auto; }
  .pair-inner > :global(astro-island) { display: contents; }
  .pair-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
  .pair h2 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 3.2vw, 3rem); font-weight: 600; line-height: 1; letter-spacing: -0.032em; color: var(--text-primary); text-wrap: balance; }
  .pair-heading a { flex-shrink: 0; padding-bottom: 4px; color: var(--accent-text); font-size: var(--font-size-lg); line-height: 1.5rem; white-space: nowrap; text-underline-offset: 0.25em; }
  .pair-heading span { margin-left: 4px; }
  .pair-heading a:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 4px; }
  @media (max-width: 680px) {
    .pair { height: auto; min-height: 0; padding: 40px 0; }
    .pair-inner { width: calc(100vw - 32px); height: 52rem; max-height: 120svh; }
    .pair-heading { align-items: flex-start; flex-direction: column; gap: 12px; margin-bottom: 24px; }
    .pair h2 { font-size: var(--font-size-4xl); line-height: 2.5rem; }
  }
</style>
