---
import type { taskPromptsFor } from '../data/benchmarks/task-sources';

interface Props {
  tasks: ReturnType<typeof taskPromptsFor>;
}

const { tasks } = Astro.props;
---

{tasks.length > 0 && (
  <div class="benchmark-tasks" id="task-prompts">
    <h2>Task prompts</h2>
    {tasks.some((task) => task.sources.length > 0) && <p class="task-origin">Tangle’s VerticalBench generated these app-building tasks from the search engine’s documentation and release notes. The prompts and their sources are below.</p>}
    {tasks.map((task) => (
      <details class="benchmark-task">
        <summary>{task.label} · {task.name}</summary>
        <p class="bench-task-prompt">{task.prompt}</p>
        {task.sources.length > 0 && <ul class="task-sources" aria-label="Documentation sources">{task.sources.map((source) => <li><a href={source.href}>{source.label}</a></li>)}</ul>}
      </details>
    ))}
  </div>
)}

<style>
  .benchmark-tasks { margin-top: 32px; }
  .benchmark-tasks h2 { margin: 0 0 12px; font-size: 24px; font-weight: 600; }
  .task-origin { margin: 0 0 24px; max-width: 75ch; font-size: 17px; line-height: 1.6; color: var(--text-secondary); }
  .task-sources { padding-left: 20px; margin: 0 0 24px; font-size: 16px; line-height: 1.7; }
  .task-sources a { color: var(--accent-text); text-underline-offset: 3px; }
  .benchmark-task { border-top: 1px solid var(--chart-rule); }
  .benchmark-task > summary { padding: 18px 0; font-size: 18px; line-height: 1.5; cursor: pointer; }
  .bench-task-prompt { margin: 0 0 24px; max-width: 75ch; font-size: 17px; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
</style>
