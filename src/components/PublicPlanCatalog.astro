---
import { loadPublicPlans, money } from '../lib/plan-catalog.mjs';
let catalog: Awaited<ReturnType<typeof loadPublicPlans>> | null = null;
try { catalog = await loadPublicPlans(); } catch { /* The fallback is deliberately not a copied price table. */ }
---
{catalog ? <>
  <div class="plan-grid" data-plan-catalog="platform">
    {catalog.plans.map((plan) => <article class="plan">
      <h3>{plan.name}</h3>
      <p class="description">{plan.description}</p>
      <p class="price"><strong>{money(plan.monthlyPriceCents)}</strong><span> / month</span></p>
      <p>{plan.creditsPerMonth > 0 ? `${money(plan.creditsPerMonth)} monthly credit included.` : 'No monthly credit included. Fund your balance before running paid workloads.'}</p>
      <ul>{plan.features.map((feature) => <li>{feature}</li>)}</ul>
      <a href={`https://id.tangle.tools/app/plans?plan=${encodeURIComponent(plan.id)}`}>Review {plan.name}</a>
    </article>)}
  </div>
  <p class="provenance">Loaded from the platform catalog at <time datetime={catalog.loadedAt}>{catalog.loadedAt}</time>. The platform confirms price and eligibility before purchase.</p>
</> : <div role="status" class="unavailable">
  <h3>Current plans could not be loaded</h3>
  <p>No substitute prices or trial allowances are shown. The current catalog is available on the platform.</p>
  <a href="https://id.tangle.tools/app/plans">Open current plans</a>
</div>}
<style>
  .plan-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
  .plan,.unavailable{border:1px solid #d7d8e0;border-radius:12px;padding:28px;background:white;color:#24233d}
  .plan{display:flex;flex-direction:column;min-width:0}.plan h3,.unavailable h3{font-size:24px;line-height:1.25;font-weight:650;margin:0}
  .plan p,.unavailable p{font-size:15px;line-height:1.6;margin:16px 0 0}.description{color:#575568}.price strong{font-size:40px;letter-spacing:-.025em}.price span{color:#575568}
  ul{margin:24px 0;padding-left:20px;flex:1}li{margin:10px 0;font-size:14px;line-height:1.5}
  a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;border:1px solid #4c3fc6;border-radius:6px;padding:10px 16px;color:#4c3fc6;text-decoration:none;font-weight:600}
  a:hover{background:#f0efff}a:focus-visible{outline:3px solid #4c3fc6;outline-offset:3px}.provenance{font-size:12px;line-height:1.6;color:#575568;margin-top:20px;overflow-wrap:anywhere}
  @media(max-width:900px){.plan-grid{grid-template-columns:1fr}.plan{padding:24px}}
  @media(forced-colors:active){.plan,.unavailable,a{border-color:ButtonText}a:focus-visible{outline-color:Highlight}}
</style>
