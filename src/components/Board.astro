---
// The one leaderboard table: rank, name with its mark, the value drawn as a bar on the table's shared scale, its spread, an
// optional extra figure and the count. Click a column head to sort; ranks renumber.
import { seconds } from '../data/benchmarks/sandbox';
export interface BoardRow { label: string; sub?: string; logo?: string; value: number; whisker?: number | null; low?: number; high?: number; extra?: string; n?: number | string; flagged?: boolean; highlight?: boolean; note?: string }
interface Props { rows: BoardRow[]; unit?: 'ms' | 'rate'; head?: string; value?: string; spread?: string; extraHead?: string; count?: string; caption?: string; ranked?: boolean }
const { rows, unit = 'ms', head = 'name', value = 'p50', spread = 'p95', extraHead, count = 'n', caption, ranked = true } = Astro.props;
const max = unit === 'rate' ? 1 : Math.max(...rows.map((r) => Math.max(r.value, r.whisker ?? 0, r.high ?? 0)));
const pct = (x: number) => `${((x / max) * 100).toFixed(1)}%`;
const text = (x: number) => (unit === 'rate' ? `${(x * 100).toFixed(x > 0 && x < 0.095 ? 1 : 0)}%` : seconds(x));
const interval = rows.some((r) => r.low != null);
---
<div class="lb">
  <table>
    <thead>
      <tr>
        {ranked && <th scope="col" class="lb-rank">#</th>}
        <th scope="col" data-sort="text">{head}</th>
        <th scope="col" class="lb-plot" data-sort="num">{value}</th>
        <th scope="col" class="num" data-sort="num">{spread}</th>
        {extraHead && <th scope="col" class="num" data-sort="num">{extraHead}</th>}
        <th scope="col" class="num" data-sort="num">{count}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r, i) => (
        <tr class:list={[{ flagged: r.flagged, highlight: r.highlight }]} title={r.note}>
          {ranked && <td class="lb-rank">{i + 1}</td>}
          <th scope="row">
            <span class="lb-name">
              {r.logo && <img src={r.logo} alt="" width="22" height="22" loading="lazy" />}
              <span>{r.label}{r.sub && <small>{r.sub}</small>}</span>
              {r.flagged && <span class="flag" title="a record in this row failed a check">✱</span>}
            </span>
          </th>
          <td class="lb-plot" data-v={r.value}>
            <span class="lb-plot-row">
            <span class="lb-track">
              {r.low != null && r.high != null && <span class="lb-band" style={`left: ${pct(r.low)}; width: ${pct(r.high - r.low)}`}></span>}
              <span class="lb-fill" style={`width: ${pct(r.value)}`}></span>
              {r.whisker != null && r.whisker > r.value && <span class="lb-tick" style={`left: ${pct(r.whisker)}`}></span>}
            </span>
            <span class="lb-val">{text(r.value)}</span>
            </span>
          </td>
          <td class="num" data-v={r.whisker ?? r.high ?? ''}>{interval ? (r.low != null && r.high != null ? `${text(r.low)} – ${text(r.high)}` : '–') : r.whisker != null ? text(r.whisker) : '–'}</td>
          {extraHead && <td class="num" data-v={r.extra ?? ''}>{r.extra ?? '–'}</td>}
          <td class="num lb-n" data-v={r.n ?? ''}>{r.n ?? '–'}</td>
        </tr>
      ))}
    </tbody>
  </table>
  {caption && <p class="lb-caption">{caption}</p>}
</div>

<script>
  for (const th of document.querySelectorAll<HTMLTableCellElement>('.lb th[data-sort]')) {
    th.addEventListener('click', () => {
      const table = th.closest('table')!;
      const body = table.tBodies[0];
      const i = th.cellIndex;
      const num = th.dataset.sort === 'num';
      const asc = th.getAttribute('aria-sort') !== 'ascending';
      const key = (tr: HTMLTableRowElement) => { const c = tr.cells[i]; return num ? Number(c.dataset.v || parseFloat(c.textContent ?? '')) : (c.textContent ?? '').trim(); };
      [...body.rows].sort((a, b) => (key(a) < key(b) ? -1 : key(a) > key(b) ? 1 : 0) * (asc ? 1 : -1)).forEach((tr, k) => {
        body.append(tr);
        const rank = tr.querySelector('.lb-rank');
        if (rank) rank.textContent = String(k + 1);
      });
      for (const h of table.tHead!.rows[0].cells) h.removeAttribute('aria-sort');
      th.setAttribute('aria-sort', asc ? 'ascending' : 'descending');
    });
  }
</script>
