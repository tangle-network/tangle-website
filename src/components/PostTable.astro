---
// Every Markdown table in a post, in the brand's scroll region: the table keeps its table semantics, a phone scrolls
// it sideways inside the column instead of crushing its columns, and the region takes focus so a keyboard can scroll it.
const props = Astro.props;
---
<div class="post-table" role="region" tabindex="0" aria-label="Table"><table {...props}><slot /></table></div>
