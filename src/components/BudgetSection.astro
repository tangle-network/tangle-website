---
import { ExampleEditor } from '@tangle-network/ui/marketing';
import '@tangle-network/ui/styles/marketing.css';
import '@tangle-network/charts/figure.css';
import { budget } from '../data/examples';

---
<section class="budget dark" data-theme="website" aria-labelledby="budget-title">
  <div class="budget-inner">
    <header class="budget-heading">
      <div><h2 id="budget-title">A runaway agent<br />stops at its budget.</h2>
        <p>Tangle checks each model call against the fleet's <code>budgetUsd</code> before it runs. <code>fleet.spend()</code> reads the total at any moment, and <code>fleet.cancel()</code> stops every agent still running.</p>
      </div>
      <a href="https://sandbox.tangle.tools/docs/agents/fleet">Fleets ↗</a>
    </header>
    <ExampleEditor client:visible subjects={budget} />
  </div>
</section>
<style>
  .budget { padding: 120px 0; background: var(--depth-1); color: var(--text-primary); }
  .budget-inner { width: min(75rem, calc(100% - 48px)); margin: 0 auto; }
  .budget-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 40px; }
  h2 { margin: 0; font: 600 clamp(1.875rem, 1.1rem + 2.3vw, 2.875rem)/1.06 var(--font-display); letter-spacing: -0.035em; }
  p { max-width: 41rem; margin: 20px 0 0; font-size: calc(var(--font-size-base) * 1.1875); line-height: 1.55; color: var(--text-secondary); }
  code { font: .85em/1.3 var(--font-mono); background: var(--depth-3); border-radius: var(--radius-tag); padding: 1px 5px; }
  a { flex: none; color: var(--accent-text); font-size: calc(var(--font-size-base) * 1.0625); }
  @media (max-width: 680px) { .budget { padding: 72px 0; } h2 { font-size: var(--font-size-3xl); line-height: 1.12; } p { font-size: calc(var(--font-size-base) * 1.0625); margin-top: 14px; } .budget-inner { width: calc(100% - 40px); } .budget-heading { align-items: flex-start; flex-direction: column; gap: 12px; margin-bottom: 24px; } }
</style>
