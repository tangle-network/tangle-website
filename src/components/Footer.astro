---
import { COMPLIANCE_BADGES } from '../data/compliance';

const products = [
  { label: 'Sandbox', href: 'https://sandbox.tangle.tools' },
  { label: 'Router', href: 'https://router.tangle.tools' },
  { label: 'Intelligence', href: 'https://intelligence.tangle.tools' },
];
const resources = [
  { label: 'Docs', href: 'https://docs.tangle.tools' },
  { label: 'SDK reference', href: 'https://docs.tangle.tools/sandbox/sdk-typescript' },
  { label: 'Console', href: 'https://sandbox.tangle.tools/dashboard' },
  { label: 'Benchmarks', href: '/benchmarks/' },
];
const company = [
  { label: 'About Tangle', href: '/what-is-tangle/' },
  { label: 'Blog', href: '/blog' },
  { label: 'Compare', href: '/compare/' },
  { label: 'Brand kit', href: '/brand-kit' },
  { label: 'Security', href: '/security/' },
  { label: 'Status', href: '/status/' },
  { label: 'Release notes', href: '/releases/' },
];
---

<footer class="ft">
  <div class="ft-inner">
    <div class="ft-grid">
      <div class="ft-brand">
        <a href="/" class="ft-lockup">
          <img src="/images/webflow/tangle icon.png" alt="" width="32" height="32" />
          <span>Tangle</span>
        </a>
        <p class="ft-tagline">Infrastructure for AI agents.</p>
        <a class="ft-mail" href="mailto:hello@tangle.tools">hello@tangle.tools</a>
      </div>

      <nav class="ft-col" aria-label="Products">
        <span class="ft-label">Products</span>
        {products.map((p) => (
          <a href={p.href} class="ft-link">
            {p.label}
          </a>
        ))}
      </nav>

      <nav class="ft-col" aria-label="Resources">
        <span class="ft-label">Resources</span>
        {resources.map((r) => (
          <a href={r.href} class="ft-link">
            {r.label}
          </a>
        ))}
      </nav>

      <nav class="ft-col" aria-label="Company">
        <span class="ft-label">Company</span>
        {company.map((c) => (
          <a href={c.href} class="ft-link">{c.label}</a>
        ))}
      </nav>
    </div>

    <div class="ft-legal">
      <span>© 2026 Tangle</span>
      <nav class="ft-legal-links" aria-label="Legal and trust">
        <a href="/privacy-policy">Privacy</a>
        <a href="/terms-of-service">Terms</a>
        <a href="/sub-processors">Sub-processors</a>
        {COMPLIANCE_BADGES.map(({ product, status, href }) => (
          <a href={href}>{product === 'soc2' ? 'SOC 2 Type II' : status === 'ready' ? 'HIPAA-Ready' : 'HIPAA Compliant'}</a>
        ))}
      </nav>
      <div class="ft-social">
        <a href="https://twitter.com/tangle_network" target="_blank" rel="noopener noreferrer" aria-label="Tangle on X">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://github.com/tangle-network" target="_blank" rel="noopener noreferrer" aria-label="Tangle on GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.15c0 .3.21.66.8.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .ft {
    background: var(--md3-surface-container-lowest);
    border-top: 1px solid var(--border-subtle);
  }
  .ft-inner {
    max-width: 75rem;
    margin-inline: auto;
    padding: clamp(3rem, 7vw, 6rem) 2rem 1.5rem;
  }
  .ft-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 2rem;
  }
  .ft-lockup, .ft-col, .ft-social { display: flex; }
  .ft-lockup {
    align-items: center;
    gap: .65rem;
    width: fit-content;
    color: var(--text-primary);
    font: 600 1.55rem / 1.2 var(--font-display);
    letter-spacing: -.02em;
    text-decoration: none;
  }
  .ft-tagline { margin: 1rem 0 .5rem; color: var(--text-secondary); }
  .ft-tagline, .ft-mail, .ft-link { font-size: 1rem; line-height: 1.5; }
  .ft-mail, .ft-link, .ft-legal a { color: var(--text-secondary); text-decoration: none; }
  .ft-col { flex-direction: column; align-items: flex-start; }
  .ft-label { color: var(--text-primary); font-weight: 600; margin-bottom: .55rem; }
  .ft-link, .ft-mail { display: inline-block; padding-block: .3rem; }
  .ft a:hover {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: .22em;
  }
  .ft a:focus-visible { outline: 2px solid var(--color-brand-glow); outline-offset: 3px; }
  .ft-legal {
    margin-top: clamp(2rem, 5vw, 4rem);
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: .5rem 2rem;
    font-size: .9375rem;
    line-height: 1.4;
    color: var(--text-muted);
  }
  .ft-legal-links { display: flex; flex-wrap: wrap; gap: 0 1.25rem; }
  .ft-legal-links a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .ft-social a { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; }

  @media (max-width: 760px) {
    .ft-inner { padding-inline: 1.25rem; }
    .ft-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
    .ft-brand { grid-column: 1 / -1; }
    .ft-col:last-child { grid-column: 2; grid-row: 2 / span 2; }
    .ft-label { margin-bottom: .25rem; }
    .ft-link { padding-block: .55rem; }
    .ft-legal { grid-template-columns: 1fr auto; }
    .ft-legal-links { grid-column: 1 / -1; grid-row: 1; column-gap: 1rem; }
  }
</style>
