---
// A verified example from src/examples, shown byte for byte in a post. `pnpm check:examples` typechecks the file
// against the published packages and `pnpm check:runs` proves it ran on production from these exact bytes.
import { createHash } from 'node:crypto';
import { Code } from 'astro:components';

interface Props { path: string; title?: string }
const { path, title } = Astro.props;
const files = import.meta.glob<string>('../examples/*/*.mts', { query: '?raw', import: 'default', eager: true });
const records = import.meta.glob<{ source: { sha256: string }; run: { id: string; recordedAt: string; exitCode: number; costUsd: number | null; sdk: Record<string, string> } }>('../data/runs/*/*.json', { import: 'default', eager: true });
const code = files[`../examples/${path}.mts`];
if (!code) throw new Error(`<Example path="${path}">: src/examples/${path}.mts does not exist`);
const record = records[`../data/runs/${path}.json`];
const run = record && record.source.sha256 === createHash('sha256').update(code).digest('hex') ? record.run : undefined;
const sdk = run?.sdk['@tangle-network/sandbox'];
const cost = run?.costUsd == null ? null : `$${run.costUsd.toFixed(run.costUsd < 1 ? 4 : 2)}`;
---
<figure class="example">
  <figcaption>
    <span class="example-title">{title ?? `src/examples/${path}.mts`}</span>
    {run
      ? <span class="example-proof">Ran on production {run.recordedAt.slice(0, 10)} from these bytes, exit {run.exitCode}{cost ? `, ${cost} of model usage` : ''}, @tangle-network/sandbox {sdk}. <a href="/#quickstart-title">Replay it</a>.</span>
      : <span class="example-proof">Typechecked against the published packages.</span>}
  </figcaption>
  <Code code={code.trimEnd()} lang="ts" theme="github-dark" />
</figure>

<style>
  .example { margin: 1.5em 0; }
  .example figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.3rem 1rem; margin-bottom: 0.5rem; font-size: 0.85rem; line-height: 1.45; color: var(--text-muted); }
  .example-title { font-family: var(--font-mono); color: var(--text-secondary); }
  .example-proof a { color: var(--accent-text); }
  .example :global(pre) { margin: 0; }
</style>
