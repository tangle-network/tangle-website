---
import CompanyExamples from './CompanyExamples';
import { initialExample, subjects } from '../data/examples';
---

<section id="quickstart" class="quickstart" data-theme="website" aria-labelledby="quickstart-title">
  <div class="quickstart-inner">
    <header class="quickstart-heading">
      <div>
        <h2 id="quickstart-title">Give each agent its own machine.</h2>
        <p>Run commands, edit files and inspect the changes alongside each step your agent took.</p>
        <a class="quickstart-link" href="https://docs.tangle.tools/sandbox/sdk-typescript">SDK reference <span aria-hidden="true">↗</span></a>
      </div>
      <a class="press-link" href="/films/carbon-copy/" aria-label="Watch Carbon copy, a 13-second film">
        <img class="quickstart-press" src="/images/branch-press-660.webp"
        srcset="/images/branch-press-660.webp 660w, /images/branch-press-1320.webp 1320w"
        sizes="(max-width: 680px) calc(100vw - 32px), (max-width: 1440px) 42vw, 600px"
        width="1320" height="880" loading="lazy" decoding="async"
        alt="A cutaway indigo press uses brass gears to split one punched tape into two." />
        <span class="press-play" aria-hidden="true">▶︎</span>
      </a>
    </header>
    <CompanyExamples client:load subjects={subjects} initial={initialExample} />
  </div>
</section>

<style>
  .quickstart { display: flex; flex-direction: column; background: color-mix(in srgb, var(--bg-card) 94%, hsl(var(--warning))); border-block-start: 1px solid var(--border-accent); color: var(--text-primary); padding: clamp(3rem, 6vw, 6rem) 0 clamp(4rem, 8vw, 7.5rem); }
  .quickstart-inner { display: flex; flex-direction: column; flex: 1; min-height: 0; width: min(88rem, 94vw); margin: 0 auto; }
  .quickstart-inner > :global(astro-island) { display: contents; }
  .quickstart-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .86fr); align-items: center; gap: clamp(2rem, 6vw, 6rem); margin-bottom: clamp(2rem, 4vw, 4rem); }
  .quickstart h2 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 3.2vw, 3rem); font-weight: 600; line-height: 1; letter-spacing: -0.032em; color: var(--text-primary); text-wrap: balance; }
  .quickstart-heading p { max-width: 44rem; margin: 20px 0 0; color: var(--text-secondary); font-size: var(--font-size-lg); line-height: 1.6; text-wrap: pretty; }
  .press-link { position: relative; display: block; width: 100%; max-width: 37.5rem; justify-self: end; }
  .press-link:focus-visible { outline: 3px solid var(--accent-text); outline-offset: 4px; }
  .quickstart-press { display: block; width: 100%; height: auto; mix-blend-mode: multiply; }
  .press-play { position: absolute; inset: auto 1rem 1rem auto; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; border-radius: 50%; color: var(--bg-card); background: var(--text-primary); border: 2px solid var(--bg-card); }
  .press-link:is(:hover, :focus-visible) .press-play { background: var(--accent-text); }
  .quickstart-link { display: inline-block; margin-top: 1.15rem; color: var(--accent-text); font-size: var(--font-size-lg); line-height: 1.5rem; white-space: nowrap; text-underline-offset: 0.25em; }
  .quickstart-link span { margin-left: 4px; }
  .quickstart-link:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 4px; }
  @media (max-width: 680px) {
    .quickstart { height: auto; min-height: 0; padding: 40px 0; }
    .quickstart-inner { width: calc(100vw - 32px); }
    .quickstart-heading { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; margin-bottom: 2rem; }
    .quickstart h2 { font-size: var(--font-size-4xl); line-height: 2.5rem; }
  }
</style>
