---
import QuickstartCode from './QuickstartCode';
---

<section class="quickstart" data-theme="website" aria-labelledby="quickstart-title">
  <div class="quickstart-inner">
    <header class="quickstart-heading">
      <div class="quickstart-copy">
        <h2 id="quickstart-title"><span>Create a sandbox.</span> <span>Run your code.</span></h2>
      </div>
      <div class="quickstart-links">
        <a href="https://docs.tangle.tools/sandbox/sdk-reference">SDK reference <span aria-hidden="true">↗</span></a>
        <a href="https://www.npmjs.com/package/@tangle-network/sandbox-cli">CLI <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <QuickstartCode client:visible />
  </div>
</section>

<style>
  /* The editor is the section: one viewport tall, the code at reading size. */
  .quickstart { display: flex; flex-direction: column; min-height: 100svh; background: var(--depth-1); color: var(--text-primary); padding: 3.5rem 0 3rem; }
  .quickstart-inner { display: flex; flex-direction: column; flex: 1; min-height: 0; width: min(88rem, 94vw); margin: 0 auto; }
  .quickstart-inner > :global(astro-island) { display: contents; }
  .quickstart-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.4rem; }
  .quickstart h2 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 3.2vw, 3rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.032em; color: var(--text-primary); }
  .quickstart h2 span { display: inline-block; }
  .quickstart-links { display: flex; flex-shrink: 0; gap: 1.5rem; padding-bottom: 0.4rem; }
  .quickstart-links a { color: var(--accent-text); font-size: 0.9375rem; white-space: nowrap; text-underline-offset: 0.25em; }
  .quickstart-links span { margin-left: 0.25rem; }
  .quickstart-links a:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 4px; }
  @media (max-width: 680px) {
    .quickstart { min-height: 0; padding: 2.5rem 0; }
    .quickstart-inner { width: 92vw; }
    .quickstart-heading { align-items: flex-start; flex-direction: column; gap: 0.8rem; margin-bottom: 1.25rem; }
    .quickstart-links { gap: 1.25rem; padding-bottom: 0; }
  }
</style>
