---
import { ExampleEditor } from '@tangle-network/ui/marketing';
import { initialExample, subjects } from '../data/examples';
---

<section id="quickstart" class="quickstart dark" data-theme="website" aria-labelledby="quickstart-title">
  <div class="quickstart-inner">
    <header class="quickstart-heading">
      <div>
        <h2 id="quickstart-title">Tangle gives each agent run its own machine.</h2>
        <p>Run commands, edit files and inspect the changes alongside each step your agent took.</p>
      </div>
      <div class="quickstart-links">
        <a href="https://docs.tangle.tools/sandbox/sdk-typescript">SDK reference <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <ExampleEditor client:visible subjects={subjects} initial={initialExample} />
  </div>
</section>

<style>
  .quickstart { display: flex; flex-direction: column; background: radial-gradient(64rem 28rem at 50% 12rem, color-mix(in srgb, var(--brand-cool) 16%, transparent), transparent 72%), var(--depth-1); color: var(--text-primary); padding: 112px 0 120px; }
  .quickstart-inner { display: flex; flex-direction: column; flex: 1; min-height: 0; width: min(88rem, 94vw); margin: 0 auto; }
  .quickstart-inner > :global(astro-island) { display: contents; }
  .quickstart-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 32px; }
  .quickstart h2 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 3.2vw, 3rem); font-weight: 600; line-height: 1; letter-spacing: -0.032em; color: var(--text-primary); text-wrap: balance; }
  .quickstart-heading p { max-width: 44rem; margin: 20px 0 0; color: var(--text-secondary); font-size: var(--font-size-lg); line-height: 1.6; text-wrap: pretty; }
  .quickstart-links { display: flex; flex-shrink: 0; gap: 24px; padding-bottom: 4px; }
  .quickstart-links a { color: var(--accent-text); font-size: var(--font-size-lg); line-height: 1.5rem; white-space: nowrap; text-underline-offset: 0.25em; }
  .quickstart-links span { margin-left: 4px; }
  .quickstart-links a:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 4px; }
  @media (max-width: 680px) {
    .quickstart { height: auto; min-height: 0; padding: 40px 0; }
    .quickstart-inner { width: calc(100vw - 32px); }
    .quickstart-heading { align-items: flex-start; flex-direction: column; gap: 12px; margin-bottom: 24px; }
    .quickstart h2 { font-size: var(--font-size-4xl); line-height: 2.5rem; }
    .quickstart-links { flex-wrap: wrap; max-width: 100%; gap: 12px 24px; padding-bottom: 0; }
  }
  .quickstart :global(.qs-editor) {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    --qs-line: var(--border-default);
    --qs-muted: var(--text-secondary);
    --qs-dim: var(--text-muted);
  }
  .quickstart :global(.qs-nav) {
    max-height: none;
    border: 0;
    border-right: 1px solid var(--border-default);
    background: var(--md3-surface-container);
  }
  .quickstart :global(.qs-nav + div) { min-width: 0; }
  .quickstart :global(.qs-source) { background: var(--md3-surface-container-lowest); }
  .quickstart :global(.qs-machine), .quickstart :global(.qs-actions) { background: var(--md3-surface-container-high); }
  .quickstart :global(.qs-receipt) { background: var(--md3-surface-container); }
  .quickstart :global(.qs-code pre) { overflow-x: auto !important; }
  .quickstart :global(.qs-code pre > code > span) { overflow: visible; }
  .quickstart :global(.qs-code pre > code) { display: block; width: max-content; min-width: 100%; }
  @media (min-width: 861px) {
    .quickstart :global(.qs-editor) { --qs-code-size: var(--font-size-sm); }
    .quickstart :global(.qs-panes) { height: clamp(29rem, 54vh, 40rem); }
  }
  @media (max-width: 860px) {
    .quickstart :global(.qs-editor) { grid-template-columns: minmax(0, 1fr); }
    .quickstart :global(.qs-nav) {
      display: grid;
      grid-auto-flow: column;
      grid-template-rows: auto auto;
      grid-auto-columns: max-content;
      padding: 0 var(--font-size-xs);
      border-right: 0;
      border-bottom: 1px solid var(--border-default);
    }
    .quickstart :global(.qs-nav button) { min-height: var(--control-height-lg); white-space: nowrap; }
    .quickstart :global(.qs-group) { grid-row: 1; }
    .quickstart :global(.qs-rows) {
      grid-row: 2;
      grid-column: 1 / span 12;
      position: sticky;
      left: var(--font-size-xs);
      width: calc(100cqw - 2 * var(--font-size-xs));
      overflow-x: auto;
    }
    .quickstart :global(.qs-list) { flex-direction: row; width: max-content; margin: 0; border: 0; }
    .quickstart :global(.qs-list span) { display: none; }
    .quickstart :global(.qs-panes) { height: auto; grid-template-columns: minmax(0, 1fr); }
    .quickstart :global(.qs-source) { order: 0; height: 21rem; border-right: 0; border-bottom: 1px solid var(--border-default); }
    .quickstart :global(.qs-machine) { order: 1; height: 22rem; }
    .quickstart :global(.qs-actions > button[title="Copy file"]),
    .quickstart :global(.qs-actions > button[title="Copied"]) { display: inline-flex; }
  }
</style>
