---
import { ExampleEditor, Section } from '@tangle-network/ui/marketing';
import { featuredExamples, subjects } from '../data/examples';
---
<Section id="quickstart" heading="Each agent gets its own Linux machine." sub="Coding agents run commands and edit files. On Tangle they do it on a Linux machine made for that run, and you get the changes back with a record of each step." glow link={{ label: 'SDK reference ↗', href: 'https://docs.tangle.tools/sandbox/sdk-typescript' }}>
  <ExampleEditor client:visible subjects={subjects} initial="sandboxes/browser-task" featured={featuredExamples} />
</Section>
