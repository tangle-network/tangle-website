---
import { ExampleEditor } from '@tangle-network/ui/marketing';
import '@tangle-network/ui/styles/marketing.css';
import { featuredExamples, subjects } from '../data/examples';
---

<section class="quickstart dark" data-theme="website" aria-labelledby="quickstart-title">
  <div class="quickstart-inner">
    <header class="quickstart-heading">
      <div>
        <h2 id="quickstart-title">Tangle gives each agent run its own machine.</h2>
        <p>Coding agents run commands and edit files. On Tangle they do it on a Linux machine made for that run, and you get the changes back with a record of each step.</p>
      </div>
      <div class="quickstart-links">
        <a href="https://docs.tangle.tools/sandbox/sdk-typescript">SDK reference <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <ExampleEditor client:visible subjects={subjects} initial="sandboxes/browser-task" featured={featuredExamples} />
  </div>
</section>

<style>
  .quickstart { display: flex; flex-direction: column; background: radial-gradient(64rem 28rem at 50% 12rem, color-mix(in srgb, var(--brand-cool) 16%, transparent), transparent 72%), var(--depth-1); color: var(--text-primary); padding: 120px 0; }
  .quickstart-inner { display: flex; flex-direction: column; flex: 1; min-height: 0; width: min(75rem, calc(100% - 48px)); margin: 0 auto; }
  .quickstart-inner > :global(astro-island) { display: contents; }
  .quickstart-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 40px; }
  .quickstart h2 { margin: 0; font-family: var(--font-display); font-size: clamp(1.875rem, 1.1rem + 2.3vw, 2.875rem); font-weight: 600; line-height: 1.06; max-width: 22ch; letter-spacing: -0.032em; color: var(--text-primary); text-wrap: balance; }
  .quickstart-heading p { max-width: 41rem; margin: 20px 0 0; color: var(--text-secondary); font-size: calc(var(--font-size-base) * 1.1875); line-height: 1.55; text-wrap: pretty; }
  .quickstart-links { display: flex; flex-shrink: 0; gap: 24px; padding-bottom: 4px; }
  .quickstart-links a { color: var(--accent-text); font-size: var(--font-size-lg); line-height: 1.5rem; white-space: nowrap; text-underline-offset: 0.25em; }
  .quickstart-links span { margin-left: 4px; }
  .quickstart-links a:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 4px; }
  @media (max-width: 680px) {
    .quickstart { height: auto; min-height: 0; padding: 72px 0; }
    .quickstart-inner { width: calc(100vw - 40px); }
    .quickstart-heading { align-items: flex-start; flex-direction: column; gap: 12px; margin-bottom: 24px; }
    .quickstart h2 { font-size: var(--font-size-3xl); line-height: 1.12; }
    .quickstart-heading p { font-size: calc(var(--font-size-base) * 1.0625); margin-top: 14px; }
    .quickstart-links { flex-wrap: wrap; max-width: 100%; gap: 12px 24px; padding-bottom: 0; }
  }
</style>
