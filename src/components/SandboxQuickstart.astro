---
import CompanyExamples from './CompanyExamples';
import { initialExample, subjects } from '../data/examples';
---

<section id="quickstart" class="quickstart" data-theme="website" aria-labelledby="quickstart-title">
  <div class="quickstart-inner">
    <header class="quickstart-heading">
      <h2 id="quickstart-title">Give each agent its own machine.</h2>
      <div>
        <p>Run commands, edit files and inspect the changes alongside each step your agent took.</p>
        <a class="quickstart-link" href="https://docs.tangle.tools/sandbox/sdk-typescript">SDK reference <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <CompanyExamples client:load subjects={subjects} initial={initialExample} />
  </div>
</section>

<style>
  .quickstart { display: flex; flex-direction: column; background: color-mix(in srgb, var(--bg-card) 94%, hsl(var(--warning))); border-block-start: 1px solid var(--border-accent); color: var(--text-primary); padding: clamp(2.5rem, 4vw, 4rem) 0 clamp(4rem, 6vw, 6rem); }
  .quickstart-inner { display: flex; flex-direction: column; flex: 1; min-height: 0; }
  .quickstart-inner > :global(astro-island) { display: contents; }
  .quickstart-heading { display: grid; grid-template-columns: 1.2fr 1fr; align-items: end; gap: clamp(2rem, 5vw, 5rem); margin-bottom: clamp(1.5rem, 2.5vw, 2.5rem); }
  .quickstart h2 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 3.2vw, 3rem); font-weight: 600; line-height: 1; letter-spacing: -0.032em; color: var(--text-primary); text-wrap: balance; }
  .quickstart-heading p { max-width: 40rem; margin: 0; color: var(--text-secondary); font-size: var(--font-size-lg); line-height: 1.6; text-wrap: pretty; }
  .quickstart-link { display: inline-block; margin-top: .5rem; color: var(--accent-text); font-size: var(--font-size-lg); line-height: 1.5rem; white-space: nowrap; text-underline-offset: 0.25em; }
  .quickstart-link span { margin-left: 4px; }
  .quickstart-link:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 4px; }
  @media (max-width: 680px) {
    .quickstart { height: auto; min-height: 0; padding: 40px 0; }
    .quickstart-heading { grid-template-columns: minmax(0, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
    .quickstart h2 { font-size: var(--font-size-4xl); line-height: 2.5rem; }
  }
</style>
