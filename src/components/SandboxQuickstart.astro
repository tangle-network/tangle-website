---
import { createHash } from 'node:crypto';
import QuickstartCode, { type Subject } from './QuickstartCode';

// Each cell shows one file from src/examples byte for byte; `pnpm check:examples`
// typechecks every file against the published packages.
const files = import.meta.glob<string>('../examples/*/*.mts', { query: '?raw', import: 'default', eager: true });
// Each file's recorded production run (scripts/record-examples.mts). A file whose record is missing or was
// recorded from other bytes gets no Play button; `pnpm check:runs` fails the gate for both.
const records = import.meta.glob<{ source: { sha256: string }; run: { id: string; recordedAt: string; costUsd: number | null; sdk: Record<string, string> } }>(
  '../data/runs/*/*.json', { import: 'default', eager: true });
const recordUrls = import.meta.glob<string>('../data/runs/*/*.json', { query: '?url&no-inline', import: 'default', eager: true });
const recorded = (path: string, code: string) => {
  const record = records[path];
  if (record?.source.sha256 !== createHash('sha256').update(code).digest('hex')) return undefined;
  const { id, recordedAt, costUsd, sdk } = record.run;
  return { url: recordUrls[path], recordedAt, runId: id, sha: record.source.sha256, sdk: sdk['@tangle-network/sandbox'], costUsd };
};
const SANDBOX = 'npm install @tangle-network/sandbox';
const RUNTIME = 'npm install @tangle-network/agent-runtime';
// [file, title, summary, install when it differs from the subject's]
const grid: [string, string, string, [string, string, string, string?][]][] = [
  ['sandboxes', 'Sandboxes', SANDBOX, [
    ['run-code', 'Run code', 'Create a sandbox, run a command, print its output, delete it.'],
    ['fix-a-test', 'Fix a failing test', 'Clone a repo, have an agent fix a failing test, rerun the suite.'],
    ['browser-task', 'Browser task', 'Run a headless browser in the sandbox and save what it reads.'],
    ['worker', 'Long running worker', 'Start a long job, disconnect, read its output when it finishes.'],
  ]],
  ['evals', 'Evals', `${SANDBOX} @tangle-network/agent-eval`, [
    ['score-a-trace', 'Score a trace', 'Score an agent’s answer and its tool calls with a model judge.'],
    ['compare-models', 'Compare two models', 'Run the same eval cases on two models and compare scores.'],
    ['regression-gate', 'Regression gate', 'Fail CI when a new prompt scores below the current one.'],
  ]],
  ['products', 'Products', SANDBOX, [
    ['legal-agent', 'Legal agent', 'Give each customer their own persistent sandbox.'],
    ['gtm-agent', 'GTM agent', 'Call a hosted agent. The Platform picks where it runs.'],
    ['worker-loop', 'Worker loop', 'Run your own agent loop with the sandbox as its tools.'],
  ]],
  ['fleets', 'Fleets', SANDBOX, [
    ['under-a-budget', 'Spawn under one budget', 'Run four agents on four tasks under one spending cap.'],
    ['fan-out', 'Fan out and collect', 'Start one agent per package and collect each result as it finishes.'],
    ['cancel-on-cap', 'Cancel on a cap', 'Cancel every agent in the fleet when spend reaches $1.'],
  ]],
  // Each agent-runtime adapter is published to npm. Only Tangle takes the harness from the profile; the others run the command you give them.
  ['runtime', 'Any cloud', `${SANDBOX} @tangle-network/agent-runtime @tangle-network/agent-provider-tangle`, [
    ['any-cloud', 'Tangle', 'Run the harness the profile names, claude-code here, on Tangle.'],
    ['any-cloud-e2b', 'E2B', 'Run a command you supply, claude -p here, in an E2B sandbox. Reads E2B_API_KEY.', `${RUNTIME} @tangle-network/agent-provider-e2b e2b`],
    ['any-cloud-daytona', 'Daytona', 'Run a command you supply, claude -p here, in a Daytona sandbox. Reads DAYTONA_API_KEY.', `${RUNTIME} @tangle-network/agent-provider-daytona @daytonaio/sdk`],
    ['any-cloud-computesdk', 'ComputeSDK', 'Run a command you supply, claude -p here, on the cloud ComputeSDK is set to, E2B here. Reads E2B_API_KEY.', `${RUNTIME} @tangle-network/agent-provider-computesdk computesdk @computesdk/e2b`],
  ]],
];
const subjects: Subject[] = grid.map(([id, label, install, ideas]) => ({
  id, label, install,
  ideas: ideas.map(([file, title, summary, own]) => {
    const code = files[`../examples/${id}/${file}.mts`];
    if (!code) throw new Error(`src/examples/${id}/${file}.mts is missing`);
    return { id: file, title, summary, code, install: own, run: recorded(`../data/runs/${id}/${file}.json`, code) };
  }),
}));
---

<section class="quickstart" data-theme="website" aria-labelledby="quickstart-title">
  <div class="quickstart-inner">
    <header class="quickstart-heading">
      <h2 id="quickstart-title"><span>Sandboxes, evals, products and fleets.</span> <span>One SDK.</span></h2>
      <div class="quickstart-links">
        <a href="https://docs.tangle.tools/sandbox/sdk-reference">SDK reference <span aria-hidden="true">↗</span></a>
        <a href="https://www.npmjs.com/package/@tangle-network/sandbox-cli">CLI <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <QuickstartCode client:visible subjects={subjects} />
  </div>
</section>

<style>
  /* The editor is the section: one viewport tall, the code at reading size. */
  .quickstart { display: flex; flex-direction: column; height: 100svh; min-height: 44rem; background: var(--depth-1); color: var(--text-primary); padding: 48px 0 40px; }
  .quickstart-inner { display: flex; flex-direction: column; flex: 1; min-height: 0; width: min(88rem, 94vw); margin: 0 auto; }
  .quickstart-inner > :global(astro-island) { display: contents; }
  .quickstart-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  .quickstart h2 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 3.2vw, 3rem); font-weight: 600; line-height: 1; letter-spacing: -0.032em; color: var(--text-primary); text-wrap: balance; }
  .quickstart h2 span { display: inline-block; }
  .quickstart-links { display: flex; flex-shrink: 0; gap: 24px; padding-bottom: 4px; }
  .quickstart-links a { color: var(--accent-text); font-size: var(--font-size-lg); line-height: 1.5rem; white-space: nowrap; text-underline-offset: 0.25em; }
  .quickstart-links span { margin-left: 4px; }
  .quickstart-links a:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 4px; }
  @media (max-width: 680px) {
    .quickstart { height: auto; min-height: 0; padding: 40px 0; }
    .quickstart-inner { width: calc(100vw - 32px); }
    .quickstart-heading { align-items: flex-start; flex-direction: column; gap: 12px; margin-bottom: 24px; }
    .quickstart h2 { font-size: var(--font-size-4xl); line-height: 2.5rem; }
    .quickstart-links { gap: 24px; padding-bottom: 0; }
  }
</style>
