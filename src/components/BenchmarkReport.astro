---
// The benchmark report layout: one 720 px column for prose and figures, with a
// numbered contents list beside it on wide screens and in a disclosure on
// narrow ones. Figures come from @tangle-network/charts; its figure.css maps
// every mark to a --chart-* token, and this layout uses brand tokens only, so
// the page follows the brand theme in dark and light.
import '@tangle-network/charts/figure.css';

export interface ContentsEntry {
  id: string;
  label: string;
  number?: string;
  items?: Array<{ id: string; label: string }>;
}

interface Props {
  contents?: ContentsEntry[];
}

const { contents } = Astro.props;
---

<div class="bench">
  <div class="bench-grid">
    {contents && (
      <nav class="bench-toc" aria-label="Contents">
        <ol>
          {contents.map((entry) => (
            <li>
              <a class="bench-toc-link" href={`#${entry.id}`}>
                {entry.number && <span class="bench-num">{entry.number}</span>}
                {entry.label}
              </a>
              {entry.items && (
                <ol>
                  {entry.items.map((item) => (
                    <li><a class="bench-toc-link" href={`#${item.id}`}>{item.label}</a></li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <div class="bench-column">
      <slot name="hero" />
      {contents && (
        <details class="bench-toc-inline">
          <summary>Contents</summary>
          <ol>
            {contents.map((entry) => (
              <li>
                <a class="bench-toc-link" href={`#${entry.id}`}>
                  {entry.number && <span class="bench-num">{entry.number}</span>}
                  {entry.label}
                </a>
              </li>
            ))}
          </ol>
        </details>
      )}
      <slot />
    </div>
  </div>
</div>

<style is:global>
  .bench {
    background: var(--depth-1);
    color: var(--text-primary);
    font-family: var(--font-sans);
  }
  .bench-grid {
    padding: 64px 16px 96px;
  }
  .bench-column {
    max-width: 720px;
    margin: 0 auto;
    min-width: 0;
  }
  @media (min-width: 1080px) {
    .bench-grid {
      display: grid;
      grid-template-columns: 1fr 720px 1fr;
      column-gap: 40px;
    }
    .bench-column {
      grid-column: 2;
      margin: 0;
    }
  }

  /* Contents */
  .bench-toc {
    display: none;
  }
  @media (min-width: 1080px) {
    .bench-toc {
      display: block;
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
      align-self: start;
      position: sticky;
      top: 112px;
      width: 176px;
      margin-top: 8px;
    }
  }
  .bench-toc ol,
  .bench-toc-inline ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bench-toc > ol > li + li {
    margin-top: 12px;
  }
  .bench-toc ol ol {
    margin-top: 6px;
    padding-left: 28px;
  }
  .bench-toc ol ol li + li {
    margin-top: 4px;
  }
  .bench-toc a,
  .bench-toc-inline a {
    color: var(--text-dim);
    font-size: 12px;
    line-height: 16px;
    text-decoration: none;
  }
  .bench-toc > ol > li > a,
  .bench-toc-inline a {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 20px;
  }
  .bench-toc a:hover,
  .bench-toc-inline a:hover {
    color: var(--text-primary);
  }
  .bench-toc-inline {
    margin: 32px 0 0;
    border-top: 1px solid var(--chart-rule);
    padding: 12px 0 0;
    font-size: 14px;
    line-height: 20px;
  }
  .bench-toc-inline > summary {
    cursor: pointer;
    color: var(--text-secondary);
  }
  .bench-toc-inline[open] > summary {
    margin-bottom: 12px;
  }
  .bench-toc-inline li + li {
    margin-top: 8px;
  }
  @media (min-width: 1080px) {
    .bench-toc-inline {
      display: none;
    }
  }
  .bench-num {
    display: inline-block;
    min-width: 28px;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    color: var(--chart-ink-muted);
  }

  /* Hero */
  .bench-h1 {
    margin: 0;
    font-size: clamp(2.25rem, 2vw + 1.5rem, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--text-primary);
  }
  .bench-lede {
    margin: 24px 0 0;
    font-size: 18px;
    line-height: 28px;
    color: var(--text-secondary);
  }
  .bench-status {
    margin: 16px 0 0;
    font-size: 16px;
    line-height: 26px;
    color: var(--text-primary);
  }
  .bench-meta {
    margin: 16px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    font-variant-numeric: tabular-nums;
    color: var(--text-dim);
  }
  .bench-back {
    display: inline-block;
    margin-bottom: 24px;
    font-size: 14px;
    line-height: 20px;
    color: var(--accent-text);
    text-decoration: none;
  }
  .bench-back:hover {
    text-decoration: underline;
  }

  /* Sections */
  .bench-section {
    padding-top: 40px;
    margin-top: 40px;
    border-top: 1px solid var(--chart-rule);
    scroll-margin-top: 88px;
  }
  .bench-section [id] {
    scroll-margin-top: 88px;
  }
  .bench-h2 .bench-num {
    min-width: 0;
    margin-right: 12px;
  }
  .bench-h2 {
    margin: 0;
    font-size: 24px;
    line-height: 32px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .bench-h3 {
    margin: 32px 0 0;
    font-size: 16px;
    line-height: 24px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .bench-section > .bench-h2 + * {
    margin-top: 24px;
  }
  .bench-section > .bench-h2 + .tgc-figure {
    margin-top: 24px;
  }
  .bench-prose {
    margin: 16px 0 0;
    font-size: 16px;
    line-height: 26px;
    color: var(--text-secondary);
  }
  .bench-small {
    margin: 16px 0 0;
    font-size: 14px;
    line-height: 22px;
    color: var(--text-secondary);
  }
  .bench a:not([class]) {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .bench a:not([class]):hover {
    color: var(--text-primary);
  }
  .bench code,
  .bench .bench-mono {
    font-family: var(--font-mono);
    font-size: 0.875em;
    font-variant-numeric: tabular-nums;
  }

  /* The standard: a numbered list with hairlines, never a card grid. */
  .bench-steps {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }
  .bench-steps > li {
    display: grid;
    grid-template-columns: 40px 1fr;
    padding: 16px 0;
    border-top: 1px solid var(--chart-rule);
  }
  .bench-steps .bench-num {
    padding-top: 2px;
    font-size: 14px;
    line-height: 22px;
  }
  .bench-steps h3 {
    margin: 0;
    font-size: 16px;
    line-height: 24px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .bench-steps p {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 22px;
    color: var(--text-secondary);
  }

  /* Tables outside figures use the figure table's hairline style. */
  .bench-table {
    margin-top: 16px;
    overflow-x: auto;
  }
  .bench-table .tgc-table caption {
    font-size: 12px;
  }
  .bench-table .tgc-table a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .bench-table .tgc-table a:hover {
    color: var(--accent-text);
  }
  .bench-rate {
    min-width: 178px;
    text-align: right;
  }
  .bench-rate-detail {
    display: block;
    color: var(--text-secondary);
    font-size: 12px;
    line-height: 18px;
    font-weight: 400;
  }
  .bench-board-list {
    display: none;
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }
  .bench-board-list li {
    border-top: 1px solid var(--chart-rule);
    padding: 16px 0;
  }
  .bench-board-list li:last-child {
    border-bottom: 1px solid var(--chart-rule);
  }
  .bench-board-list li > a {
    color: var(--text-primary);
    font-size: 16px;
    line-height: 24px;
    font-weight: 600;
  }
  .bench-board-list p {
    margin: 4px 0 0;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 20px;
  }
  .bench-board-list .bench-board-value {
    margin-top: 12px;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 18px;
    line-height: 24px;
    font-weight: 600;
  }
  .bench-board-list .bench-board-interval {
    margin-top: 8px;
    font-size: 13px;
    line-height: 20px;
  }
  .bench-board-list .bench-board-meta {
    font-size: 12px;
    line-height: 18px;
  }
  @media (max-width: 600px) {
    .bench-board-desktop {
      display: none;
    }
    .bench-board-list {
      display: block;
    }
  }
  .bench-digest {
    word-break: break-all;
  }

  /* Disclosures in Reproduce */
  .bench-details {
    margin-top: 12px;
    border-top: 1px solid var(--chart-rule);
    padding-top: 12px;
    font-size: 14px;
    line-height: 22px;
  }
  .bench-details > summary {
    cursor: pointer;
    color: var(--text-primary);
  }
  .bench-details pre {
    margin: 12px 0 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--text-secondary);
  }
  .bench-details ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--text-secondary);
  }

  /* Preview banner: states what the page is not. */
  .bench-banner {
    margin: 0 0 32px;
    padding: 12px 16px;
    border: 1px solid var(--border-accent);
    background: var(--accent-surface-soft);
    font-size: 14px;
    line-height: 22px;
    color: var(--text-primary);
  }

  .bench-notes {
    margin-top: 0;
  }
</style>
