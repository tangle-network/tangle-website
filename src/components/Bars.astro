---
// A measured table: one row per label, the value drawn as a bar, a whisker as a tick or an interval as a band, every number printed.
// Bars share one scale: the table's largest value or whisker for durations, 100% for rates.
import { seconds, type Row } from '../data/benchmarks/sandbox';
interface Props { rows: Row[]; caption: string; unit?: 'ms' | 'rate'; whisker?: string; count?: string }
const { rows, caption, unit = 'ms', whisker = 'p95', count = 'n' } = Astro.props;
const max = unit === 'rate' ? 1 : Math.max(...rows.map((r) => Math.max(r.value, r.whisker ?? 0)));
const pct = (x: number) => `${((x / max) * 100).toFixed(1)}%`;
const text = (x: number) => (unit === 'rate' ? `${(x * 100).toFixed(x > 0 && x < 0.095 ? 1 : 0)}%` : seconds(x));
const interval = rows.some((r) => r.low != null);
---
<table class="bars">
  <caption>{caption}</caption>
  <thead><tr><th scope="col">measure</th><th scope="col" class="bars-plot">{unit === 'rate' ? '0% to 100%' : <><span>p50</span><span class="bars-tick-key" aria-hidden="true"></span><span>{whisker}</span></>}</th><th scope="col" class="num">{unit === 'rate' ? 'rate' : 'p50'}</th>{(interval || unit === 'ms') && <th scope="col" class="num">{interval ? 'interval' : whisker}</th>}<th scope="col" class="num">{count}</th></tr></thead>
  <tbody>
    {rows.map((r) => (
      <tr class:list={[{ flagged: r.flagged }]} title={r.note}>
        <th scope="row">{r.label}{r.flagged && <span class="flag" title="a record in this row failed a check"> ✱</span>}</th>
        <td class="bars-plot"><span class="fill" style={`width: ${pct(r.value)}`}></span>{r.whisker != null && r.whisker > r.value && <span class="tick" style={`left: ${pct(r.whisker)}`}></span>}{r.low != null && r.high != null && <span class="band" style={`left: ${pct(r.low)}; width: ${pct(r.high - r.low)}`}></span>}</td>
        <td class="num">{text(r.value)}</td>
        {interval ? <td class="num">{r.low != null && r.high != null ? `${text(r.low)} to ${text(r.high)}` : '–'}</td> : unit === 'ms' && <td class="num">{r.whisker != null ? text(r.whisker) : '–'}</td>}
        <td class="num">{r.n ?? '–'}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .bars { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .bars caption { caption-side: top; text-align: left; padding: 0 0 0.6rem; color: var(--text-secondary); font-size: 0.9rem; line-height: 1.5; }
  .bars th, .bars td { padding: 0.45rem 0.6rem 0.45rem 0; vertical-align: middle; border-bottom: 1px solid var(--chart-rule); text-align: left; font-weight: 500; }
  .bars thead th { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.02em; border-bottom-color: var(--chart-ink-muted); }
  .bars tbody th { color: var(--text-primary); white-space: nowrap; width: 1%; padding-right: 1.2rem; }
  .bars .num { font-family: var(--font-mono); font-feature-settings: 'tnum'; text-align: right; white-space: nowrap; width: 1%; padding-left: 1rem; color: var(--text-primary); }
  .bars tbody .num:last-child { color: var(--text-muted); }
  .bars-plot { position: relative; width: 100%; min-width: 10rem; }
  .bars thead .bars-plot span { display: inline-block; margin-right: 0.5rem; }
  .bars-tick-key { width: 2px; height: 0.8em; vertical-align: -0.15em; background: var(--chart-ink); }
  .fill { display: block; height: 0.8rem; border-radius: 0 3px 3px 0; background: var(--chart-accent); }
  .tick { position: absolute; top: 50%; width: 2px; height: 1rem; margin-top: -0.5rem; background: var(--chart-ink); }
  .band { position: absolute; top: 50%; height: 0.25rem; margin-top: 0.55rem; border-radius: 2px; background: var(--chart-ink-muted); }
  .flagged .fill { background: var(--chart-muted); }
  .flag { color: var(--text-muted); font-size: 0.8em; }
  @media (max-width: 640px) { .bars tbody th { white-space: normal; } }
</style>
