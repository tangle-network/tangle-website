---
// A measured-latency table: one row per label, the p50 drawn as a bar, the p95 as a tick, every number printed.
// The bars share one scale so lengths compare within the table; the scale is the table's largest p95 (or p50).
import { seconds, type Row } from '../data/benchmarks/sandbox';
interface Props { rows: Row[]; caption: string; whisker?: string }
const { rows, caption, whisker = 'p95' } = Astro.props;
const max = Math.max(...rows.map((r) => Math.max(r.p50_ms, r.p95_ms ?? 0)));
const pct = (ms: number) => `${((ms / max) * 100).toFixed(1)}%`;
---
<table class="bars">
  <caption>{caption}</caption>
  <thead><tr><th scope="col">measure</th><th scope="col" class="bars-plot"><span>p50</span><span class="bars-tick-key" aria-hidden="true"></span><span>{whisker}</span></th><th scope="col" class="num">p50</th><th scope="col" class="num">{whisker}</th><th scope="col" class="num">n</th></tr></thead>
  <tbody>
    {rows.map((r) => (
      <tr class:list={[{ flagged: r.flagged }]} title={r.note}>
        <th scope="row">{r.label}{r.flagged && <span class="flag" title="a record in this row failed a check"> ✱</span>}</th>
        <td class="bars-plot"><span class="bar" style={`width: ${pct(r.p50_ms)}`}></span>{r.p95_ms != null && r.p95_ms > r.p50_ms && <span class="tick" style={`left: ${pct(r.p95_ms)}`}></span>}</td>
        <td class="num">{seconds(r.p50_ms)}</td>
        <td class="num">{r.p95_ms != null ? seconds(r.p95_ms) : '–'}</td>
        <td class="num">{r.n}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .bars { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .bars caption { caption-side: top; text-align: left; padding: 0 0 0.6rem; color: var(--text-secondary); font-size: 0.9rem; line-height: 1.5; }
  .bars th, .bars td { padding: 0.45rem 0.6rem 0.45rem 0; vertical-align: middle; border-bottom: 1px solid var(--chart-rule); text-align: left; font-weight: 500; }
  .bars thead th { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.02em; border-bottom-color: var(--chart-ink-muted); }
  .bars tbody th { color: var(--text-primary); white-space: nowrap; width: 1%; padding-right: 1.2rem; }
  .bars .num { font-family: var(--font-mono); font-feature-settings: 'tnum'; text-align: right; white-space: nowrap; width: 1%; padding-left: 1rem; color: var(--text-primary); }
  .bars tbody .num:last-child { color: var(--text-muted); }
  .bars-plot { position: relative; width: 100%; min-width: 10rem; }
  .bars thead .bars-plot { display: table-cell; }
  .bars thead .bars-plot span { display: inline-block; margin-right: 0.5rem; }
  .bars-tick-key { width: 2px; height: 0.8em; vertical-align: -0.15em; background: var(--chart-ink); }
  .bar { display: block; height: 0.8rem; border-radius: 0 3px 3px 0; background: var(--chart-accent); }
  .tick { position: absolute; top: 50%; width: 2px; height: 1rem; margin-top: -0.5rem; background: var(--chart-ink); }
  .flagged .bar { background: var(--chart-muted); }
  .flag { color: var(--text-muted); font-size: 0.8em; }
  @media (max-width: 640px) {
    .bars tbody th { white-space: normal; }
    .bars .num:nth-child(4), .bars thead th:nth-child(4) { display: none; }
  }
</style>
