---
interface Props {
  change: {
    url: string;
    title: string;
    file: string;
    additions: number;
    deletions: number;
    diff: string;
  };
  summary: string;
  summaryUrl: string;
}

const { change, summary, summaryUrl } = Astro.props;
const shareText = `${summary}\n\n${summaryUrl}`;
const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
const diffLines = change.diff.replace(/\r\n/g, '\n').split('\n');
if (diffLines.at(-1) === '') diffLines.pop();

const lineKind = (line: string) => {
  if (line.startsWith('@@')) return 'hunk';
  if (line.startsWith('+')) return 'addition';
  if (line.startsWith('-')) return 'deletion';
  return 'context';
};

let oldNumber: number | null = null;
let newNumber: number | null = null;
let inHunk = false;
const displayDiffLines = diffLines.flatMap((line) => {
  if (line.startsWith('diff ')) inHunk = false;
  if (!inHunk && /^(diff |index |--- |\+\+\+ )/.test(line)) return [];
  const kind = lineKind(line);
  if (kind === 'hunk') {
    inHunk = true;
    const range = /^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@/.exec(line);
    oldNumber = range ? Number(range[1]) : null;
    newNumber = range ? Number(range[2]) : null;
    return [{ text: line, kind, oldLine: null, newLine: null }];
  }
  const isCode = kind === 'addition' || kind === 'deletion' || line.startsWith(' ');
  const oldLine = isCode && kind !== 'addition' ? oldNumber : null;
  const newLine = isCode && kind !== 'deletion' ? newNumber : null;
  if (oldLine !== null) oldNumber = oldLine + 1;
  if (newLine !== null) newNumber = newLine + 1;
  return [{ text: line, kind, oldLine, newLine }];
});
---

<run-actions class="run-actions">
  <article class="action-card change-card" aria-label="GitHub file changes">
    <header class="change-header">
      <img src="/images/logos/github.svg" alt="" width="24" height="24" class="github-mark" loading="lazy" />
      <span>GitHub</span>
    </header>
    <div class="change-body">
      <h4><a href={change.url} target="_blank" rel="noopener noreferrer">{change.title}</a></h4>
      <div class="change-facts">
        <span class="change-counts">
          <span class="additions" aria-label={`${change.additions} lines added`}>+{change.additions}</span>
          <span class="deletions" aria-label={`${change.deletions} lines deleted`}>−{change.deletions}</span>
        </span>
      </div>
    </div>
    <details class="change-diff" open>
      <summary>
        <span>{change.file}</span>
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
      </summary>
      <div class="diff-scroll" tabindex="0" role="region" aria-label={`Changes to ${change.file}`}>
        <pre><code>{displayDiffLines.map((line) => <span class={`diff-line ${line.kind}`}><span class="line-number" aria-hidden="true">{line.oldLine ?? ''}</span><span class="line-number" aria-hidden="true">{line.newLine ?? ''}</span><span class="line-code">{line.text || ' '}</span></span>)}</code></pre>
      </div>
    </details>
    <footer class="change-footer">
      <a class="action-link github-link" href={change.url} target="_blank" rel="noopener noreferrer">
        View diff
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7" /></svg>
      </a>
    </footer>
  </article>

  <div class="share-cards">
    <article class="action-card slack-card" aria-label="Slack summary">
      <header class="share-header slack-header">
        <span class="slack-mark"><img src="/images/logos/slack.svg" alt="" width="22" height="22" loading="lazy" /></span>
        <h4>Slack</h4>
      </header>
      <div class="slack-message">
        <p>{summary}</p>
        <a class="summary-url" href={summaryUrl} target="_blank" rel="noopener noreferrer">View change</a>
      </div>
      <div class="slack-actions">
        <button type="button" class="action-link copy-summary" data-copy-summary hidden>
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5.25" y="5.25" width="8" height="8" rx="1.25" /><path d="M10.75 3.25v-.5A1 1 0 0 0 9.75 1.75h-7a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h.5" /></svg>
          <span data-copy-label>Copy summary</span>
        </button>
        <p class="copy-status" role="status" aria-live="polite" aria-atomic="true" data-copy-status></p>
      </div>
      <div class="copy-fallback" data-copy-fallback hidden>
        <label>Summary and link<textarea readonly rows="5" data-copy-text>{shareText}</textarea></label>
      </div>
    </article>

    <article class="action-card whatsapp-card" aria-label="Share summary on WhatsApp">
      <header class="share-header whatsapp-header">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.5 11.5a8.5 8.5 0 0 1-12.8 7.32L3 20l1.18-4.7A8.5 8.5 0 1 1 20.5 11.5Z" /><path d="M8.45 7.2c-.5 0-1.2.7-1.2 1.6 0 2.6 3.2 5.8 5.8 5.8.9 0 1.6-.7 1.6-1.2l-1.7-.9-.8.8c-1.2-.45-2.4-1.65-2.85-2.85l.8-.8-.9-1.7Z" fill="currentColor" stroke="none" /></svg>
        <h4>WhatsApp</h4>
      </header>
      <div class="whatsapp-message">
        <p>{summary}</p>
        <a class="summary-url" href={summaryUrl} target="_blank" rel="noopener noreferrer">View change</a>
      </div>
      <a class="action-link whatsapp-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
        Share on WhatsApp
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 8 10-5-3 10-2-5-5-2ZM8 8l5-5" /></svg>
      </a>
    </article>
  </div>
</run-actions>

<script>
  class RunActions extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('[data-copy-summary]');
      const text = this.querySelector<HTMLTextAreaElement>('[data-copy-text]');
      const label = this.querySelector<HTMLElement>('[data-copy-label]');
      const status = this.querySelector<HTMLElement>('[data-copy-status]');
      const fallback = this.querySelector<HTMLElement>('[data-copy-fallback]');
      if (!button || !text || !label || !status || !fallback || button.dataset.bound) return;
      button.dataset.bound = 'true';
      button.hidden = false;
      button.addEventListener('click', async () => {
        button.disabled = true;
        status.textContent = '';
        try {
          await navigator.clipboard.writeText(text.value);
          label.textContent = 'Copied';
          status.textContent = 'Summary and link copied.';
          fallback.hidden = true;
        } catch {
          label.textContent = 'Copy summary';
          status.textContent = 'Select and copy the text below.';
          fallback.hidden = false;
          text.focus();
          text.select();
        } finally {
          button.disabled = false;
        }
      });
    }
  }

  if (!customElements.get('run-actions')) customElements.define('run-actions', RunActions);
</script>

<style>
  .run-actions {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
    width: 100%;
    min-width: 0;
    color: #1f2328;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .run-actions [hidden] { display: none !important; }
  .run-actions ::selection { background: #dcd6ff; color: #242633; }
  .share-cards { display: grid; align-items: start; gap: 1rem; min-width: 0; }
  .action-card { min-width: 0; border: 1px solid #d1d9e0; border-radius: 12px; background: #fff; box-shadow: 0 3px 12px rgb(25 28 36 / 5%); }
  .change-card { overflow: hidden; }
  .change-header { display: flex; align-items: center; gap: 0.6rem; padding: 0.9rem 1.1rem; border-bottom: 1px solid #d1d9e0; background: #f6f8fa; font-weight: 600; }
  .github-mark { filter: brightness(0); flex: none; }
  .change-body { padding: 1.1rem; }
  .change-body h4 { margin: 0; font-size: 1.2rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.35; overflow-wrap: anywhere; }
  .change-body h4 a { color: #1f2328; text-decoration: none; }
  .change-body h4 a:hover { color: #0969da; text-decoration: underline; text-underline-offset: 3px; }
  .change-facts { display: flex; align-items: center; flex-wrap: wrap; gap: 0.8rem; margin-top: 1rem; }
  .change-counts { display: inline-flex; gap: 0.6rem; font-family: var(--font-mono, monospace); font-size: 0.875rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .additions { color: #116329; }
  .deletions { color: #a40e26; }
  .change-diff { border-top: 1px solid #d1d9e0; }
  .change-diff summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.8rem 1.1rem; background: #f6f8fa; cursor: pointer; list-style: none; font-weight: 600; }
  .change-diff summary::-webkit-details-marker { display: none; }
  .change-diff summary span { min-width: 0; overflow-wrap: anywhere; font-family: var(--font-mono, monospace); font-size: 0.875rem; }
  .change-diff summary svg { flex: none; }
  .change-diff[open] summary svg { transform: rotate(180deg); }
  .diff-scroll { max-height: 16rem; overflow: auto; border-top: 1px solid #d1d9e0; overscroll-behavior: contain; }
  .diff-scroll pre { margin: 0; padding: 0.65rem 0; min-width: max-content; background: #fff; color: #1f2328; }
  .diff-scroll code { font-family: var(--font-mono, monospace); font-size: 0.875rem; line-height: 1.7; tab-size: 2; }
  .diff-line { display: flex; padding: 0 0.8rem 0 0; white-space: pre; }
  .line-number { flex: none; width: 4ch; padding-right: 1ch; color: #59636e; text-align: right; user-select: none; }
  .line-code { padding-left: 0.5rem; }
  .diff-line.addition { background: #dafbe1; color: #116329; }
  .diff-line.deletion { background: #ffebe9; color: #82071e; }
  .diff-line.hunk { background: #ddf4ff; color: #0550ae; }
  .change-footer { padding: 1rem 1.1rem; border-top: 1px solid #d1d9e0; }
  .action-link { display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem; min-height: 2.5rem; border: 1px solid transparent; border-radius: 6px; padding: 0.45rem 0.8rem; font: inherit; font-size: 0.875rem; font-weight: 600; line-height: 1.3; text-decoration: none; cursor: pointer; }
  .action-link svg { flex: none; }
  .github-link { border-color: #d1d9e0; background: #f6f8fa; color: #1f2328; }
  .github-link:hover { border-color: #a6b0ba; background: #eff2f5; }
  .share-header { display: flex; align-items: center; gap: 0.65rem; padding: 0.65rem 1rem; }
  .share-header h4 { margin: 0; font-size: 1rem; font-weight: 700; letter-spacing: -0.015em; line-height: 1.3; }
  .slack-header { border-bottom: 1px solid #e8e2e9; color: #4a154b; }
  .slack-mark { display: grid; place-items: center; width: 2rem; height: 2rem; flex: none; border-radius: 7px; background: #4a154b; }
  .slack-message { margin: 0.7rem 1rem 0; padding-left: 0.8rem; border-left: 3px solid #ddd0de; }
  .slack-message p, .whatsapp-message p { margin: 0; color: #1f2328; white-space: pre-line; overflow-wrap: anywhere; }
  .summary-url { display: inline-block; margin-top: 0.4rem; color: #0969da; font-size: 0.875rem; text-decoration: none; }
  .summary-url:hover { text-decoration: underline; text-underline-offset: 3px; }
  .slack-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 0.8rem; padding: 0.65rem 1rem 0.8rem; }
  .copy-summary { border-color: #ddd0de; background: #fff; color: #4a154b; }
  .copy-summary:hover { background: #f6f1f6; }
  .copy-summary:disabled { cursor: wait; opacity: 0.65; }
  .copy-status { margin: 0; color: #59636e; font-size: 0.875rem; }
  .copy-status:empty { display: none; }
  .copy-fallback { padding: 0 1rem 1rem; font-size: 0.875rem; color: #4a154b; }
  .copy-fallback textarea { display: block; width: 100%; min-width: 0; margin-top: 0.5rem; border: 1px solid #ddd0de; border-radius: 6px; padding: 0.6rem; background: #fff; color: #1f2328; font: inherit; resize: vertical; }
  .whatsapp-card { padding-bottom: 1rem; border-color: #cadbcf; background: #eaf2ec; }
  .whatsapp-header { color: #075e54; }
  .whatsapp-header svg { flex: none; }
  .whatsapp-message { position: relative; margin: 0 1rem 0 1.45rem; border-radius: 0 8px 8px; padding: 0.8rem 0.9rem; background: #fff; box-shadow: 0 1px 2px rgb(11 61 43 / 9%); }
  .whatsapp-message::before { position: absolute; top: 0; left: -0.45rem; width: 0.5rem; height: 0.75rem; background: #fff; clip-path: polygon(0 0, 100% 0, 100% 100%); content: ''; }
  .whatsapp-link { margin: 0.65rem 1rem 0 1.45rem; background: #075e54; color: #fff; }
  .whatsapp-link:hover { background: #054d45; }
  .run-actions :is(a, button, summary, textarea):focus-visible { outline: 2px solid #5140ca; outline-offset: 3px; }
  .diff-scroll:focus-visible { outline: 2px solid #5140ca; outline-offset: -3px; }
  @media (max-width: 640px) {
    .run-actions { grid-template-columns: minmax(0, 1fr); gap: 0.9rem; }
    .change-body h4 { font-size: 1.125rem; }
    .diff-scroll { max-height: 15rem; }
  }
</style>
