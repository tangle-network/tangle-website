---
interface Props {
  change: {
    title: string;
    file: string;
    additions: number;
    deletions: number;
    diff: string;
  };
  summary: string;
}

const { change, summary } = Astro.props;
const diffLines = change.diff.replace(/\r\n/g, '\n').split('\n');
if (diffLines.at(-1) === '') diffLines.pop();

const lineKind = (line: string) => {
  if (line.startsWith('@@')) return 'hunk';
  if (line.startsWith('+')) return 'addition';
  if (line.startsWith('-')) return 'deletion';
  return 'context';
};

let oldNumber: number | null = null;
let newNumber: number | null = null;
let inHunk = false;
const displayDiffLines = diffLines.flatMap((line) => {
  if (line.startsWith('diff ')) inHunk = false;
  if (!inHunk && /^(diff |index |--- |\+\+\+ )/.test(line)) return [];
  const kind = lineKind(line);
  if (kind === 'hunk') {
    inHunk = true;
    const range = /^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@/.exec(line);
    oldNumber = range ? Number(range[1]) : null;
    newNumber = range ? Number(range[2]) : null;
    return [{ text: line, kind, oldLine: null, newLine: null }];
  }
  const isCode = kind === 'addition' || kind === 'deletion' || line.startsWith(' ');
  const oldLine = isCode && kind !== 'addition' ? oldNumber : null;
  const newLine = isCode && kind !== 'deletion' ? newNumber : null;
  if (oldLine !== null) oldNumber = oldLine + 1;
  if (newLine !== null) newNumber = newLine + 1;
  return [{ text: line, kind, oldLine, newLine }];
});
---


<div class="run-actions" data-theme="website" data-run-actions>
  <article class="action-card change-card" data-action-card="github" aria-label="GitHub file changes">
    <header class="card-header">
      <span class="logo-frame"><img src="/images/logos/github.svg" alt="" width="24" height="24" class="github-mark" loading="lazy" /></span>
      <h4>GitHub</h4>
    </header>
    <div class="change-body">
      <p class="change-title">{change.title}</p>
    </div>
    <div class="file-header">
      <span>{change.file}</span>
      <span class="change-counts">
        <span class="additions" aria-label={`${change.additions} lines added`}>+{change.additions}</span>
        <span class="deletions" aria-label={`${change.deletions} lines deleted`}>−{change.deletions}</span>
      </span>
    </div>
    <div class="diff-preview" aria-label={`Changes to ${change.file}`}>
      <pre><code>{displayDiffLines.map((line) => <span class={`diff-line ${line.kind}`}><span class="line-number" aria-hidden="true">{line.oldLine ?? ''}</span><span class="line-number" aria-hidden="true">{line.newLine ?? ''}</span><span class="line-code">{line.text || ' '}</span></span>)}</code></pre>
    </div>
  </article>

  <div class="share-cards">
    <article class="action-card slack-card" data-action-card="slack" aria-label="Slack summary">
      <header class="card-header slack-header">
        <span class="logo-frame"><img src="/images/logos/slack-colored.svg" alt="" width="24" height="24" loading="lazy" /></span>
        <h4>Slack</h4>
      </header>
      <div class="slack-message"><p>{summary}</p></div>
    </article>

    <article class="action-card whatsapp-card" data-action-card="whatsapp" aria-label="WhatsApp summary">
      <header class="card-header whatsapp-header">
        <span class="logo-frame"><img src="/images/logos/whatsapp-green.svg" alt="" width="24" height="24" loading="lazy" /></span>
        <h4>WhatsApp</h4>
      </header>
      <div class="whatsapp-message"><p>{summary}</p></div>
    </article>
  </div>
</div>

<style>
  /* Artwork: these cards reproduce GitHub, Slack and WhatsApp chrome, so they keep
     those products' literal colors instead of Brand tokens. */
  .run-actions {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.95fr);
    align-items: center;
    gap: 1.4rem;
    width: 100%;
    min-width: 0;
    padding: 1.25rem 1rem;
    box-sizing: border-box;
    color: var(--text-primary);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .action-card {
    --card-progress: clamp(0, calc((var(--actions-progress, 1) - var(--deal-start)) * 2.6), 1);
    position: relative;
    min-width: 0;
    border: 1px solid var(--md3-outline-variant);
    border-radius: 12px;
    background: var(--bg-card);
    box-shadow: 0 12px 32px rgb(25 28 36 / 11%);
    opacity: var(--card-progress);
    transform: translate3d(calc(var(--entry-x) * (1 - var(--card-progress))), calc(3.5rem * (1 - var(--card-progress))), 0) rotate(calc(var(--rest-angle) + var(--entry-angle) * (1 - var(--card-progress))));
    transform-origin: center bottom;
  }
  .change-card { --deal-start: 0; --entry-x: -1rem; --rest-angle: -3deg; --entry-angle: -9deg; z-index: 1; overflow: hidden; }
  .slack-card { --deal-start: 0.18; --entry-x: 1.5rem; --rest-angle: 4deg; --entry-angle: 8deg; z-index: 2; }
  .whatsapp-card { --deal-start: 0.42; --entry-x: 0.75rem; --rest-angle: -2deg; --entry-angle: 8deg; z-index: 3; padding-bottom: 1rem; border-color: var(--tone-teal-border); background: var(--tone-teal-bg); }
  .share-cards { display: grid; align-items: start; gap: 1.6rem; min-width: 0; }
  .card-header { display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 1rem; }
  .card-header h4 { margin: 0; color: inherit; font-size: 1rem; font-weight: 650; line-height: 1.3; letter-spacing: -0.015em; }
  .logo-frame { display: grid; flex: none; place-items: center; width: 32px; height: 32px; }
  .logo-frame img { display: block; width: 24px; height: 24px; object-fit: contain; }
  .github-mark { filter: brightness(0); }
  .change-card .card-header { border-bottom: 1px solid var(--md3-outline-variant); background: var(--bg-root); }
  .change-body { padding: 0.8rem 1rem; }
  .change-title { margin: 0; color: var(--text-primary); font-size: 1rem; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
  .file-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; padding: 0.65rem 0.9rem; border-block: 1px solid var(--md3-outline-variant); background: var(--bg-root); font-family: var(--font-mono, monospace); font-size: 0.875rem; }
  .file-header > span:first-child { min-width: 0; overflow-wrap: anywhere; }
  .change-counts { display: inline-flex; flex: none; gap: 0.5rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .additions { color: var(--surface-success-text); }
  .deletions { color: var(--surface-danger-text); }
  .diff-preview pre { margin: 0; padding: 0.5rem 0; background: var(--bg-card); color: var(--text-primary); }
  .diff-preview code { font-family: var(--font-mono, monospace); font-size: 0.875rem; line-height: 1.6; tab-size: 2; }
  .diff-line { display: flex; padding-right: 0.6rem; }
  .line-number { flex: none; width: 3ch; padding-right: 0.6ch; color: var(--text-muted); text-align: right; user-select: none; }
  .line-code { min-width: 0; padding-left: 0.4rem; white-space: pre-wrap; overflow-wrap: anywhere; }
  .diff-line.addition { background: var(--surface-success-bg); color: var(--surface-success-text); }
  .diff-line.deletion { background: var(--surface-danger-bg); color: var(--surface-danger-text); }
  .diff-line.hunk { background: var(--surface-info-bg); color: var(--surface-info-text); }
  .slack-header { border-bottom: 1px solid var(--md3-outline-variant); color: var(--tone-pink-text); }
  .slack-message { margin: 0.85rem 1rem 1rem; padding-left: 0.8rem; border-left: 3px solid var(--tone-pink-border); }
  .slack-message p, .whatsapp-message p { margin: 0; color: var(--text-primary); white-space: pre-line; overflow-wrap: anywhere; }
  .whatsapp-header { color: var(--tone-teal-text); }
  .whatsapp-message { position: relative; margin: 0 1rem 0 1.4rem; border-radius: 0 8px 8px; padding: 0.8rem; background: var(--bg-card); box-shadow: 0 1px 2px rgb(11 61 43 / 9%); }
  .whatsapp-message::before { position: absolute; top: 0; left: -0.45rem; width: 0.5rem; height: 0.75rem; background: var(--bg-card); clip-path: polygon(0 0, 100% 0, 100% 100%); content: ''; }
  @media (max-width: 640px) {
    .run-actions { grid-template-columns: minmax(0, 1fr); padding: 0.65rem; gap: 1.1rem; }
    .share-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; }
    .change-card { --rest-angle: -1deg; }
    .slack-card { --rest-angle: 2deg; }
    .whatsapp-card { --rest-angle: -1deg; padding-bottom: 0.8rem; }
    .share-cards .card-header { gap: 0.35rem; padding: 0.6rem; }
    .share-cards .card-header h4 { font-size: 0.875rem; }
    .slack-message { margin: 0.65rem 0.65rem 0.8rem; padding-left: 0.55rem; }
    .whatsapp-message { margin: 0 0.65rem 0 0.85rem; padding: 0.65rem; }
  }
  @media (max-width: 360px) { .share-cards { grid-template-columns: minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .action-card { opacity: 1; transform: none; } }
</style>
