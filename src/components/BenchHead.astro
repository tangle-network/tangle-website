---
// The head of a benchmark page: its title, the two pages, and what its numbers cover.
interface Props { regime: 'stack' | 'applied'; title: string; status: string }
const { regime, title, status } = Astro.props;
const regimes = [
  { id: 'stack', href: '/benchmarks', label: 'Sandboxes' },
  { id: 'applied', href: '/benchmarks/applied', label: 'Applied AI' },
];
---
<header class="bench-head">
  <h1>{title}</h1>
  <nav class="regimes" aria-label="Benchmark pages">
    {regimes.map((r) => <a href={r.href} aria-current={r.id === regime ? 'page' : undefined}>{r.label}</a>)}
  </nav>
  <p>{status}</p>
</header>
