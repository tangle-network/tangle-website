---
// The head of a leaderboard page: the two regimes, then the title beside its one-paragraph intro and the dated leader line.
interface Props { regime: 'stack' | 'applied'; title: string }
const { regime, title } = Astro.props;
const regimes = [
  { id: 'stack', href: '/benchmarks', label: 'The stack' },
  { id: 'applied', href: '/benchmarks/applied', label: 'Applied AI' },
];
---
<header class="bench-head">
  <nav class="regimes" aria-label="Benchmark regimes">
    {regimes.map((r) => <a href={r.href} aria-current={r.id === regime ? 'page' : undefined}>{r.label}</a>)}
  </nav>
  <div class="bench-title">
    <h1>{title}</h1>
    <div class="bench-intro"><slot /></div>
  </div>
</header>
