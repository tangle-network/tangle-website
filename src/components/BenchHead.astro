---
// The head of a leaderboard page: the two boards, the title and the day of its newest run.
interface Props { regime: 'stack' | 'applied'; title: string; updated: string }
const { regime, title, updated } = Astro.props;
const regimes = [
  { id: 'stack', href: '/benchmarks', label: 'Sandboxes' },
  { id: 'applied', href: '/benchmarks/applied', label: 'Applied AI' },
];
---
<header class="bench-head">
  <nav class="regimes" aria-label="Benchmark boards">
    {regimes.map((r) => <a href={r.href} aria-current={r.id === regime ? 'page' : undefined}>{r.label}</a>)}
  </nav>
  <div class="bench-title">
    <h1>{title}</h1>
    <p>Updated {updated}</p>
  </div>
</header>
