---
// The head of a benchmarks page: the two regimes side by side, then the page's title and intro.
// One regime measures the stack itself; the other measures agents built on it doing real work.
interface Props { regime: 'stack' | 'applied'; title: string }
const { regime, title } = Astro.props;
const regimes = [
  { id: 'stack', href: '/benchmarks', label: 'The stack', what: 'how fast and reliable Tangle is' },
  { id: 'applied', href: '/benchmarks/applied', label: 'Applied AI', what: 'how well agents built on it do real work' },
];
---
<header class="bench-head">
  <nav class="regimes" aria-label="Benchmark regimes">
    {regimes.map((r) => <a href={r.href} aria-current={r.id === regime ? 'page' : undefined}><strong>{r.label}</strong><span>{r.what}</span></a>)}
  </nav>
  <h1>{title}</h1>
  <slot />
</header>
