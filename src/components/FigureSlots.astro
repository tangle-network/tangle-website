---
// Figure blocks from @tangle-network/charts, in page order. A figure the
// library refused keeps its place and states the library's reason.
import { renderFigure } from '@tangle-network/charts';
import { FIGURE_NAMES, type FigureSlot } from '../data/benchmarks/figures';

interface Props {
  slots: FigureSlot[];
  compact?: boolean;
}

const { slots, compact = false } = Astro.props;
---

{slots.map((slot) =>
  'figure' in slot ? (
    <Fragment set:html={renderFigure(slot.figure, slot.note, compact ? { presentation: 'chart' } : undefined)} />
  ) : (
    <figure class="tgc-figure" id={`fig-${slot.refusal.id}`}>
      <h3 class="tgc-finding">{FIGURE_NAMES[slot.refusal.id] ?? slot.refusal.id}: not drawn</h3>
      <p class="tgc-lede">{slot.refusal.refused}</p>
    </figure>
  ),
)}
