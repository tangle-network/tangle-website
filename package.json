{
  "name": "tangle-website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "status:collect": "node scripts/collect-status.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:blog": "node scripts/audit-blog.mjs",
    "check:blog:report": "node scripts/audit-blog.mjs --report audit-results/blog-editorial-audit.md",
    "check:blog:reader": "node --test scripts/audit-blog-reader.test.mjs && node scripts/audit-blog-reader.mjs",
    "check:blog:reader:report": "node scripts/audit-blog-reader.mjs --report docs/editorial/blog-zero-context-triage.md",
    "check:copy": "node scripts/check-copy.mjs",
    "check:models": "node scripts/check-models.mjs",
    "check:status-workflow": "node scripts/check-status-workflow.mjs",
    "test:cta": "node --test scripts/cta-observability.test.mjs",
    "test:cta:corpus": "node scripts/cta-observability-corpus.mjs",
    "audit:visual": "node scripts/visual-audit.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.7.4",
    "@gsap/react": "^2.1.2",
    "@iconify-json/simple-icons": "^1.2.94",
    "@tailwindcss/vite": "^4.3.3",
    "@tangle-network/brand": "file:../brand/packages/brand",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.3.1",
    "gsap": "^3.15.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "wrangler": "^4.128.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@types/serve-handler": "^6.1.4",
    "linkinator": "^7.6.1",
    "openai": "^6.49.0",
    "playwright": "^1.62.1",
    "serve-handler": "^6.1.7"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.2",
      "esbuild": "0.28.1"
    }
  }
}
