{
  "name": "tangle-website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "status:collect": "node scripts/collect-status.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:blog": "node scripts/audit-blog.mjs",
    "check:blog:report": "node scripts/audit-blog.mjs --report audit-results/blog-editorial-audit.md",
    "check:blog:reader": "node --test scripts/audit-blog-reader.test.mjs && node scripts/audit-blog-reader.mjs",
    "check:blog:reader:report": "node scripts/audit-blog-reader.mjs --report docs/editorial/blog-zero-context-triage.md",
    "check:copy": "node --test scripts/extract-copy.test.mjs scripts/copy-audit-model.test.mjs && node scripts/check-copy.mjs",
    "check:examples": "cd scripts/examples-typecheck && npm ci --no-audit --no-fund --silent && npm run --silent typecheck",
    "check:drift": "tangle-drift check --surface website --repo-dir . --worktree --baseline drift-baseline.json",
    "check:plans": "node scripts/check-plans.mjs",
    "check:models": "node scripts/check-models.mjs",
    "check:status-workflow": "node scripts/check-status-workflow.mjs",
    "test:benchmarks": "node --experimental-strip-types --test scripts/benchmarks-board.test.mjs",
    "test:cta": "node --test scripts/cta-observability.test.mjs",
    "test:cta:corpus": "node scripts/cta-observability-corpus.mjs",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tangle-network/agent-interface": "5.10.2",
    "@tangle-network/brand": "1.27.1",
    "@tangle-network/charts": "0.19.0",
    "@tangle-network/ui": "11.44.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.152.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "zod@4": "4.6.7",
      "undici@7": "7.30.1"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3"
  }
}
