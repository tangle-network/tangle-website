{
  "name": "tangle-website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "status:collect": "node scripts/collect-status.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:blog": "node scripts/audit-blog.mjs",
    "check:blog:report": "node scripts/audit-blog.mjs --report audit-results/blog-editorial-audit.md",
    "check:copy": "node --test scripts/extract-copy.test.mjs scripts/copy-audit-model.test.mjs && node scripts/check-copy.mjs",
    "check:examples": "cd scripts/examples-typecheck && npm ci --no-audit --no-fund --silent && npm run --silent typecheck",
    "check:runs": "node --experimental-strip-types scripts/record-examples.mts --check",
    "check:editor": "node scripts/example-editor.test.mjs",
    "check:drift": "tangle-drift check --surface website --repo-dir . --worktree --baseline drift-baseline.json",
    "check:plans": "node scripts/check-plans.mjs",
    "check:public": "node scripts/check-public.mjs dist dist/client https://tangle.tools",
    "crawl:public": "node scripts/check-public.mjs live",
    "check:models": "node scripts/check-models.mjs",
    "typecheck": "astro check",
    "pull:benchmarks": "node scripts/pull-sandbox-benchmarks.mjs",
    "import:applied": "node scripts/import-applied.mts",
    "check:blog-code": "node scripts/check-blog-code.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tangle-network/agent-interface": "5.10.14",
    "@tangle-network/brand": "1.31.3",
    "@tangle-network/charts": "4.0.13",
    "@tangle-network/sandbox-ui": "8.0.8",
    "@tangle-network/ui": "11.51.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "astro": "^7.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.152.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "zod@4": "4.6.7",
      "undici@7": "7.30.1",
      "@emnapi/core": "1.11.3",
      "@emnapi/runtime": "1.11.3"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3"
  }
}
